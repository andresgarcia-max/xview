<config>
	<!-- Confirms that a device is eligible for the suite of Operator customizations -->
	<feature name="com.google.android.tv.operator_tier" />
	
	<!-- Confirms that a device is *eligible* for a Custom Launcher -->
	<feature name="com.google.android.tv.custom_launcher_eligible" />
	
	<!-- Confirms that a device uses a Custom Launcher, rather than TvLauncher -->
	<feature name="com.google.android.tv.custom_launcher" />
	
</config>