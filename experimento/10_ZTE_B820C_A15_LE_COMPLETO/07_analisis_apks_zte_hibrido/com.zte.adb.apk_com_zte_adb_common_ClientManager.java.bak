	private void init(){
		if(0 == cc_opened){
			int myPid = Process.myPid();
			Log.d(TAG, FILE + " [init] pid=" + Process.myPid() + ",tid = " + Process.myTid());
			compCom = new McspCompCommun(TAG+myPid);
			int ret = compCom.MCSP_SrvEvt_Init();
			Log.d(TAG, FILE + " [init] compcom first open,ret="+ret);
			if(0 == ret ){
				cc_opened = 1;
			}
		}

		cfgmanager.newComoCommun(compCom);
		for(int i=0; i<5; i++){
			if(Ping() == 0){
				connect_ok = true;
				break;
			}
		}
		if(mDestCompName.equals("Terminal")) {
			cfgDispatcher.newComoCommun(compCom);	
		}
	}
	
	public void Destroy() {
		Log.d(TAG, FILE + " [Destroy] before Destroy()......");
		compCom.MCSP_SrvEvt_Uninit();
		cc_opened = 0; 
		Log.d(TAG, FILE + " [Destroy] after Destroy()......");
	}
