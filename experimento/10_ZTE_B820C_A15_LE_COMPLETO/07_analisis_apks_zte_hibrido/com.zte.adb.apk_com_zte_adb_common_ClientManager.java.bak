	//0:CONNECTING, 2:FAILED, 3:SUCC other:FAILED
	public int getConnectState(int nettype)	{
		try{
			byte szData[] = new byte[4];
			byte aReply[] = new byte[4*3];
			int iReplyLen[] = new int[1];
			iReplyLen[0] = 4*3;
			
			Log.d(TAG, FILE + " [getConnectState] Before getConnectState()...... pid=" + Process.myPid() + ",tid = " + Process.myTid()+",uid="+Process.myUid() 
				+ ", McspEvt.CMD_NA_GETCONNECTSTATE = 0x"+ Integer.toHexString(McspEvt.CMD_NA_GETCONNECTSTATE));
			int iRet = compCom.MCSP_InvokeService(NETACCESS, McspEvt.CMD_NA_GETCONNECTSTATE, szData, szData.length, aReply, iReplyLen);						
			if (-1 == iRet){
				Log.e(TAG, FILE + " [getConnectState] compCom.MCSP_InvokeService error!!!");
				return -1;
			}
			ByteBuffer buffer = ByteBuffer.wrap(aReply);
			buffer.order(ByteOrder.nativeOrder());
			int sessionID = buffer.getInt();
			int returnResult = buffer.getInt();
			int NetState = buffer.getInt();
			
			Log.d(TAG, FILE + " [getConnectState] After getConnectState()......NetState="+NetState);
			return NetState;
		} catch (Exception e){
			Log.e(TAG, FILE + " [getConnectState] catch Exception!!!");
			e.printStackTrace();
			return -1;
		}
	}

    // added getNetHardware()  by pengzs ,to check out whether have ethernet card or network cable 2013.11.27 begin
	//0:have ethernet card or network cable.  0x75 :have no wireless card  0x76: have no network cable -1:get error
	public int getNetHardwareState(){
        if(false == connect_ok)
        {
            Log.d(TAG, FILE + "[getNetHardwareState] mcsp server didn't connect, init first");
            init();
        }
    
		try {
			byte szData[] = new byte[4];
			byte aReply[] = new byte[4*3];
			int iReplyLen[] = new int[1];
			iReplyLen[0] = 4*3;
			Log.d(TAG, FILE + " [getNetHardwareState] begin getNetHardwareState()...... pid=" + Process.myPid() + ",tid = " + Process.myTid()+",uid="+Process.myUid());
			int iRet = compCom.MCSP_InvokeService(NETACCESS, McspEvt.CMD_NA_DETECTNETLINK, szData, szData.length, aReply, iReplyLen);						
			if (-1 == iRet){
				Log.e(TAG, FILE + " [getNetHardwareState] getNetHardwareState compCom.MCSP_InvokeService error!!!");
				return -1;
			}
			ByteBuffer buffer = ByteBuffer.wrap(aReply);
			buffer.order(ByteOrder.nativeOrder());
			buffer.getInt();// skip two byes
			buffer.getInt();
			int netHardwareState = buffer.getInt();
			
			Log.d(TAG, FILE + " [getNetHardwareState] normal end getNetHardwareState()......netHardwareState="+netHardwareState);
			return netHardwareState;
		} catch (Exception e){
			Log.e(TAG, FILE + " [getNetHardwareState] getNetHardwareState catch Exception!!!");
			e.printStackTrace();
			return -1;
		}
	}
	
    // added getNetworkHardware()  by pengzs ,to check out whether have ethernet card or network cable 2013.11.27 end 
	
	//褰撶綉缁滈厤缃湁淇敼鏃讹紝閲嶅惎缃戠粶 ,nettype鍚箟瑙佸睘鎬у畾涔夈€?
	public int startnet(int nettype){
		Log.d(TAG, FILE + " [startnet] Before startnet()......");
		try{
			if (nettype != NET_MODE_WIRE && nettype != NET_MODE_WIRELESS && nettype != NET_MODE_BOTHCARD){
				Log.d(TAG, FILE + " [startnet] input parameter error!!!");
				return -1;
			}
			byte szData[] = new byte[1088];
			byte aReply[] = new byte[1024];
			int iReplyLen[] = new int[1];
			iReplyLen[0] = 1024;
			
			System.arraycopy(UtilsInstance.intToByte(nettype), 0, szData, 0, UtilsInstance.intToByte(nettype).length);
			Log.d(TAG, FILE + " [startnet] pid=" + Process.myPid() + ",tid = " + Process.myTid()+",uid="+Process.myUid()
				+" McspEvt.CMD_NA_STARTNETLINK=0x"+Integer.toHexString(McspEvt.CMD_NA_STARTNETLINK) +",nettype = "+nettype);
			int iRet = compCom.MCSP_InvokeService(NETACCESS, McspEvt.CMD_NA_STARTNETLINK, szData, szData.length, aReply, iReplyLen);
			if (-1 == iRet){
				Log.e(TAG, FILE + " [startnet] compCom.MCSP_InvokeService error!!!");
				return -1;
			}
			String strReply = new String(aReply);
			String strData = strReply.toString().trim();
			if (null == strData){
				Log.d(TAG, FILE + " [startnet] return data error!!!,strData= null");
				return -1;
			} 
			Log.d(TAG, FILE + " [startnet] After startnet()......");
			return 0;
		} catch (Exception e){
			Log.e(TAG, FILE + " [startnet] catch Exception!!!");
			e.printStackTrace();
			return -1;
		}
	}

	public int stopnet(int nettype){
		Log.d(TAG, FILE + " [stopnet] Before stopnet()......");
		try{
			if (nettype != NET_MODE_WIRE && nettype != NET_MODE_WIRELESS && nettype != NET_MODE_BOTHCARD){
				Log.d(TAG, FILE + " [stopnet] input parameter err!!!");
				return -1;
			}
			byte szData[] = new byte[1088];
			byte aReply[] = new byte[1024];
			int iReplyLen[] = new int[1];
			iReplyLen[0] = 1024;
			
			System.arraycopy(UtilsInstance.intToByte(nettype), 0, szData, 0, UtilsInstance.intToByte(nettype).length);
			
			Log.d(TAG, FILE + " [stopnet] pid=" + Process.myPid() + ",tid = " + Process.myTid()+",uid="+Process.myUid()
				+ "McspEvt.CMD_NA_STOPNETLINK=0x"+Integer.toHexString(McspEvt.CMD_NA_STOPNETLINK)+",nettype = "+nettype);
			int iRet = compCom.MCSP_InvokeService(NETACCESS, McspEvt.CMD_NA_STOPNETLINK, szData, szData.length, aReply, iReplyLen);
			if (-1 == iRet){
				Log.e(TAG, FILE + " [stopnet] compCom.MCSP_InvokeService error iRet = -1 ");
				return -1;
			}
			String strReply = new String(aReply);
			String strData = strReply.toString().trim();
			if (null == strData){
				Log.e(TAG, FILE + " [stopnet] return data = null !!!");
				return -1;
			} 
			Log.d(TAG, FILE + " [stopnet] After stopnet()......");
			return 0;
		} catch (Exception e) {
			// TODO: handle exception
			Log.e(TAG, FILE + " [stopnet] catch Exception!!!");
			e.printStackTrace();
			return -1;
		}
	}
	
	public String[] getApList(){
		Log.d(TAG, FILE + " [getApList] iEventId=0x"+Integer.toHexString(McspEvt.CMD_NA_WIFIAPLIST));
		byte[] aData = new byte[4];
		int MaxLen = 2048;
		ByteBuffer buffer=ByteBuffer.wrap(aData);
		buffer.putInt(MaxLen);
		
		int aDataLen = 4;
		byte[] pAPlist = new byte[MaxLen];
		int[] iDataLen = new int[1];
		iDataLen[0] = MaxLen;
		
		compCom.MCSP_InvokeService(NETACCESS, McspEvt.CMD_NA_WIFIAPALLLIST, aData, aDataLen, pAPlist, iDataLen);
		
		/* Different encoding for different Ap in list -- begin */
		String strtemp;
		try {
			UtilsInstance.bytes2HexString(pAPlist);
			strtemp = new String(pAPlist, 8, MaxLen-8, "GBK").trim();
		} catch (UnsupportedEncodingException e) {
			Log.d(TAG, FILE + " [getApList] change code error ap_info");
			e.printStackTrace(); 
			return null;
		}
		/* Different encoding for different Ap in list -- end */
		
		Log.d(TAG, FILE + " [getApList] strtemp="+strtemp);
		String []apSinInfo = strtemp.split("\n");
		if(strtemp.trim().equals("")){
			return null;
		}
		Log.d(TAG, FILE + " [getApList] =====apSinInfo length======"+apSinInfo.length);
		return strtemp.split("\n");
	}
}
