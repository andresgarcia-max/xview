SO 1: ASEGURAR QUE FASTTRACK ESTÉ DESACTIVADO PARA QUE LAS COLAS FUNCIONEN\\n# ------------------------------------------------------------------------------\\n/ip firewall filter remove [find action=\\\"fasttrack-connection\\\"]\\n\\n# ------------------------------------------------------------------------------\\n# PASO 2: CREAR COLAS INTELIGENTES PCQ (CADA IP DENTRO DEL PAQUETE RECIBE SU VELOCIDAD)\\n# ------------------------------------------------------------------------------\\n/queue type remove [find name~\\\"PCQ_PAQUETE_\\\"]\\n\\n# --- \n<truncated 6730 bytes>","Overwrite":"true","Path":"\"C:\\\\Users\\\\andre\\\\OneDrive\\\\Desktop\\\\microtik\\\\ubiquiti\\\\00_Configuraciones_Optimas_PowerBeam_y_LiteBeam_M5\\\\09_MikroTik_Paquetes_5_10_20_30_40_Megas.rsc\""}}],"truncated_fields":["tool_calls"]}
