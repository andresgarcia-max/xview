{"step_index":41,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-10-24T15:32:21Z","content":"Created At: 2026-10-24T09:32:21-06:00\nCompleted At: 2026-10-24T09:32:21-06:00\nShowing lines 1-100 of 164\n1: // Utility for gym-themed avatars for members featuring high-definition gym facilities and equipment\r\n2: import { \r\n3:   gymDumbbellsBase64,\r\n4:   gymRackBase64,\r\n5:   gymCableBase64,\r\n6:   gymCardioBase64,\r\n7:   maleGym1Base64, \r\n8:   maleGym2Base64, \r\n9:   femaleGym1Base64, \r\n10:   femaleGym2Base64 \r\n11: } from '../assets/avatars/avatarBase64';\r\n12: \r\n13: // 100% offline Base64 ultra-HD photos of gym facilities, areas and equipment\r\n14: export const GYM_AREAS_PHOTOS = [\r\n15:   gymRackBase64,      // Rack de sentadillas y barras olímpicas Eleiko con discos dorados\r\n16:   gymDumbbellsBase64, // Zona de mancuernas premium acero negro y dorado\r\n17:   gymCableBase64,     // Máquina de poleas cruzadas y fuerza\r\n18:   gymCardioBase64,    // Zona de cardio y caminadoras panorámicas de lujo\r\n19: ];\r\n20: \r\n21: // Presets for selection in modals\r\n22: export const MALE_GYM_PHOTOS = [\r\n23:   gymRackBase64,\r\n24:   gymDumbbellsBase64,\r\n25: ];\r\n26: \r\n27: export const FEMALE_GYM_PHOTOS = [\r\n28:   gymCableBase64,\r\n29:   gymCardioBase64,\r\n30: ];\r\n31: \r\n32: // Offline avatars (using high-def gym area photos)\r\n33: export const MALE_GYM_SVG_AVATAR = gymRackBase64;\r\n34: export const FEMALE_GYM_SVG_AVATAR = gymCableBase64;\r\n35: \r\n36: const KNOWN_FEMALE_NAMES = new Set([\r\n37:   'maria', 'mary', 'carmen', 'ana', 'valeria', 'sofia', 'andrea', 'valentina', 'camila',\r\n38:   'isabella', 'lucia', 'natalia', 'daniela', 'mariana', 'fernanda', 'gabriela', 'laura',\r\n39:   'paula', 'patricia', 'claudia', 'diana', 'carolina', 'brenda', 'alejandra', 'sara',\r\n40:   'monica', 'elena', 'rosa', 'jessica', 'vanessa', 'karen', 'karla', 'guadalupe', 'lupita',\r\n41:   'ximena', 'jimena', 'paulina', 'adriana', '