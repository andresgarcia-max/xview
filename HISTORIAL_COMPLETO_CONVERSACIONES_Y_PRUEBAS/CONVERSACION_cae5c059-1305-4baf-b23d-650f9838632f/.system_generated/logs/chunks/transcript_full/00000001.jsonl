{"step_index":37,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-10-24T15:32:12Z","content":"Created At: 2026-10-24T09:32:12-06:00\nCompleted At: 2026-10-24T09:32:12-06:00\nShowing lines 1-100 of 250\n1: // Web Audio API Synthesizer for biometric turnstile and POS feedback\r\n2: \r\n3: class SoundEffects {\r\n4:   private ctx: AudioContext | null = null;\r\n5:   private lastGrantedTime = 0;\r\n6:   private lastDeniedTime = 0;\r\n7: \r\n8:   constructor() {\r\n9:     if (typeof window !== 'undefined') {\r\n10:       const unlock = () => {\r\n11:         this.unlock();\r\n12:         window.removeEventListener('pointerdown', unlock);\r\n13:         window.removeEventListener('click', unlock);\r\n14:         window.removeEventListener('keydown', unlock);\r\n15:       };\r\n16:       window.addEventListener('pointerdown', unlock, { passive: true });\r\n17:       window.addEventListener('click', unlock, { passive: true });\r\n18:       window.addEventListener('keydown', unlock, { passive: true });\r\n19:     }\r\n20:   }\r\n21: \r\n22:   private initCtx() {\r\n23:     if (!this.ctx && typeof window !== 'undefined') {\r\n24:       const AudioCtx = window.AudioContext || (window as unknown as { webkitAudioContext: typeof AudioContext }).webkitAudioContext;\r\n25:       if (AudioCtx) {\r\n26:         this.ctx = new AudioCtx();\r\n27:       }\r\n28:     }\r\n29:   }\r\n30: \r\n31:   public unlock() {\r\n32:     try {\r\n33:       this.initCtx();\r\n34:       if (this.ctx && this.ctx.state === 'suspended') {\r\n35:         this.ctx.resume().catch(() => {});\r\n36:       }\r\n37:     } catch {\r\n38:       // Ignore\r\n39:     }\r\n40:   }\r\n41: \r\n42:   // Resonant, crystal-clear 4-tone futuristic chime for access granted\r\n43:   playAccessGranted() {\r\n44:     try {\r\n45:       const timestamp = Date.now();\r\n46:       if (timestamp - this.lastGrantedTime < 500) return;\r\n47:       this.lastGrantedTime = timestamp;\r\n48: \r\n49:       this.unlock();\r\n50:       if (!this.ctx) return;\r\n51: \r\n52:       const trigger = () => {\r\n53:         if (!this.ctx) return;\r\n54:         const now = this.ctx.currentTime;\r\n55: \r\n56:         // Ascending major chord arpeggio with high sparkle:\r\n57:         // C5 (523.25 Hz) -> E5 (659.25 Hz) -> G5 (783.99 Hz) -> C6 (1046.50 Hz)\r\n58:         const notes = [\r\n59:           { freq: 523.25, time: 0.00, dur: 0.25, vol: 0.32 },\r\n60:           { freq: 659.25, time: 0.08, dur: 0.28, vol: 0.34 },\r\n61:           { freq: 783.99, time: 0.16, dur: 0.32, vol: 0.36 },\r\n62:           { freq: 1046.50, time: 0.26, dur: 0.65, vol: 0.42 },\r\n63:         ];\r\n64: \r\n65:         notes.forEach(({ freq, time, dur, vol }) => {\r\n66:           if (!this.ctx) return;\r\n67:           const osc = this.ctx.createOscillator();\r\n68:           const gain = this.ctx.createGain();\r\n69: \r\n70:           osc.type = 'sine';\r\n71:           osc.frequency.setValueAtTime(freq, now + time);\r\n72: \r\n73:           // Subtle bell overtone\r\n74:           const oscHarmonic = this.ctx.createOscillator();\r\n75:           const gainHarmonic = this.ctx.createGain();\r\n76:           oscHarmonic.type = 'triangle';\r\n77:           oscHarmonic.frequency.setValueAtTime(freq * 2, now + time);\r\n78: \r\n79:           gain.gain.setValueAtTime(vol, now + time);\r\n80:           gain.gain.exponentialRampToValueAtTime(0.001, now + time + dur);\r\n81: \r\n82:           gainHarmonic.gain.setValueAtTime(vol * 0.25, now + time);\r\n83:           gainHarmonic.gain.exponentialRampToValueAtTime(0.001, now + time + dur * 0.7);\r\n84: \r\n85:           osc.connect(gain);\r\n86:           oscHarmonic.connect(gainHarmonic);\r\n87:           gain.connect(this.ctx.destination);\r\n88:           gainHarmonic.connect(this.ctx.destination);\r\n89: \r\n90:           osc.start(now + time);\r\n91:           osc.stop(now + time + dur);\r\n92:           oscHarmonic.start(now + time);\r\n93:           oscHarmonic.stop(now + time + dur);\r\n94:         });\r\n95:       };\r\n96: \r\n97:       if (this.ctx.state === 'suspended') {\r\n98:         this.ctx.resume().then(trigger).catch(() => {});\r\n99:       } else {\r\n100:         trigger();\r"}
