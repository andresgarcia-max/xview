) return true;\r\n1498:       if (emailNorm && emailNorm === q) return true;\r\n1499:       if (queryDigits.length >= 6 && phoneDigits.endsWith(queryDigits)) return true;\r\n1500:       if (nameNorm.includes(q)) return true;\r\n1501:       if (qWords.length > 1 && qWords.every(w => nameNorm.includes(w))) return true;\r\n1502:       return false;\r\n1503:     });\r\n1504: \r\n1505:     const now = new Date().toISOString();\r\n1506: \r\n1507:     if (!matched) {\r\n1508:       sounds.playAccessDenied();\r\n1509:       const failLog: AccessLog = {\r\n1510:         id: `LOG-${Date.now()}`,\r\n1511:         timestamp: now,\r\n1512:         clientName: 'Huella / Credencial No Identificada',\r\n1513:         status: 'denied',\r\n1514:         reason: `Credencial o huella \"${biometricQuery.trim()}\" no encontrada en el padrón de socios`,\r\n1515:         method: 'fingerprint',\r\n1516:       };\r\n1517:       setAccessLogs(prev => [failLog, ...prev]);\r\n1518:       broadcastLocalSync({ type: 'ACCESS_LOG_ADDED', log: failLog });\r\n1519:       pushAccessLogToServer(failLog).catch(() => {});\r\n1520:       return { granted: false, reason: failLog.reason, log: failLog };\r"}
