stName === 'ma')) {\r\n79:     return 'female';\r\n80:   }\r\n81:   if (firstName === 'jose' && secondName === 'maria') {\r\n82:     return 'male';\r\n83:   }\r\n84: \r\n85:   // Exact dictionary match for first name\r\n86:   if (KNOWN_FEMALE_NAMES.has(firstName)) return 'female';\r\n87:   if (KNOWN_MALE_NAMES.has(firstName)) return 'male';\r\n88: \r\n89:   // Check second name if first name is indeterminate\r\n90:   if (KNOWN_FEMALE_NAMES.has(secondName)) return 'female';\r\n91:   if (KNOWN_MALE_NAMES.has(secondName)) return 'male';\r\n92: \r\n93:   // Fallback heuristics: names ending in 'a' are overwhelmingly female in Spanish\r\n94:   if (firstName.endsWith('a') && firstName !== 'luca' && firstName !== 'luka' && firstName !== 'borja') {\r\n95:     return 'female';\r\n96:   }\r\n97: \r\n98:   // Otherwise default to male\r\n99:   return 'male';\r\n100: }\r"}
