SalesTransfer;\r\n38:   const totalMemberships = cashSession.totalMembershipsCash + cashSession.totalMembershipsCard + (cashSession.totalMembershipsTransfer || 0);\r\n39:   const grandTotalShift = totalStoreSales + totalMemberships;\r\n40: \r\n41:   const totalElectronic = cashSession.totalSalesCard + cashSession.totalSalesTransfer + cashSession.totalMembershipsCard + (cashSession.totalMembershipsTransfer || 0);\r\n42:   const expectedCashInDrawer = cashSession.expectedCash;\r\n43: \r\n44:   const remanentCash = cashSession.leaveCashInDrawer ? (cashSession.remanentCash || 0) : 0;\r\n45:   const withdrawnCash = cashSession.withdrawnCash ?? (cashSession.actualCash ?? expectedCashInDrawer);\r\n46: \r\n47:   // ==========================================\r\n48:   // HOJA 1: RESUMEN DE CORTE DE CAJA (CORTE Z)\r\n49:   // ==========================================\r\n50:   const summaryData: (string | number)[][] = [\r"}
