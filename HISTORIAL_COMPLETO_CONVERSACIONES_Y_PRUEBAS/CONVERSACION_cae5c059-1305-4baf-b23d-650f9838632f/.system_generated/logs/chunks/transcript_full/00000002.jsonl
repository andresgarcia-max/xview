.toISOString().slice(0, 10);\r\n357:   const fileName = `Reporte_Ingresos_${safePeriod}_${safeDate}.xlsx`;\r\n358:   XLSX.writeFile(wb, fileName);\r\n359: };\r"}
{"step_index":181,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-10-24T15:38:03Z","input_tokens":4211,"cache_read_tokens":105566,"output_tokens":1149,"tool_calls":[{"name":"edit_file","args":{"Path":"c:\\Users\\andre\\OneDrive\\Desktop\\gym\\LEGENDS\\src\\utils\\excelExport.ts","Replacement":"  const safePeriod = periodLabel.replace(/[\\s\\/\\(\\)]+/g, '_');\n  const safeDate = new Date().toISOString().slice(0, 10);\n  const fileName = `Reporte_Ingresos_${safePeriod}_${safeDate}.xlsx`;\n  XLSX.writeFile(wb, fileName);\n};\n\nexport const exportClientsToExcel = (clients: any[]) => {\n  const wb = XLSX.utils.book_new();\n\n  const titleRows = [\n    ['FITNESS LEGENDS PRO GYM - PADRÓN MAESTRO DE CLIENTES & MEMBRESÍAS'],\n    [`Generado el: ${new Date().toLocaleString('es-MX')}`],\n    [`Total registros: ${clients.length}`],\n    ['']\n  ];\n\n  const headers = [\n    'ID Socio',\n    'Nombre Completo',\n    'DNI / Documento',\n    'Teléfono',\n    'Correo Electrónico',\n    'Plan de Membresía',\n    'Costo Plan ($ MXN)',\n    'Fecha Inicio',\n    'Fecha Vencimiento',\n    'Días Restantes',\n    'Estado Membresía',\n    'Huella Enrolada',\n    'Asistencias Totales',\n    'Última Asistencia',\n    'Gasto en Tienda ($ MXN)',\n    'Contacto de Emergencia',\n    'Tel. Emergencia',\n    'Notas Médicas'\n  ];\n\n  const dataRows = clients.map(c => {\n    const isExpired = c.membership?.status === 'expired' || c.membership?.daysRemaining < 0;\n    const isExpiring = c.membership?.daysRemaining <= 5 && !isExpired;\n    const statusLabel = isExpired ? 'VENCIDA / MOROSA' : isExpiring ? 'POR VENCER' : 'ACTIVA VIGENTE';\n\n    return [\n      c.id,\n      c.fullName,\n      c.documentId || 'S/N',\n      c.phone || '',\n      c.email || '',\n      c.membership?.planName || 'Sin Plan',\n      c.membership?.price || 0,\n      c.membership?.startDate || '',\n      c.membership?.endDate || '',\n      c.membership?.daysRemaining ?? 0,\n      statusLabel,\n      c.biometricRegistered ? 'SÍ (Enrolada)' : 'NO (Pendiente)',\n      c.checkInsCount || 0,\n      c.lastCheckIn ? new Date(c.lastCheckIn).toLocaleString('es-MX') : 'Sin registros',\n      c.totalSpentInStore || 0,\n      c.emergencyContact?.name || '',\n      c.emergencyContact?.phone || '',\n      c.medicalNotes || 'Sin notas'\n    ];\n  });\n\n  const ws = XLSX.utils.aoa_to_sheet([...titleRows, headers, ...dataRows]);\n\n  ws['!cols'] = [\n    { wch: 14 }, // ID Socio\n    { wch: 28 }, // Nombre Completo\n    { wch: 16 }, // DNI\n    { wch: 18 }, // Teléfono\n    { wch: 26 }, // Email\n    { wch: 30 }, // Plan\n    { wch: 16 }, // Costo\n    { wch: 14 }, // Inicio\n    { wch: 14 }, // Fin\n    { wch: 14 }, // Días\n    { wch: 20 }, // Estado\n    { wch: 16 }, // Huella\n    { wch: 18 }, // Asistencias\n    { wch: 22 }, // Última Asistencia\n    { wch: 18 }, // Gasto\n    { wch: 22 }, // Emergencia\n    { wch: 18 }, // Tel Emergencia\n    { wch: 40 }, // Notas\n  ];\n\n  XLSX.utils.book_append_sheet(wb, ws, 'Cartera de Socios');\n  const safeDate = new Date().toISOString().slice(0, 10);\n  XLSX.writeFile(wb, `Cartera_Clientes_LegendsGym_${safeDate}.xlsx`);\n};","Target":"  const safePeriod = periodLabel.replace(/[\\s\\/\\(\\)]+/g, '_');\n  const safeDate = new Date().toISOString().slice(0, 10);\n  const fileName = `Reporte_Ingresos_${safePeriod}_${safeDate}.xlsx`;\n  XLSX.writeFile(wb, fileName);\n};"}}]}
