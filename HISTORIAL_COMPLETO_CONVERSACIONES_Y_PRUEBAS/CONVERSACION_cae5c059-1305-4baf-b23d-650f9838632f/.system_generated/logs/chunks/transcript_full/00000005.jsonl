         ? `<span class=\"text-red-400 font-bold font-mono\">Venció hace ${Math.abs(m.daysRemaining)} d</span>`\n1337:             : isExpiring\n1338:             ? `<span class=\"text-amber-400 font-bold font-mono\">${m.daysRemaining} d restantes</span>`\n1339:             : `<span class=\"text-emerald-400 font-bold font-mono\">${m.daysRemaining} d restantes</span>`;\n1340: "}
