{"step_index":237,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-10-24T15:46:56Z","content":"Created At: 2026-10-24T09:46:56-06:00\nCompleted At: 2026-10-24T09:46:57-06:00\nShowing lines 1000-1150 of 1607\n1000:     function handleSortChange(val) {\n1001:       audio.playBlip();\n1002:       currentSortBy = val;\n1003:       render();\n1004:     }\n1005: \n1006:     function handleSearch(val) {\n1007:       currentSearch = val;\n1008:       document.getElementById('clearSearchBtn').style.display = val ? 'block' : 'none';\n1009:       render();\n1010:     }\n1011: \n1012:     function clearSearch() {\n1013:       document.getElementById('searchInput').value = '';\n1014:       currentSearch = '';\n1015:       document.getElementById('clearSearchBtn').style.display = 'none';\n1016:       render();\n1017:     }\n1018: \n1019:     function setViewMode(mode) {\n1020:       audio.playBlip();\n1021:       currentViewMode = mode;\n1022:       \n1023:       const bTable = document.getElementById('btnViewTable');\n1024:       const bGrid = document.getElementById('btnViewGrid');\n1025:       const bDesk = document.getElementById('btnViewDesk');\n1026: \n1027:       bTable.className = mode === 'table' ? 'p-1.5 rounded-lg transition-all flex items-center gap-1.5 text-xs font-bold bg-amber-500 text-black shadow-md' : 'p-1.5 rounded-lg transition-all flex items-center gap-1.5 text-xs font-bold text-gym-muted hover:text-white';\n1028:       bGrid.className = mode === 'grid' ? 'p-1.5 rounded-lg transition-all flex items-center gap-1.5 text-xs font-bold bg-amber-500 text-black shadow-md' : 'p-1.5 rounded-lg transition-all flex items-center gap-1.5 text-xs font-bold text-gym-muted hover:text-white';\n1029:       bDesk.className = mode === 'desk' ? 'p-1.5 rounded-lg transition-all flex items-center gap-1.5 text-xs font-bold bg-amber-500 text-black shadow-md' : 'p-1.5 rounded-lg transition-all flex items-center gap-1.5 text-xs font-bold text-gym-muted hover:text-white';\n1030: \n1031:       render();\n1032:     }\n1033: \n1034:     // Quick Gate Simulator\n1035:     function simulateAccess(id) {\n1036:       const member = members.find(m => m.id === id);\n1037:       if (!member) return;\n1038: \n1039:       const isExpired = member.status === 'expired' || member.daysRemaining < 0;\n1040: \n1041:       const toast = document.getElementById('accessToast');\n1042:       const icon = document.getElementById('toastIcon');\n1043:       const title = document.getElementById('toastTitle');\n1044:       const body = document.getElementById('toastBody');\n1045: \n1046:       if (!isExpired) {\n1047:         audio.playGranted();\n1048:         member.checkInsCount = (member.checkInsCount || 0) + 1;\n1049:         updateKPIs();\n1050: \n1051:         toast.className = 'fixed top-5 right-5 z-50 transform translate-y-0 transition-transform duration-300 p-4 rounded-2xl border shadow-2xl backdrop-blur-md max-w-md flex items-start gap-3 bg-[#0b1d14]/95 border-emerald-500/60 shadow-emerald-500/20 text-white';\n1052:         icon.className = 'p-2 rounded-xl shrink-0 bg-emerald-500/20 text-emerald-400 font-black text-lg';\n1053:         icon.innerText = '✓';\n1054:         title.innerHTML = `<span>${member.fullName}</span><span class=\"text-[10px] font-mono px-2 py-0.5 rounded bg-black/40 text-emerald-400\">PASE AUTORIZADO</span>`;\n1055:         body.innerText = `¡Torniquete 1 Abierto! ${member.planName} • Visita #${member.checkInsCount}`;\n1056:       } else {\n1057:         audio.playDenied();\n1058:         toast.className = 'fixed top-5 right-5 z-50 transform translate-y-0 transition-transform duration-300 p-4 rounded-2xl border shadow-2xl backdrop-blur-md max-w-md flex items-start gap-3 bg-[#21090a]/95 border-red-500/60 shadow-red-500/20 text-white';\n1059:         icon.className = 'p-2 rounded-xl shrink-0 bg-red-500/20 text-red-400 font-black text-lg';\n1060:         icon.innerText = '✕';\n1061:         title.innerHTML = `<span>${member.fullName}</span><span class=\"text-[10px] font-mono px-2 py-0.5 rounded bg-black/40 text-red-400\">ACCESO DENEGADO</span>`;\n1062:         body.innerText = `Membresía vencida hace ${Math.abs(member.daysRemaining)} días. Favor de renovar en recepción.`;\n1063:       }\n1064: \n1065:       setTimeout(() => {\n1066:         toast.className = 'fixed top-5 right-5 z-50 transform translate-y-[-150%] transition-transform duration-300 p-4 rounded-2xl border shadow-2xl backdrop-blur-md max-w-md flex items-start gap-3';\n1067:       }, 4000);\n1068: \n1069:       render();\n1070:     }\n1071: \n1072:     // Direct WhatsApp message\n1073:     function sendWhatsApp(id) {\n1074:       const member = members.find(m => m.id === id);\n1075:       if (!member || !member.phone) return;\n1076: \n1077:       const isExpired = member.status === 'expired' || member.daysRemaining < 0;\n1078:       const isExpiring = member.daysRemaining <= 5 && !isExpired;\n1079: \n1080:       let msg = '';\n1081:       if (isExpired) {\n1082:         msg = `Hola ${member.fullName}! Te saludamos de Legends Pro Gym. Notamos que tu membresia (${member.planName}) vencio hace ${Math.abs(member.daysRemaining)} dias. Te extrañamos en el gym! Puedes pasar a recepcion a renovar hoy mismo.`;\n1083:       } else if (isExpiring) {\n1084:         msg = `Hola ${member.fullName}! Te recordamos cordialmente de Legends Pro Gym que tu membresia (${member.planName}) vence en ${member.daysRemaining} dias (${member.endDate}). Pasa a recepcion a renovar y asegura tu acceso continuo!`;\n1085:       } else {\n1086:         msg = `Hola ${member.fullName}! Te saludamos de Legends Pro Gym. Tu membresia (${member.planName}) esta activa y vigente. Necesitas apoyo de un entrenador o tienes alguna consulta? Estamos a tu orden!`;\n1087:       }\n1088: \n1089:       window.open(`https://wa.me/${member.phone.replace(/\\D/g, '')}?text=${encodeURIComponent(msg)}`, '_blank');\n1090:     }\n1091: \n1092:     // Open Credential Modal\n1093:     function openCredential(id) {\n1094:       audio.playBlip();\n1095:       const member = members.find(m => m.id === id);\n1096:       if (!member) return;\n1097:       activeClientForCred = member;\n1098: \n1099:       document.getElementById('credAvatar').src = member.avatarUrl;\n1100:       document.getElementById('credName').innerText = member.fullName;\n1101:       document.getElementById('credId').innerText = member.id;\n1102:       document.getElementById('credDni').innerText = member.documentId;\n1103:       document.getElementById('credPlan').innerText = member.planName;\n1104:       document.getElementById('credEnd').innerText = member.endDate;\n1105:       document.getElementById('credBarcodeText').innerText = `*${member.id}*`;\n1106: \n1107:       const isVip = member.planType === 'vip' || member.planName.toLowerCase().includes('vip');\n1108:       document.getElementById('credBadgeVip').innerText = isVip ? '👑 BLACK VIP' : 'MEMBER PASS';\n1109: \n1110:       // Barcode lines generator\n1111:       const barcodeContainer = document.getElementById('barcodeLines');\n1112:       barcodeContainer.innerHTML = '';\n1113:       for (let i = 0; i < 38; i++) {\n1114:         const line = document.createElement('div');\n1115:         const w = (i % 3 === 0) ? '3px' : (i % 2 === 0) ? '2px' : '1px';\n1116:         line.style.width = w;\n1117:         line.style.backgroundColor = '#000';\n1118:         barcodeContainer.appendChild(line);\n1119:       }\n1120: \n1121:       document.getElementById('credentialModal').classList.remove('hidden');\n1122:     }\n1123: \n1124:     function shareCredViaWhatsApp() {\n1125:       if (!activeClientForCred) return;\n1126:       const text = `🏋️ *FITNESS LEGENDS PRO GYM* 🏋️\\n*Credencial Digital Oficial*\\n👤 Socio: ${activeClientForCred.fullName}\\n🆔 ID: ${activeClientForCred.id}\\n⭐ Plan: ${activeClientForCred.planName}\\n📅 Vigencia: ${activeClientForCred.endDate}\\n🔒 Acceso: Torniquetes Biométricos Habilitados`;\n1127:       window.open(`https://wa.me/${activeClientForCred.phone.replace(/\\D/g, '')}?text=${encodeURIComponent(text)}`, '_blank');\n1128:     }\n1129: \n1130:     // Open Detail Modal\n1131:     function openDetail(id) {\n1132:       audio.playBlip();\n1133:       const member = members.find(m => m.id === id);\n1134:       if (!member) return;\n1135: \n1136:       document.getElementById('detAvatar').src = member.avatarUrl;\n1137:       document.getElementById('detName').innerText = member.fullName;\n1138:       document.getElementById('detIdBadge').innerText = member.id;\n1139:       document.getElementById('detDni').innerText = member.documentId;\n1140:       document.getElementById('detCreated').innerText = member.startDate;\n1141:       document.getElementById('detPlanName').innerText = `${member.planName} • $${member.price} MXN`;\n1142:       document.getElementById('detPhone').innerText = member.phone;\n1143:       document.getElementById('detEmail').innerText = member.email;\n1144:       document.getElementById('detCheckins').innerText = `${member.checkInsCount} ingresos`;\n1145:       document.getElementById('detSpent').innerText = `$${member.totalSpent} MXN`;\n1146:       document.getElementById('detEmergency').innerText = member.emergency;\n1147:       document.getElementById('detMedical').innerText = member.medicalNotes;\n1148: \n1149:       document.getElementById('detailModal').classList.remove('hidden');\n1150:     }"}
