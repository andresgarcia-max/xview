-->\n          <button \n            onclick=\"openNewClientModal()\"\n            class=\"flex items-center gap-2 px-5 py-2.5 rounded-2xl bg-gradient-to-r from-amber-500 to-amber-400 hover:from-amber-400 hover:to-amber-300 text-black font-extrabold text-sm shadow-glow-gold hover:shadow-[0_0_30px_rgba(245,158,11,0.6)] transition-all transform hover:-translate-y-0.5 active:translate-y-0\"\n          >\n            <svg class=\"w-4 h-4\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"3\" d=\"M12 4v16m8-8H4\"></path></svg>\n            <span>Nuevo Cliente</span>\n          </button>\n        </div>\n      </div>\n    </header>\n\n    <!-- 2. KPI METRIC CARDS (High Impact + Textures + Active Glow Filters) -->\n    <section class=\"grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3.5\">\n      \n      <!-- Card 1: Total Cartera -->\n      <div \n        id=\"kpi-all\"\n        onclick=\"setStatusFilter('all')\"\n        class=\"relative p-4 rounded-2xl border cursor-pointer transition-all duration-300 overflow-hidden bg-gradient-to-br from-amber-500/20 via-[#181922] to-[#12131a] border-amber-500 ring-2 ring-amber-500/30 shadow-glow-gold/20\"\n      >\n        <div class=\"flex items-center justify-between text-xs text-gym-muted mb-1 font-semibold\">\n          <span>Total Cartera</span>\n          <svg class=\"w-4 h-4 text-amber-400\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z\"></path></svg>\n        </div>\n        <div class=\"flex items-baseline gap-2\">\n          <span id=\"kpiTotalNum\" class=\"text-3xl font-black text-white\">8</span>\n          <span class=\"text-[11px] font-bold text-zinc-400 font-mono\">socios</span>\n        </div>\n        <p class=\"text-[11px] text-zinc-400 mt-1 truncate\">Padrón activo registrado</p>\n      </div>\n\n      <!-- Card 2: Activos Vigentes -->\n      <div \n        id=\"kpi-active\"\n        onclick=\"setStatusFilter('active')\"\n        class=\"relative p-4 rounded-2xl border cursor-pointer transition-all duration-300 overflow-hidden bg-gym-card/90 hover:bg-[#131a15] border-gym-border hover:border-emerald-500/40\"\n      >\n        <div class=\"flex items-center justify-between text-xs text-emerald-400 mb-1 font-bold\">\n          <span>Activos Vigentes</span>\n          <svg class=\"w-4 h-4 text-emerald-400\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z\"></path></svg>\n        </div>\n        <div class=\"flex items-baseline gap-2\">\n          <span id=\"kpiActiveNum\" class=\"text-3xl font-black text-emerald-400\">6</span>\n          <span class=\"text-[10px] font-extrabold uppercase px-1.5 py-0.5 rounded bg-emerald-500/20 text-emerald-300\">Pase OK</span>\n        </div>\n        <p class=\"text-[11px] text-emerald-400/80 mt-1 truncate\">Torniquete libre</p>\n      </div>\n\n      <!-- Card 3: Por Vencer (<= 5 días) -->\n      <div \n        id=\"kpi-expiring_soon\"\n        onclick=\"setStatusFilter('expiring_soon')\"\n        class=\"relative p-4 rounded-2xl border cursor-pointer transition-all duration-300 overflow-hidden bg-gym-card/90 hover:bg-[#1f1a10] border-gym-border hover:border-amber-500/40\"\n      >\n        <div class=\"flex items-center justify-between text-xs text-amber-400 mb-1 font-bold\">\n          <span class=\"flex items-center gap-1\">\n            <span>Por Vencer (&le; 5 d)</span>\n            <span class=\"w-2 h-2 rounded-full bg-amber-400 animate-pulse\"></span>\n          </span>\n          <svg class=\"w-4 h-4 text-amber-400\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z\"></path></svg>\n        </div>\n        <div class=\"flex items-baseline gap-2\">\n          <span id=\"kpiExpiringNum\" class=\"text-3xl font-black text-amber-400\">1</span>\n          <span class=\"text-[10px] font-extrabold uppercase px-1.5 py-0.5 rounded bg-amber-500/20 text-amber-300\">Aviso</span>\n        </div>\n        <p class=\"text-[11px] text-amber-400/80 mt-1 truncate\">Renovación prioritaria</p>\n      </div>\n\n      <!-- Card 4: Vencidos / Morosos -->\n      <div \n        id=\"kpi-expired\"\n        onclick=\"setStatusFilter('expired')\"\n        class=\"relative p-4 rounded-2xl border cursor-pointer transition-all duration-300 overflow-hidden bg-gym-card/90 hover:bg-[#1c0f11] border-gym-border hover:border-red-500/40\"\n      >\n        <div class=\"flex items-center justify-between text-xs text-red-400 mb-1 font-bold\">\n          <span>Vencidos / Morosos</span>\n          <svg class=\"w-4 h-4 text-red-400\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636\"></path></svg>\n        </div>\n        <div class=\"flex items-baseline gap-2\">\n          <span id=\"kpiExpiredNum\" class=\"text-3xl font-black text-red-400\">1</span>\n          <span class=\"text-[10px] font-extrabold uppercase px-1.5 py-0.5 rounded bg-red-500/20 text-red-300\">Bloqueado</span>\n        </div>\n        <p class=\"text-[11px] text-red-400/80 mt-1 truncate\">Acceso denegado</p>\n      </div>\n\n      <!-- Card 5: Sin Huella Enrolada -->\n      <div \n        id=\"kpi-no_fingerprint\"\n        onclick=\"setStatusFilter('no_fingerprint')\"\n        class=\"relative p-4 rounded-2xl border cursor-pointer transition-all duration-300 overflow-hidden bg-gym-card/90 hover:bg-[#181122] border-gym-border hover:border-purple-500/40 col-span-2 sm:col-span-1\"\n      >\n        <div class=\"flex items-center justify-between text-xs text-purple-400 mb-1 font-bold\">\n          <span>Sin Huella Enrolada</span>\n          <svg class=\"w-4 h-4 text-purple-400\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M12 11c0 3.517-1.009 6.799-2.753 9.571m-3.44-2.04l.054-.09A13.916 13.916 0 008 11a4 4 0 118 0c0 1.017-.07 2.019-.203 3m-2.118 6.844A21.88 21.88 0 0015.171 17m3.839 1.132c.645-2.266.99-4.659.99-7.132A8 8 0 004 11a7.962 7.962 0 001.353 4.498\"></path></svg>\n        </div>\n        <div class=\"flex items-baseline gap-2\">\n          <span id=\"kpiNoFpNum\" class=\"text-3xl font-black text-purple-400\">0</span>\n          <span class=\"text-[10px] font-extrabold uppercase px-1.5 py-0.5 rounded bg-purple-500/20 text-purple-300\">Biometría</span>\n        </div>\n        <p class=\"text-[11px] text-purple-400/80 mt-1 truncate\">Pendiente captura</p>\n      </div>\n\n    </section>\n\n    <!-- 3. SEARCH & SMART FILTER CONTROLS BAR -->\n    <div class=\"bg-[#12131a] p-4 rounded-2xl border border-gym-border flex flex-col lg:flex-row items-stretch lg:items-center justify-between gap-3 shadow-md\">\n      \n      <!-- Search Input -->\n      <div class=\"relative flex-1 max-w-md\">\n        <svg class=\"w-4 h-4 text-gym-muted absolute left-3.5 top-1/2 -translate-y-1/2\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z\"></path></svg>\n        <input\n          id=\"searchInput\"\n          type=\"text\"\n          oninput=\"handleSearch(this.value)\"\n          placeholder=\"Buscar por nombre, DNI, teléfono o ID...\"\n          class=\"w-full pl-10 pr-9 py-2.5 bg-[#181924] rounded-xl border border-gym-border text-sm text-white placeholder-gym-muted focus:outline-none focus:border-amber-400 focus:ring-1 focus:ring-amber-400 transition-all\"\n        />\n        <button id=\"clearSearchBtn\" onclick=\"clearSearch()\" class=\"hidden absolute right-3 top-1/2 -translate-y-1/2 text-gym-muted hover:text-white\">\n          <svg class=\"w-4 h-4\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M6 18L18 6M6 6l12 12\"></path></svg>\n        </button>\n      </div>\n\n      <!-- Filters & Controls -->\n      <div class=\"flex items-center justify-between lg:justify-end gap-2.5 overflow-x-auto flex-wrap sm:flex-nowrap\">\n        \n        <!-- Status Tabs -->\n        <div class=\"flex items-center gap-1.5 p-1 bg-[#181924] rounded-xl border border-gym-border shrink-0\">\n          <button onclick=\"setStatusFilter('all')\" id=\"tab-all\" class=\"px-3 py-1.5 rounded-lg text-xs font-bold transition-all bg-amber-500 text-black shadow-md\">\n            Todos <span class=\"text-[10px] ml-1 px-1.5 py-0.2 rounded-full bg-black/30 font-mono\" id=\"tabCount-all\">8</span>\n          </button>\n          <button onclick=\"setStatusFilter('active')\" id=\"tab-active\" class=\"px-3 py-1.5 rounded-lg text-xs font-bold transition-all text-gym-muted hover:text-white\">\n            Activos <span class=\"text-[10px] ml-1 px-1.5 py-0.2 rounded-full bg-black/40 text-zinc-400 font-mono\" id=\"tabCount-active\">6</span>\n          </button>\n          <button onclick=\"setStatusFilter('expiring_soon')\" id=\"tab-expiring_soon\" class=\"px-3 py-1.5 rounded-lg text-xs font-bold transition-all text-gym-muted hover:text-white\">\n            Por Vencer <span class=\"text-[10px] ml-1 px-1.5 py-0.2 rounded-full bg-black/40 text-zinc-400 font-mono\" id=\"tabCount-expiring_soon\">1</span>\n          </button>\n          <button onclick=\"setStatusFilter('expired')\" id=\"tab-expired\" class=\"px-3 py-1.5 rounded-lg text-xs font-bold transition-all text-gym-muted hover:text-white\">\n            Vencidos <span class=\"text-[10px] ml-1 px-1.5 py-0.2 rounded-full bg-black/40 text-zinc-400 font-mono\" id=\"tabCount-expired\">1</span>\n          </button>\n          <button onclick=\"setStatusFilter('no_fingerprint')\" id=\"tab-no_fingerprint\" class=\"px-3 py-1.5 rounded-lg text-xs font-bold transition-all text-gym-muted hover:text-white\">\n            Sin Huella <span class=\"text-[10px] ml-1 px-1.5 py-0.2 rounded-full bg-black/40 text-zinc-400 font-mono\" id=\"tabCount-no_fingerprint\">0</span>\n          </button>\n        </div>\n\n        <!-- Plan Tier Selector -->\n        <select id=\"tierFilter\" onchange=\"handleTierChange(this.value)\" class=\"bg-[#181924] border border-gym-border text-zinc-200 text-xs font-semibold rounded-xl px-3 py-2 focus:outline-none focus:border-amber-400 shrink-0\">\n          <option value=\"all\">Todos los Planes</option>\n          <option value=\"vip\">👑 VIP & Black Pass</option>\n          <option value=\"monthly\">📅 Mensualidades</option>\n          <option value=\"quarterly\">⚡ Trimestrales</option>\n          <option value=\"daily\">🎫 Pases de Día</option>\n        </select>\n\n        <!-- Sorting Selector -->\n        <select id=\"sortBy\" onchange=\"handleSortChange(this.value)\" class=\"bg-[#181924] border border-gym-border text-zinc-200 text-xs font-semibold rounded-xl px-3 py-2 focus:outline-none focus:border-amber-400 shrink-0\">\n          <option value=\"urgency\">⌛ Próximos a Vencer</option>\n          <option value=\"checkins\">🏆 Mayor Asistencia</option>\n          <option value=\"name\">🔤 Nombre (A - Z)</option>\n          <option value=\"recent\">🆕 Más Recientes</option>\n        </select>\n\n        <!-- View Switcher -->\n        <div class=\"flex items-center bg-[#181924] p-1 rounded-xl border border-gym-border shrink-0\">\n          <button onclick=\"setViewMode('table')\" id=\"btnViewTable\" class=\"p-1.5 rounded-lg transition-all flex items-center gap-1.5 text-xs font-bold bg-amber-500 text-black shadow-md\">\n            <svg class=\"w-4 h-4\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M4 6h16M4 10h16M4 14h16M4 18h16\"></path></svg>\n            <span class=\"hidden sm:inline\">Tabla</span>\n          </button>\n          \n          <button onclick=\"setViewMode('grid')\" id=\"btnViewGrid\" class=\"p-1.5 rounded-lg transition-all flex items-center gap-1.5 text-xs font-bold text-gym-muted hover:text-white\">\n            <svg class=\"w-4 h-4\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z\"></path></svg>\n            <span class=\"hidden sm:inline\">Fichas</span>\n          </button>\n\n          <button onclick=\"setViewMode('desk')\" id=\"btnViewDesk\" class=\"p-1.5 rounded-lg transition-all flex items-center gap-1.5 text-xs font-bold text-gym-muted hover:text-white\">\n            <svg class=\"w-4 h-4 text-amber-400\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M13 10V3L4 14h7v7l9-11h-7z\"></path></svg>\n            <span class=\"hidden sm:inline\">Renovaciones</span>\n          </button>\n        </div>\n\n      </div>\n\n    </div>\n\n    <!-- 4. DYNAMIC VIEW CONTAINER -->\n    <main id=\"mainContainer\">\n      <!-- Injected by JavaScript render() -->\n    </main>\n\n  </div>\n\n  <!-- ================================================================= -->\n  <!-- MODAL: DIGITAL CREDENTIAL PASS (Printable & WhatsApp)             -->\n  <!-- ================================================================= -->\n  <div id=\"credentialModal\" class=\"hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/85 backdrop-blur-md overflow-y-auto\">\n    <div class=\"bg-[#0f1015] rounded-3xl border border-gym-border/80 w-full max-w-lg overflow-hidden shadow-2xl relative my-6\">\n      \n      <div class=\"flex items-center justify-between px-6 py-4 border-b border-gym-border/60 bg-[#14151d]\">\n        <div class=\"flex items-center gap-2\">\n          <div class=\"w-8 h-8 rounded-lg bg-amber-500/10 border border-amber-500/30 flex items-center justify-center text-amber-400\">\n            👑\n          </div>\n          <div>\n            <h3 class=\"text-sm font-black text-white uppercase tracking-wider\">Credencial Oficial de Socio</h3>\n            <p class=\"text-[11px] text-gym-muted\">Pase digital autorizado para torniquetes</p>\n          </div>\n        </div>\n\n        <div class=\"flex items-center gap-2\">\n          <button onclick=\"window.print()\" class=\"px-3 py-1.5 rounded-xl bg-gym-surface hover:bg-zinc-800 text-white text-xs font-bold flex items-center gap-1.5 border border-gym-border\">\n            🖨️ <span class=\"hidden sm:inline\">Imprimir</span>\n          </button>\n          <button onclick=\"closeModal('credentialModal')\" class=\"p-1.5 rounded-xl bg-gym-surface text-gym-muted hover:text-white\">\n            ✕\n          </button>\n        </div>\n      </div>\n\n      <div class=\"p-6 flex flex-col items-center\">\n        <!-- Physical Card Frame -->\n        <div id=\"printArea\" class=\"w-full max-w-sm rounded-3xl p-6 relative overflow-hidden bg-gradient-to-br from-[#1c1608] via-[#0f1118] to-[#08090d] border border-amber-500/50 shadow-2xl\">\n          <div class=\"flex items-center justify-between pb-3 border-b border-white/10\">\n            <div class=\"flex items-center gap-2\">\n              <div class=\"w-9 h-9 rounded-xl bg-gradient-to-br from-amber-400 to-amber-600 flex items-center justify-center text-black font-black text-sm shadow-glow-gold\">\n                FL\n              </div>\n              <div>\n                <span class=\"text-sm font-black text-white tracking-widest uppercase\">LEGENDS</span>\n                <span class=\"text-sm font-black text-amber-400\">PRO GYM</span>\n              </div>\n            </div>\n            <span id=\"credBadgeVip\" class=\"px-2.5 py-0.5 rounded-full bg-amber-500/20 border border-amber-500/40 text-[10px] font-black uppercase text-amber-400\">\n              BLACK VIP\n            </span>\n          </div>\n\n          <div class=\"flex items-center gap-4 py-4\">\n            <img id=\"credAvatar\" src=\"\" class=\"w-18 h-18 rounded-2xl object-cover border-2 border-amber-400 shadow-lg\" style=\"width:72px; height:72px;\" alt=\"Avatar\">\n            <div class=\"min-w-0 flex-1\">\n              <h4 id=\"credName\" class=\"text-base font-black text-white leading-tight truncate\">Carlos Mendoza</h4>\n              <p class=\"text-xs font-mono text-amber-400 mt-0.5\"><span id=\"credId\">MEM-001</span> • DNI: <span id=\"credDni\">45892011</span></p>\n              <p id=\"credPlan\" class=\"text-xs font-semibold text-emerald-400 truncate mt-1\">Membresía Black VIP Anual</p>\n            </div>\n          </div>\n\n          <div class=\"p-3 bg-black/50 rounded-2xl border border-white/10 text-xs space-y-1 mb-3\">\n            <div class=\"flex justify-between\">\n              <span class=\"text-gym-muted\">Vigencia hasta:</span>\n              <span id=\"credEnd\" class=\"font-bold font-mono text-white\">2027-01-10</span>\n            </div>\n            <div class=\"flex justify-between\">\n              <span class=\"text-gym-muted\">Huella Acceso:</span>\n              <span id=\"credFingerprint\" class=\"font-bold text-emerald-400\">Enrolada & Activa ✅</span>\n            </div>\n          </div>\n\n          <!-- Barcode simulation -->\n          <div class=\"p-2.5 bg-white rounded-xl flex flex-col items-center justify-center\">\n            <div class=\"w-full flex justify-between h-9 px-2 items-stretch\" id=\"barcodeLines\"></div>\n            <span id=\"credBarcodeText\" class=\"text-[9px] font-mono font-bold tracking-[0.25em] text-black mt-1 uppercase\">*MEM-001*</span>\n          </div>\n\n          <p class=\"text-[9px] text-zinc-500 font-mono text-center mt-2.5\">TORNIQUETE BIOMÉTRICO AUTORIZADO • LEGENDS GYM</p>\n        </div>\n\n        <button onclick=\"shareCredViaWhatsApp()\" class=\"mt-4 px-4 py-2.5 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-black font-extrabold text-xs flex items-center gap-2 shadow-md\">\n          💬 Enviar Credencial por WhatsApp\n        </button>\n      </div>\n\n    </div>\n  </div>\n\n  <!-- ================================================================= -->\n  <!-- MODAL: DETALLE DE EXPEDIENTE                                      -->\n  <!-- ================================================================= -->\n  <div id=\"detailModal\" class=\"hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/85 backdrop-blur-md overflow-y-auto\">\n    <div class=\"bg-[#12131a] rounded-3xl border border-gym-border/90 w-full max-w-xl overflow-hidden shadow-2xl relative my-6\">\n      <div class=\"p-5 border-b border-gym-border/60 bg-[#161722] flex items-center justify-between\">\n        <div class=\"flex items-center gap-2\">\n          <span class=\"text-xs font-black uppercase px-2 py-0.5 rounded bg-amber-500/20 text-amber-400 border border-amber-500/30\">\n            Expediente de Socio\n          </span>\n          <span id=\"detIdBadge\" class=\"text-xs font-mono text-zinc-300 bg-black/40 px-2 py-0.5 rounded\"></span>\n        </div>\n        <button onclick=\"closeModal('detailModal')\" class=\"text-gym-muted hover:text-white p-1\">✕</button>\n      </div>\n\n      <div class=\"p-6 space-y-4\">\n        <div class=\"flex items-center gap-4\">\n          <img id=\"detAvatar\" src=\"\" class=\"w-16 h-16 rounded-2xl object-cover border-2 border-amber-400 shadow-md\">\n          <div>\n            <h3 id=\"detName\" class=\"text-lg font-black text-white\"></h3>\n            <p class=\"text-xs text-gym-muted font-mono\">DNI: <span id=\"detDni\" class=\"text-zinc-200\"></span> • Ingreso: <span id=\"detCreated\" class=\"text-zinc-200\"></span></p>\n            <p id=\"detPlanName\" class=\"text-xs font-bold text-amber-400 mt-1\"></p>\n          </div>\n        </div>\n\n        <div class=\"grid grid-cols-2 gap-3 text-xs\">\n          <div class=\"p-3 bg-black/40 rounded-xl border border-white/5\">\n            <span class=\"text-gym-muted block\">Teléfono / WhatsApp:</span>\n            <span id=\"detPhone\" class=\"font-bold text-emerald-400\"></span>\n          </div>\n          <div class=\"p-3 bg-black/40 rounded-xl border border-white/5\">\n            <span class=\"text-gym-muted block\">Correo Electrónico:</span>\n            <span id=\"detEmail\" class=\"font-bold text-zinc-200 truncate block\"></span>\n          </div>\n          <div class=\"p-3 bg-black/40 rounded-xl border border-white/5\">\n            <span class=\"text-gym-muted block\">Total Asistencias:</span>\n            <span id=\"detCheckins\" class=\"font-black text-amber-400\"></span>\n          </div>\n          <div class=\"p-3 bg-black/40 rounded-xl border border-white/5\">\n            <span class=\"text-gym-muted block\">Gasto en Tienda POS:</span>\n            <span id=\"detSpent\" class=\"font-bold text-white\"></span>\n          </div>\n        </div>\n\n        <div class=\"p-3.5 bg-black/40 rounded-xl border border-white/5 text-xs\">\n          <span class=\"text-gym-muted block font-semibold mb-0.5\">Contacto de Emergencia:</span>\n          <span id=\"detEmergency\" class=\"text-zinc-200\"></span>\n        </div>\n\n        <div class=\"p-3.5 bg-black/40 rounded-xl border border-white/5 text-xs\">\n          <span class=\"text-gym-muted block font-semibold mb-0.5\">Observaciones Médicas:</span>\n          <span id=\"detMedical\" class=\"text-zinc-300\"></span>\n        </div>\n      </div>\n\n      <div class=\"p-4 bg-[#161722] border-t border-gym-border/60 flex items-center justify-end gap-2\">\n        <button onclick=\"closeModal('detailModal')\" class=\"px-4 py-2 rounded-xl bg-gym-surface text-white text-xs font-bold\">Cerrar</button>\n      </div>\n    </div>\n  </div>\n\n  <!-- ================================================================= -->\n  <!-- MODAL: NUEVO CLIENTE (Alta rápida con enrolamiento)               -->\n  <!-- ================================================================= -->\n  <div id=\"newClientModal\" class=\"hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/85 backdrop-blur-md overflow-y-auto\">\n    <div class=\"bg-[#12131a] rounded-3xl border border-gym-border/90 w-full max-w-lg overflow-hidden shadow-2xl relative my-6\">\n      <div class=\"p-5 border-b border-gym-border/60 bg-[#161722] flex items-center justify-between\">\n        <div class=\"flex items-center gap-2\">\n          <span class=\"text-base\">💪</span>\n          <h3 class=\"text-sm font-black text-white uppercase tracking-wider\">Inscripción de Nuevo Socio</h3>\n        </div>\n        <button onclick=\"closeModal('newClientModal')\" class=\"text-gym-muted hover:text-white p-1\">✕</button>\n      </div>\n\n      <form onsubmit=\"handleCreateClient(event)\" class=\"p-6 space-y-3.5 text-xs\">\n        <div>\n          <label class=\"text-gym-muted block mb-1 font-semibold\">Nombre Completo *</label>\n          <input id=\"newFullName\" type=\"text\" required placeholder=\"Ej. Mariana López Santos\" class=\"w-full p-2.5 bg-[#181924] rounded-xl border border-gym-border text-white text-xs focus:outline-none focus:border-amber-400\">\n        </div>\n\n        <div class=\"grid grid-cols-2 gap-3\">\n          <div>\n            <label class=\"text-gym-muted block mb-1 font-semibold\">DNI / Cédula / RFID *</label>\n            <input id=\"newDocId\" type=\"text\" required placeholder=\"Ej. 48920192\" class=\"w-full p-2.5 bg-[#181924] rounded-xl border border-gym-border text-white text-xs focus:outline-none focus:border-amber-400\">\n          </div>\n          <div>\n            <label class=\"text-gym-muted block mb-1 font-semibold\">Teléfono / WhatsApp *</label>\n            <input id=\"newPhone\" type=\"tel\" required placeholder=\"+52 55 1234 5678\" class=\"w-full p-2.5 bg-[#181924] rounded-xl border border-gym-border text-white text-xs focus:outline-none focus:border-amber-400\">\n          </div>\n        </div>\n\n        <div>\n          <label class=\"text-gym-muted block mb-1 font-semibold\">Plan de Membresía *</label>\n          <select id=\"newPlanSelect\" class=\"w-full p-2.5 bg-[#181924] rounded-xl border border-gym-border text-white text-xs focus:outline-none focus:border-amber-400\">\n            <option value=\"vip\">👑 Membresía Black VIP Anual ($9,500 MXN - 365 Días)</option>\n            <option value=\"monthly\" selected>📅 Mensualidad Estándar ($850 MXN - 30 Días)</option>\n            <option value=\"quarterly\">⚡ Plan Trimestral Fuerza ($2,300 MXN - 90 Días)</option>\n            <option value=\"daily\">🎫 Pase por Día ($150 MXN - 1 Día)</option>\n          </select>\n        </div>\n\n        <div>\n          <label class=\"text-gym-muted block mb-1 font-semibold\">Método de Pago de Inscripción</label>\n          <div class=\"grid grid-cols-3 gap-2\">\n            <label class=\"flex items-center gap-1.5 p-2 rounded-xl bg-black/40 border border-white/10 cursor-pointer\">\n              <input type=\"radio\" name=\"payMethod\" value=\"cash\" checked class=\"text-amber-500\">\n              <span class=\"text-zinc-200\">Efectivo</span>\n            </label>\n            <label class=\"flex items-center gap-1.5 p-2 rounded-xl bg-black/40 border border-white/10 cursor-pointer\">\n              <input type=\"radio\" name=\"payMethod\" value=\"card\" class=\"text-amber-500\">\n              <span class=\"text-zinc-200\">Tarjeta</span>\n            </label>\n            <label class=\"flex items-center gap-1.5 p-2 rounded-xl bg-black/40 border border-white/10 cursor-pointer\">\n              <input type=\"radio\" name=\"payMethod\" value=\"transfer\" class=\"text-amber-500\">\n              <span class=\"text-zinc-200\">Transferencia</span>\n            </label>\n          </div>\n        </div>\n\n        <div class=\"p-3 bg-emerald-500/10 rounded-xl border border-emerald-500/30 flex items-center gap-2\">\n          <input id=\"newAutoBiometric\" type=\"checkbox\" checked class=\"w-4 h-4 text-emerald-500 rounded\">\n          <label for=\"newAutoBiometric\" class=\"text-emerald-300 font-semibold cursor-pointer\">\n            Habilitar huella biométrica y autorizar en torniquete al guardar\n          </label>\n        </div>\n\n        <div class=\"pt-3 flex items-center justify-end gap-2 border-t border-gym-border/60\">\n          <button type=\"button\" onclick=\"closeModal('newClientModal')\" class=\"px-4 py-2.5 rounded-xl bg-gym-surface text-white font-bold\">Cancelar</button>\n          <button type=\"submit\" class=\"px-5 py-2.5 rounded-xl bg-amber-500 hover:bg-amber-400 text-black font-black shadow-glow-gold\">Inscribir Socio</button>\n        </div>\n      </form>\n    </div>\n  </div>\n\n  <!-- ================================================================= -->\n  <!-- MODAL: RENOVAR MEMBRESÍA                                          -->\n  <!-- ================================================================= -->\n  <div id=\"renewModal\" class=\"hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/85 backdrop-blur-md overflow-y-auto\">\n    <div class=\"bg-[#12131a] rounded-3xl border border-gym-border/90 w-full max-w-md overflow-hidden shadow-2xl relative my-6\">\n      <div class=\"p-5 border-b border-gym-border/60 bg-[#161722] flex items-center justify-between\">\n        <div class=\"flex items-center gap-2\">\n          <span class=\"text-base\">💳</span>\n          <h3 class=\"text-sm font-black text-white uppercase tracking-wider\">Renovación de Membresía</h3>\n        </div>\n        <button onclick=\"closeModal('renewModal')\" class=\"text-gym-muted hover:text-white p-1\">✕</button>\n      </div>\n\n      <div class=\"p-6 space-y-4 text-xs\">\n        <div class=\"p-3 bg-black/40 rounded-xl border border-white/5\">\n          <span class=\"text-gym-muted block\">Socio:</span>\n          <span id=\"renMemberName\" class=\"text-sm font-black text-white\"></span>\n          <p id=\"renMemberPlan\" class=\"text-xs text-amber-400 mt-0.5\"></p>\n        </div>\n\n        <div>\n          <label class=\"text-gym-muted block mb-1 font-semibold\">Seleccionar Plan a Renovar:</label>\n          <select id=\"renPlanSelect\" class=\"w-full p-2.5 bg-[#181924] rounded-xl border border-gym-border text-white text-xs font-semibold focus:outline-none focus:border-amber-400\">\n            <option value=\"vip\">👑 Membresía Black VIP Anual - $9,500 MXN (365 Días)</option>\n            <option value=\"monthly\" selected>📅 Mensualidad Estándar - $850 MXN (30 Días)</option>\n            <option value=\"quarterly\">⚡ Plan Trimestral Fuerza - $2,300 MXN (90 Días)</option>\n            <option value=\"daily\">🎫 Pase de Día - $150 MXN (1 Día)</option>\n          </select>\n        </div>\n\n        <div>\n          <label class=\"text-gym-muted block mb-1 font-semibold\">Método de Pago:</label>\n          <div class=\"grid grid-cols-3 gap-2\">\n            <label class=\"flex items-center gap-1.5 p-2 rounded-xl bg-black/40 border border-white/10 cursor-pointer\">\n              <inpu