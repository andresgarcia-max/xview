             <span>{accessToast.clientName}</span>\n              <span className=\"text-[10px] font-mono px-2 py-0.5 rounded uppercase tracking-wider bg-black/40\">\n                {accessToast.granted ? 'CONCEDIDO' : 'DENEGADO'}\n              </span>\n            </h4>\n            <p className=\"text-xs text-zinc-300 mt-0.5 leading-snug\">{accessToast.message}</p>\n          </div>\n          <button \n            onClick={() => setAccessToast(null)} \n            className=\"text-zinc-400 hover:text-white p-1\"\n          >\n            <X className=\"w-4 h-4\" />\n          </button>\n        </div>\n      )}\n\n      {/* Main Top Header Banner */}\n      <div className=\"relative bg-gradient-to-r from-[#14151c] via-[#101117] to-[#161722] p-5 sm:p-6 rounded-3xl border border-gym-border shadow-xl overflow-hidden\">\n        {/* Ambient subtle glow background */}\n        <div className=\"absolute top-0 right-0 w-96 h-96 bg-amber-500/10 rounded-full blur-3xl pointer-events-none -mr-20 -mt-20\" />\n        <div className=\"absolute bottom-0 left-1/3 w-64 h-64 bg-emerald-500/5 rounded-full blur-2xl pointer-events-none\" />\n\n        <div className=\"relative z-10 flex flex-col lg:flex-row items-start lg:items-center justify-between gap-5\">\n          <div>\n            <div className=\"flex items-center gap-2.5\">\n              <div className=\"w-10 h-10 rounded-2xl bg-gradient-to-br from-amber-400 to-amber-600 flex items-center justify-center text-black font-black shadow-glow-gold\">\n                <Users className=\"w-5 h-5\" />\n              </div>\n              <div>\n                <div className=\"flex items-center gap-2 flex-wrap\">\n                  <h1 className=\"text-xl sm:text-2xl font-black text-white tracking-wide uppercase\">\n                    Cartera de Clientes & Membresías\n                  </h1>\n                  <span className=\"px-2.5 py-0.5 rounded-full bg-amber-500/15 border border-amber-500/30 text-amber-400 text-[10px] font-black tracking-widest uppercase\">\n                    CLUB PRO\n                  </span>\n                </div>\n                <p className=\"text-xs sm:text-sm text-gym-muted mt-0.5\">\n                  Expedientes completos, vigencias en tiempo real, credenciales QR y enrolamiento biométrico.\n                </p>\n              </div>\n            </div>\n\n            {/* Hardware & Live Status Pills */}\n            <div className=\"flex items-center gap-2.5 mt-3 flex-wrap text-xs\">\n              <span className=\"inline-flex items-center gap-1.5 px-3 py-1 rounded-xl bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 font-bold\">\n                <span className=\"w-2 h-2 rounded-full bg-emerald-400 animate-pulse\"></span>\n                <span>Torniquetes Biométricos Online (ZKTeco & RFID)</span>\n              </span>\n\n              <span className=\"inline-flex items-center gap-1.5 px-3 py-1 rounded-xl bg-zinc-800/80 border border-zinc-700 text-zinc-300 font-semibold font-mono\">\n                <Activity className=\"w-3.5 h-3.5 text-amber-400\" />\n                <span>{todayCheckInsCount} Asistencias Hoy</span>\n              </span>\n\n              {activeBranch && (\n                <span className=\"hidden sm:inline-flex items-center gap-1 px-2.5 py-1 rounded-xl bg-black/40 border border-white/10 text-zinc-400 text-[11px]\">\n                  <span>Sede:</span>\n                  <strong className=\"text-zinc-200\">{activeBranch.name}</strong>\n                </span>\n              )}\n            </div>\n          </div>\n\n          {/* Action buttons */}\n          <div className=\"flex items-center gap-2.5 w-full sm:w-auto justify-end flex-wrap\">\n            {/* Export Excel Button */}\n            <button\n              onClick={() => exportClientsToExcel(filteredMembers)}\n              className=\"flex items-center gap-2 px-3.5 py-2.5 rounded-2xl bg-gym-surface hover:bg-zinc-800 text-zinc-200 hover:text-white border border-gym-border text-xs font-bold transition-all shadow-sm\"\n              title=\"Descargar padrón de clientes a Excel (.xlsx)\"\n            >\n              <Download className=\"w-4 h-4 text-emerald-400\" />\n              <span>Exportar Excel</span>\n            </button>\n\n            {/* Add Client Button (Only admin & receptionist) */}\n            {currentRole !== 'trainer' && (\n              <button\n                onClick={() => setShowAddModal(true)}\n                className=\"flex items-center gap-2 px-5 py-2.5 rounded-2xl bg-gradient-to-r from-amber-500 to-amber-400 hover:from-amber-400 hover:to-amber-300 text-black font-extrabold text-sm shadow-glow-gold hover:shadow-[0_0_30px_rgba(245,158,11,0.6)] transition-all transform hover:-translate-y-0.5 active:translate-y-0\"\n              >\n                <UserPlus className=\"w-4 h-4 stroke-[3]\" />\n                <span>Nuevo Cliente</span>\n              </button>\n            )}\n          </div>\n        </div>\n      </div>\n\n      {/* KPI Cards Grid with Rich Textures and Glow Effects */}\n      <div className=\"grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3 sm:gap-4\">\n        \n        {/* Total Cartera */}\n        <div \n          onClick={() => setStatusFilter('all')}\n          className={`relative p-4 rounded-2xl border cursor-pointer transition-all duration-300 overflow-hidden ${\n            statusFilter === 'all' \n              ? 'bg-gradient-to-br from-amber-500/20 via-[#181922] to-[#12131a] border-amber-500 ring-2 ring-amber-500/30 shadow-glow-gold/20' \n              : 'bg-gym-card/90 hover:bg-[#161720] border-gym-border hover:border-zinc-600'\n          }`}\n        >\n          <div className=\"flex items-center justify-between text-xs text-gym-muted mb-1 font-semibold\">\n            <span>Total Cartera</span>\n            <Users className=\"w-4 h-4 text-amber-400 opacity-80\" />\n          </div>\n          <div className=\"flex items-baseline gap-2\">\n            <span className=\"text-3xl font-black text-white\">{totalCount}</span>\n            <span className=\"text-[11px] font-bold text-zinc-400 font-mono\">socios</span>\n          </div>\n          <p className=\"text-[11px] text-zinc-400 mt-1 truncate\">\n            {activeCount} vigentes ({totalCount ? Math.round((activeCount / totalCount) * 100) : 0}%)\n          </p>\n        </div>\n\n        {/* Activos Vigentes */}\n        <div \n          onClick={() => setStatusFilter('active')}\n          className={`relative p-4 rounded-2xl border cursor-pointer transition-all duration-300 overflow-hidden ${\n            statusFilter === 'active' \n              ? 'bg-gradient-to-br from-emerald-500/20 via-[#131c17] to-[#0e1411] border-emerald-500 ring-2 ring-emerald-500/30 shadow-glow-green/20' \n              : 'bg-gym-card/90 hover:bg-[#131a15] border-gym-border hover:border-emerald-500/40'\n          }`}\n        >\n          <div className=\"flex items-center justify-between text-xs text-emerald-400 mb-1 font-bold\">\n            <span>Activos Vigentes</span>\n            <CheckCircle2 className=\"w-4 h-4 text-emerald-400\" />\n          </div>\n          <div className=\"flex items-baseline gap-2\">\n            <span className=\"text-3xl font-black text-emerald-400\">{activeCount}</span>\n            <span className=\"text-[10px] font-extrabold uppercase px-1.5 py-0.5 rounded bg-emerald-500/20 text-emerald-300\">\n              Pase OK\n            </span>\n          </div>\n          <p className=\"text-[11px] text-emerald-400/80 mt-1 truncate\">\n            Acceso libre al torniquete\n          </p>\n        </div>\n\n        {/* Por Vencer (<= 5 días) */}\n        <div \n          onClick={() => setStatusFilter('expiring_soon')}\n          className={`relative p-4 rounded-2xl border cursor-pointer transition-all duration-300 overflow-hidden ${\n            statusFilter === 'expiring_soon' \n              ? 'bg-gradient-to-br from-amber-500/25 via-[#221c11] to-[#17130a] border-amber-500 ring-2 ring-amber-500/40 shadow-glow-gold/25' \n              : 'bg-gym-card/90 hover:bg-[#1f1a10] border-gym-border hover:border-amber-500/40'\n          }`}\n        >\n          <div className=\"flex items-center justify-between text-xs text-amber-400 mb-1 font-bold\">\n            <span className=\"flex items-center gap-1\">\n              <span>Por Vencer (&le; 5 d)</span>\n              {expiringCount > 0 && <span className=\"w-2 h-2 rounded-full bg-amber-400 animate-pulse\"></span>}\n            </span>\n            <Clock className=\"w-4 h-4 text-amber-400\" />\n          </div>\n          <div className=\"flex items-baseline gap-2\">\n            <span className=\"text-3xl font-black text-amber-400\">{expiringCount}</span>\n            <span className=\"text-[10px] font-extrabold uppercase px-1.5 py-0.5 rounded bg-amber-500/20 text-amber-300\">\n              Urgente\n            </span>\n          </div>\n          <p className=\"text-[11px] text-amber-400/80 mt-1 truncate\">\n            Requieren aviso de renovación\n          </p>\n        </div>\n\n        {/* Vencidos / Morosos */}\n        <div \n          onClick={() => setStatusFilter('expired')}\n          className={`relative p-4 rounded-2xl border cursor-pointer transition-all duration-300 overflow-hidden ${\n            statusFilter === 'expired' \n              ? 'bg-gradient-to-br from-red-500/20 via-[#221113] to-[#170a0c] border-red-500 ring-2 ring-red-500/30 shadow-glow-red/20' \n              : 'bg-gym-card/90 hover:bg-[#1c0f11] border-gym-border hover:border-red-500/40'\n          }`}\n        >\n          <div className=\"flex items-center justify-between text-xs text-red-400 mb-1 font-bold\">\n            <span>Vencidos / Morosos</span>\n            <AlertTriangle className=\"w-4 h-4 text-red-400\" />\n          </div>\n          <div className=\"flex items-baseline gap-2\">\n            <span className=\"text-3xl font-black text-red-400\">{expiredCount}</span>\n            <span className=\"text-[10px] font-extrabold uppercase px-1.5 py-0.5 rounded bg-red-500/20 text-red-300\">\n              Bloqueado\n            </span>\n          </div>\n          <p className=\"text-[11px] text-red-400/80 mt-1 truncate\">\n            Acceso denegado en molinete\n          </p>\n        </div>\n\n        {/* Sin Huella Enrolada */}\n        <div \n          onClick={() => setStatusFilter('no_fingerprint')}\n          className={`relative p-4 rounded-2xl border cursor-pointer transition-all duration-300 overflow-hidden col-span-2 sm:col-span-1 ${\n            statusFilter === 'no_fingerprint' \n              ? 'bg-gradient-to-br from-purple-500/20 via-[#1b1426] to-[#120c1b] border-purple-500 ring-2 ring-purple-500/30' \n              : 'bg-gym-card/90 hover:bg-[#181122] border-gym-border hover:border-purple-500/40'\n          }`}\n        >\n          <div className=\"flex items-center justify-between text-xs text-purple-400 mb-1 font-bold\">\n            <span>Sin Huella Enrolada</span>\n            <Fingerprint className=\"w-4 h-4 text-purple-400\" />\n          </div>\n          <div className=\"flex items-baseline gap-2\">\n            <span className=\"text-3xl font-black text-purple-400\">{noFingerprintCount}</span>\n            <span className=\"text-[10px] font-extrabold uppercase px-1.5 py-0.5 rounded bg-purple-500/20 text-purple-300\">\n              Biometría\n            </span>\n          </div>\n          <p className=\"text-[11px] text-purple-400/80 mt-1 truncate\">\n            Pendiente captura dactilar\n          </p>\n        </div>\n\n      </div>\n\n      {/* Search, Filter Tabs and View Controls Bar */}\n      <div className=\"bg-[#12131a] p-4 rounded-2xl border border-gym-border flex flex-col lg:flex-row items-stretch lg:items-center justify-between gap-3 shadow-md\">\n        \n        {/* Search Input */}\n        <div className=\"relative flex-1 max-w-md\">\n          <Search className=\"w-4 h-4 text-gym-muted absolute left-3.5 top-1/2 -translate-y-1/2\" />\n          <input\n            type=\"text\"\n            value={search}\n            onChange={(e) => setSearch(e.target.value)}\n            placeholder=\"Buscar por nombre, DNI, teléfono o ID...\"\n            className=\"w-full pl-10 pr-9 py-2.5 bg-[#181924] rounded-xl border border-gym-border text-sm text-white placeholder-gym-muted focus:outline-none focus:border-amber-400 focus:ring-1 focus:ring-amber-400 transition-all\"\n          />\n          {search && (\n            <button \n              onClick={() => setSearch('')}\n              className=\"absolute right-3 top-1/2 -translate-y-1/2 text-gym-muted hover:text-white\"\n            >\n              <X className=\"w-4 h-4\" />\n            </button>\n          )}\n        </div>\n\n        {/* Filter Tabs & Modifiers */}\n        <div className=\"flex items-center justify-between lg:justify-end gap-2.5 overflow-x-auto flex-wrap sm:flex-nowrap\">\n          \n          {/* Status Tabs */}\n          <div className=\"flex items-center gap-1.5 p-1 bg-[#181924] rounded-xl border border-gym-border shrink-0\">\n            {[\n              { id: 'all', label: 'Todos', count: totalCount },\n              { id: 'active', label: 'Activos', count: activeCount },\n              { id: 'expiring_soon', label: 'Por Vencer', count: expiringCount },\n              { id: 'expired', label: 'Vencidos', count: expiredCount },\n              { id: 'no_fingerprint', label: 'Sin Huella', count: noFingerprintCount },\n            ].map((tab) => (\n              <button\n                key={tab.id}\n                onClick={() => setStatusFilter(tab.id as typeof statusFilter)}\n                className={`px-3 py-1.5 rounded-lg text-xs font-bold transition-all flex items-center gap-1.5 ${\n                  statusFilter === tab.id\n                    ? 'bg-amber-500 text-black shadow-md'\n                    : 'text-gym-muted hover:text-white hover:bg-white/5'\n                }`}\n              >\n                <span>{tab.label}</span>\n                <span className={`text-[10px] px-1.5 py-0.2 rounded-full font-mono ${\n                  statusFilter === tab.id ? 'bg-black/30 text-black font-extrabold' : 'bg-black/40 text-zinc-400'\n                }`}>\n                  {tab.count}\n                </span>\n              </button>\n            ))}\n          </div>\n\n          {/* Plan Tier Dropdown */}\n          <select\n            value={tierFilter}\n            onChange={(e) => setTierFilter(e.target.value)}\n            className=\"bg-[#181924] border border-gym-border text-zinc-200 text-xs font-semibold rounded-xl px-3 py-2 focus:outline-none focus:border-amber-400 shrink-0\"\n          >\n            <option value=\"all\">Todos los Planes</option>\n            <option value=\"vip\">👑 Membresías VIP / Black</option>\n            <option value=\"monthly\">📅 Mensualidades</option>\n            <option value=\"quarterly\">⚡ Trimestrales</option>\n            <option value=\"daily\">🎫 Pases de Día</option>\n          </select>\n\n          {/* Sort By Dropdown */}\n          <select\n            value={sortBy}\n            onChange={(e) => setSortBy(e.target.value as typeof sortBy)}\n            className=\"bg-[#181924] border border-gym-border text-zinc-200 text-xs font-semibold rounded-xl px-3 py-2 focus:outline-none focus:border-amber-400 shrink-0\"\n          >\n            <option value=\"urgency\">⌛ Próximos a Vencer</option>\n            <option value=\"checkins\">🏆 Mayor Asistencia</option>\n            <option value=\"name\">🔤 Nombre (A - Z)</option>\n            <option value=\"recent\">🆕 Más Recientes</option>\n          </select>\n\n          {/* View Mode Toggle: Tabla vs Recuadros vs Mesa de Cobro */}\n          <div className=\"flex items-center bg-[#181924] p-1 rounded-xl border border-gym-border shrink-0\">\n            <button\n              onClick={() => setViewMode('table')}\n              title=\"Vista en tabla para alta lectura y control rápido\"\n              className={`p-1.5 rounded-lg transition-all flex items-center gap-1.5 text-xs font-bold ${\n                viewMode === 'table'\n                  ? 'bg-amber-500 text-black shadow-md'\n                  : 'text-gym-muted hover:text-white'\n              }`}\n            >\n              <List className=\"w-4 h-4\" />\n              <span className=\"hidden sm:inline\">Tabla</span>\n            </button>\n            \n            <button\n              onClick={() => setViewMode('grid')}\n              title=\"Vista en fichas con fotos de atletas\"\n              className={`p-1.5 rounded-lg transition-all flex items-center gap-1.5 text-xs font-bold ${\n                viewMode === 'grid'\n                  ? 'bg-amber-500 text-black shadow-md'\n                  : 'text-gym-muted hover:text-white'\n              }`}\n            >\n              <LayoutGrid className=\"w-4 h-4\" />\n              <span className=\"hidden sm:inline\">Fichas</span>\n            </button>\n\n            <button\n              onClick={() => setViewMode('desk')}\n              title=\"Mesa de renovación: alertas urgentes y WhatsApp 1-clic\"\n              className={`p-1.5 rounded-lg transition-all flex items-center gap-1.5 text-xs font-bold ${\n                viewMode === 'desk'\n                  ? 'bg-amber-500 text-black shadow-md'\n                  : 'text-gym-muted hover:text-white'\n              }`}\n            >\n              <Zap className=\"w-4 h-4 text-amber-400 group-hover:text-black\" />\n              <span className=\"hidden sm:inline\">Renovaciones</span>\n            </button>\n          </div>\n\n        </div>\n\n      </div>\n\n      {/* Main Content Area */}\n      {filteredMembers.length === 0 ? (\n        <div className=\"bg-[#12131a] rounded-3xl border border-gym-border p-14 text-center\">\n          <Users className=\"w-14 h-14 mx-auto mb-3 text-amber-500/30\" />\n          <h3 className=\"font-extrabold text-white text-lg\">No se encontraron clientes</h3>\n          <p className=\"text-xs text-gym-muted mt-1 max-w-md mx-auto\">\n            No hay registros que coincidan con el término de búsqueda o con el filtro seleccionado.\n          </p>\n          <button\n            onClick={() => {\n              setSearch('');\n              setStatusFilter('all');\n              setTierFilter('all');\n            }}\n            className=\"mt-4 px-4 py-2 rounded-xl bg-gym-surface hover:bg-zinc-800 text-amber-400 border border-amber-500/30 text-xs font-bold\"\n          >\n            Limpiar Filtros\n          </button>\n        </div>\n      ) : viewMode === 'table' ? (\n        \n        /* ============================================================== */\n        /* VIEW 1: TABLA INTELIGENTE (THE ENHANCED TABLE SCREENSHOT)        */\n        /* ============================================================== */\n        <div className=\"bg-[#101117] rounded-3xl border border-gym-border/90 overflow-hidden shadow-2xl\">\n          <div className=\"overflow-x-auto\">\n            <table className=\"w-full text-left border-collapse\">\n              <thead>\n                <tr className=\"border-b border-gym-border bg-[#141520] text-[11px] font-extrabold uppercase tracking-wider text-zinc-400\">\n                  <th className=\"p-4 pl-5\">Socio</th>\n                  <th className=\"p-4\">Contacto Directo</th>\n                  <th className=\"p-4\">Membresía / Plan</th>\n                  <th className=\"p-4\">Estado & Vigencia</th>\n                  <th className=\"p-4 text-center\">Acceso Huella</th>\n                  <th className=\"p-4 pr-5 text-right\">Acciones Rápidas</th>\n                </tr>\n              </thead>\n              <tbody className=\"divide-y divide-gym-border/50 text-sm\">\n                {filteredMembers.map((member) => {\n                  const isExpired = member.membership.status === 'expired' || member.membership.daysRemaining < 0;\n                  const isExpiring = member.membership.daysRemaining <= 5 && !isExpired;\n                  const isVip = member.membership.planType === 'vip' || member.membership.planName.toLowerCase().includes('vip') || member.membership.planName.toLowerCase().includes('black');\n\n                  return (\n                    <tr \n                      key={member.id}\n                      className=\"hover:bg-white/[0.025] transition-colors group\"\n                    >\n                      {/* SOCIO COLUMN */}\n                      <td className=\"p-4 pl-5\">\n                        <div className=\"flex items-center gap-3.5\">\n                          {/* Avatar with Halo Ring */}\n                          <div className=\"relative shrink-0 cursor-pointer\" onClick={() => setSelectedClientForDetail(member)}>\n                            <img\n                              src={getGymAvatar(member.fullName, member.avatarUrl)}\n                              alt={member.fullName}\n                              onError={(e) => {\n                                (e.currentTarget as HTMLImageElement).src = getOfflineGymSvgAvatar(detectGender(member.fullName));\n                              }}\n                              className={`w-11 h-11 rounded-2xl object-cover border-2 shadow-md transition-transform group-hover:scale-105 ${\n                                isExpired \n                                  ? 'border-red-500/80 ring-2 ring-red-500/20' \n                                  : isExpiring \n                                  ? 'border-amber-400 ring-2 ring-amber-400/30' \n                                  : 'border-emerald-400/80 ring-2 ring-emerald-400/20'\n                              }`}\n                            />\n                            {/* VIP Crown or check badge */}\n                            {isVip && (\n                              <span className=\"absolute -top-1.5 -right-1.5 w-5 h-5 rounded-full bg-gradient-to-br from-amber-400 to-amber-600 flex items-center justify-center text-black shadow-sm\" title=\"Socio Black VIP\">\n                                <Crown className=\"w-3 h-3 fill-black text-black\" />\n                              </span>\n                            )}\n                          </div>\n\n                          <div>\n                            <div \n                              onClick={() => setSelectedClientForDetail(member)}\n                              className=\"font-black text-white hover:text-amber-400 cursor-pointer text-sm leading-tight transition-colors flex items-center gap-1.5\"\n                            >\n                              <span>{member.fullName}</span>\n                              {isVip && (\n                                <span className=\"text-[10px] font-black uppercase px-1.5 py-0.2 rounded bg-amber-500/20 text-amber-400 border border-amber-500/30\">\n                                  VIP\n                                </span>\n                              )}\n                            </div>\n\n                            <div className=\"flex items-center gap-2 text-xs text-gym-muted font-mono mt-1\">\n                              <span className=\"bg-black/40 px-1.5 py-0.5 rounded text-zinc-300 font-bold border border-white/5\">\n                                ID: {member.id}\n                              </span>\n                              <span>•</span>\n                              <span className=\"text-zinc-400\">\n                                DNI: {member.documentId || 'S/N'}\n                              </span>\n                            </div>\n                          </div>\n                        </div>\n                      </td>\n\n                      {/* CONTACTO DIRECTO */}\n                      <td className=\"p-4\">\n                        <div className=\"space-y-1 text-xs\">\n                          {member.phone ? (\n                            <div className=\"flex items-center gap-2\">\n                              <button\n                                onClick={(e) => handleSendWhatsApp(e, member)}\n                                className=\"inline-flex items-center gap-1.5 text-emerald-400 hover:text-emerald-300 font-semibold bg-emerald-500/10 hover:bg-emerald-500/20 px-2 py-0.5 rounded-lg border border-emerald-500/20 transition-colors\"\n                                title=\"Enviar mensaje por WhatsApp con 1 clic\"\n                              >\n                                <Phone className=\"w-3.5 h-3.5\" />\n                                <span>{member.phone}</span>\n                              </button>\n                            </div>\n                          ) : (\n                            <span className=\"text-zinc-500\">Sin teléfono</span>\n                          )}\n\n                          {member.email && (\n                            <div className=\"flex items-center gap-1.5 text-zinc-400 text-[11px] truncate max-w-[200px]\">\n                              <Mail className=\"w-3 h-3 text-blue-400 shrink-0\" />\n                              <span className=\"truncate\">{member.email}</span>\n                            </div>\n                          )}\n                        </div>\n                      </td>\n\n                      {/* MEMBRESÍA / PLAN */}\n                      <td className=\"p-4\">\n                        <div>\n                          <div className=\"font-extrabold text-white text-xs leading-tight\">\n                            {member.membership.planName}\n                          </div>\n                          <div className=\"flex items-center gap-2 mt-1\">\n                            <span className=\"text-amber-400 font-black font-mono text-xs\">\n                              ${member.membership.price.toLocaleString()} MXN\n                            </span>\n                            <span className=\"text-[10px] text-zinc-400 font-mono\">\n                              ({member.membership.planType})\n                            </span>\n                          </div>\n                        </div>\n                      </td>\n\n                      {/* ESTADO & VIGENCIA */}\n                      <td className=\"p-4\">\n                        <div className=\"space-y-1.5 max-w-[190px]\">\n                          <div className=\"flex items-center gap-2\">\n                            <span className={`text-[10px] font-black uppercase px-2.5 py-0.5 rounded-full border ${\n                              isExpired \n                                ? 'bg-red-500/20 text-red-400 border-red-500/40' \n                                : isExpiring \n                                ? 'bg-amber-500/20 text-amber-400 border-amber-500/40' \n                                : 'bg-emerald-500/20 text-emerald-400 border-emerald-500/40'\n                            }`}>\n                              {isExpired ? 'VENCIDA' : isExpiring ? 'POR VENCER' : 'ACTIVA'}\n                            </span>\n\n                            <span className={`text-[11px] font-bold font-mono ${\n                              isExpired ? 'text-red-400' : isExpiring ? 'text-amber-400' : 'text-zinc-300'\n                            }`}>\n                              {member.membership.daysRemaining >= 0 \n                                ? `${member.membership.daysRemaining} d restantes`\n                                : `-${Math.abs(member.membership.daysRemaining)} d`}\n                            </span>\n                          </div>\n\n                          {/* Mini Progress Bar for Days */}\n                          <div className=\"w-full bg-zinc-800 rounded-full h-1.5 overflow-hidden\">\n                            <div \n                              className={`h-full rounded-full transition-all duration-500 ${\n                                isExpired \n                                  ? 'bg-red-500 w-full' \n                                  : isExpiring \n                                  ? 'bg-amber-400 w-1/4 animate-pulse' \n                                  : 'bg-emerald-400 w-3/4'\n                              }`} \n                            />\n                          </div>\n\n                          <span className=\"text-[10px] text-zinc-400 font-mono block\">\n                            Fin: {member.membership.endDate}\n                          </span>\n                        </div>\n                      </td>\n\n                      {/* ACCESO HUELLA */}\n                      <td className=\"p-4 text-center\">\n                        {member.biometricRegistered ? (\n                          <div className=\"inline-flex flex-col items-center\">\n                            <div className=\"inline-flex items-center gap-1 px-2.5 py-1 rounded-xl bg-emerald-500/15 border border-emerald-500/30 text-emerald-400 text-xs font-bold\" title=\"Huella dactilar activa en torniquetes\">\n                              <Fingerprint className=\"w-3.5 h-3.5\" />\n                              <span>Enrolada</span>\n                            </div>\n                            <span className=\"text-[10px] text-zinc-400 font-mono mt-1\">\n                              {member.checkInsCount || 0} visitas\n                            </span>\n                          </div>\n                        ) : (\n                          <button\n                            onClick={() => setSelectedClientForEnroll(member)}\n                            className=\"inline-flex items-center gap-1 px-3 py-1 rounded-xl bg-purple-500/15 hover:bg-purple-500/25 border border-purple-500/30 text-purple-300 hover:text-purple-200 text-xs font-bold transition-all shadow-sm\"\n                            title=\"Capturar huella biométrica del socio\"\n                          >\n                            <Fingerprint className=\"w-3.5 h-3.5 text-purple-400\" />\n                            <span>Capturar</span>\n                          </button>\n                        )}\n                      </td>\n\n                      {/* ACCIONES RÁPIDAS */}\n                      <td className=\"p-4 pr-5 text-right\">\n                        <div className=\"flex items-center justify-end gap-1.5\">\n                          \n                          {/* Pase Rápido Torniquete (Simulation & check) */}\n                          <button\n                            onClick={(e) => handleQuickAccessCheck(e, member)}\n                            className=\"p-2 rounded-xl bg-gym-surface hover:bg-amber-500/20 text-zinc-300 hover:text-amber-400 border border-gym-border transition-colors\"\n                            title=\"⚡ Simular Pase / Abrir Torniquete para este socio\"\n                          >\n                            <DoorOpen className=\"w-4 h-4\" />\n                          </button>\n\n                          {/* Digital Pass / Credential */}\n                          <button\n                            onClick={() => setSelectedClientForCredential(member)}\n                            className=\"p-2 rounded-xl bg-gym-surface hover:bg-white/10 text-zinc-300 hover:text-white border border-gym-border transition-colors\"\n                            title=\"Generar Credencial Digital & Barcode\"\n                          >\n                            <QrCode className=\"w-4 h-4 text-amber-400\" />\n                          </button>\n\n                          {/* View Dossier / Detail */}\n                          <button\n                            onClick={() => setSelectedClientForDetail(member)}\n                            className=\"p-2 rounded-xl bg-gym-surface hover:bg-white/10 text-zinc-300 hover:text-white border border-gym-border transition-colors\"\n                            title=\"Ver expediente completo\"\n                          >\n                            <Eye className=\"w-4 h-4\" />\n                          </button>\n\n                          {/* Edit Client */}\n                          {currentRole !== 'trainer' && (\n                            <button\n                              onClick={() => setSelectedClientForEdit(member)}\n                              className=\"px-2.5 py-1.5 rounded-xl bg-blue-500/15 hover:bg-blue-500/25 text-blue-400 text-xs font-bold border border-blue-500/30 transition-colors flex items-center gap-1\"\n                              title=\"Editar datos del socio\"\n                            >\n                              <Pencil className=\"w-3.5 h-3.5\" />\n                              <span className=\"hidden xl:inline\">Editar</span>\n                            </button>\n                          )}\n\n                          {/* Renew Membership Button */}\n                          {currentRole !== 'trainer' && (\n                            <button\n                              onClick={() => setSelectedClientForRenew(member)}\n                              className=\"px-3 py-1.5 rounded-xl bg-emerald-500/20 hover:bg-emerald-500/30 text-emerald-400 text-xs font-bold border border-emerald-500/40 transition-colors flex items-center gap-1 shadow-sm\"\n                              title=\"Renovar membresía\"\n                            >\n                              <RefreshCw className=\"w-3.5 h-3.5\" />\n                              <span className=\"hidden xl:inline\">Renovar</span>\n                            </button>\n                          )}\n\n                          {/* Delete Member (Admin Only) */}\n                          {currentRole === 'admin' && (\n                            <button\n                              onClick={() => {\n                                if (confirm(`¿Eliminar socio permanentemente: ${member.fullName}?`)) {\n                                  deleteMember(member.id);\n                                }\n                              }}\n                              className=\"p-2 rounded-xl bg-gym-surface hover:bg-red-500/20 text-zinc-400 hover:text-red-400 border border-gym-border transition-colors\"\n                              title=\"Eliminar socio\"\n                            >\n                              <Trash2 className=\"w-3.5 h-3.5\" />\n                            </button>\n                          )}\n\n                        </div>\n                      </td>\n\n                    </tr>\n                  );\n                })}\n              </tbody>\n            </table>\n          </div>\n        </div>\n\n      ) : viewMode === 'grid' ? (\n\n        /* ============================================================== */\n        /* VIEW 2: FICHAS PRO (MODERN ATHLETIC CARDS)                      */\n        /* ============================================================== */\n        <div className=\"grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-3 xl:grid-cols-4 2xl:grid-cols-5 gap-4\">\n          {filteredMembers.map((member) => {\n            const isExpired = member.membership.status === 'expired' || member.membership.daysRemaining < 0;\n            const isExpiring = member.membership.daysRemaining <= 5 && !isExpired;\n            const isVip = member.membership.planType === 'vip' || member.membership.planName.toLowerCase().includes('vip') || member.membership.planName.toLowerCase().includes('black');\n\n            return (\n              <div\n                key={member.id}\n                onClick={() => setSelectedClientForDetail(member)}\n                className={`group relative rounded-3xl border p-4 transition-all duration-300 cursor-pointer shadow-lg hover:shadow-2xl flex flex-col justify-between ${\n                  isVip \n                    ? 'bg-gradient-to-b from-[#19150b] via-[#12131b] to-[#0c0d12] border-amber-500/40 hover:border-amber-400 shadow-amber-500/5' \n                    : 'bg-[#12131a] hover:bg-[#161722] border-gym-border hover:border-zinc-500'\n                }`}\n              >\n                <div>\n                  {/* Top Status & Biometric Badges */}\n                  <div className=\"flex items-center justify-between gap-2 mb-3\">\n                    <span className={`text-[10px] font-black uppercase px-2.5 py-0.5 rounded-full border ${\n                      isExpired \n                        ? 'bg-red-500/20 text-red-400 border-red-500/30' \n                        : isExpiring \n                        ? 'bg-amber-500/20 text-amber-400 border-amber-500/30' \n                        : 'bg-emerald-500/20 text-emerald-400 border-emerald-500/30'\n                    }`}>\n                      {isExpired ? 'Vencida' : isExpiring ? 'Por Vencer' : 'Activa'}\n                    </span>\n\n                    {member.biometricRegistered ? (\n                      <span className=\"flex items-center gap-1 text-[11px] text-emerald-400 font-bold bg-emerald-500/10 px-2 py-0.5 rounded-lg border border-emerald-500/20\">\n                        <Fingerprint className=\"w-3 h-3\" />\n                        <span>Huella OK</span>\n                      </span>\n                    ) : (\n                      <button\n                        onClick={(e) => {\n                          e.stopPropagation();\n                          setSelectedClientForEnroll(member);\n                        }}\n                        className=\"flex items-center gap-1 text-[10px] text-purple-300 hover:text-purple-200 font-bold px-2 py-0.5 rounded-lg bg-purple-500/15 border border-purple-500/30 transition-colors\"\n                      >\n                        <Fingerprint className=\"w-3 h-3 text-purple-400\" />\n                        <span>Capturar</span>\n                      </button>\n                    )}\n                  </div>\n\n                  {/* Avatar & Identification */}\n                  <div className=\"flex items-center gap-3.5 mb-3.5\">\n                    <div className=\"relative shrink-0\">\n                      <img\n                        src={getGymAvatar(member.fullName, member.avatarUrl)}\n                        alt={member.fullName}\n                        onError={(e) => {\n                          (e.currentTarget as HTMLImageElement).src = getOfflineGymSvgAvatar(detectGender(member.fullName));\n                        }}\n                        className={`w-13 h-13 rounded-2xl object-cover border-2 shadow-md transition-transform group-hover:scale-105 ${\n                          isExpired \n                            ? 'border-red-500' \n                            : isExpiring \n                            ? 'border-amber-400' \n                            : 'border-emerald-400'\n                        }`}\n                      />\n                      {isVip && (\n                        <span className=\"absolute -top-1.5 -right-1.5 w-5 h-5 rounded-full bg-gradient-to-br from-amber-400 to-amber-600 flex items-center justify-center text-black shadow-md\">\n                          <Crown className=\"w-3 h-3 fill-black text-black\" />\n                        </span>\n                      )}\n                    </div>\n\n                    <div className=\"min-w-0 flex-1\">\n                      <h3 className=\"font-extrabold text-white text-sm group-hover:text-amber-400 transition-colors truncate\">\n                        {member.fullName}\n                      </h3>\n                      <div className=\"flex items-center gap-1.5 text-[11px] text-gym-muted font-mono mt-0.5\">\n                        <span className=\"text-zinc-300 font-bold\">ID: {member.id}</span>\n                        <span>•</span>\n                        <span>DNI: {member.documentId || 'S/N'}</span>\n                      </div>\n                    </div>\n                  </div>\n\n                  {/* Membership Info Box */}\n                  <div className=\"bg-[#181924]/80 rounded-2xl p-3 border border-white/5 mb-3 space-y-1.5\">\n                    <div className=\"flex items-center justify-between text-xs\">\n                      <span className=\"font-bold text-white truncate max-w-[65%]\">\n                        {member.membership.planName}\n                      </span>\n                      <span className=\"text-amber-400 font-black font-mono text-xs\">\n                        ${member.membership.price.toLocaleString()}\n                      </span>\n                    </div>\n\n                    <div className=\"flex items-center justify-between text-[11px] text-gym-muted\">\n                      <span>Vigencia:</span>\n                      <span className={`font-bold font-mono ${\n                        isExpired ? 'text-red-400' : isExpiring ? 'text-amber-400' : 'text-emerald-400'\n                      }`}>\n                        {member.membership.daysRemaining >= 0 \n                          ? `${member.membership.daysRemaining} días`\n                          : `Venció hace ${Math.abs(member.membership.daysRemaining)} d`}\n                      </span>\n                    </div>\n\n                    <div className=\"w-full bg-zinc-800 rounded-full h-1.5 overflow-hidden\">\n                      <div \n                        className={`h-full rounded-full ${\n                          isExpired ? 'bg-red-500 w-full' : isExpiring ? 'bg-amber-400 w-1/4' : 'bg-emerald-400 w-3/4'\n                        }`} \n                      />\n                    </div>\n                  </div>\n\n                  {/* Activity Snippet */}\n                  <div className=\"flex items-center justify-between text-[11px] text-zinc-400 px-1 mb-2\">\n                    <span className=\"flex items-center gap-1 font-mono\">\n                      <Activity className=\"w-3 h-3 text-amber-400\" />\n                      <span>{member.checkInsCount || 0} visitas</span>\n                    </span>\n                    {member.phone && (\n                      <span \n                        onClick={(e) => handleSendWhatsApp(e, member)}\n                        className=\"text-emerald-400 hover:underline flex items-center gap-1\"\n                        title=\"Enviar WhatsApp\"\n                      >\n                        <Phone className=\"w-3 h-3\" />\n                        <span>WhatsApp</span>\n                      </span>\n                    )}\n                  </div>\n                </div>\n\n                {/* Card Footer: Expediente + Quick action buttons */}\n                <div className=\"border-t border-white/10 pt-2.5 mt-2 flex items-center justify-between gap-1\" onClick={(e) => e.stopPropagation()}>\n                  <button\n                    onClick={() => setSelectedClientForDetail(member)}\n                    className=\"text-xs font-bold text-amber-400 hover:text-amber-300 flex items-center gap-1 py-1\"\n                  >\n                    <span>Expediente</span>\n                    <ChevronRight className=\"w-3.5 h-3.5\" />\n                  </button>\n\n                  <div className=\"flex items-center gap-1\">\n                    <button\n                      onClick={(e) => handleQuickAccessCheck(e, member)}\n                      className=\"p-1.5 rounded-lg bg-gym-surface hover:bg-amber-500/20 text-zinc-300 hover:text-amber-400 border border-gym-border transition-colors\"\n                      title=\"Simular Pase de Torniquete\"\n                    >\n                      <DoorOpen className=\"w-3.5 h-3.5\" />\n                    </button>\n\n                    <button\n                      onClick={() => setSelectedClientForCredential(member)}\n                      className=\"p-1.5 rounded-lg bg-gym-surface hover:bg-white/10 text-zinc-300 hover:text-white border border-gym-border transition-colors\"\n                      title=\"Credencial Digital\"\n                    >\n                      <QrCode className=\"w-3.5 h-3.5 text-amber-400\" />\n                    </button>\n\n                    {currentRole !== 'trainer' && (\n                      <button\n                        onClick={() => setSelectedClientForRenew(member)}\n                        className=\"p-1.5 rounded-lg bg-emerald-500/20 hover:bg-emerald-500/30 text-emerald-400 border border-emerald-500/30 transition-colors\"\n                        title=\"Renovar membresía\"\n                      >\n                        <RefreshCw className=\"w-3.5 h-3.5\" />\n                      </button>\n                    )}\n                  </div>\n                </div>\n\n              </div>\n            );\n          })}\n        </div>\n\n      ) : (\n\n        /* ============================================================== */\n        /* VIEW 3: MESA DE RENOVACIONES (RECEPCIONIST FOLLOW-UP DESK)       */\n        /* ============================================================== */\n        <div className=\"space-y-4\">\n          <div className=\"p-4 rounded-2xl bg-amber-500/10 border border-amber-500/30 flex items-center gap-3\">\n            <Zap className=\"w-5 h-5 text-amber-400 shrink-0\" />\n            <div className=\"text-xs text-zinc-300 leading-relaxed\">\n              <strong className=\"text-white\">Mesa de Renovaciones y Cobranza Rápida:</strong> Esta vista prioriza los socios que vencieron recientemente o vencen en los próximos 5 días. Utiliza el botón de WhatsApp para enviar el recordatorio precargado con un solo clic.\n            </div>\n          </div>\n\n          <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4\">\n            {filteredMembers\n              .filter(m => m.membership.daysRemaining <= 5 || m.membership.status === 'expired')\n              .map((member) => {\n                const isExpired = member.membership.status === 'expired' || member.membership.daysRemaining < 0;\n\n                return (\n                  <div \n                    key={member.id}\n                    className={`p-5 rounded-3xl border shadow-xl flex flex-col justify-between ${\n                      isExpired \n                        ? 'bg-gradient-to-br from-[#230f12] via-[#141015] to-[#0c0d12] border-red-500/40' \n                        : 'bg-gradient-to-br from-[#241a0d] via-[#151318] to-[#0c0d12] border-amber-500/40'\n                    }`}\n                  >\n                    <div>\n                      <div className=\"flex items-center justify-between mb-3\">\n                        <span className={`text-[10px] font-black uppercase px-2.5 py-0.5 rounded-full ${\n                          isExpired ? 'bg-red-500 text-white' : 'bg-amber-400 text-black'\n                        }`}>\n                          {isExpired ? 'Acceso Bloqueado' : 'Próximo a Vencer'}\n                        </span>\n\n                        <span className={`text-xs font-black font-mono ${isExpired ? 'text-red-400' : 'text-amber-400'}`}>\n                          {member.membership.daysRemaining >= 0 \n                            ? `Vence en ${member.membership.daysRemaining} días` \n                            : `Venció hace ${Math.abs(member.membership.daysRemaining)} días`}\n                        </span>\n                      </div>\n\n                      <div className=\"flex items-center gap-3 mb-3\">\n                        <img\n                          src={getGymAvatar(member.fullName, member.avatarUrl)}\n                          alt={member.fullName}\n                          className=\"w-12 h-12 rounded-2xl object-cover border border-white/20\"\n                        />\n                        <div>\n                          <h4 className=\"font-black text-white text-base leading-tight\">{member.fullName}</h4>\n                          <p className=\"text-xs text-zinc-400 font-mono\">DNI: {member.documentId} • ID: {member.id}</p>\n                        </div>\n                      </div>\n\n                      <div className=\"p-3 bg-black/40 rounded-2xl border border-white/10 space-y-1 text-xs mb-4\">\n                        <div className=\"flex justify-between\">\n                          <span className=\"text-gym-muted\">Plan Actual:</span>\n                          <span className=\"font-bold text-white\">{member.membership.planName}</span>\n                        </div>\n                        <div className=\"flex justify-between\">\n                          <span className=\"text-gym-muted\">Costo Renovación:</span>\n                          <span className=\"font-black text-amber-400 font-mono\">${member.membership.price.toLocaleString()} MXN</span>\n                        </div>\n                        <div className=\"flex justify-between\">\n                          <span className=\"text-gym-muted\">Fecha Límite:</span>\n                          <span className=\"font-mono text-zinc-300\">{member.membership.endDate}</span>\n                        </div>\n                      </div>\n                    </div>\n\n                    <div className=\"flex items-center gap-2 pt-2 border-t border-white/10\">\n                      <button\n                        onClick={(e) => handleSendWhatsApp(e, member)}\n                        className=\"flex-1 py-2.5 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-black font-black text-xs flex items-center justify-center gap-1.5 transition-all shadow-md\"\n                      >\n                        <Phone className=\"w-3.5 h-3.5\" />\n                        <span>Aviso WhatsApp</span>\n                      </button>\n\n                      <button\n                        onClick={() => setSelectedClientForRenew(member)}\n                        className=\"px-4 py-2.5 rounded-xl bg-amber-500 hover:bg-amber-400 text-black font-black text-xs flex items-center justify-center gap-1.5 transition-all shadow-glow-gold\"\n                      >\n                        <RefreshCw className=\"w-3.5 h-3.5\" />\n                        <span>Renovar</span>\n                      </button>\n                    </div>\n\n                  </div>\n                );\n              })}\n          </div>\n        </div>\n\n      )}\n\n      {/* ============================================================== */}\n      {/* ALL MODAL DIALOGS                                              */}\n      {/* ============================================================== */}\n\n      {/* 1. Add Client Modal */}\n      {showAddModal && (\n        <ClientFormModal\n          onClose={() => setShowAddModal(false)}\n          onClientCreated={(newClient, wantsEnrollment) => {\n            setShowAddModal(false);\n            if (wantsEnrollment) {\n              setSelectedClientForEnroll(newClient);\n            }\n          }}\n        />\n      )}\n\n      {/* 2. Edit Client Modal */}\n      {selectedClientForEdit && (\n        <ClientEditModal\n          client={selectedClientForEdit}\n          onClose={() => setSelectedClientForEdit(null)}\n          onClientUpdated={(updatedClient) => {\n            setSelectedClientForEdit(null);\n          }}\n        />\n      )}\n\n      {/* 3. Detail Dossier Modal */}\n      {selectedClientForDetail && (\n        <ClientDetailModal\n          client={selectedClientForDetail}\n          onClose={() => setSelectedClientForDetail(null)}\n          onEdit={() => {\n            const client = selectedClientForDetail;\n            setSelectedClientForDetail(null);\n            setSelectedClientForEdit(client);\n          }}\n          onEnrollBiometric={() => {\n            const client = selectedClientForDetail;\n            setSelectedClientForDetail(null);\n            setSelectedClientForEnroll(client);\n          }}\n          onRenewMembership={() => {\n            const client = selectedClientForDetail;\n            setSelectedClientForDetail(null);\n            setSelectedClientForRenew(client);\n          }}\n        />\n      )}\n\n      {/* 4. Biometric Fingerprint Capture Wizard */}\n      {selectedClientForEnroll && (\n        <BiometricEnrollModal\n          client={selectedClientForEnroll}\n          onClose={() => setSelectedClientForEnroll(null)}\n          onSuccess={() => setSelectedClientForEnroll(null)}\n        />\n      )}\n\n      {/* 5. Renew Membership Modal */}\n      {selectedClientForRenew && (\n        <RenewMembershipModal\n          client={selectedClientForRenew}\n          onClose={() => setSelectedClientForRenew(null)}\n        />\n      )}\n\n      {/* 6. Digital Credential Pass with QR & Barcode */}\n      {selectedClientForCredential && (\n        <ClientCredentialModal\n          client={selectedClientForCredential}\n          onClose={() => setSelectedClientForCredential(null)}\n        />\n      )}\n\n    </div>\n  );\n};\n","Overwrite":true,"Path":"c:\\Users\\andre\\OneDrive\\Desktop\\gym\\LEGENDS\\src\\components\\clients\\ClientList.tsx"}}]}
