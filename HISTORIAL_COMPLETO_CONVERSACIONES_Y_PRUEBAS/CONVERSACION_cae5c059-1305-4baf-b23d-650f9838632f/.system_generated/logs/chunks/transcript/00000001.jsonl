{"step_index":135,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-10-24T15:35:50Z","content":"Created At: 2026-10-24T09:35:50-06:00\nCompleted At: 2026-10-24T09:35:50-06:00\nShowing lines 1-50 of 359\n1: import * as XLSX from 'xlsx';\r\n2: import { CashRegisterSession, Expense, Sale, GymSettings } from '../types';\r\n3: \r\n4: export const exportShiftReportToExcel = (\r\n5:   cashSession: CashRegisterSession,\r\n6:   expenses: Expense[],\r\n7:   sales: Sale[],\r\n8:   gymSettings?: GymSettings\r\n9: ) => {\r\n10:   const wb = XLSX.utils.book_new();\r\n11: \r\n12:   const openedDateStr = new Date(cashSession.openedAt).toLocaleString('es-MX');\r\n13:   const closedDateStr = cashSession.closedAt \r\n14:     ? new Date(cashSession.closedAt).toLocaleString('es-MX') \r\n15:     : 'Turno en curso (No cerrado)';\r\n16: \r\n17:   const todayStr = new Date().toISOString().slice(0, 10);\r\n18:   const shiftOpenTime = new Date(cashSession.openedAt).getTime();\r\n19:   const shiftCloseTime = cashSession.closedAt ? new Date(cashSession.closedAt).getTime() : Date.now();\r\n20: \r\n21:   // Filtrar ventas del turno actual\r\n22:   const shiftSales = sales.filter(s => {\r\n23:     const saleTime = new Date(s.timestamp || '').getTime();\r\n24:     if (isNaN(saleTime)) return s.timestamp?.startsWith(todayStr);\r\n25:     return saleTime >= shiftOpenTime && saleTime <= shiftCloseTime;\r\n26:   });\r\n27: \r\n28:   // Gastos pagados de caja\r\n29:   const shiftCashExpenses = expenses.filter(e => {\r\n30:     const expTime = new Date(e.date).getTime();\r\n31:     if (isNaN(expTime)) return e.date?.startsWith(todayStr) && e.paidFromCashRegister;\r\n32:     return expTime >= shiftOpenTime && expTime <= shiftCloseTime && e.paidFromCashRegister;\r\n33:   });\r\n34: \r\n35:   const totalCashExpenses = shiftCashExpenses.reduce((sum, e) => sum + e.amount, 0);\r\n36: \r\n37:   const totalStoreSales = cashSession.totalSalesCash + cashSession.totalSalesCard + cashSession.totalSalesTransfer;\r\n38:   const totalMemberships = cashSession.totalMembershipsCash + cashSession.totalMembershipsCard + (cashSession.totalMembershipsTransfer || 0);\r\n39:   const grandTotalShift = totalStoreSales + totalMemberships;\r\n40: \r\n41:   const totalElectronic = cashSession.totalSalesCard + cashSession.totalSalesTransfer + cashSession.totalMembershipsCard + (cashSession.totalMembershipsTransfer || 0);\r\n42:   const expectedCashInDrawer = cashSession.expectedCash;\r\n43: \r\n44:   const remanentCash = cashSession.leaveCashInDrawer ? (cashSession.remanentCash || 0) : 0;\r\n45:   const withdrawnCash = cashSession.withdrawnCash ?? (cashSession.actualCash ?? expectedCashInDrawer);\r\n46: \r\n47:   // ==========================================\r\n48:   // HOJA 1: RESUMEN DE CORTE DE CAJA (CORTE Z)\r\n49:   // ==========================================\r\n50:   const summaryData: (string | number)[][] = [\r"}
