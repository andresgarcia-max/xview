ount: matched.checkInsCount + 1,\r\n1560:       lastCheckIn: now,\r\n1561:     });\r\n1562: \r\n1563:     // Update active branch occupancy in real time\r\n1564:     setBranches(prev => {\r\n1565:       const updated = prev.map(b => b.id === activeBranchId ? {\r\n1566:         ...b,\r\n1567:         currentOccupancy: Math.min(b.maxCapacity, b.currentOccupancy + 1)\r\n1568:       } : b);\r\n1569:       const targetB = updated.find(b => b.id === activeBranchId);\r\n1570:       if (targetB) broadcastLocalSync({ type: 'BRANCH_UPDATED', branch: targetB });\r"}
