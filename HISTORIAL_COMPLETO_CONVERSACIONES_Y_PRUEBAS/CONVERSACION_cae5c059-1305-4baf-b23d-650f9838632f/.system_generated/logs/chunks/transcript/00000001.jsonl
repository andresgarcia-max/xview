{"step_index":133,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-10-24T15:35:47Z","content":"Created At: 2026-10-24T09:35:47-06:00\nCompleted At: 2026-10-24T09:35:47-06:00\nShowing lines 1-79 of 79\n1: /**\r\n2:  * Lightweight Code 128 (Subset B) barcode encoder.\r\n3:  * Generates exact bar and space coordinates for crisp SVG rendering.\r\n4:  * 100% compatible with optical, laser, and camera barcode scanners.\r\n5:  */\r\n6: \r\n7: // Code 128 patterns for indices 0 to 106\r\n8: const CODE128_PATTERNS: string[] = [\r\n9:   '212222', '222122', '222221', '121223', '121322', '131222', '122213', '122312', '132212', '221213',\r\n10:   '221312', '231212', '112232', '122132', '122231', '113222', '123122', '123221', '223211', '221132',\r\n11:   '221231', '213212', '223112', '312131', '311222', '321122', '321221', '312212', '322112', '322211',\r\n12:   '212123', '212321', '232121', '111323', '131123', '131321', '112313', '132113', '132311', '211313',\r\n13:   '231113', '231311', '112133', '112331', '132131', '113123', '113321', '133121', '313121', '211331',\r\n14:   '231131', '213113', '213311', '213131', '311123', '311321', '331121', '312113', '312311', '332111',\r\n15:   '314111', '221411', '431111', '111224', '111422', '121124', '121421', '141122', '141221', '112214',\r\n16:   '112412', '122114', '122411', '142112', '142211', '241211', '221114', '413111', '241112', '134111',\r\n17:   '111242', '121142', '121241', '114212', '124112', '124211', '411212', '421112', '421211', '212141',\r\n18:   '214121', '412121', '111143', '111341', '131141', '114113', '114311', '411113', '411311', '113141',\r\n19:   '114131', '311141', '411131', '211412', '211214', '211232', '2331112'\r\n20: ];\r\n21: \r\n22: export interface BarcodeBar {\r\n23:   x: number;\r\n24:   width: number;\r\n25: }\r\n26: \r\n27: export interface EncodedBarcode {\r\n28:   bars: BarcodeBar[];\r\n29:   totalWidth: number;\r\n30:   text: string;\r\n31: }\r\n32: \r\n33: export function encodeBarcodeCode128(text: string): EncodedBarcode {\r\n34:   const cleanText = text.trim() || '000000';\r\n35:   const startCode = 104; // Code 128B start symbol\r\n36:   const codes: number[] = [startCode];\r\n37:   let checksum = startCode;\r\n38: \r\n39:   for (let i = 0; i < cleanText.length; i++) {\r\n40:     const charCode = cleanText.charCodeAt(i);\r\n41:     // ASCII 32 to 127\r\n42:     const code = charCode - 32;\r\n43:     if (code >= 0 && code <= 95) {\r\n44:       codes.push(code);\r\n45:       checksum += code * (i + 1);\r\n46:     }\r\n47:   }\r\n48: \r\n49:   const checkDigit = checksum % 103;\r\n50:   codes.push(checkDigit);\r\n51:   codes.push(106); // Stop symbol\r\n52: \r\n53:   let patternStr = '';\r\n54:   for (const c of codes) {\r\n55:     patternStr += CODE128_PATTERNS[c];\r\n56:   }\r\n57: \r\n58:   // Convert pattern to bars\r\n59:   // Characters alternate between bar and space\r\n60:   const bars: BarcodeBar[] = [];\r\n61:   let currentX = 10; // Quiet zone on left\r\n62: \r\n63:   for (let i = 0; i < patternStr.length; i++) {\r\n64:     const width = parseInt(patternStr[i], 10);\r\n65:     const isBar = i % 2 === 0;\r\n66:     if (isBar) {\r\n67:       bars.push({ x: currentX, width });\r\n68:     }\r\n69:     currentX += width;\r\n70:   }\r\n71: \r\n72:   const totalWidth = currentX + 10; // Quiet zone on right\r\n73: \r\n74:   return {\r\n75:     bars,\r\n76:     totalWidth,\r\n77:     text: cleanText,\r\n78:   };\r\n79: }\r"}
