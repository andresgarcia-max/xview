r design. A common data model should serve both while optimizing for respective display layouts.\n\n\nConsidering a \"Desk View\" for renewals, specifically highlighting expiring or expired members is needed. The view should provide direct contact information, renewal action buttons, and visit history. Confirmed available icons for UI elements are from `lucide-react`.\n\nThe `ClientCredentialModal` component will use the output of `encodeBarcodeCode128` function to render the barcode.\n\n\n","tool_calls":[{"name":"write_file","args":{"Content":"\"import React, { useRef } from 'react';\\nimport { Client } from '../../types';\\nimport { getGymAvatar, getOfflineGymSvgAvatar, detectGender } from '../../utils/genderAvatar';\\nimport { encodeBarcodeCode128 } from '../../utils/barcode';\\nimport { \\n  X, \\n  Printer, \\n  Download, \\n  Share2, \\n  CheckCircle2, \\n  Fingerprint, \\n  QrCode, \\n  ShieldCheck, \\n  Award,\\n  Crown,\\n  Calendar,\\n  Flame\\n} from 'lucide-react';\\n\\ninterface ClientCredentialModalProps {\\n  client: Client;\\n  onClose: () => void;\\n}\\n\\nexport const ClientCredentialModal: React.FC<ClientCredentialModalProps> = ({\\n  client,\\n  onClose,\\n}) => {\\n  const cardRef = useRef<HTMLDivElement>(null);\\n\\n  const isExpired = client.membership.status === 'expired' || client.membership.daysRemaining < 0;\\n  const isExpiringSoon = client.membership.status === 'expiring_soon' || (client.membership.daysRemaining <= 5 && !isExpired);\\n  const isVip = client.membership.planType === 'vip' || client.membership.planName.toLowerCase().includes('vip') || client.membership.planName.toLowerCase().includes('black');\\n\\n  // Generate barcode\\n  const barcode = encodeBarcodeCode128(client.id || 'MEM-000');\\n\\n  const handlePrint = () => {\\n    window.print();\\n  };\\n\\n  const handleShareWhatsApp = () => {\\n    const text = encodeURIComponent(\\n      `🏋️ *FITNESS LEGENDS PRO GYM* 🏋️\\\\n` +\\n      `*Credencial Digital de Socio*\\\\n\\\\n` +\\n      `👤 *Socio:* ${client.fullName}\\\\n` +\\n      `🆔 *ID:* ${client.id}\\\\n` +\\n      `📋 *DNI:* ${client.documentId}\\\\n` +\\n      `⭐ *Membresía:* ${client.membership.planName}\\\\n` +\\n      `📅 *Vigencia:* ${client.membership.startDate} al ${client.membership.endDate}\\\\n` +\\n      `🔒 *Huella Biometríca:* ${client.biometricRegistered ? 'Activa & Enrolada ✅' : 'Pendiente en Recepción'}\\\\n\\\\n` +\\n      `_¡Presenta esta credencial o tu huella en el torniquete de acceso!_`\\n    );\\n    window.open(`https://wa.me/${client.phone.replace(/\\\\D/g, '')}?text=${text}`, '_blank');\\n  };\\n\\n  return (\\n    <div className=\n<truncated 11112 bytes>","Overwrite":"true","Path":"\"c:\\\\Users\\\\andre\\\\OneDrive\\\\Desktop\\\\gym\\\\LEGENDS\\\\src\\\\components\\\\clients\\\\ClientCredentialModal.tsx\""}}],"truncated_fields":["tool_calls"]}
