alidad Estándar');\r\n96:   const [newClientPaymentMethod, setNewClientPaymentMethod] = useState<PaymentMethod>('cash');\r\n97:   const [newClientId, setNewClientId] = useState('');\r\n98:   const [newClientPhone, setNewClientPhone] = useState('');\r\n99:   const [newClientFingerprintEnrolled, setNewClientFingerprintEnrolled] = useState(false);\r\n100:   const [showBiometricDashboard, setShowBiometricDashboard] = useState(false);\r\n101:   const [biometricScanState, setBiometricScanState] = useState<'idle' | 'scanning' | 'completed'>('idle');\r\n102:   const [selectedFinger, setSelectedFinger] = useState('Pulgar Derecho');\r\n103: \r\n104:   // Available plans list (from catalogPlans or gym defaults)\r\n105:   const availablePlans = (catalogPlans && catalogPlans.length > 0)\r\n106:     ? catalogPlans.filter(p => p.active !== false)\r\n107:     : [\r\n108:         { id: 'CAT-PLAN-002', name: 'Mensualidad Estándar', type: 'monthly', durationDays: 30, price: 850 },\r\n109:         { id: 'CAT-PLAN-005', name: 'Mensualidad Estudiante', type: 'monthly', durationDays: 30, price: 650 },\r\n110:         { id: 'CAT-PLAN-003', name: 'Plan Trimestral Fuerza', type: 'quarterly', durationDays: 90, price: 2300 },\r\n111:         { id: 'CAT-PLAN-004', name: 'Membresía Black VIP Anual', type: 'annual', durationDays: 365, price: 9500 },\r\n112:       ];\r\n113: \r\n114:   // Birthday change: auto-calculate Age\r\n115:   const handleBirthDateChange = (dateStr: string) => {\r\n116:     setNewClientBirthDate(dateStr);\r\n117:     if (dateStr) {\r\n118:       const birth = new Date(dateStr);\r\n119:       if (!isNaN(birth.getTime())) {\r\n120:         const today = new Date();\r\n121:         let age = today.getFullYear() - birth.getFullYear();\r\n122:         const monthDiff = today.getMonth() - birth.getMonth();\r\n123:         if (monthDiff < 0 || (monthDiff === 0 && today.getDate() < birth.getDate())) {\r\n124:           age--;\r\n125:         }\r\n126:         if (age >= 0 && age <= 120) {\r\n127:           setNewClientAge(age);\r\n128:         }\r\n129:       }\r\n130:     }\r\n131:   };\r\n132: \r\n133:   // Age change: approximate birth year if not set\r\n134:   const handleAgeChange = (val: string) => {\r\n135:     setNewClientAge(val);\r\n136:     const num = parseInt(val, 10);\r\n137:     if (!isNaN(num) && num > 0 && num < 120 && !newClientBirthDate) {\r\n138:       const approxYear = new Date().getFullYear() - num;\r\n139:       setNewClientBirthDate(`${approxYear}-01-01`);\r\n140:     }\r\n141:   };\r\n142: \r\n143:   // Visit pass state\r\n144:   const [visitClientName, setVisitClientName] = useState('');\r\n145:   const [visitCost, setVisitCost] = useState('5.00');\r\n146:   const [searchQuery, setSearchQuery] = useState('');\r\n147:   const [isFullScreen, setIsFullScreen] = useState(isEmbeddedFullScreen);\r\n148:   const [showEscHint, setShowEscHint] = useState(false);\r\n149:   const [isMuted, setIsMuted] = useState(false);\r\n150:   const [bgImage, setBgImage] = useState<string>(() => {\r\n151:     if (typeof window !== 'undefined' && localStorage.getItem('legends_terminal_bg_version') !== 'v10_clear_photo') {\r\n152:       localStorage.setItem('legends_terminal_bg_version', 'v10_clear_photo');\r\n153:       localStorage.setItem('legends_terminal_bg', gymBg);\r\n154:       return gymBg;\r\n155:     }\r\n156:     return localStorage.getItem('legends_terminal_bg') || gymBg;\r\n157:   });\r\n158: \r\n159:   // Standalone terminal configuration\r\n160:   const [config, setConfig] = useState<TerminalConfig>(() => getTerminalConfig());\r\n161:   const [isSyncing, setIsSyncing] = useState(false);\r\n162:   const [lastSyncTime, setLastSyncTime] = useState<Date | null>(new Date());\r\n163:   const [serverStatus, setServerStatus] = useState<'connected' | 'disconnected' | 'checking'>('disconnected');\r\n164: \r\n165:   // Turnstile relay pulse countdown state\r\n166:   const [relayRemainingSeconds, setRelayRemainingSeconds] = useState<number>(0);\r\n167:   const relayTimerRef = useRef<number | null>(null);\r\n168: \r\n169:   // Barcode / RFID Keyboard Wedge scanner buffer\r\n170:   const keyBufferRef = useRef<string>('');\r\n171:   const lastKeyTimeRef = useRef<number>(0);\r\n172: \r\n173:   const serverVersionRef = useRef<number>(0);\r\n174: \r\n175:   // Sync members from server\r\n176:   const syncWithServer = useCallback(async (): Promise<boolean> => {\r\n177:     if (!config.serverUrl) {\r\n178:       setServerStatus('disconnected');\r\n179:       return false;\r\n180:     }\r\n181:     try {\r\n182:       const res = await fetchMembersFromServer(config.serverUrl, serverVersionRef.current);\r\n183:       if (res.success) {\r\n184:         setServerStatus('connected');\r\n185:         if (res.hasChanges || (res.members && res.members.length > 0 && serverVersionRef.current === 0)) {\r\n186:           if (res.members && res.members.length > 0) {\r\n187:             replaceMembers(res.members);\r\n188:             serverVersionRef.current = res.version;\r\n189:             setLastSyncTime(new Date());\r\n190:           }\r\n191:         }\r\n192:         return true;\r\n193:       } else {\r\n194:         const health = await checkServerHealth(config.serverUrl);\r\n195:         setServerStatus(health.online ? 'connected' : 'disconnected');\r\n196:         return health.online;\r\n197:       }\r\n198:     } catch {\r\n199:       setServerStatus('disconnected');\r\n200:       return false;\r\n201:     }\r\n202:   }, [config.serverUrl, replaceMembers]);\r\n203: \r\n204:   // Periodic polling for new/deleted/updated members\r\n205:   useEffect(() => {\r\n206:     syncWithServer();\r\n207:     if (config.autoSync) {\r\n208:       const intervalSec = Math.max(2, config.syncIntervalSeconds || 3);\r\n209:       const interval = setInterval(() => {\r\n210:         syncWithServer();\r\n211:       }, intervalSec * 1000);\r\n212:       return () => clearInterval(interval);\r\n213:     }\r\n214:   }, [syncWithServer, config.autoSync, config.syncIntervalSeconds]);\r\n215: \r\n216:   // Custom speech synthesis announcement\r\n217:   const speakCustomMessage = (text: string) => {\r\n218:     if (!config.voiceEnabled || isMuted || typeof window === 'undefined' || !('speechSynthesis' in window)) {\r\n219:       return;\r\n220:     }\r\n221:     try {\r\n222:       window.speechSynthesis.cancel();\r\n223:       const utterance = new SpeechSynthesisUtterance(text);\r\n224:       utterance.lang = 'es-MX';\r\n225:       utterance.rate = 0.95;\r\n226:       utterance.pitch = 1.0;\r\n227:       utterance.volume = config.soundVolume ?? 1.0;\r\n228:       const voices = window.speechSynthesis.getVoices();\r\n229:       const esVoice = voices.find(v => (v.lang && v.lang.startsWith('es')) || (v.name && (v.name.includes('Spanish') || v.name.includes('Mexico'))));\r\n230:       if (esVoice) utterance.voice = esVoice;\r\n231:       window.speechSynthesis.speak(utterance);\r\n232:     } catch {\r\n233:       // ignore\r\n234:     }\r\n235:   };\r\n236: \r\n237:   // Speech synthesis announcement\r\n238:   const announceAccess = (clientName: string, granted: boolean) => {\r\n239:     if (!config.voiceEnabled || isMuted || typeof window === 'undefined' || !('speechSynthesis' in window)) {\r\n240:       return;\r\n241:     }\r\n242:     try {\r\n243:       window.speechSynthesis.cancel();\r\n244:       const text = granted \r\n245:         ? `Bienvenido ${clientName}, acceso concedido` \r\n246:         : `Acceso restringido para ${clientName}`;\r\n247:       const utterance = new SpeechSynthesisUtterance(text);\r\n248:       utterance.lang = 'es-MX';\r\n249:       utterance.rate = 1.05;\r\n250:       utterance.pitch = 1.0;\r\n251:       utterance.volume = config.soundVolume ?? 0.9;\r\n252:       window.speechSynthesis.speak(utterance);\r\n253:     } catch {\r\n254:       // ignore\r\n255:     }\r\n256:   };\r\n257: \r\n258:   // Handle Registration of New Member\r\n259:   \r\n260:   const handle