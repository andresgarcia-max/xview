     className=\"px-3.5 py-2 bg-rose-500/15 hover:bg-rose-500/25 border border-rose-500/30 disabled:opacity-40 text-rose-400 font-bold text-xs rounded-xl transition-all\"\r\n328:                   title=\"Registrar salida para este socio\"\r\n329:                 >\r\n330:                   Salida\r\n331:                 </button>\r\n332:               </div>\r\n333:             </div>\r\n334: \r\n335: \r\n336: \r\n337:             {/* Quick access history launcher */}\r\n338:             <div className=\"mt-4 pt-3.5 border-t border-gym-border/80 flex items-center justify-between\">\r\n339:               <span className=\"text-xs text-gym-muted flex items-center gap-1.5\">\r\n340:                 <span className=\"w-2 h-2 rounded-full bg-emerald-400 animate-pulse\" />\r\n341:                 <span>Accesos hoy: <strong className=\"text-white font-mono\">{accessLogs.length}</strong></span>\r\n342:               </span>\r\n343:               <button\r\n344:                 onClick={() => setIsHistoryModalOpen(true)}\r\n345:                 className=\"flex items-center gap-1.5 text-xs font-bold text-amber-400 hover:text-amber-300 bg-amber-500/10 hover:bg-amber-500/20 border border-amber-500/30 px-3 py-1.5 rounded-xl transition-all\"\r\n346:               >\r\n347:                 <Clock className=\"w-3.5 h-3.5\" />\r\n348:                 <span>Ver desglose completo &rarr;</span>\r\n349:               </button>\r\n350:             </div>\r\n351: \r\n352:           </div>\r\n353: \r\n354:       </div>\r\n355: \r\n356:       {/* Detailed Access Breakdown Modal */}\r\n357:       <AccessHistory \r\n358:         isOpen={isHistoryModalOpen} \r\n359:         onClose={() => setIsHistoryModalOpen(false)} \r\n360:       />\r\n361: \r\n362:     </div>\r\n363:   );\r\n364: };\r"}
