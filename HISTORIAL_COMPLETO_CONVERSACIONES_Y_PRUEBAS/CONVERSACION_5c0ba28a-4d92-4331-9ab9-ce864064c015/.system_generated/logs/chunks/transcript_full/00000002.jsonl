d === 'card' \r\n303:         ? 'Tarjeta' \r\n304:         : 'Transferencia / SINPE';\r\n305: \r\n306:     const clientData: Partial<Client> = {\r\n307:       id: memberId,\r\n308:       fullName: trimmedName,\r\n309:       documentId: newClientId.trim() || `${Math.floor(10000000 + Math.random() * 90000000)}`,\r\n310:       email: finalEmail,\r\n311:       phone: newClientPhone.trim() || '+52 55 0000 0000',\r\n312:       birthDate: finalBirthDate,\r\n313:       avatarUrl: getGymAvatar(trimmedName),\r\n314:       biometricRegistered: newClientFingerprintEnrolled,\r\n315:       biometricHash: `BIO_HASH_${memberId}`,\r\n316:       biometricTemplate: `FP_THUMB_RIGHT_${memberId}`,\r\n317:       membership: {\r\n318:         planType,\r\n319:         planName,\r\n320:         startDate: new Date().toISOString().slice(0, 10),\r\n321:         endDate: new Date(Date.now() + durationDays * 24 * 60 * 60 * 1000).toISOString().slice(0, 10),\r\n322:         price: planPrice,\r\n323:         status: 'active',\r\n324:         daysRemaining: durationDays,\r\n325:       },\r\n326:       medicalNotes: `Inscripción desde Terminal. Edad: ${newClientAge || 'N/A'}. Método de pago: ${paymentLabel}.`\r\n327:     };\r\n328: \r\n329:     if (addMember) {\r\n330:       addMember(clientData, newClientPaymentMethod);\r\n331:     } else {\r\n332:       const fullMember: any = {\r\n333:         ...clientData,\r\n334:         name: trimmedName,\r\n335:         status: 'active',\r\n336:         startDate: new Date().toISOString(),\r\n337:         endDate: new Date(Date.now() + durationDays * 24 * 60 * 60 * 1000).toISOString(),\r\n338:         daysRemaining: durationDays,\r\n339:         biometricEnrolled: newClientFingerprintEnrolled,\r\n340:         biometrics: {\r\n341:           enrolled: newClientFingerprintEnrolled,\r\n342:           template: 'simulated_template_' + Date.now(),\r\n343:           registeredAt: new Date().toISOString(),\r\n344:           quality: 95\r\n345:         }\r\n346:       };\r\n347:       replaceMembers([fullMember, ...members]);\r\n348:     }\r\n349: \r\n350:     setShowNewMemberModal(false);\r\n351:     setNewClientName('');\r\n352:     setNewClientBirthDate('');\r\n353:     setNewClientAge('');\r\n354:     setNewClientEmail('');\r\n355:     setNewClientId('');\r\n356:     setNewClientPhone('');\r\n357:     setNewClientPaymentMethod('cash');\r\n358:     setNewClientFingerprintEnrolled(false);\r\n359: \r\n360:     // Announce out loud as requested: \"Por favor diríjase al encargado\"\r\n361:     speakCustomMessage(\"Por favor diríjase al encargado\");\r\n362: \r\n363:     // Display welcome banner on screen & trigger turnstile\r\n364:     setScanStatus('granted');\r\n365:     setLastVerifiedClient({\r\n366:       name: trimmedName,\r\n367:       plan: planName,\r\n368:       daysRemaining: durationDays,\r\n369:       reason: 'Registro completado • Por favor diríjase al encargado',\r\n370:       avatarUrl: getGymAvatar(trimmedName),\r\n371:       status: 'granted',\r\n372:     });\r\n373: \r\n374:     triggerTurnstileRelay(config.relayPulseDurationSeconds || 5);\r\n375:     if (!isMuted) sounds.playAccessGranted();\r\n376:     try {\r\n377:       confetti({\r\n378:         particleCount: 55,\r\n379:         spread: 70,\r\n380:         origin: { y: 0.5, x: 0.5 }\r\n381:       });\r\n382:     } catch {}\r\n383: \r\n384:     setTimeout(() => {\r\n385:       setScanStatus('idle');\r\n386:       setLastVerifiedClient(null);\r\n387:     }, 6000);\r\n388:   };\r\n389: \r\n390:   // Handle Visit / Day Pass\r\n391:   const handleRegisterVisit = () => {\r\n392:     const name = visitClientName.trim() || 'Visitante del Día';\r\n393: \r\n394:     setScanStatus('granted');\r\n395:     setLastVerifiedClient({\r\n396:       name: name,\r\n397:       plan: 'Pase por 1 Día',\r\n398:       reason: 'Pase de Visita Concedido',\r\n399:       status: 'granted',\r\n400:       daysRemaining: 1\r\n401:     });\r\n402: \r\n403:     triggerTurnstileRelay(5);\r\n404:     announceAccess(name, true);\r\n405:     sounds.playAccessGranted();\r\n406:     confetti({ particleCount: 70, spread: 60, origin: { y: 0.6 } });\r\n407: \r\n408:     setShowVisitModal(false);\r\n409:     setVisitClientName('');\r\n410:     setTimeout(() => { setScanStatus('idle'); setLastVerifiedClient(null); }, 5000);\r\n411:   };\r\n412: \r\n413:   // Turnstile relay pulse simulator\r\n414:   const triggerTurnstileRelay = (seconds: number) => {\r\n415:     if (relayTimerRef.current) {\r\n416:       clearInterval(relayTimerRef.current);\r\n417:     }\r\n418:     setRelayRemainingSeconds(seconds);\r\n419:     relayTimerRef.current = window.setInterval(() => {\r\n420:       setRelayRemainingSeconds(prev => {\r\n421:         if (prev <= 1) {\r\n422:           if (relayTimerRef.current) clearInterval(relayTimerRef.current);\r\n423:           return 0;\r\n424:         }\r\n425:         return prev - 1;\r\n426:       });\r\n427:     }, 1000);\r\n428:   };\r\n429: \r\n430:   // Main scan execution\r\n431:   const executeScan = (identifier: string) => {\r\n432:     if (scanStatus === 'scanning') return;\r\n433:     \r\n434:     if (!isMuted) {\r\n435:       sounds.unlock();\r\n436:       sounds.playScanBlip();\r\n437:     }\r\n438:     setScanStatus('scanning');\r\n439:     setLastVerifiedClient(null);\r\n440: \r\n441:     // Refresh member list from server in parallel during the scan animation\r\n442:     const syncPromise = syncWithServer().catch(() => {});\r\n443: \r\n444:     setTimeout(async () => {\r\n445:       await Promise.race([\r\n446:         syncPromise,\r\n447:         new Promise(resolve => setTimeout(resolve, 600))\r\n448:       ]);\r\n449:       const result = verifyBiometricAccess(identifier);\r\n450:       \r\n451:       if (result.granted) {\r\n452:         if (!isMuted) sounds.playAccessGranted();\r\n453:         const quote = getRandomMotivationalQuote(currentQuote);\r\n454:         setCurrentQuote(quote);\r\n455:         \r\n456:         triggerTurnstileRelay(config.relayPulseDurationSeconds || 4);\r\n457: \r\n458:         if (result.client) {\r\n459:           announceAccess(result.client.fullName, true);\r\n460:           setLastVerifiedClient({\r\n461:             name: result.client.fullName,\r\n462:             plan: result.client.membership.planName,\r\n463:             daysRemaining: result.client.membership.daysRemaining,\r\n464:             reason: result.reason,\r\n465:             avatarUrl: getGymAvatar(result.client.fullName, result.client.avatarUrl),\r\n466:             status: 'granted',\r\n467:           });\r\n468:         }\r\n469: \r\n470:         try {\r\n471:           confetti({\r\n472:             particleCount: 45,\r\n473:             spread: 70,\r\n474:             origin: { y: 0.5, x: 0.5 },\r\n475:             colors: ['#FFFFFF', '#E4E4E7', '#A1A1AA', '#F4F4F6'],\r\n476:           });\r\n477:         } catch {\r\n478:           // ignore\r\n479:         }\r\n480:       } else {\r\n481:         if (!isMuted) sounds.playAccessDenied();\r\n482:         if (result.client) {\r\n483:           announceAccess(result.client.fullName, false);\r\n484:           setLastVerifiedClient({\r\n485:             name: result.client.fullName,\r\n486:             plan: result.client.membership.planName,\r\n487:             daysRemaining: result.client.membership.daysRemaining,\r\n488:             reason: result.reason,\r\n489:             avatarUrl: getGymAvatar(result.client.fullName, result.client.avatarUrl),\r\n490:             status: 'denied',\r\n491:           });\r\n492:         } else {\r\n493:           announceAccess('Socio no encontrado', false);\r\n494:           setLastVerifiedClient({\r\n495:             name: 'Huella / Credencial Desconocida',\r\n496:             plan: 'Sin Membresía',\r\n497:             reason: result.reason || 'No registrado en la base de datos',\r\n498:             status: 'denied',\r\n499:           });\r\n500:         }\r\n501:       }\r\n502: \r\n503:       setScanStatus(result.granted ? 'granted' : 'denied');\r\n504: \r\n505:       // Return to idle\r\n506:       setTimeout(() => {\r\n507:         setScanStatus('idle');\r\n508:         setLastVerifiedClient(null);\r\n509:       }, 4500);\r\n510:     }, 850);\r\n511:   };\r\n512: \r\n513:   // Direct sensor pad click (quick scan Carlos Mendoza MEM-001 or current search query)\r\n514:   const handleDirectPadClick = () => {\r\n515:     if (searchQuery.trim()) {\r\n516:       executeScan(searchQuery.trim());\r\n517:       setSearchQuery('');\r\n518:     } else {\r\n519:       executeScan('MEM-001');\r\n520:     }\r\n521:   };\r\n522: \r\n523:   // Global Keyboard listener for USB Barcode / RFID scanner guns\r\n524:   useEffect(() => {\r\n525:     const handleGlobalKeyDown = (e: KeyboardEvent) => {\r\n526:     if (e.key === 'Escape') {\r\n527:       if (showNewMemberModal || showVisitModal || showDirectAccessModal || isConfigModalOpen || isHistoryModalOpen) {\r\n528:         setShowNewMemberModal(false);\r\n529:         setShowVisitModal(false);\r\n530:         setShowDirectAccessModal(false);\r\n531:         setIsConfigModalOpen(false);\r\n532:         setIsHistoryModalOpen(false);\r\n533:         return;\r\n534:       }\r\n535:       if (document.fullscreenElement || isFullScreen) {\r\n536:         if (document.fullscreenElement) {\r\n537:           document.exitFullscreen().catch(() => {});\r\n538:         }\r\n539:         setIsFullScreen(false);\r\n540:         if (onExitFullScreen) onExitFullScreen();\r\n541:       }\r\n542:       return;\r\n543:     }\r\n544: \r\n545:       // Don't intercept if user is actively typing in a standard input or textarea\r\n546:       const target = e.target as HTMLElement;\r\n547:       if (target && (target.tagName === 'INPUT' || target.tagName === 'TEXTAREA')) {\r\n548:         return;\r\n549:       }\r\n550: \r\n551:       const now = Date.now();\r\n552:       // Hardware barcode scanners send keystrokes extremely rapidly (< 50ms between keys)\r\n553:       if (now - lastKeyTimeRef.current > 300) {\r\n554:         keyBufferRef.current = '';\r\n555:       }\r\n556:       lastKeyTimeRef.current = now;\r\n557: \r\n558:       if (e.key === 'Enter') {\r\n559:         const scannedCode = keyBufferRef.current.trim();\r\n560:         if (scannedCode.length >= 2) {\r\n561:           executeScan(scannedCode);\r\n562:         }\r\n563:         keyBufferRef.current = '';\r\n564:       } else if (e.key.length === 1) {\r\n565:         keyBufferRef.current += e.key;\r\n566:       }\r\n567:     };\r\n568: \r\n569:     window.addEventListener('keydown', handleGlobalKeyDown);\r\n570:     return () => window.removeEventListener('keydown', handleGlobalKeyDown);\r\n571:   }, [scanStatus]);\r\n572: \r\n573:   \r\n574:   useEffect(() => {\r\n575:     const handleFullscreenChange = () => {\r\n576:       const isNowFull = !!document.fullscreenElement;\r\n577:       setIsFullScreen(isNowFull);\r\n578:       if (!isNowFull && onExitFullScreen) {\r\n579:         onExitFullScreen();\r\n580:       }\r\n581:     };\r\n582: \r\n583:     document.addEventListener('fullscreenchange', handleFullscreenChange);\r\n584:     document.addEventListener('webkitfullscreenchange', handleFullscreenChange);\r\n585:     document.addEventListener('mozfullscreenchange', handleFullscreenChange);\r\n586:     document.addEventListener('MSFullscreenChange', handleFullscreenChange);\r\n587: \r\n588:     return () => {\r\n589:       document.removeEventListener('fullscreenchange', handleFullscreenChange);\r\n590:       document.removeEventListener('webkitfullscreenchange', handleFullscreenChange);\r\n591:       document.removeEventListener('mozfullscreenchange', handleFullscreenChange);\r\n592:       document.removeEventListener('MSFullscreenChange', handleFullscreenChange);\r\n593:     };\r\n594:   }, [onExitFullScreen]);\r\n595: \r\n596:   // Fullscreen / Kiosk toggle\r\n597:   const toggleBackground = () => {\r\n598:     const nextBg = bg