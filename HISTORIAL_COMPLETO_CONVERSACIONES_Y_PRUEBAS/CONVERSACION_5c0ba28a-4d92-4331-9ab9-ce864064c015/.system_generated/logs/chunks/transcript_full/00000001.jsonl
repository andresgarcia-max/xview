{"step_index":45,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-10-23T23:32:25Z","content":"Created At: 2026-10-23T16:32:25-07:00\nCompleted At: 2026-10-23T16:32:26-07:00\nShowing lines 1-150 of 156\n1: import json\n2: from django.shortcuts import render\n3: from django.http import JsonResponse\n4: from django.views.decorators.http import require_http_methods\n5: from django.contrib.auth.decorators import login_required\n6: from django.utils import timezone\n7: from ..models import CustomUser, AccessLog\n8: \n9: @require_http_methods([\"POST\"])\n10: def process_qr_scan(request):\n11:     \"\"\"\n12:     Procesa el escaneo de QR y registra el acceso del usuario.\n13:     CORREGIDO: Usa rango de fechas para evitar error de timezone en MySQL.\n14:     \"\"\"\n15:     try:\n16:         # Obtener datos del QR\n17:         if request.content_type == 'application/json':\n18:             data = json.loads(request.body)\n19:         else:\n20:             data = request.POST\n21:         \n22:         qr_data = data.get('qr_data')\n23:         \n24:         if not qr_data:\n25:             return JsonResponse({'success': False, 'error': 'No se proporcionó información del QR'}, status=400)\n26:         \n27:         # --- PARSEO DE DATOS (Igual que antes) ---\n28:         user_id, qr_id, rut = None, None, None\n29:         try:\n30:             if isinstance(qr_data, str):\n31:                 import ast\n32:                 qr_dict = ast.literal_eval(qr_data.strip())\n33:                 user_id = qr_dict.get('user_id')\n34:                 qr_id = qr_dict.get('qr_id')\n35:                 rut = qr_dict.get('rut')\n36:             elif isinstance(qr_data, dict):\n37:                 user_id = qr_data.get('user_id')\n38:                 qr_id = qr_data.get('qr_id')\n39:                 rut = qr_data.get('rut')\n40:             else:\n41:                 qr_dict = json.loads(qr_data)\n42:                 user_id = qr_dict.get('user_id')\n43:                 qr_id = qr_dict.get('qr_id')\n44:                 rut = qr_dict.get('rut')\n45:                 \n46:             if not user_id or not qr_id or not rut:\n47:                 raise ValueError(\"Datos incompletos\")\n48:         except Exception:\n49:             return JsonResponse({'success': False, 'error': 'Formato QR inválido'}, status=400)\n50:         \n51:         # Buscar usuario\n52:         try:\n53:             user = CustomUser.objects.get(id=user_id, rut=rut, qr_unique_id=qr_id)\n54:         except CustomUser.DoesNotExist:\n55:             return JsonResponse({\n56:                 'success': False, \n57:                 'status': 'denied', \n58:                 'error': 'Usuario no encontrado o QR inválido',\n59:                 'user': {'name': 'Desconocido', 'rut': rut or 'N/A'}\n60:             }, status=404)\n61:         \n62:         # Verificar membresía\n63:         membership = user.get_active_membership()\n64:         if not membership or not membership.is_valid():\n65:             AccessLog.objects.create(user=user, status='denied', membership=membership, denial_reason='Membresía vencida')\n66:             return JsonResponse({\n67:                 'success': False,\n68:                 'status': 'denied',\n69:                 'error': 'Membresía vencida o inexistente',\n70:                 'user': {'name': user.get_full_name(), 'rut': user.rut}\n71:             })\n72:         \n73:         # CORRECCIÓN PRINCIPAL: FILTRO POR RANGO HORARIO\n74:         \n75:         # 1. Obtenemos la hora actual en Chile\n76:         now_chile = timezone.localtime(timezone.now())\n77:         \n78:         # 2. Definimos el inicio (00:00:00) y fin (23:59:59) del día actual\n79:         start_of_day = now_chile.replace(hour=0, minute=0, second=0, microsecond=0)\n80:         end_of_day = now_chile.replace(hour=23, minute=59, second=59, microsecond=999999)\n81: \n82:         # 3. Buscamos registros usando el rango (__range) en lugar de __date\n83:         already_accessed_today = AccessLog.objects.filter(\n84:             user=user,\n85:             timestamp__range=(start_of_day, end_of_day),\n86:             status='allowed'\n87:         ).exists()\n88:         \n89:         if already_accessed_today:\n90:             # Obtener el registro para mostrar la hora\n91:             todays_access = AccessLog.objects.filter(\n92:                 user=user,\n93:                 timestamp__range=(start_of_day, end_of_day),\n94:                 status='allowed'\n95:             ).first()\n96:             \n97:             # Estadísticas\n98:             primer_dia_mes = now_chile.replace(day=1, hour=0, minute=0, second=0)\n99:             monthly_access = AccessLog.objects.filter(user=user, timestamp__gte=primer_dia_mes, status='allowed').count()\n100:             \n101:             return JsonResponse({\n102:                 'success': False,\n103:                 'status': 'denied',\n104:                 'error': f'Ya registraste entrada a las {timezone.localtime(todays_access.timestamp).strftime(\"%H:%M:%S\")}',\n105:                 'already_accessed_today': True,\n106:                 'user': {\n107:                     'name': user.get_full_name(),\n108:                     'rut': user.rut,\n109:                     'monthly_access': monthly_access,\n110:                     'access_time': timezone.localtime(todays_access.timestamp).strftime('%H:%M:%S'),\n111:                     # ✅ AGREGADO: Claves exactas que pide QRScanner.js\n112:                     'membership_plan': membership.plan.name if membership.plan else 'Sin Plan',\n113:                     # Usamos formato YYYY-MM-DD para que JavaScript no de \"Invalid Date\"\n114:                     'membership_end': membership.end_date.strftime('%Y-%m-%d') if membership.end_date else None\n115:                 }\n116:             }, status=403)\n117:         \n118:         # CREAR NUEVO REGISTRO\n119:         access_log = AccessLog.objects.create(\n120:             user=user,\n121:             status='allowed',\n122:             membership=membership\n123:         )\n124:         \n125:         # Estadísticas finales\n126:         primer_dia_mes = now_chile.replace(day=1, hour=0, minute=0, second=0)\n127:         monthly_access = AccessLog.objects.filter(user=user, timestamp__gte=primer_dia_mes, status='allowed').count()\n128: \n129:         return JsonResponse({\n130:             'success': True,\n131:             'status': 'allowed',\n132:             'message': '¡Bienvenido!',\n133:             'already_accessed_today': False,\n134:             'user': {\n135:                 'name': user.get_full_name(),\n136:                 'rut': user.rut,\n137:                 'monthly_access': monthly_access,\n138:                 'access_time': timezone.localtime(access_log.timestamp).strftime('%H:%M:%S'),\n139:                 # ✅ AGREGADO AQUÍ TAMBIÉN\n140:                 'membership_plan': membership.plan.name if membership.plan else 'Sin Plan',\n141:                 'membership_end': membership.end_date.strftime('%Y-%m-%d') if membership.end_date else None\n142:             }\n143:         })\n144:         \n145:     except Exception as e:\n146:         print(f\"Error: {str(e)}\")\n147:         return JsonResponse({'success': False, 'error': str(e)}, status=500)\n148: \n149: @login_required(login_url='inicio_sesion')\n150: def mostrar_Scanner(request):"}
{"step_index":46,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-10-23T23:32:25Z","content":"Created At: 2026-10-23T16:32:25-07:00\nCompleted At: 2026-10-23T16:32:26-07:00\nShowing lines 1-150 of 395\n1: from django.contrib.auth.models import AbstractUser, UserManager\n2: from django.db import models\n3: from django.utils import timezone\n4: from datetime import timedelta\n5: import hashlib\n6: \n7: # --- NUEVAS IMPORTACIONES NECESARIAS ---\n8: import os\n9: from django.db.models.signals import post_delete\n10: from django.dispatch import receiver\n11: # ---------------------------------------\n12: \n13: class CustomUserManager(UserManager):\n14:     \"\"\"Manager personalizado que diferencia entre superusuarios y usuarios normales\"\"\"\n15:     \n16:     def create_superuser(self, username, email=None, password=None, **extra_fields):\n17:         \"\"\"\n18:         Override para crear superusuarios SIN asignarles rol de socio y \n19:         SIN campos obligatorios que no sean necesarios para el admin\n20:         \"\"\"\n21:         extra_fields.setdefault('is_staff', True)\n22:         extra_fields.setdefault('is_superuser', True)\n23:         \n24:         # Los superusuarios NO tienen rol porque NO son parte del sistema de socios\n25:         if 'role' not in extra_fields:\n26:             extra_fields['role'] = None  # Superusuarios sin rol\n27:         \n28:         # Asegurarse de que los campos opcionales sean None\n29:         extra_fields.setdefault('rut', None)\n30:         extra_fields.setdefault('phone', None)\n31:         extra_fields.setdefault('birthdate', None)\n32:         \n33:         if extra_fields.get('is_staff') is not True:\n34:             raise ValueError('Superuser must have is_staff=True.')\n35:         if extra_fields.get('is_superuser') is not True:\n36:             raise ValueError('Superuser must have is_superuser=True.')\n37:         \n38:         return self.create_user(username, email, password, **extra_fields)\n39: \n40: \n41: class CustomUser(AbstractUser):\n42:     \"\"\"Modelo de usuario personalizado que extiende AbstractUser\"\"\"\n43:     \n44:     ROLE_CHOICES = (\n45:         ('admin', 'Administrador'),\n46:         ('moderador', 'Moderador'),\n47:         ('socio', 'Socio'),\n48:     )\n49:     \n50:     objects = CustomUserManager()  # Usar el manager personalizado\n51:     \n52:     # Campos adicionales - TODOS OPCIONALES\n53:     rut = models.CharField(max_length=12, unique=True, verbose_name=\"RUT\", null=True, blank=True)\n54:     phone = models.CharField(max_length=15, verbose_name=\"Teléfono\", null=True, blank=True)\n55:     birthdate = models.DateField(verbose_name=\"Fecha de Nacimiento\", null=True, blank=True)\n56:     role = models.CharField(\n57:         max_length=10, \n58:         choices=ROLE_CHOICES, \n59:         null=True,  # Permite NULL para superusuarios\n60:         blank=True,\n61:         verbose_name=\"Rol\"\n62:     )\n63:     \n64:     # QR Code\n65:     #qr_code = models.ImageField(upload_to='qr_codes/', blank=True, null=True, verbose_name=\"Código QR\")\n66:     qr_unique_id = models.CharField(max_length=64, unique=True, blank=True, null=True, verbose_name=\"ID Único QR\")\n67:     \n68:     # Metadata\n69:     created_at = models.DateTimeField(auto_now_add=True, verbose_name=\"Fecha de Registro\")\n70:     updated_at = models.DateTimeField(auto_now=True, verbose_name=\"Última Actualización\")\n71:     is_active_member = models.BooleanField(default=False, verbose_name=\"Socio Activo\")\n72:     \n73:     # Related names para evitar conflictos\n74:     groups = models.ManyToManyField(\n75:         'auth.Group',\n76:         verbose_name='groups',\n77:         blank=True,\n78:         help_text='The groups this user belongs to.',\n79:         related_name='customuser_set',\n80:         related_query_name='customuser',\n81:     )\n82:     user_permissions = models.ManyToManyField(\n83:         'auth.Permission',\n84:         verbose_name='user permissions',\n85:         blank=True,\n86:         help_text='Specific permissions for this user.',\n87:         related_name='customuser_set',\n88:         related_query_name='customuser',\n89:     )\n90:     \n91:     class Meta:\n92:         verbose_name = \"Usuario\"\n93:         verbose_name_plural = \"Usuarios\"\n94:         ordering = ['-created_at']\n95:     \n96:     def __str__(self):\n97:         if self.is_superuser:\n98:             return f\"SUPERUSER: {self.username}\"\n99:         if self.rut:\n100:             return f\"{self.get_full_name()} ({self.rut})\"\n101:         return self.get_full_name() or self.username\n102:     \n103:     def save(self, *args, **kwargs):\n104:         \"\"\"\n105:         Override del método save.\n106:         IMPORTANTE: NO genera QR ni asigna rol a superusuarios\n107:         \"\"\"\n108:         # Si es superuser, guardar y salir\n109:         if self.is_superuser:\n110:             super().save(*args, **kwargs)\n111:             return\n112:     \n113:         # Generar qr_unique_id si es socio y tiene RUT\n114:         if self.role == 'socio' and self.rut and not self.qr_unique_id:\n115:             unique_string = f\"{self.rut}-{timezone.now().timestamp()}\"\n116:             self.qr_unique_id = hashlib.sha256(unique_string.encode()).hexdigest()\n117:     \n118:         # SIEMPRE hacer el save principal\n119:         super().save(*args, **kwargs)\n120:     \n121: \n122:     def generate_qr_code(self):\n123:         \"\"\"\n124:         Método de compatibilidad: asegura que exista el qr_unique_id.\n125:         Ya no genera imagen física.\n126:         \"\"\"\n127:         if self.role == 'socio' and self.rut and not self.qr_unique_id:\n128:             self.save() # El save() generará el ID\n129: \n130:     def get_qr_data(self):\n131:         \"\"\"Retorna el string exacto que se debe codificar en el QR\"\"\"\n132:         if not self.qr_unique_id:\n133:             return None\n134:             \n135:         data_dict = {\n136:             'user_id': self.id,\n137:             'qr_id': self.qr_unique_id,\n138:             'rut': self.rut\n139:         }\n140:         return str(data_dict) # Retorna la representación en texto del diccionario\n141:     \n142:     def get_active_membership(self):\n143:         \"\"\"Retorna la membresía activa del usuario o None.\"\"\"\n144:         if self.is_superuser:\n145:             return None\n146:         return self.memberships.filter(\n147:             is_active=True,\n148:             end_date__gt=timezone.now().date()\n149:         ).first()\n150:     "}
