torage.setItem('legends_terminal_bg_version', 'v7_fixed_bright_8k');\r\n41:       localStorage.setItem('legends_terminal_bg', gymBg);\r\n42:       return gymBg;\r\n43:     }\r\n44:     return localStorage.getItem('legends_terminal_bg') || gymBg;\r\n45:   });\r\n46: \r\n47:   // Trigger simulated scan\r\n48:   const executeScan = (identifier: string) => {\r\n49:     if (scanStatus === 'scanning') return;\r\n50:     sounds.unlock();\r\n51:     sounds.playScanBlip();\r\n52:     setScanStatus('scanning');\r\n53:     setVerifiedClient(null);\r\n54: \r\n55:     setTimeout(() => {\r\n56:       const result = verifyBiometricAccess(identifier);\r\n57:       \r\n58:       if (result.client) {\r\n59:         setVerifiedClient({\r\n60:           name: result.client.fullName,\r\n61:           avatarUrl: getGymAvatar(result.client.fullName, result.client.avatarUrl),\r\n62:           planName: result.client.membership.planName,\r\n63:         });\r\n64:       } else {\r\n65:         setVerifiedClient(null);\r\n66:       }\r\n67: \r\n68:       if (result.granted) {\r\n69:         sounds.playAccessGranted();\r\n70:         const quote = getRandomMotivationalQuote(currentQuote);\r\n71:         setCurrentQuote(quote);\r\n72:         try {\r\n73:           confetti({\r\n74:             particleCount: 40,\r\n75:             spread: 65,\r\n76:             origin: { y: 0.5, x: 0.35 },\r\n77:             colors: ['#FFB800', '#10B981', '#F59E0B', '#FFFFFF'],\r\n78:           });\r\n79:         } catch {\r\n80:           // ignore if canvas is not supported\r\n81:         }\r\n82:       } else {\r\n83:         sounds.playAccessDenied();\r\n84:       }\r\n85: \r\n86:       setScanStatus(result.granted ? 'granted' : 'denied');\r\n87: \r\n88:       // Return to idle after 4.5 seconds\r\n89:       setTimeout(() => {\r\n90:         setScanStatus('idle');\r\n91:         setVerifiedClient(null);\r\n92:       }, 4500);\r\n93:     }, 1100);\r\n94:   };\r\n95: \r\n96:   // Default quick scan if user just clicks the fingerprint sensor directly\r\n97:   const handleDirectPadClick = () => {\r\n98:     // If there is a search query, use it; otherwise test with active member 1\r\n99:     if (searchQuery.trim()) {\r\n100:       executeScan(searchQuery.trim());\r\n101:     } else {\r\n102:       executeScan('MEM-001'); // Carlos Mendoza\r\n103:     }\r\n104:   };\r\n105: \r\n106:   const toggleFullScreen = () => {\r\n107:     if (!document.fullscreenElement) {\r\n108:       document.documentElement.requestFullscreen().catch(() => {});\r\n109:       setIsFullScreen(true);\r\n110:     } else {\r\n111:       document.exitFullscreen().catch(() => {});\r\n112:       setIsFullScreen(false);\r\n113:     }\r\n114:   };\r\n115: \r\n116:   \r\n117:   // Modo Pantalla Completa: Cubre toda la pantalla al 100% y oculta todos los menús\r\n118:   if (isFullScreen) {\r\n119:     return (\r\n120:       <div className=\"fixed inset-0 z-50 bg-black w-screen h-screen overflow-hidden\">\r\n121:         <IndependentTerminalApp \r\n122:           isEmbeddedFullScreen={true} \r\n123:           onExitFullScreen={() => {\r\n124:             if (document.fullscreenElement) {\r\n125:               document.exitFullscreen().catch(() => {});\r\n126:             }\r\n127:             setIsFullScreen(false);\r\n128:           }} \r\n129:         />\r\n130:       </div>\r\n131:     );\r\n132:   }\r\n133: \r\n134:   return (\r\n135:     <div className={`space-y-6 relative rounded-3xl overflow-hidden p-3 sm:p-5 ${isFullScreen ? 'p-6 min-h-screen' : ''}`}>\r\n136:       \r\n137:             \r\n138: \r\n139:       {/* Real Gym Background Photo */}\r\n140:       <div className=\"absolute inset-0 pointer-events-none z-0 overflow-hidden rounded-3xl\">\r\n141:         <img\n142:           src={bgImage}\n143:           alt=\"Fitness Legends Gym Background\"\n144:           style={{\n145:             filter: 'brightness(1.04) contrast(1.06) saturate(1.06)',\n146:             objectPosition: 'center center',\n147:           }}\n148:           className=\"w-full h-full object-cover object-center\"\n149:         />\n150:         <div className=\"absolute inset-0 bg-gradient-to-t from-black/50 via-transparent to-black/20 pointer-events-none\" />\r\n151:         {/* Soft Eye-Care anti-glare shield so neon lights do not hurt the eyes */}\r\n152:         <div className=\"absolute inset-0 bg-slate-950/20 backdrop-blur-[0.5px] pointer-events-none\" />\r\n153: \r\n154:       </div>\r\n155: \r\n156:       {/* Top Banner / Mode Header */}\r\n157:       <div className=\"flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 p-3 relative z-10\">\r\n158:         <div>\r\n159:           <div className=\"flex items-center gap-2\">\r\n160:             <span className=\"w-2.5 h-2.5 rounded-full bg-emerald-400 animate-ping\" />\r\n161:             <h1 className=\"text-xl font-black text-white tracking-wide uppercase\">\r\n162:               Control de Acceso\r\n163:             </h1>\r\n164:             <span className=\"text-xs bg-amber-500/20 text-amber-400 border border-amber-500/30 px-2 py-0.5 rounded-md font-bold\">\r\n165:               Lector Activo\r\n166:             </span>\r\n167:           </div>\r\n168:           <p className=\"text-sm text-gym-muted mt-1\">\r\n169:             Validación instantánea de huella digital y vigencia de cuota en el acceso principal.\r\n170:           </p>\r\n171:         </div>\r\n172: \r\n173:         <div className=\"flex items-center gap-3 flex-wrap\">\r\n174:           {/* Live Occupancy Pill */}\r\n175:           <div className=\"flex items-center gap-2 px-3 py-1.5 rounded-xl bg-gym-surface border border-gym-border text-xs\">\r\n176:             <Users className=\"w-3.5 h-3.5 text-emerald-400\" />\r\n177:             <span className=\"text-gym-muted\">Aforo Sala:</span>\r\n178:             <span className=\"font-bold text-white font-mono\">{activeBranch.currentOccupancy} / {activeBranch.maxCapacity}</span>\r\n179:          