e)...');\n48:   console.log('======================================================');\n49: \n50:   cleanDirFiles(path.join(rootLegendsDir, 'dist', 'assets'));\n51: \n52:   const tscRes = spawnSync(nodeBin, ['node_modules/typescript/bin/tsc', '-b'], {\n53:     cwd: rootLegendsDir,\n54:     env: nodeEnv,\n55:     stdio: 'inherit'\n56:   });\n57:   if (tscRes.status !== 0) {\n58:     throw new Error('Error en compilación TypeScript');\n59:   }\n60: \n61:   const viteRes = spawnSync(nodeBin, ['node_modules/vite/bin/vite.js', 'build', '--emptyOutDir', 'false'], {\n62:     cwd: rootLegendsDir,\n63:     env: nodeEnv,\n64:     stdio: 'inherit'\n65:   });\n66:   if (viteRes.status !== 0) {\n67:     throw new Error('Error en compilación Vite');\n68:   }\n69: \n70:   console.log('\\n======================================================');\n71:   console.log('2. Generando versión HTML autocontenida actualizada...');\n72:   console.log('======================================================');\n73:   spawnSync(nodeBin, ['scripts/build-single-html.cjs'], {\n74:     cwd: rootLegendsDir,\n75:     env: nodeEnv,\n76:     stdio: 'inherit'\n77:   });\n78: \n79:   console.log('\\n======================================================');\n80:   console.log('3. Actualizando Ejecutable Nativo en release/...');\n81:   console.log('======================================================');\n82: \n83:   const outDir = path.join(rootLegendsDir, 'release', 'FITNESS_LEGENDS_TERMINAL-win32-x64');\n84:   const appDir = path.join(outDir, 'resources', 'app');\n85: \n86:   // Clean old hashed assets in release/resources/app/dist/assets\n87:   cleanDirFiles(path.join(appDir, 'dist', 'assets'));\n88: \n89:   // Sync updated build artifacts into release/resources/app\n90:   copyFilesRecursive(path.join(rootLegendsDir, 'dist'), path.join(appDir, 'dist'));\n91:   copyFilesRecursive(path.join(rootLegendsDir, 'electron'), path.join(appDir, 'electron'));\n92:   copyFilesRecursive(path.join(rootLegendsDir, '