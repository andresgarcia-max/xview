] = useState('');\r\n344:       const [searchQuery, setSearchQuery] = useState('');\r\n345:       const [isMuted, setIsMuted] = useState(false);\r\n346:       const [isFullScreen, setIsFullScreen] = useState(false);\r\n347:       const [relaySeconds, setRelaySeconds] = useState(0);\r\n348: \r\n349:       // Server Sync URL\r\n350:       const [serverUrl, setServerUrl] = useState(() => {\r\n351:         return localStorage.getItem('legends_server_url') || 'https://legends-gym-gold.vercel.app';\r\n352:       });\r\n353:       const [serverOnline, setServerOnline] = useState(false);\r\n354: \r\n355:       const relayTimerRef = useRef(null);\r\n356:       const keyBufferRef = useRef('');\r\n357:       const lastKeyTimeRef = useRef(0);\r\n358: \r\n359:       // Save access logs\r\n360:       useEffect(() => {\r\n361:         try {\r\n362:           localStorage.setItem('legends_access_logs_v1', JSON.stringify(accessLogs));\r\n363:         } catch {}\r\n364:       }, [accessLogs]);\r\n365: \r\n366:       const toggleBackground = () => {\r\n367:         const next = (currentBgIndex + 1) % 3;\r\n368:         setCurrentBgIndex(next);\r\n369:         localStorage.setItem('legends_bg_choice', String(next));\r\n370:       };\r\n371: \r\n372:       // Check server health across Vercel Cloud and LAN\r\n373:       const checkServer = useCallback(async () => {\r\n374:         const candidateUrls = [serverUrl, 'https://legends-gym-gold.vercel.app', 'http://localhost:3001'];\r\n375:         for (const url of candidateUrls) {\r\n376:           try {\r\n377:             const controller = new AbortController();\r\n378:             const timer = setTimeout(() => controller.abort(), 3000);\r\n379:             const res = await fetch(\\`\\${url}/api/sync/status\\`, { mode: 'cors', signal: controller.signal });\r\n380:             clearTimeout(timer);\r\n381:             if (res.ok) {\r\n382:               setServerUrl(url);\r\n383:               setServerOnline(true);\r\n384:               const mRes = await fetch(\\`\\${url}/api/sync/members\\`);\r\n385:               if (mRes.ok) {\r\n386:                 const mData = await mRes.json();\r\n387:                 if (Array.isArray(mData.members) && mData.members.length > 0) {\r\n388:                   setMembers(mData.members);\r\n389:                   try { localStorage.setItem('legends_members_v1', JSON.stringify(mData.members)); } catch {}\r\n390:                 }\r\n391:               }\r\n392:               return;\r\n393:             }\r\n394:           } catch {}\r\n395:         }\r\n396:         setServerOnline(false);\r\n397:       }, [serverUrl]);\r\n398: \r\n399:       // Multi-Window & Background Sync: BroadcastChannel + storage event + 1.5s live sync\r\n400:       useEffect(() => {\r\n401:         let channel = null;\r\n402:         try {\r\n403:           channel = new BroadcastChannel('legends_gym_sync_bus_v1');\r\n404:           channel.onmessage = (event) => {\r\n405:             const data = event.data;\r\n406:             if (!data) return;\r\n407:             if (data.type === 'MEMBER_ADDED' && data.member) {\r\n408:               setMembers(prev => {\r\n409:                 const next = [data.member, ...prev.filter(m => m.id !== data.member.id)];\r\n410:                 try { localStorage.setItem('legends_members_v1', JSON.stringify(next)); } catch {}\r\n411:                 return next;\r\n412:               });\r\n413:             } else if (data.type === 'MEMBER_UPDATED' && data.member) {\r\n414:               setMembers(prev => {\r\n415:                 const next = prev.map(m => m.id === data.member.id ? { ...m, ...data.member } : m);\r\n416:                 try { localStorage.setItem('legends_members_v1', JSON.stringify(next)); } catch {}\r\n417:                 return next;\r\n418:               });\r\n419:             } else if (data.type === 'MEMBER_DELETED' && data.memberId) {\r\n420:               setMembers(prev => {\r\n421:                 const next = prev.filter(m => m.id !== data.memberId);\r\n422:                 try { localStorage.setItem('legends_members_v1', JSON.stringify(next)); } catch {}\r\n423:                 return next;\r\n424:               });\r\n425:             } else if (data.type === 'MEMBERS_REPLACED' && Array.isArray(data.members)) {\r\n426:               setMembers(data.members);\r\n427:               try { localStorage.setItem('legends_members_v1', JSON.stringify(data.members)); } catch {}\r\n428:             }\r\n429:           };\r\n430:         } catch {}\r\n431: \r\n432:         const handleStorage = (e) => {\r\n433:           if (e.key === 'legends_members_v1' && e.newValue) {\r\n434:             try {\r\n435:               const parsed = JSON.parse(e.newValue);\r\n436:               if (Array.isArray(parsed) && parsed.length > 0) {\r\n437:                 setMembers(parsed);\r\n438:               }\r\n439:             } catch {}\r\n440:           }\r\n441:         };\r\n442: \r\n443:         const pollLocalMembers = setInterval(() => {\r\n444:           try {\r\n445:             const raw = localStorage.getItem('legends_members_v1');\r\n446:             if (raw) {\r\n447:               const parsed = JSON.parse(raw);\r\n448:               if (Array.isArray(parsed) && parsed.length > 0) {\r\n449:                 setMembers(prev => {\r\n450:                   if (prev.length !== parsed.length) return parsed;\r\n451:                   return prev;\r\n452:                 });\r\n453:               }\r\n454:             }\r\n455:           } catch {}\r\n456:         }, 1500);\r\n457: \r\n458:         window.addEventListener('storage', handleStorage);\r\n459:         return () => {\r\n460:           window.removeEventListener('storage', handleStorage);\r\n461:           clearInterval(pollLocalMembers);\r\n462:           if (channel) channel.close();\r\n463:         };\r\n464:       }, []);\r\n465: \r\n466:       useEffect(() => {\r\n467:         checkServer();\r\n468:         const interval = setInterval(checkServer, 5000);\r\n469:         return () => clearInterval(interval);\r\n470:       }, [checkServer]);\r\n471: \r\n472:       // Turnstile relay pulse\r\n473:       const triggerTurnstile = (sec = 4) => {\r\n474:         if (relayTimerRef.current) clearInterval(relayTimerRef.current);\r\n475:         setRelaySeconds(sec);\r\n476:         relayTimerRef.current = setInterval(() => {\r\n477:           setRelaySeconds(prev => {\r\n478:             if (prev <= 1) {\r\n479:               clearInterval(relayTimerRef.current);\r\n480:               return 0;\r\n481:             }\r\n482:             return prev - 1;\r\n483:           });\r\n484:         }, 1000);\r\n485:       };\r\n486: \r\n487:       // Execute scan / verify access with multi-attribute normalized matching\r\n488:       const executeScan = (rawIdentifier) => {\r\n489:         const rawStr = String(rawIdentifier || '').trim();\r\n490:         if (!rawStr) return;\r\n491: \r\n492:         setScanStatus('scanning');\r\n493:         setVerifiedClient(null);\r\n494: \r\n495:         // Fetch latest pool directly from state and localStorage\r\n496:         let currentPool = members;\r\n497:         try {\r\n498:           const stored = localStorage.getItem('legends_members_v1');\r\n499:           if (stored) {\r\n500:             const parsed = JSON.parse(stored);\r\n501:             if (Array.isArray(parsed) && parsed.length > 0) currentPool = parsed;\r\n502:           }\r\n503:         } catch {}\r\n504: \r\n505:         const norm = (str) => String(str || '')\r\n506:           .normalize('NFD')\r\n507:           .replace(/[\\u0300-\\u036f]/g, '')\r\n508:           .toLowerCase()\r\n509:           .trim();\r\n510: \r\n511:         const q = norm(rawStr);\r\n512:         const qCompact = q.replace(/[\\s\\-_]/g, '');\r\n513:         const qWords = q.split(/\\s+/).filter(Boolean);\r\n514:         const qDigits = q.replace(/\\D/g, '');\r\n515: \r\n516:         setTimeout(() => {\r\n517:           const found = currentPool.find(m => {\r\n518:             if (!q) return false;\r\n519:             const idNorm = norm(m.id);\r\n520:             const idCompact = idNorm.replace(/[\\s\\-_]/g, '');\r\n521:             const docNorm = norm(m.documentId);\r\n522:             const docCompact = docNorm.replace(/[\\s\\-_]/g, '');\r\n523:             const nameNorm = norm(m.fullName);\r\n524:             const emailNorm = norm(m.email);\r\n525:             const hashNorm = norm(m.biometricHash);\r\n526:             const tplNorm = norm(m.biometricTemplate);\r\n527:             const phoneDigits = String(m.phone || '').replace(/\\D/g, '');\r\n528: \r\n529:             if (hashNorm && hashNorm === q) return true;\r\n530:             if (tplNorm && tplNorm === q) return true;\r\n531:             if (idNorm === q || idCompact === qCompact) return true;\r\n532:             if (docNorm === q || (docCompact && docCompact === qCompact)) return true;\r\n533:             if (emailNorm === q) return true;\r\n534:             if (qDigits.length >= 6 && phoneDigits.endsWith(qDigits)) return true;\r\n535:             if (nameNorm === q || nameNorm.includes(q)) return true;\r\n536:             if (qWords.length > 1 && qWords.every(w => nameNorm.includes(w))) return true;\r\n537:             return false;\r\n538:           });\r\n539: \r\n540:           if (!found) {\r\n541:             setScanStatus('denied');\r\n542:             setVerifiedClient({\r\n543:               name: 'Usuario No Reconocido',\r\n544:               plan: 'Sin Membresía',\r\n545:               reason: 'ID o huella no registrada en el sistema',\r\n546:               status: 'denied',\r\n547:               daysRemaining: 0\r\n548:             });\r\n549:             if (!isMuted) soundManager.playAccessDenied();\r\n550: \r\n551:             const newLog = {\r\n552:               id: 'LOG-' + Date.now(),\r\n553:               clientName: 'Desconocido (' + rawIdentifier + ')',\r\n554:               status: 'denied',\r\n555:               reason: 'No registrado',\r\n556:               timestamp: new Date().toLocaleTimeString('es-MX', { hour: '2-digit', minute: '2-digit', second: '2-digit' })\r\n557:             };\r\n558:             setAccessLogs(prev => [newLog, ...prev.slice(0, 499)]);\r\n559: \r\n560:             setTimeout(() => {\r\n561:               setScanStatus('idle');\r\n562:               setVerifiedClient(null);\r\n563:             }, 3800);\r\n564:             return;\r\n565:           }\r\n566: \r\n567:           const planName = found.membership?.planName || found.plan || 'Mensualidad Estándar';\r\n568:           const days = found.membership?.daysRemaining !== undefined ? found.membership.daysRemaining : (found.daysRemaining !== undefined ? found.daysRemaining : 30);\r\n569:           const isExpired = found.status === 'expired' || days < 0;\r\n570: \r\n571:           if (isExpired) {\r\n572:             setScanStatus('denied');\r\n573:             setVerifiedClient({\r\n574:               name: found.fullName,\r\n575:               plan: planName,\r\n576:               reason: 'Membresía vencida (' + Math.abs(days) + ' días)',\r\n577:               status: 'denied',\r\n578:               daysRemaining: days\r\n579:             });\r\n580:             if (!isMuted) soundManager.playAccessDenied();\r\n581: \r\n582:             const newLog = {\r\n583:               id: 'LOG-' + Date.now(),\r\n584:               clientName: found.fullName,\r\n585:               status: 'denied',\r\n586:               reason: 'Cuota vencida',\r\n587:               timestamp: new Date().toLocaleTimeString('es-MX', { hour: '2-digit', minute: '2-digit', second: '2-digit' })\r\n588:             };\r\n589:             setAccessLogs(prev => [newLog, ...prev.slice(0, 499)]);\r\n590: \r\n591:             setTimeout(() => {\r\n592:               setScanStatus('idle');\r\n593:               setVerifiedClient(null);\r\n594:             }, 4000);\r\n595:           } else {\r\n596:             setScanStatus('granted');\r\n597:             const randomQuote = MOTIVATIONAL_QUOTES[Math.floor(Math.random() * MOTIVATIONAL_QUOTES.length)];\r\n598:             setCurrentQuote(randomQuote);\r\n599: \r\n600:             setVerifiedClient({\r\n601:               name: found.fullName,\r\n602:               plan: planName,\r\n603:               reason: 'Acceso Concedido • ' + days + ' días restantes',\r\n604:               status: 'granted',\r\n605:               daysRemaining: days\r\n606:             });\r\n607: \r\n608:             if (!isMuted) soundManager.playAccessGranted();\r\n609:             triggerTurnstile(4);\r\n610: \r\n611:             try {\r\n612:               confetti({\r\n613:                 particleCount: 45,\r\n614:                 spread: 70,\r\n615:                 origin: { y: 0.6 }\r\n616:               });\r\n617:             } catch {}\r\n618: \r\n619:             const newLog = {\r\n620:               id: 'LOG-' + Date.now(),\r\n621:               clientName: found.fullName,\r\n622:               status: 'granted',\r\n623:               reason: planName,\r\n624:               timestamp: new Date().toLocaleTimeString('es-MX', { hour: '2-digit', minute: '2-digit', second: '2-digit' })\r\n625:             };\r\n626:             setAccessLogs(prev => [newLog, ...prev.slice(0, 499)]);\r\n627: \r\n628:             // Sync with Cloud / LAN server\r\n629:             if (serverOnline) {\r\n630:               fetch(\\`\\${serverUrl}/api/sync/access-log\\`, {\r\n631:                 method: 'POST',\r\n632:                 headers: { 'Content-Type': 'application/json' },\r\n633:                 body: JSON.stringify({ log: { id: newLog.id, clientName: found.fullName, status: newLog.status, reason: newLog.reason, timestamp: new Date().toISOString() } })\r\n634:               }).catch(() => {});\r\n635:             }\r\n636: \r\n637:             setTimeout(() => {\r\n638:               setScanStatus('idle');\r\n639:               setVerifiedClient(null);\r\n640:             }, 4500);\r\n641:           }\r\n642:         }, 300);\r\n643:       };\r\n644: \r\n645:       // Handle Visit / Day Pass\r\n646:       const handleRegisterVisit = () => {\r\n647:         const name = visitClientName.trim() || 'Visitante del Día';\r\n648:         setScanStatus('granted');\r\n649:         setVerifiedClient({\r\n650:           name: name,\r\n651:           plan: 'Pase por 1 Día ($' + visitCost + ')',\r\n652:           reason: 'Pase de Visita Concedido',\r\n653:           status: 'granted',\r\n654:           daysRemaining: 1\r\n655:         });\r\n656: \r\n657:         if (!isMuted) soundManager.playAccessGranted();\r\n658:         triggerTurnstile(4);\r\n659: \r\n660:         const newLog = {\r\n661:           id: 'VISIT-' + Date.now(),\r\n662:           clientName: name,\r\n663:           status: 'granted',\r\n664:           reason: 'Pase Diario ($' + visitCost + ')',\r\n665:           timestamp: new Date().toLocaleTimeString('es-MX', { hour: '2-digit', minute: '2-digit', second: '2-digit' })\r\n666:         };\r\n667:         setAccessLogs(prev => [newLog, ...prev.slice(0, 499)]);\r\n668: \r\n669:         setShowVisitModal(false);\r\n670:         setVisitClientName('');\r\n671: \r\n672:         setTimeout(() => {\r\n673:           setScanStatus('idle');\r\n674:           setVerifiedClient(null);\r\n675:         }, 4500);\r\n676:       };\r\n677: \r\n678:       // Handle New Member Registration\r\n679:       \r\n680:       // Speech synthesis\r\n681:       const speakCustomMessage = (text) => {\r\n682:         if (isMuted || typeof window === 'undefined' || !('speechSynthesis' in window)) return;\r\n683:         try {\r\n684:           window.speechSynthesis.cancel();\r\n685:           const utterance = new SpeechSynthesisUtterance(text);\r\n686:           utterance.lang = 'es-MX';\r\n687:           utterance.rate = 0.95;\r\n688:           utterance.pitch = 1.0;\r\n689:           utterance.volume = 1.0;\r\n690:           const voi