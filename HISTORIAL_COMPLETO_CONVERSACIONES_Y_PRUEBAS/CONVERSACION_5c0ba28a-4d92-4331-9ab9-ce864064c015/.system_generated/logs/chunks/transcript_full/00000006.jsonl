de Acceso' \n      : 'FITNESS LEGENDS GYM - Sistema de Gestión',\n    backgroundColor: '#09090b',\n    icon: appIcon,\n    autoHideMenuBar: true,\n    webPreferences: {\n      preload: path.join(__dirname, 'preload.cjs'),\n      nodeIntegration: false,\n      contextIsolation: true,\n      webSecurity: true,\n    },\n  });\n\n  try {\n    if (appIcon && typeof mainWindow.setIcon === 'function') {\n      mainWindow.setIcon(appIcon);\n    }\n  } catch {}\n\n  Menu.setApplicationMenu(null);\n\n  const modeQuery = `?mode=${appMode}`;\n\n  if (startUrlArg) {\n    mainWindow.loadURL(startUrlArg + modeQuery);\n  } else if (isDev) {\n    mainWindow.loadURL(`http://localhost:5173${modeQuery}`);\n  } else {\n    const indexPath = path.join(__dirname, '../dist/index.html');\n    mainWindow.loadFile(indexPath, {\n      query: { mode: appMode }\n    });\n  }\n\n  // Fullscreen event notifications to renderer\n  mainWindow.on('enter-full-screen', () => {\n    try { mainWindow?.webContents?.send('window:fullscreen-changed', true); } catch {}\n  });\n  mainWindow.on('leave-full-screen', () => {\n    try { mainWindow?.webContents?.send('window:fullscreen-changed', false); } catch {}\n  });\n\n  // Global key events (F11 and ESCAPE to toggle/exit fullscreen, F5 / Ctrl+R to reload with fresh cache, F12 DevTools)\n  mainWindow.webContents.on('before-input-event', (event, input) => {\n    if (input.type === 'keyDown') {\n      if (input.key === 'F11') {\n        const next = !mainWindow.isFullScreen();\n        mainWindow.setFullScreen(next);\n        try { mainWindow.webContents.send('window:fullscreen-changed', next); } catch {}\n        event.preventDefault();\n      } else if (input.key === 'Escape') {\n        if (mainWindow.isFullScreen()) {\n          mainWindow.setFullScreen(false);\n          try { mainWindow.webContents.send('window:fullscreen-changed', false); } catch {}\n          event.preventDefault();\n        }\n      } else if (input.key === 'F5' || (input.control && input.key.toLowerCase() === 'r')) {\n        // F5 or Ctrl+R: Clear session cache and reload immediately from disk\n        mainWindow.webContents.session.clearCache().catch(() => {});\n        mainWindow.webContents.reloadIgnoringCache();\n        event.preventDefault();\n      } else if (input.key === 'F12' || (input.control && input.shift && input.key.toLowerCase() === 'i')) {\n        mainWindow.webContents.toggleDevTools();\n        event.preventDefault();\n      }\n    }\n  });\n\n  mainWindow.on('closed', () => {\n    mainWindow = null;\n  });\n}\n\n// IPC Handlers\nipcMain.on('window:toggle-fullscreen', () => {\n  if (mainWindow) {\n    const next = !mainWindow.isFullScreen();\n    mainWindow.setFullScreen(next);\n    try { mainWindow.webContents.send('window:fullscreen-changed', next); } catch {}\n  }\n});\n\nipcMain.on('window:exit-fullscreen', () => {\n  if (mainWindow && mainWindow.isFullScreen()) {\n    mainWindow.setFullScreen(false);\n    try { mainWindow.webContents.send('window:fullscreen-changed', false); } catch {}\n  }\n});\n\nipcMain.on('window:enter-fullscreen', () => {\n  if (mainWindow && !mainWindow.isFullScreen()) {\n    mainWindow.setFullScreen(true);\n    try { mainWindow.webContents.send('window:fullscreen-changed', true); } catch {}\n  }\n});\n\nipcMain.on('window:reload', () => {\n  if (mainWindow) {\n    mainWindow.webContents.session.clearCache().catch(() => {});\n    mainWindow.webContents.reloadIgnoringCache();\n  }\n});\n\nipcMain.on('window:hard-reload', () => {\n  if (mainWindow) {\n    mainWindow.webContents.session.clearCache().catch(() => {});\n    mainWindow.webContents.reloadIgnoringCache();\n  }\n});\n\nipcMain.handle('window:is-fullscreen', () => {\n  return mainWindow ? mainWindow.isFullScreen() : false;\n});\n\nipcMain.on('window:minimize', () => {\n  if (mainWindow) mainWindow.minimize();\n});\n\nipcMain.on('window:maximize', () => {\n  if (mainWindow) {\n    if (mainWindow.isMaximized()) {\n      mainWindow.unmaximize()