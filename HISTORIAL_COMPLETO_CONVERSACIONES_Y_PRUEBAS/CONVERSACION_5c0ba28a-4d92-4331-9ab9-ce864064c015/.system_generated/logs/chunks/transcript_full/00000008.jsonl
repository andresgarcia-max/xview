const nowDate = new Date();\r\n48:       return saleDate.getDate() === nowDate.getDate() &&\r\n49:              saleDate.getMonth() === nowDate.getMonth() &&\r\n50:              saleDate.getFullYear() === nowDate.getFullYear();\r\n51:     }\r\n52:     if (period === 'week') {\r\n53:       return diffMs >= -60000 && diffMs <= 7 * 24 * 60 * 60 * 1000;\r\n54:     }\r\n55:     if (period === 'month') {\r\n56:       const saleDate = new Date(saleTimestamp);\r\n57:       const nowDate = new Date();\r\n58:       const isCurrentMonth = saleDate.getMonth() === nowDate.getMonth() && saleDate.getFullYear() === nowDate.getFullYear();\r\n59:       return (diffMs >= -60000 && diffMs <= 30 * 24 * 60 * 60 * 1000) || isCurrentMonth;\r\n60:     }\r\n61:     if (period === 'year') {\r\n62:       const saleDate = new Date(saleTimestamp);\r\n63:       const nowDate = new Date();\r\n64:       const isCurrentYear = saleDate.getFullYear() === nowDate.getFullYear();\r\n65:       return (diffMs >= -60000 && diffMs <= 365 * 24 * 60 * 60 * 1000) || isCurrentYear;\r\n66:     }\r\n67:     return true;\r\n68:   };\r\n69: \r\n70:   // Totales del periodo seleccionado\r"}
