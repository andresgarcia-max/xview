entDefault();\n96:       } else if (input.key === 'Escape') {\n97:         if (mainWindow.isFullScreen()) {\n98:           mainWindow.setFullScreen(false);\n99:           try { mainWindow.webContents.send('window:fullscreen-changed', false); } catch {}\n100:           event.preventDefault();\n101:         }\n102:       }\n103:     }\n104:   });\n105: \r\n106:   mainWindow.on('closed', () => {\r\n107:     mainWindow = null;\r\n108:   });\r\n109: }\r\n110: \r\n111: // IPC Handlers\r\n112: ipcMain.on('window:toggle-fullscreen', () => {\r\n113:   if (mainWindow) {\r\n114:     mainWindow.setFullScreen(!mainWindow.isFullScreen());\r\n115:   }\r\n116: });\r\n117: \r\n118: ipcMain.handle('window:is-fullscreen', () => {\r\n119:   return mainWindow ? mainWindow.isFullScreen() : false;\r\n120: });\r\n121: \r\n122: ipcMain.on('window:minimize', () => {\r\n123:   if (mainWindow) mainWindow.minimize();\r\n124: });\r\n125: \r\n126: ipcMain.on('window:maximize', () => {\r\n127:   if (mainWindow) {\r\n128:     if (mainWindow.isMaximized()) {\r\n129:       mainWindow.unmaximize();\r\n130:     } else {\r\n131:       mainWindow.maximize();\r\n132:     }\r\n133:   }\r\n134: });\r\n135: \r\n136: ipcMain.on('window:close', () => {\r\n137:   if (mainWindow) mainWindow.close();\r\n138: });\r\n139: \r\n140: app.whenReady().then(() => {\r\n141:   // Ensure sync server is active on port 3001\r\n142:   try {\r\n143:     const syncServer = require('../server/syncServer.cjs');\r\n144:     if (syncServer && typeof syncServer.startServer === 'function') {\r\n145:       syncServer.startServer(3001);\r\n146:     }\r\n147:   } catch (err) {\r\n148:     console.log('[MAIN] Servidor de sincronización embebido omitido o activo:', err.message);\r\n149:   }\r\n150: \r\n151:   createWindow();\r\n152: \r\n153:   app.on('activate', () => {\r\n154:     if (BrowserWindow.getAllWindows().length === 0) createWindow();\r\n155:   });\r\n156: });\r\n157: \r\n158: app.on('window-all-closed', () => {\r\n159:   if (pro