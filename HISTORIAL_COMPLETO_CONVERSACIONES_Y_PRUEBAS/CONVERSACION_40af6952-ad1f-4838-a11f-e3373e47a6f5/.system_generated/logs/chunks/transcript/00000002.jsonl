vc\\\"=hex:00,00\\n\\n; U-Boot Fastboot Amlogic / ZTE B866V2 (VID_18D1 & PID_0D02)\\n[HKEY_LOCAL_MACHINE\\\\SYSTEM\\\\CurrentControlSet\\\\Control\\\\usbflags\\\\18D10D02]\\n\\\"SkipBOSDescriptorQuery\\\"=dword:00000001\\n\\\"SkipContainerIdQuery\\\"=dword:00000001\\n\\\"osvc\\\"=hex:00,00\\n\\n; Android Recovery Fastbootd / ADB (VID_18D1 & PID_4EE7)\\n[HKEY_LOCAL_MACHINE\\\\SYSTEM\\\\CurrentControlSet\\\\Control\\\\usbflags\\\\18D14EE7]\\n\\\"SkipBOSDescriptorQuery\\\"=dword:00000001\\n\\\"SkipContainerIdQuery\\\"=dword:00000001\\n\\\"osvc\\\"=hex:00,00\\n\\n; Android Fastboot Bootloader (VID_18D1 & PID_4EE0 / 4E40 / D001 / D00D)\\n[HKEY_LOCAL_MACHINE\\\\SYSTEM\\\\CurrentControlSet\\\\Control\\\\usbflags\\\\18D14EE0]\\n\\\"\n<truncated 4314 bytes>","Overwrite":"true","Path":"\"C:\\\\Users\\\\andre\\\\OneDrive\\\\Desktop\\\\xview\\\\DRIVERS_USB_MACHO_A_MACHO_COMPLETOS\\\\8_REGISTRO_USBFLAGS_Y_ENERGIA_USB\\\\FIX_REGISTRO_AMD_B550_XHCI_Y_USBFLAGS_XVIEW.reg\""}},{"name":"write_file","args":{"Content":"\"# ==============================================================================\\n# CONFIGURADOR ESPECIAL PARA TARJETA MADRE:\\n# ASUS ROG STRIX B550-A GAMING (Chipset AMD B550 / Procesador AMD Ryzen AM4)\\n#\\n# Prepara y corrige el controlador AMD USB 3.10 eXtensible Host Controller (xHCI),\\n# instala los 5 certificados autofirmados, los 4 paquetes de drivers de la Xview+\\n# (incluyendo VID_1B8E&PID_C004 ADNL y PID_C003 WorldCup), aplica el parche\\n# SkipBOSDescriptorQuery para AMD B550, apaga el ahorro de energía PCIe/USB y\\n# limpia dispositivos USB fallidos en caché.\\n# ==============================================================================\\n\\n$ErrorActionPreference = \\\"Continue\\\"\\n$BaseDir = Split-Path -Parent $MyInvocation.MyCommand.Path\\n\\nWrite-Host \\\"==============================================================================\\\" -ForegroundColor Magenta\\nWrite-Host \\\" CONFIGURACION ESPECIAL PARA ASUS ROG STRIX B550-A GAMING (AMD B550 + XVIEW+)\\\" -ForegroundColor Cyan\\nWrite-Host \\\" Parcheando AMD xHCI + Certificados + Drivers ADNL/WorldCup/Fastboot\\\" -ForegroundColor Cyan\\nWrite-Host \\\"==============================================================================\\\" -ForegroundColor Magenta\\nWrite-Host \\\"\\\"\\n\\n# Verificar privilegios de Administrador\\n$isAdmin = ([Security.Principal.WindowsPrincipal][Security.Principal.WindowsIdentity]::GetCurrent()).IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)\\nif (-not $isAdmin) {\\n    Write-Host \\\"[!] Elevando permisos a Administrador...\\\" -ForegroundColor Yellow\\n    Start-Process powershell.exe -ArgumentList \\\"-NoProfile -ExecutionPolicy Bypass -File `\\\"$PSCommandPath`\\\"\\\" -Verb RunAs\\n    exit\\n}\\n\\n# Detectar placa base actual\\n$board = Get-CimInstance Win32_BaseBoard -ErrorAction SilentlyContinue\\n$cpu = Get-CimInstance Win32_Processor -ErrorAction SilentlyContinue\\nWrite-Host \\\"[INFO] Placa Base detectada : $($board.Manufacturer) - $($board.Product) (Rev: $($board.Version))\\\" -ForegroundColor White\\nWrite-Host \\\"[INFO] Procesador dete\n<truncated 11027 bytes>","Overwrite":"true","Path":"\"C:\\\\Users\\\\andre\\\\OneDrive\\\\Desktop\\\\xview\\\\DRIVERS_USB_MACHO_A_MACHO_COMPLETOS\\\\CONFIGURAR_ASUS_ROG_STRIX_B550_PARA_XVIEW.ps1\""}},{"name":"write_file","args":{"Content":"\"@echo off\\ntitle CONFIGURACION ESPECIAL ASUS ROG STRIX B550-A GAMING PARA XVIEW+ (MACHO A MACHO)\\ncolor 0B\\necho ===============================================================================\\necho   CONFIGURADOR ESPECIAL PARA TARJETA MADRE: ASUS ROG STRIX B550-A GAMING\\necho   Corrige el controlador AMD B550 xHCI + Instala Certificados y Drivers Xview+\\necho ===============================================================================\\necho.\\npowershell.exe -NoProfile -ExecutionPolicy Bypass -File \\\"%~dp0CONFIGURAR_ASUS_ROG_STRIX_B550_PARA_XVIEW.ps1\\\"\\n\"","Overwrite":"true","Path":"\"C:\\\\Users\\\\andre\\\\OneDrive\\\\Desktop\\\\xview\\\\DRIVERS_USB_MACHO_A_MACHO_COMPLETOS\\\\EJECUTAR_EN_MI_PC_ASUS_ROG_STRIX_B550.bat\""}}],"truncated_fields":["thinking","tool_calls"]}
