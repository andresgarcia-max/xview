 (poolOff + 4 <= b.Length) {\\n                    int val = BitConverter.ToInt32(b, poolOff);\\n                    for (int k = off + 2; k <= off + 20 && k < b.Length - 2; k += 2) {\\n                        ushort insn2 = BitConverter.ToUInt16(b, k);\\n                        if (insn2 == (0x4478 | rd)) {\\n                            int addPc = k + 0x1000 + 4;\\n                            int target = val + addPc;\\n                            string s = ReadStr(b, target);\\n                            if (s.Length >= 2) {\\n                                Console.WriteLine(\\\"0x{0:X} (vaddr 0x{1:X}): -> 0x{2:X} \\\\\\\"{3}\\\\\\\"\\\", off, off + 0x1000, target, s);\\n                            }\\n                            break;\\n                        }\\n                    }\\n                }\\n            }\\n        }\\n    }\\n}\\n\\\"@\\n[RecoveryDump2]::Dump(\\\"c:\\\\Users\\\\andre\\\\OneDrive\\\\Desktop\\\\xview\\\\experimento\\\\11_VALIDACION_OTA_Y_FIRMWARE_ZTE\\\\system_bin_recovery\\\", 0xB06A0, 0xB4D00)\"","WaitMsBeforeAsync":"5000","toolSummary":"\"Dump all string references in 0xB06A0..0xB4D00 of system_bin_recovery\""}}]}
