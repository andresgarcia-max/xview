{"step_index":330,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-04T05:54:32Z","content":"Created At: 2026-11-03T23:54:32-06:00\nCompleted At: 2026-11-03T23:54:32-06:00\nShowing lines 1-400 of 618\n1: # ==============================================================================\n2: # MOTOR PRINCIPAL: PROGRAMA PERFECTO XVIEW+ (ZTE ZXV10 B866V2 - S905X2 G12A)\n3: # Fusion integral de todas las herramientas de la memoria USB + hallazgos REA\n4: # Reglas absolutas:\n5: #   1. 100% Externo (Cero tornillos, Cero TTL)\n6: #   2. Proteccion total de factory.img (Widevine L1) y cri_data.img (MAC/Serie)\n7: #   3. Salto directo del bloqueo QR RSA-2048 de ZTE mediante programas integrados\n8: #      (Recovery fastbootd PID_4EE7 / U-Boot Fastboot PID_0D02 / WorldCup VID_1B8E / QADEBUG)\n9: # ==============================================================================\n10: \n11: [Console]::OutputEncoding = [System.Text.Encoding]::UTF8\n12: $ErrorActionPreference = \"Continue\"\n13: \n14: $ROOT_DIR   = Split-Path -Parent $PSScriptRoot\n15: $MOTOR_DIR  = Join-Path $ROOT_DIR \"1_HERRAMIENTAS_MOTOR\"\n16: $APKS_DIR   = Join-Path $ROOT_DIR \"2_APKS_LIBERACION_Y_TV\"\n17: $KEYS_DIR   = Join-Path $ROOT_DIR \"3_LLAVES_USB_PARA_LA_CAJA\"\n18: $DRV_DIR    = Join-Path $ROOT_DIR \"4_DRIVERS_Y_GUI_WINDOWS\"\n19: $FW_DIR     = Join-Path $ROOT_DIR \"5_FIRMWARE_SEGURO_B866V2\"\n20: \n21: $ADB        = Join-Path $MOTOR_DIR \"adb.exe\"\n22: $FASTBOOT   = Join-Path $MOTOR_DIR \"fastboot_moderno.exe\"\n23: if (-not (Test-Path $FASTBOOT)) { $FASTBOOT = Join-Path $MOTOR_DIR \"fastboot.exe\" }\n24: $ADNL       = Join-Path $MOTOR_DIR \"adnl.exe\"\n25: $UPDATE     = Join-Path $MOTOR_DIR \"update.exe\"\n26: \n27: $Global:ADB_TARGET_ARGS = @()\n28: $Global:CONNECTED_IP    = \"\"\n29: \n30: function Invoke-Adb {\n31:     param([string[]]$Arguments)\n32:     $allArgs = @()\n33:     if ($Global:ADB_TARGET_ARGS.Count -gt 0) { $allArgs += $Global:ADB_TARGET_ARGS }\n34:     $allArgs += $Arguments\n35:     & $ADB @allArgs\n36: }\n37: \n38: function Get-BoxConnectionState {\n39:     $state = [ordered]@{\n40:         UsbHardwareMode = \"Ninguno detectado por cable USB directo\"\n41:         SerialNumber    = \"No\n<truncated 19247 bytes>\neen\n365:         Write-Host \"    Ahora puedes pasar la memoria USB KINGSTON de la caja a tu PC para leer 'super.img'.\" -ForegroundColor Yellow\n366:         Read-Host \"    Conecta la memoria USB a tu PC y presiona ENTER\"\n367:         foreach ($drv in @(\"D\",\"E\",\"F\",\"G\",\"H\")) {\n368:             $tryPath = \"${drv}:\\B866v2 Android 12\\B866v2 Android 12\\B866V2\\super.img\"\n369:             if (Test-Path $tryPath) { $superPath = $tryPath; break }\n370:         }\n371:     }\n372: \n373:     Write-Host \"[3/12] Flasheando boot.img...\" -ForegroundColor Cyan\n374:     & $FASTBOOT flash boot (Join-Path $FW_DIR \"boot.img\")\n375: \n376:     Write-Host \"[4/12] Flasheando _aml_dtb y dtbo.img...\" -ForegroundColor Cyan\n377:     & $FASTBOOT flash _aml_dtb (Join-Path $FW_DIR \"dtb.img\")\n378:     & $FASTBOOT flash dtbo (Join-Path $FW_DIR \"dtbo.img\")\n379: \n380:     Write-Host \"[5/12] PROTEGIENDO factory.img (Widevine L1) y cri_data.img (MAC/Serie) - OMITIDOS POR SEGURIDAD.\" -ForegroundColor Green\n381: \n382:     Write-Host \"[6/12] Flasheando logo.img y param.img...\" -ForegroundColor Cyan\n383:     & $FASTBOOT flash logo (Join-Path $FW_DIR \"logo.img\")\n384:     & $FASTBOOT flash param (Join-Path $FW_DIR \"param.img\")\n385: \n386:     Write-Host \"[7/12] Flasheando conf.img y oem.img...\" -ForegroundColor Cyan\n387:     & $FASTBOOT flash conf (Join-Path $FW_DIR \"conf.img\")\n388:     & $FASTBOOT flash oem (Join-Path $FW_DIR \"oem.img\")\n389: \n390:     if (Test-Path $superPath) {\n391:         Write-Host \"[8/12] Flasheando super.img (Android 12 Liberado B866V2)...\" -ForegroundColor Cyan\n392:         & $FASTBOOT flash super $superPath\n393:     } else {\n394:         Write-Host \"[!] No s