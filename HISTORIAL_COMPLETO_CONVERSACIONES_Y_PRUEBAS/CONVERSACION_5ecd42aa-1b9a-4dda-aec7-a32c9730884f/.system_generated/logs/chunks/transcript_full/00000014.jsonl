ecific script run when the device is in a particular mode.\n\n\n","tool_calls":[{"name":"run_command","args":{"CommandLine":"Select-String -Path \"c:\\Users\\andre\\OneDrive\\Desktop\\xview\\FIRMWARE_COMPLETO_B866V2_FASTBOOT\\SESION_FASTBOOT_B866V2.log\" -Pattern \"1B8E|WorldCup|env_unlocked|4EE7|4EE2\" | Select-Object -First 40","WaitMsBeforeAsync":5000,"toolSummary":"Search log for USB modes and unlock events"}}]}
