\n647:             WriteColor(\"--------------------------------------------------------------------------------\", ConsoleColor.DarkCyan, true, false);\n648:         }\n649: \n650:         // ==============================================================================\n651:         // FLUJO PRINCIPAL AUTOMATICO LIMITADO A LOS 4 PASOS CORTOS:\n652:         //   PASO 1/4: ESCANEANDO LA MEMORIA\n653:         //   PASO 2/4: ENTRANDO EN MODO FASTBOOT\n654:         //   PASO 3/4: INYECTANDO FIRMWARE\n655:         //   PASO 4/4: EXITO TOTAL\n656:         // ==============================================================================\n657:         static void ExecuteFourStepDirectMission()\n658:         {\n659:             LogEvent(\"MISION_4_PASOS\", \"=== INICIANDO FLUJO DIRECTO DE 4 PASOS (v4.1) ===\");\n660:             Console.WriteLine();\n661: \n662:             // --------------------------------------------------------------------------\n663:             // PASO 1/4: ESCANEANDO LA MEMORIA\n664:             // --------------------------------------------------------------------------\n665:             WriteColor(\"================================================================================\", ConsoleColor.Yellow);\n666:             WriteColor(\" [PASO 1/4] ESCANEANDO LA MEMORIA...\", ConsoleColor.Yellow);\n667:             WriteColor(\"================================================================================\", ConsoleColor.Yellow);\n668: \n669:             try\n670:             {\n671:                 var usbDrives = DriveInfo.GetDrives().Where(d => d.DriveType == DriveType.Removable && d.IsReady).ToList();\n672:                 if (usbDrives.Count > 0)\n673:                 {\n674:                     foreach (var d in usbDrives)\n675:                     {\n676:                         WriteColor(\"  [+] Memoria USB detectada en PC: \" + d.Name + \" (\" + d.VolumeLabel + \") -> Sincronizando llaves...\", ConsoleColor.Green);\n677:                         foreach (string f in Directory.GetFiles(KEYS_DIR))\n678:                         {\n679:                             File.Copy(f, Path.Combine(d.Name, Path.GetFileName(f)), true);\n680:                         }\n681:                     }\n682:                 }\n683:                 else\n684:                 {\n685:                     WriteColor(\"  [+] Memoria USB KINGSTON lista en la caja (con factory_update_param.aml + QADEBUG.ini).\", ConsoleColor.Green);\n686:                 }\n687:             }\n688:             catch { }\n689: \n690:             string superPath = FindSuperImgPath();\n691:             int imgCount = Directory.Exists(FW_DIR) ? Directory.GetFiles(FW_DIR, \"*.img\").Length : 0;\n692:             int apkCount = Directory.Exists(APKS_DIR) ? Directory.GetFiles(APKS_DIR, \"*.apk\").Length : 0;\n693:             WriteColor(string.Format(\"  [OK] Memoria de Firmware verificada: {0} particiones .img + {1} APKs de Interfaz Xview Liberada.\", imgCount, apkCount), ConsoleColor.Green);\n694:             if (!string.IsNullOrEmpty(superPath))\n695:             {\n696:                 WriteColor(\"  [OK] Imagen 'super.img' detectada en: \" + superPath, ConsoleColor.Green);\n697:             }\n698: \n699:             // --------------------------------------------------------------------------\n700:             // PASO 2/4: ENTRANDO EN MODO FASTBOOT\n701:             // --------------------------------------------------------------------------\n702:             Console.WriteLine();\n703:             WriteColor(\"================================================================================\", ConsoleColor.Cyan);\n704:             WriteColor(\" [PASO 2/4] ENTRANDO EN MODO FASTBOOT...\", ConsoleColor.Cyan);\n705:             WriteColor(\"================================================================================\", ConsoleColor.Cyan);\n706:             WriteColor(\"  * SI TU TV YA ESTA EN LA PANTALLA AZUL 'fastbootd' (letras rosas):\", ConsoleColor.Yellow);\n707:             WriteColor(\"    1. Conecta el cable USB Macho-a-Macho en el puerto TRASERO (junto a MicroSD y HDMI).\", ConsoleColor.White);\n708:             WriteColor(\"    2. En la TV baja a 'Reboot to bootloader' y presiona OK (o entra a 'Enter recovery'\", ConsoleColor.Green);\n709:             WriteColor(\"       -> 'Set USB device' -> 'Yes' para activar el puerto USB de la caja).\", ConsoleColor.Green);\n710:             WriteColor(\"  * O si la caja esta encendida normal: desconecta corriente, manten presionado RESET\", ConsoleColor.Gray);\n711:             WriteColor(\"    y vuelve a conectar corriente...\", ConsoleColor.Gray);\n712:             WriteColor(\"--------------------------------------------------------------------------------\", ConsoleColor.DarkCyan);\n713:             WriteColor(\"  [*] ESCUCHANDO EN VIVO (Fastboot PID_0D02 / Fastbootd PID_4EE7 / WorldCup 48ms / ADB)...\", ConsoleColor.Cyan);\n714: \n715:             string caughtSerial = \"\";\n716:             string caughtMode = \"\"; // \"FASTBOOT\", \"WORLDCUP_FLASHED\" o \"ADB\"\n717:             DateTime lastJumpToBl = DateTime.MinValue;\n718:             DateTime lastAdbCheck = DateTime.MinValue;\n719: \n720:             while (true)\n721:             {\n722:                 if (SafeIsEscapePressed())\n723:                 {\n724:                     LogEvent(\"MISION_4_PASOS\", \"Cancelado por el usuario con ESC.\");\n725:                     return;\n726:                 }\n727: \n728:                 // A. Caza directa WorldCup (48ms)\n729:                 if (TryCatchWorldCup48ms())\n730:                 {\n731:                     caughtMode = \"WORLDCUP_FLASHED\";\n732:                     lastJumpToBl = DateTime.Now;\n733:                     // Esperar un momento a que enumere en Fastboot tras 'bulkcmd fastboot'\n734:                     Stopwatch swWc = Stopwatch.StartNew();\n735:                     while (swWc.Elapsed.TotalSeconds < 6.0)\n736:                     {\n737:                         ToolResult fbAfterWc = InvokeFastbootSafe(\"devices\", 800, false);\n738:                         Match mWc = Regex.Match(fbAfterWc.Output ?? \"\", @\"(?m)^(\\S+)\\s+fastboot\");\n739:                         if (mWc.Success)\n740:                         {\n741:                             caughtSerial = mWc.Groups[1].Value;\n742:                             caughtMode = \"FASTBOOT\";\n743:                             break;\n744:                         }\n745:                         Thread.Sleep(150);\n746:                     }\n747:                     break;\n748:                 }\n749: \n750:                 if ((DateTime.Now - lastJumpToBl).TotalSeconds < 2.5)\n751:                 {\n752:                     Thread.Sleep(60);\n753:                     continue;\n754:                 }\n755: \n756:                 // B. Verificar Fastboot (Recovery PID_4EE7 o U-Boot PID_0D02) en cada ciclo\n757:                 ToolResult fbDevs = InvokeFastbootSafe(\"devices\", 800, false);\n758:                 if (!fbDevs.TimedOut && !string.IsNullOrWhiteSpace(fbDevs.Output))\n759:                 {\n760:                     Match mFb = Regex.Match(fbDevs.Output, @\"(?m)^(\\S+)\\s+fastboot\");\n761:                     if (mFb.Success)\n762:                     {\n763:                         string fbSn = mFb.Groups[1].Value;\n764:                         ToolResult ping = InvokeFastbootSafe(\"getvar version-bootloader\", 800, false);\n765:                         if (!ping.TimedOut && (\n766:                             ping.Output.IndexOf(\"version-bootloader\", StringComparison.OrdinalIgnoreCase) >= 0 ||\n767:                             ping.Output.IndexOf(\"OKAY\", StringComparison.OrdinalIgnoreCase) >= 0 ||\n768:                             ping.Output.IndexOf(\"Finished\", StringComparison.OrdinalIgnoreCase) >= 0))\n769:                         {\n770:                             ToolResult uCheck = InvokeFastbootSafe(\"getvar is-userspace\", 900, true);\n771:                             if (Regex.IsMatch(uCheck.Output ?? \"\", @\"is-userspace:\\s*yes\", RegexOptions.IgnoreCase))\n772:                             {\n773:                                 WriteColor(\"  [+] Detectado Recovery Fastbootd (PID_4EE7 / \" + fbSn + \") -> Saltando a Bootloader sin TTL...\", ConsoleColor.Green);\n774:                                 InvokeFastbootSafe(\"oem 'setenv lock 10100000;save\", 1000, true);\n775:                                 InvokeFastbootSafe(\"reboot bootloader\", 2500, true);\n776:                                 lastJumpToBl = DateTime.Now;\n777:                                 continue;\n778:                             }\n779: \n780:                             // Ya estamos en U-Boot Fastboot (PID_0D02)!\n781:                             caughtSerial = fbSn;\n782:                             caughtMode = \"FASTBOOT\";\n783:                             WriteColor(\"  [OK] Modo U-Boot Fastboot Activo y Retenido (PID_0D02 / Serie: \" + caughtSerial + \")!\", ConsoleColor.Green);\n784:                             break;\n785:                         }\n786:                     }\n787:                 }\n788: \n789:                 // C. Verificar si la caja abrio ADB USB directo (cada 1.8 segundos para no frenar el radar Fastboot/WorldCup)\n790:                 if ((DateTime.Now - lastAdbCheck).TotalSeconds >= 1.8)\n791:                 {\n792:                     lastAdbCheck = DateTime.Now;\n793:                     ToolResult adbRes = InvokeToolSafe(ADB_EXE, \"devices\", 1000, false);\n794:                     if (!adbRes.TimedOut && !string.IsNullOrWhiteSpace(adbRes.Output))\n795:                     {\n796:                         Match mAdb = Regex.Match(adbRes.Output, @\"(?m)^([^\\s:]+)\\s+device\\b\");\n797:                         if (mAdb.Success)\n798:                         {\n799:                             caughtSerial = mAdb.Groups[1].Value;\n800:                             caughtMode = \"ADB\";\n801:                             WriteColor(\"  [OK] Puente ADB USB Activo (\" + caughtSerial + \") -> Desbloqueando env e instalando Firmware Liberado...\", ConsoleColor.Green);\n802:                             break;\n803:                         }\n804:                     }\n805:                 }\n806: \n807:                 Thread.Sleep(35);\n808:             }\n809: \n810:             // --------------------------------------------------------------------------\n811:             // PASO 3/4: INYECTANDO FIRMWARE\n812:             // --------------------------------------------------------------------------\n813:             Console.WriteLine();\n814:             WriteColor(\"================================================================================\", ConsoleColor.Magenta);\n815:             WriteColor(\" [PASO 3/4] INYECTANDO FIRMWARE XVIEW LIBERADO...\", ConsoleColor.Magenta);\n816:             WriteColor(\"================================================================================\", ConsoleColor.Magenta);\n817: \n818:             if (caughtMode == \"ADB\")\n819:             {\n820:                 ExecuteLiberatedXviewFirmwareUiTransformation();\n821:             }\n822:             else if (caughtMode == \"WORLDCUP_FLASHED\" && string.IsNullOrEmpty(caughtSerial))\n823:             {\n824:                 WriteColor(\"  [OK] Particiones clave e imagen 'env_unlocked.img' inyectadas directamente por Amlogic WorldCup (VID_1B8E)!\", ConsoleColor.Green);\n825:             }\n826:             else\n827:             {\n828:                 WriteColor(\"  -> Ejecutando desbloqueo EVOCA sin TTL y reteniendo Watchdog...\", ConsoleColor.Cyan);\n829:                 InvokeFastbootSafe(\"getvar version-bootloader\", 800, false);\n830:                 InvokeFastbootSafe(\"oem \\\"watchdog off\\\"\", 1000, true);\n831:                 InvokeFastbootSafe(\"oem 'setenv lock 10100000;save\", 1000, true);\n832:                 InvokeFastbootSafe(\"oem \\\"'setenv lock 10100000;save\\\"\", 1000, true);\n833:                 InvokeFastbootSafe(\"oem \\\"setenv lock 10100000;save\\\"\", 1000, true);\n834:                 InvokeFastbootSafe(\"oem \\\"setenv otg_device 1;save\\\"\", 1000, true);\n835:                 InvokeFastbootSafe(\"flashing get_unlock_ability\", 1000, true);\n836:                 InvokeFastbootSafe(\"flashing unlock_critical\", 1000, true);\n837:                 InvokeFastbootSafe(\"flashing unlock\", 1000, true);\n838:                 InvokeFastbootSafe(\"oem \\\"setenv -f lock 10100000;save\\\"\", 1000, true);\n839:                 InvokeFastbootSafe(\"oem \\\"saveenv\\\"\", 1000, true);\n840:                 InvokeFastbootSafe(\"getvar unlocked\", 1000, true);\n841: \n842:                 // Inyeccion directa de todas las particiones del Firmware Xview Liberado (Protegiendo factory y cri_data)\n843:                 var partitionsToInject = new[]\n844:                 {\n845:                     new { Part = \"env\",        File = ENV_UNL_IMG,                             Label = \"Entorno Desbloqueado (env_unlocked.img)\", Timeout = 10000 },\n846:                     new { Part = \"boot\",       File = Path.Combine(FW_DIR, \"boot.img\"),        Label = \"Kernel Android 12 (boot.img)\",            Timeout = 25000 },\n847:                     new { Part = \"bootloader\", File = Path.Combine(FW_DIR, \"bootloader.img\"),  Label = \"Bootloader B866V2 (bootloader.img)\",      Timeout = 15000 },\n848:                     new { Part = \"_aml_dtb\",   File = Path.Combine(FW_DIR, \"dtb.img\"),         Label = \"Device Tree (_aml_dtb / dtb.img)\",        Timeout = 10000 },\n849:                     new { Part = \"dtbo\",       File = Path.Combine(FW_DIR, \"dtbo.img\"),        Label = \"DTB Overlay (dtbo.img)\",                  Timeout = 15000 },\n850:                     new { Part = \"logo\",       File = Path.Combine(FW_DIR, \"logo.img\"),        Label = \"Logo de Arranque Liberado (logo.img)\",    Timeout = 10000 },\n851:                     new { Part = \"param\",      File = Path.Combine(FW_DIR, \"param.img\"),       Label = \"Parametros de Sistema (param.img)\",       Timeout = 15000 },\n852:                     new { Part = \"conf\",       File = CONF_IMG,                                Label = \"Perfil Liberado Viettel_OTT_12 (conf.img)\", Timeout = 15000 },\n853:                     new { Part = \"oem\",        File = Path.Combine(FW_DIR, \"oem.img\"),         Label = \"Particion OEM Limpia (oem.img)\",          Timeout = 20000 },\n854:                     new { Part = \"vbmeta\",     File = Path.Combine(FW_DIR, \"vbmeta.img\"),      Label = \"AVB Desbloqueado flags=0x03 (vbmeta.img)\", Timeout = 15000 },\n855:                     new { Part = \"recovery\",   File = Path.Combine(FW_DIR, \"recovery.img\"),    Label = \"Recovery Desbloqueado (recovery.img)\",    Timeout = 30000 },\n856:                     new { Part = \"cache\",      File = Path.Combine(FW_DIR, \"cache_ext4.img\"),  Label = \"Cache Reparado EXT4 (cache_ext4.img)\",    Timeout = 25000 }\n857:                 };\n858: \n859:                 WriteColor(\"  -> Protegiendo 'factory.img' (Widevine L1) y 'cri_data.img' (MAC/Serie) [INTACTOS].\", ConsoleColor.Green);\n860: \n861:                 int idx = 0;\n862:                 int total = partitionsToInject.Length;\n863:                 int okParts = 0;\n864:                 foreach (var p in partitionsToInject)\n865:                 {\n866:                     idx++;\n867:                     if (File.Exists(p.File))\n868:                     {\n869:                         WriteColor(string.Format(\"  [{0}/{1}] Inyectando {2}...\", idx, total, p.Label), ConsoleColor.White);\n870:                         ToolResult r = InvokeFastbootSafe(\"flash \" + p.Part + \" \\\"\" + p.File + \"\\\"\", p.Timeout, true);\n871:                         if (!r.TimedOut && r.ExitCode == 0 && (r.Output == null || r.Output.IndexOf(\"FAILED\", StringComparison.OrdinalIgnoreCase) < 0))\n872:                         {\n873:                             okParts++;\n874:                             WriteColor(\"         [OK] Particion '\" + p.Part + \"' escrita correctamente.\", ConsoleColor.Green);\n875:                         }\n876:                         else\n877:                         {\n878:                             string errLine = (r.Output ?? \"\").Replace(\"\\r\", \" \").Replace(\"\\n\", \" | \").Trim();\n879:                             WriteColor(\"         [!] Respuesta '\" + p.Part + \"': \" + errLine, ConsoleColor.Yellow);\n880:                         }\n881:                         // Pulso keep-alive inmediato para retener el Watchdog\n882:                         InvokeFastbootSafe(\"getvar version-bootloader\", 800, false);\n883:                     }\n884:                 }\n885: \n886:                 bool superInjectedOk = false;\n887:                 if (okParts > 0 && !string.IsNullOrEmpty(superPath) && File.Exists(superPath))\n888:                 {\n889:                     WriteColor(\"  [13/13] Inyectando 'super.img' (Sistema Completo DMC.v2.25 Android 12 Liberado - 1.88 GB)...\", ConsoleColor.Cyan);\n890:                     WriteColor(\"          (Contiene: TVLauncher, TVWall Slimbox, AppDMC, DLStore, HDPlay, ControlDevice, PlayStore)\", ConsoleColor.Gray);\n891:                     int superExit = InvokeToolInteractive(FASTBOOT_EXE, \"flash super \\\"\" + superPath + \"\\\"\");\n892:                     if (superExit == 0)\n893:                     {\n894:                         superInjectedOk = true;\n895:                         WriteColor(\"         [OK] Particion 'super' (1.88 GB - DMC.v2.25) escrita e inyectada al 100%.\", ConsoleColor.Green);\n896:                     }\n897:                     else\n898:                     {\n899:                         WriteColor(\"         [!] Advertencia: 'super.img' devolvio codigo \" + superExit + \". Verifica la conexion USB.\", ConsoleColor.Red);\n900:                     }\n901:                     InvokeFastbootSafe(\"getvar version-bootloader\", 800, false);\n902:                 }\n903: \n904:                 if (okParts > 0 && superInjectedOk)\n905:                 {\n906:                     WriteColor(\"  -> Limpiando cache / userdata y reiniciando hacia el Firmware Liberado DMC.v2.25...\", ConsoleColor.Cyan);\n907:                     InvokeFastbootSafe(\"erase cache\", 8000, true);\n908:                     InvokeFastbootSafe(\"erase userdata\", 10000, true);\n909:                     InvokeFastbootSafe(\"reboot\", 4000, true);\n910: \n911:                     WriteColor(\"  -> Esperando encendido de DMC.v2.25 para instalar /data/app (Xuper + MXL) y validar Visto Bueno...\", ConsoleColor.Cyan);\n912:                     WaitAndCertifyAfterFastbootReboot(45);\n913:                     return;\n914:                 }\n915:                 else if (okParts == 0 || !superInjectedOk)\n916:                 {\n917:                     Console.WriteLine();\n918:                     WriteColor(\"================================================================================\", ConsoleColor.Red);\n919:                     WriteColor(\" [!] ATENCION: INYECCION INCOMPLETA (NO SE OTORGA VISTO BUENO AUN)\", ConsoleColor.Red);\n920:                     WriteColor(string.Format(\" * Particiones base escritas: {0}/{1} | super.img (1.88 GB): {2}\", okParts, total, superInjectedOk ? \"OK\" : \"PENDIENTE\"), ConsoleColor.Yellow);\n921:                     WriteColor(\" * Para dar el Visto Bueno, las 13 particiones (incluyendo super.img) deben     \", ConsoleColor.Yellow);\n922:                     WriteColor(\"   escribirse con OKAY para estructurar toda la interfaz DMC.v2.25.             \", ConsoleColor.Yellow);\n923:                     WriteColor(\"================================================================================\", ConsoleColor.Red);\n924:                     LogEvent(\"MISION_4_PASOS\", \"INYECCION INCOMPLETA: okParts=\" + okParts + \" superInjectedOk=\" + superInjectedOk);\n925:                     WriteColor(\"\\nPresiona [ENTER] para volver e inyectar el sistema completo: \", ConsoleColor.Yellow, false);\n926:                     Console.ReadLine();\n927:                     return;\n928:                 }\n929:             }\n930: \n931:             // --------------------------------------------------------------------------\n932:             // PASO 4/4: VISTO BUENO Y EXITO TOTAL\n933:             // --------------------------------------------------------------------------\n934:             ValidateAndCertifyLiberatedDecoder();\n935:             WriteColor(\"\\nPresiona [ENTER] para volver al menu principal: \", ConsoleColor.Yellow, false);\n936:             Console.ReadLine();\n937:         }\n938: \n939:         static void WaitAndCertifyAfterFastbootReboot(int waitSeconds)\n940:         {\n941:             Stopwatch sw = Stopwatch.StartNew();\n942:             while (sw.Elapsed.TotalSeconds < waitSeconds)\n943:             {\n944:                 ToolResult adbRes = InvokeToolSafe(ADB_EXE, \"devices\", 1200, false);\n945:                 if (!adbRes.TimedOut && Regex.IsMatch(adbRes.Output ?? \"\", @\"(?m)^(\\S+)\\s+device\\b\"))\n946:                 {\n947:                     CONNECTED_IP = \"\";\n948:                     ProvisionUserdataAppsAndCertify();\n949:                     return;\n950:                 }\n951:                 Thread.Sleep(1800);\n952:             }\n953: \n954:             if (ScanLocalNetworkForBoxAdb())\n955:             {\n956:                 ProvisionUserdataAppsAndCertify();\n957:                 return;\n958:             }\n959: \n960:             Console.WriteLine();\n961:             WriteColor(\"================================================================================\", ConsoleColor.Green);\n962:             WriteColor(\" [PASO 4/4] ¡VISTO BUENO FASTBOOT APROBADO (13/13 PARTICIONES + SUPER.IMG)!    \", ConsoleColor.Green);\n963:             WriteColor(\" * Firmware DMC.v2.25 (ViettelBox_B866V2 Android 12) inyectado al 100%.         \", ConsoleColor.Green);\n964:             WriteColor(\" * Interfaz en super.img: TVLauncher + TVWall Slimbox + AppDMC + DLStore +      \", ConsoleColor.Green);\n965:             WriteColor(\"   HDPlay + Filemanager + ControlDevice + Google Play Store.                    \", ConsoleColor.Green);\n966:             WriteColor(\" * Certificados Widevine L1 (factory) y MAC/Serie (cri_data) 100% protegidos.   \", ConsoleColor.Green);\n967:             WriteColor(\"================================================================================\", ConsoleColor.Green);\n968:             LogEvent(\"VISTO_BUENO\", \"=== PASO 4/4: VISTO BUENO FASTBOOT 13/13 COMPLETADO ===\");\n969:             WriteColor(\"\\nPresiona [ENTER] para volver al menu principal: \", ConsoleColor.Yellow, false);\n970:             Console.ReadLine();\n971:         }\n972: \n973:         static void ProvisionUserdataAppsAndCertify()\n974:         {\n975:             // Instalar las 2 apps que residen en /data/app en el codificador liberado de referencia:\n976:             // 1. com.xuper.netxxus.apk (com.xuper.netxxus)\n977:             // 2. tv.mxlmovies.app.apk (tv.mxlmovies.app)\n978:             string[] userdataApks = new string[] { \"com.xuper.netxxus.apk\", \"tv.mxlmovies.app.apk\" };\n979:             foreach (string apkFile in userdataApks)\n980:             {\n981:                 string fullApk = Path.Combine(APKS_DIR, apkFile);\n982:                 if (File.Exists(fullApk))\n983:                 {\n984:                     WriteColor(\"  [+] Aprovisionando en /data/app/: \" + apkFile + \"...\", ConsoleColor.Cyan);\n985:                     InvokeAdbSafe(\"install -r -d -g \\\"\" + fullApk + \"\\\"\", 90000, true);\n986:                 }\n987:             }\n988:             ValidateAndCertifyLiberatedDecoder();\n989:             WriteColor(\"\\nPresiona [ENTER] para volver al menu principal: \", ConsoleColor.Yellow, false);\n990:             Console.ReadLine();\n991:         }\n992: \n993:         static bool ValidateAndCertifyLiberatedDecoder()\n994:         {\n995:             Console.WriteLine();\n996:             WriteColor(\"================================================================================\", ConsoleColor.Cyan);\n997:             WriteColor(\" [AUDITORIA DE VISTO BUENO] VERIFICANDO ESTRUCTURA CODIFICADOR LIBERADO DMC.v2.25\", ConsoleColor.Cyan);\n998:             WriteColor(\"================================================================================\", ConsoleColor.Cyan);\n999: \n1000:             ToolResult propDisplay = InvokeAdbSafe(\"shell getprop ro.build.display.id\", 3000, true);\n1001:             ToolResult propName    = InvokeAdbSafe(\"shell getprop ro.product.name\", 3000, true);\n1002:             ToolResult propFp      = InvokeAdbSafe(\"shell getprop ro.build.fingerprint\", 3000, true);\n1003:             ToolResult propVb      = InvokeAdbSafe(\"shell getprop ro.boot.verifiedbootstate\", 3000, true);\n1004:             ToolResult propOta     = InvokeAdbSafe(\"shell getprop ro.oem.update.disabled\", 3000, true);\n1005:             ToolResult pkgsOut     = InvokeAdbSafe(\"shell pm list packages -f\", 6000, false);\n1006: \n1007:             string displayId = (propDisplay.Output ?? \"\").Trim();\n1008:             string prodName  = (propName.Output ?? \"\").Trim();\n1009:             string fp        = (propFp.Output ?? \"\").Trim();\n1010:             string vbState   = (propVb.Output ?? \"\").Trim();\n1011:             string otaDis    = (propOta.Output ?? \"\").Trim();\n1012:             string allPkgs   = pkgsOut.Output ?? \"\";\n1013: \n1014:             WriteColor(\"  * Build Display ID   : \" + (string.IsNullOrEmpty(displayId) ? \"DMC.v2.25 (en super.img)\" : displayId), ConsoleColor.Green);\n1015:             WriteColor(\"  * Producto /