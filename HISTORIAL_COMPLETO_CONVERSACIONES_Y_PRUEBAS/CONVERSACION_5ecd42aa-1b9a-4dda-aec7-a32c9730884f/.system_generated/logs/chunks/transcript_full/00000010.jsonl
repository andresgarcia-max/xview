en);\n334: \t\t\n335: \t\tint aDataLen = 4;\n336: \t\tbyte[] pAPlist = new byte[MaxLen];\n337: \t\tint[] iDataLen = new int[1];\n338: \t\tiDataLen[0] = MaxLen;\n339: \t\t\n340: \t\tcompCom.MCSP_InvokeService(NETACCESS, McspEvt.CMD_NA_WIFIAPALLLIST, aData, aDataLen, pAPlist, iDataLen);\n341: \t\t\n342: \t\t/* Different encoding for different Ap in list -- begin */\n343: \t\tString strtemp;\n344: \t\ttry {\n345: \t\t\tUtilsInstance.bytes2HexString(pAPlist);\n346: \t\t\tstrtemp = new String(pAPlist, 8, MaxLen-8, \"GBK\").trim();\n347: \t\t} catch (UnsupportedEncodingException e) {\n348: \t\t\tLog.d(TAG, FILE + \" [getApList] change code error ap_info\");\n349: \t\t\te.printStackTrace(); \n350: \t\t\treturn null;\n351: \t\t}\n352: \t\t/* Different encoding for different Ap in list -- end */\n353: \t\t\n354: \t\tLog.d(TAG, FILE + \" [getApList] strtemp=\"+strtemp);\n355: \t\tString []apSinInfo = strtemp.split(\"\\n\");\n356: \t\tif(strtemp.trim().equals(\"\")){\n357: \t\t\treturn null;\n358: \t\t}\n359: \t\tLog.d(TAG, FILE + \" [getApList] =====apSinInfo length======\"+apSinInfo.length);\n360: \t\treturn strtemp.split(\"\\n\");\n361: \t}\n362: }"}
{"step_index":262,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-04T05:35:42Z","content":"Created At: 2026-11-03T23:35:42-06:00\nCompleted At: 2026-11-03T23:35:42-06:00\nShowing lines 1-160 of 160\n1: package com.zte.adb.common;\r\n2: \r\n3: import android.content.Context;\r\n4: import android.util.Log;\r\n5: \r\n6: class UtilsInstance{\r\n7: \tprivate static final String TAG = \"[Settings]\";\r\n8: \tprivate static final String FILE = \"[UtilsInstance]\";\r\n9: \tprivate static final String KEY_SECTION = \"Common\";\r\n10: \tprivate static final String KEY_EXT_SECTION = \"Common_ext\"; \r\n11: \t//private static ClientManager clientManagerProxy = new ClientManager();\r\n12: \tprivate static int mMarketCode = 0;\r\n13: \tprivate static int mOperatorsCode = 0;\r\n14: \tprivate Context mContext;\r\n15: \r\n16: \t/*static\r\n17: \t{\r\n18: \t\tmMarketCode = clientManagerProxy.GetConfigInteger(KEY_SECTION, \"MarketCode\");\r\n19: \t\tmOperatorsCode = clientManagerProxy.GetConfigInteger(KEY_SECTION, \"OperatorsCode\");\r\n20: \t\tLog.d(TAG, FILE + \" [static] class UtilsInstance --> mMarketCode = \" + mMarketCode\r\n21: \t\t\t+ \", mOperatorsCode = \" +\tmOperatorsCode);\r\n22: \t}*/\r\n23: \r\n24: \t/**\r\n25: \t* return IPTV operators code, such as PrivateSettingCommon.CHINA_DIANXIN and so on.\r\n26: \t*/\r\n27: \tpublic static int getOperatorsCode()\r\n28: \t{\r\n29: \t    return mOperatorsCode;\r\n30: \t}\r\n31: \r\n32: \t/**\r\n33: \t* return IPTV operators code, such as PrivateSettingCommon.BEIJING and so on.\r\n34: \t*/\r\n35: \tpublic static int getMarketCode()\r\n36: \t{\r\n37: \t    return mMarketCode;\r\n38: \t}\r\n39: \r\n40: \r\n41: \tpublic static boolean isUTF8(byte[] rawtext) {\r\n42:         int score = 0; \r\n43:         int i, rawtextlen = 0; \r\n44:         int goodbytes = 0, asciibytes = 0; \r\n45:         // Maybe also use UTF8 Byte Order Mark: EF BB BF \r\n46:         // Check to see if characters fit into acceptable ranges \r\n47:         rawtextlen = rawtext.length; \r\n48:         for (i = 0; i < rawtextlen; i++) { \r\n49:             if ((rawtext[i] & (byte) 0x7F) == rawtext[i]) {  \r\n50:                 asciibytes++; \r\n51:                 // Ignore ASCII, can throw off count \r\n52:             } else if (-64 <= rawtext[i] && rawtext[i] <= -33 \r\n53:                 //-0x40~-0x21 \r\n54:                 && // Two bytes \r\n55:                 i + 1 < rawtextlen && -128 <= rawtext[i + 1] \r\n56:                 && rawtext[i + 1] <= -65) { \r\n57:                 goodbytes += 2; \r\n58:                 i++; \r\n59:             } else if (-32 <= rawtext[i] \r\n60:                 && rawtext[i] <= -17\r\n61:                 && // Three bytes\r\n62:                 i + 2 < rawtextlen && -128 <= rawtext[i + 1]\r\n63:                 && rawtext[i + 1] <= -65 && -128 <= rawtext[i + 2]\r\n64:                 && rawtext[i + 2] <= -65) {\r\n65:                 goodbytes += 3;\r\n66:                 i += 2;\r\n67:             } \r\n68:         } \r\n69:         if (asciibytes == rawtextlen) { \r\n70:             return false; \r\n71:         } \r\n72:         score = 100 * goodbytes / (rawtextlen - asciibytes); \r\n73:         // If not above 98, reduce to zero to prevent coincidental matches \r\n74:         // Allows for some (few) bad formed sequences \r\n75:         if (score > 98) { \r\n76:             return true; \r\n77:         } else if (score > 95 && goodbytes > 30) { \r\n78:             return true; \r\n79:         } else { \r\n80:             return false;\r\n81:         }\r\n82:     } \r\n83: \r\n84:     /**\r\n85:     * @hide\r\n86:     */\r\n87:     public static String bytes2HexString(byte[] aData/*, int len*/) {\r\n88:         StringBuilder stringBuilder = new StringBuilder(\"\");\r\n89:         if (null == aData || aData.length <= 0) {\r\n90:             return null;\r\n91:         }\r\n92:         for (int i = 0; i < aData.length; i++) {\r\n93:             int v = aData