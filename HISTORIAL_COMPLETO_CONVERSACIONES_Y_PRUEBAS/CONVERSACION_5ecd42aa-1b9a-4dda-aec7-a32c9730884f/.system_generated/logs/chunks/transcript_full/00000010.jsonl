spatcher.cfgWrite(szSection, aData, iValue);\n171: \t}\t\n172: \t//add end\n173: \t\n174: \tpublic int SetConfigString(String szSection, String szKey, String szValue){\n175: \t\treturn cfgmanager.putString(szSection, szKey, szValue);\n176: \t}\n177: \n178: \tpublic int SetConfigInteger(String szSection, String szKey, int iValue){\n179: \t\tLog.d(TAG, FILE + \" [SetConfigInteger] section = \" + szSection + \", Key = \" + szKey + \"value = \" + iValue);\n180: \t\treturn cfgmanager.putInteger(szSection, szKey, iValue);\n181: \t}\n182: \n183: \tpublic static final String defaultStbConfig= \"/system/etc/stbconfig_bak\";\n184: \tpublic int UpdateConfigFromFs(String szFsFileName){\n185: \t\treturn cfgmanager.UpdateConfigFromFs(szFsFileName);\n186: \t}\n187: \t\n188: \t//0:CONNECTING, 2:FAILED, 3:SUCC other:FAILED\n189: \tpublic int getConnectState(int nettype)\t{\n190: \t\ttry{\n191: \t\t\tbyte szData[] = new byte[4];\n192: \t\t\tbyte aReply[] = new byte[4*3];\n193: \t\t\tint iReplyLen[] = new int[1];\n194: \t\t\tiReplyLen[0] = 4*3;\n195: \t\t\t\n196: \t\t\tLog.d(TAG, FILE + \" [getConnectState] Before getConnectState()...... pid=\" + Process.myPid() + \",tid = \" + Process.myTid()+\",uid=\"+Process.myUid() \n197: \t\t\t\t+ \", McspEvt.CMD_NA_GETCONNECTSTATE = 0x\"+ Integer.toHexString(McspEvt.CMD_NA_GETCONNECTSTATE));\n198: \t\t\tint iRet = compCom.MCSP_InvokeService(NETACCESS, McspEvt.CMD_NA_GETCONNECTSTATE, szData, szData.length, aReply, iReplyLen);\t\t\t\t\t\t\n199: \t\t\tif (-1 == iRet){\n200: \t\t\t\tLog.e(TAG, FILE + \" [getConnectState] compCom.MCSP_InvokeService error!!!\");\n201: \t\t\t\treturn -1;\n202: \t\t\t}\n203: \t\t\tByteBuffer buffer = ByteBuffer.wrap(aReply);\n204: \t\t\tbuffer.order(ByteOrder.nativeOrder());\n205: \t\t\tint sessionID = buffer.getInt();\n206: \t\t\tint returnResult = buffer.getInt();\n207: \t\t\tint NetState = buffer.getInt();\n208: \t\t\t\n209: \t\t\tLog.d(TAG, FILE + \" [getConnectState] After getConnectState()......NetState=\"+NetState);\n210: \t\t\treturn NetState;\n211: \t\t} catch (Exception e){\n212: \t\t\tLog.e(TAG, FILE + \" [getConnectState] catch Exception!!!\");\n213: \t\t\te.printStackTrace();\n214: \t\t\treturn -1;\n215: \t\t}\n216: \t}\n217: \n218:     // added getNetHardware()  by pengzs ,to check out whether have ethernet card or network cable 2013.11.27 begin\n219: \t//0:have ethernet card or network cable.  0x75 :have no wireless card  0x76: have no network cable -1:get error\n220: \tpublic int getNetHardwareState(){\n221:         if(false == connect_ok)\n222:         {\n223:             Log.d(TAG, FILE + \"[getNetHardwareState] mcsp server didn't connect, init first\");\n224:             init();\n225:         }\n226:     \n227: \t\ttry {\n228: \t\t\tbyte szData[] = new byte[4];\n229: \t\t\tbyte aReply[] = new byte[4*3];\n230: \t\t\tint iReplyLen[] = new int[1];\n231: \t\t\tiReplyLen[0] = 4*3;\n232: \t\t\tLog.d(TAG, FILE + \" [getNetHardwareState] begin getNetHardwareState()...... pid=\" + Process.myPid() + \",tid = \" + Process.myTid()+\",uid=\"+Process.myUid());\n233: \t\t\tint iRet = compCom.MCSP_InvokeService(NETACCESS, McspEvt.CMD_NA_DETECTNETLINK, szData, szData.length, aReply, iReplyLen);\t\t\t\t\t\t\n234: \t\t\tif (-1 == iRet){\n235: \t\t\t\tLog.e(TAG, FILE + \" [getNetHardwareState] getNetHardwareState compCom.MCSP_InvokeService error!!!\");\n236: \t\t\t\treturn -1;\n237: \t\t\t}\n238: \t\t\tByteBuffer buffer = ByteBuffer.wrap(aReply);\n239: \t\t\tbuffer.order(ByteOrder.nativeOrder());\n240: \t\t\tbuffer.getInt();// skip two byes\n241: \t\t\tbuffer.getInt();\n242: \t\t\tint netHardwareState = buffer.getInt();\n243: \t\t\t\n244: \t\t\tLog.d(TAG, FILE + \" [getNetHardwareState] normal end getNetHardwareState()......netHardwareState=\"+netHardwareState);\n245: \t\t\treturn netHardwareState;\n246: \t\t} catch (Exception e){\n247: \t\t\tLog.e(TAG, FILE + \" [getNetHardwareState] getNetHardwareState catch Exception!!!\");\n248: \t\t\te.printStackTrace();\n249: \t\t\treturn -1;\n250: \t\t}\n251: \t}\n252: \t\n253:     // added getNetworkHardware()  by pengzs ,to check out whether have ethernet card or network cable 2013.11.27 end \n254: \t\n255: \t//褰撶綉缁滈厤缃湁淇敼鏃讹紝閲嶅惎缃戠粶 ,nettype鍚箟瑙佸睘鎬у畾涔夈€?\n256: \tpublic int startnet(int nettype){\n257: \t\tLog.d(TAG, FILE + \" [startnet] Before startnet()......\");\n258: \t\ttry{\n259: \t\t\tif (nettype != NET_MODE_WIRE && nettype != NET_MODE_WIRELESS && nettype != NET_MODE_BOTHCARD){\n260: \t\t\t\tLog.d(TAG, FILE + \" [startnet] input parameter error!!!\");\n261: \t\t\t\treturn -1;\n262: \t\t\t}\n263: \t\t\tbyte szData[] = new byte[1088];\n264: \t\t\tbyte aReply[] = new byte[1024];\n265: \t\t\tint iReplyLen[] = new int[1];\n266: \t\t\tiReplyLen[0] = 1024;\n267: \t\t\t\n268: \t\t\tSystem.arraycopy(UtilsInstance.intToByte(nettype), 0, szData, 0, UtilsInstance.intToByte(nettype).length);\n269: \t\t\tLog.d(TAG, FILE + \" [startnet] pid=\" + Process.myPid() + \",tid = \" + Process.myTid()+\",uid=\"+Process.myUid()\n270: \t\t\t\t+\" McspEvt.CMD_NA_STARTNETLINK=0x\"+Integer.toHexString(McspEvt.CMD_NA_STARTNETLINK) +\",nettype = \"+nettype);\n271: \t\t\tint iRet = compCom.MCSP_InvokeService(NETACCESS, McspEvt.CMD_NA_STARTNETLINK, szData, szData.length, aReply, iReplyLen);\n272: \t\t\tif (-1 == iRet){\n273: \t\t\t\tLog.e(TAG, FILE + \" [startnet] compCom.MCSP_InvokeService error!!!\");\n274: \t\t\t\treturn -1;\n275: \t\t\t}\n276: \t\t\tString strReply = new String(aReply);\n277: \t\t\tString strData = strReply.toString().trim();\n278: \t\t\tif (null == strData){\n279: \t\t\t\tLog.d(TAG, FILE + \" [startnet] return data error!!!,strData= null\");\n280: \t\t\t\treturn -1;\n281: \t\t\t} \n282: \t\t\tLog.d(TAG, FILE + \" [startnet] After startnet()......\");\n283: \t\t\treturn 0;\n284: \t\t} catch (Exception e){\n285: \t\t\tLog.e(TAG, FILE + \" [startnet] catch Exception!!!\");\n286: \t\t\te.printStackTrace();\n287: \t\t\treturn -1;\n288: \t\t}\n289: \t}\n290: \n291: \tpublic int stopnet(int nettype){\n292: \t\tL