\\\"\");\n1017:             InvokeAdbSafe(\"shell \\\"setprop ubootenv.var.lock 10100000; setprop ubootenv.var.unlock_ability 1; setprop ubootenv.var.otg_device 1; setprop persist.sys.usb.config mtp,adb\\\"\");\n1018:             InvokeAdbSafe(\"shell \\\"settings put global package_verifier_user_consent -1; settings put global package_verifier_enable 0; bmgr enable false\\\"\");\n1019: \n1020:             if (File.Exists(ENV_UNL_IMG))\n1021:             {\n1022:                 InvokeAdbSafe(\"push \\\"\" + ENV_UNL_IMG + \"\\\" /data/local/tmp/env_unlocked.img\");\n1023:                 InvokeAdbSafe(\"shell \\\"dd if=/data/local/tmp/env_unlocked.img of=/dev/block/env bs=65536 count=1 2>/dev/null; su -c 'dd if=/data/local/tmp/env_unlocked.img of=/dev/block/env bs=65536 count=1' 2>/dev/null; sync\\\"\");\n1024:             }\n1025: \n1026:             WriteColor(\"  -> Quitando Pantalla Azul de Megacable y candados ZTE...\", ConsoleColor.Cyan);\n1027:             foreach (string pkg in MEGACABLE_LOCK_PACKAGES)\n1028:             {\n1029:                 InvokeAdbSafe(\"shell \\\"cmd appops set \" + pkg + \" RUN_IN_BACKGROUND ignore; am force-stop \" + pkg + \"; pm disable-user --user 0 \" + pkg + \"; pm uninstall -k --user 0 \" + pkg + \"\\\"\");\n1030:             }\n1031: \n1032:             WriteColor(\"  -> Instalando Interfaz y Apps del Firmware Xview Liberado (DMC.v2.25)...\", ConsoleColor.Cyan);\n1033:             int totalApks = LIBERATED_FIRMWARE_UI_APKS.GetLength(0);\n1034:             for (int i = 0; i < totalApks; i++)\n1035:             {\n1036:                 string apkPath = Path.Combine(APKS_DIR, LIBERATED_FIRMWARE_UI_APKS[i, 0]);\n1037:                 if (File.Exists(apkPath))\n1038:                 {\n1039:                     WriteColor(string.Format(\"     [{0}/{1}] {2}...\", i + 1, totalApks, LIBERATED_FIRMWARE_UI_APKS[i, 1]), ConsoleColor.White);\n1040:                     InvokeAdbSafe(\"install -r -d -g \\\"\" + apkPath + \"\\\"\", 90000, true);\n1041:                 }\n1042:             }\n1043: \n1044:             WriteColor(\"  -> Activando Launcher del Firmware Xview Liberado en la TV...\", ConsoleColor.Green);\n1045:             InvokeAdbSafe(\"shell \\\"cmd package set-home-activity com.google.android.tvlauncher/.MainActivity 2>/dev/null || cmd package set-home-activity dev.dworks.apps.alauncher/.Launcher\\\"\");\n1046:             InvokeAdbSafe(\"shell \\\"settings put secure enabled_accessibility_services flar2.homebutton/flar2.homebutton.ButtonMapperService; settings put secure accessibility_enabled 1\\\"\");\n1047:             InvokeAdbSafe(\"shell \\\"input keyevent KEYCODE_WAKEUP; input keyevent KEYCODE_HOME\\\"\");\n1048:             InvokeAdbSafe(\"shell \\\"am start -a android.intent.action.MAIN -c android.intent.category.HOME\\\"\");\n1049:         }\n1050: \n1051:         static void InvokeDirectLiberatedUiTransformation()\n1052:         {\n1053:             Console.WriteLine();\n1054:             ToolResult adbRes = InvokeToolSafe(ADB_EXE, \"devices\", 2000, true);\n1055:             if (Regex.IsMatch(adbRes.Output, @\"(?m)^(\\S+)\\s+device\\b\") || ScanLocalNetworkForBoxAdb())\n1056:             {\n1057:                 ExecuteLiberatedXviewFirmwareUiTransformation();\n1058:                 WriteColor(\"\\n[PASO 4/4] ¡EXITO TOTAL! Interfaz del Firmware Xview Liberado activa en la TV.\", ConsoleColor.Green);\n1059:             }\n1060:             else\n1061:             {\n1062:                 WriteColor(\"[!] No se detecto ADB activo. Usa la Opcion [1] (4 Pasos Directos).\", ConsoleColor.Yellow);\n1063:             }\n1064:             WriteColor(\"\\nPresiona ENTER para volver: \", ConsoleColor.Gray, false);\n1065:             Console.ReadLine();\n1066:         }\n1067: \n1068:         static bool AutoPrepareConnectedUsbDrive()\n1069:         {\n1070:             try\n1071:             {\n1072:                 var drives = DriveInfo.GetDrives().Where(d => d.DriveType == DriveTyp