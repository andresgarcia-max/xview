ice = \"1\";\n216:                 }\n217: \n218:                 LogEvent(\"MENU\", \"Usuario selecciono opcion: '\" + choice + \"'\");\n219: \n220:                 switch (choice)\n221:                 {\n222:                     case \"1\":\n223:                         ExecuteFourStepDirectMission();\n224:                         break;\n225:                     case \"2\":\n226:                         AutoPrepareConnectedUsbDrive();\n227:                         WriteColor(\"\\nPresiona ENTER para volver: \", ConsoleColor.Gray, false);\n228:                         Console.ReadLine();\n229:                         break;\n230:                     case \"3\":\n231:                         InvokeDirectLiberatedUiTransformation();\n232:                         break;\n233:                     case \"4\":\n234:                         LogEvent(\"SESION\", \"Usuario salio con opcion 4.\");\n235:                         return 0;\n236:                     default:\n237:                         ExecuteFourStepDirectMission();\n238:                         break;\n239:                 }\n240:             }\n241:             return 0;\n242:         }\n243: \n244:         static void PrintMenuOptions()\n245:         {\n246:             WriteColor(\"  [1] INICIAR LIBERACION AUTOMATICA EN 4 PASOS CORTOS:\", ConsoleColor.Green, true, false);\n247:             WriteColor(\"      1. Escanear la Memoria  ->  2. Entrar en Modo Fastboot  ->  3. Inyectar Firmware  ->  4. Exito Total\", ConsoleColor.White, true, false);\n248:             WriteColor(\"  [2] Preparar Memoria USB (KINGSTON) en PC con Llaves y Firmware Liberado\", ConsoleColor.Yellow, true, false);\n249:             WriteColor(\"  [3] Aplicar Interfaz Xview Liberado directo por ADB / Red Local (:5555)\", ConsoleColor.Cyan, true, false);\n250:             WriteColor(\"  [4] Salir\", ConsoleColor.DarkGray, true, false);"}
