iteColor(\" [PASO 4/4] ¡EXITO TOTAL!\", ConsoleColor.Green);\n875:             WriteColor(\" * Secuencia completa ejecutada (Escaneo de Memoria -> Fastboot -> Inyeccion).  \", ConsoleColor.Green);\n876:             WriteColor(\" * Sistema 'super.img' + 12 particiones inyectadas y caja reiniciando a TV.     \", ConsoleColor.Green);\n877:             WriteColor(\" * Certificados Widevine L1 (factory) y MAC/Serie (cri_data) 100% protegidos.   \", ConsoleColor.Green);\n878:             WriteColor(\"================================================================================\", ConsoleColor.Green);\n879:             LogEvent(\"MISION_4_PASOS\", \"=== PASO 4/4: EXITO TOTAL COMPLETADO ===\");\n880: \n881:             WriteColor(\"\\nPresiona [ENTER] para volver al menu principal: \", ConsoleColor.Yellow, false);\n882:             Console.ReadLine();\n883:         }\n884: \n885:         static void WaitAndExecuteAdbBridgeAfterReboot(int waitSeconds)\n886:         {\n887:             Stopwatch sw = Stopwatch.StartNew();\n888:             while (sw.Elapsed.TotalSeconds < waitSeconds)\n889:             {\n890:                 ToolResult adbRes = InvokeToolSafe(ADB_EXE, \"devices\", 1200, false);\n891:                 if (!adbRes.TimedOut && Regex.IsMatch(adbRes.Output ?? \"\", @\"(?m)^(\\S+)\\s+device\\b\"))\n892:                 {\n893:                     WriteColor(\"  [+] Puente ADB USB detectado! Aplicando Interfaz Firmware Xview Liberado...\", ConsoleColor.Green);\n894:                     ExecuteLiberatedXviewFirmwareUiTransformation();\n895:                     WriteColor(\"\\n[PASO 4/4] ¡EXITO TOTAL! Interfaz del Firmware Xview Liberado activa en la TV.\", ConsoleColor.Green);\n896:                     WriteColor(\"\\nPresiona ENTER para volver al menu: \", ConsoleColor.Gray, false);\n897:                     Console.ReadLine();\n898:                     return;\n899:                 }\n900:                 Thread.Sleep(1500);\n901:             }\n902: \n903:     