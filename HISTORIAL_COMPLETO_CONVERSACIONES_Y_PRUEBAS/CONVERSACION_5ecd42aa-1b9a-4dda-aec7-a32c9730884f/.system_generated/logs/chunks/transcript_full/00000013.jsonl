lor Cyan\n601:     Write-Host \"  [5] Preparar Memoria USB (QADEBUG.ini + factory_update_param.aml) y Descifrar Logs\" -ForegroundColor Yellow\n602:     Write-Host \"  [6] Instalar Drivers USB (WorldCup VID_1B8E) o Abrir ADB AppControl GUI\" -ForegroundColor White\n603:     Write-Host \"  [0] Conectar por IP Local o Refrescar Radar USB   |   [7] Salir\" -ForegroundColor DarkGray\n604:     Write-Host \"--------------------------------------------------------------------------------\" -ForegroundColor DarkCyan\n605:     $choice = Read-Host \"Selecciona el numero de la opcion [0-7]\"\n606: \n607:     switch ($choice) {\n608:         \"0\" { Connect-AdbTarget }\n609:         \"1\" { Invoke-AutoMultiChannelJump }\n610:         \"2\" { Invoke-SafeAndroid12Flash }\n611:         \"3\" { Invoke-AppInstallerMenu }\n612:         \"4\" { Invoke-AmlogicWorldCupEngine }\n613:         \"5\" { Invoke-UsbPrepAndLogDecrypt }\n614:         \"6\" { Invoke-DriversAndGuiMenu }\n615:         \"7\" { exit 0 }\n616:         default { Start-Sleep -Milliseconds 500 }\n617:     }\n618: }"}
