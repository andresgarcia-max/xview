+3] -eq 0x18) {\n        Write-Host \"LZ4 header @ 0x$($i.ToString('X'))\"\n    }\n    # AML FIP / TOC / LZO / XZ\n    if ($bytes[$i] -eq 0xFD -and $bytes[$i+1] -eq 0x37 -and $bytes[$i+2] -eq 0x7A -and $bytes[$i+3] -eq 0x58) {\n        Write-Host \"XZ header @ 0x$($i.ToString('X'))\"\n    }\n}","WaitMsBeforeAsync":5000,"toolSummary":"Find compressed BL33 payload offset inside bootloader.img"}}]}
