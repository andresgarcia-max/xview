IPT_DIR=%~dp0\"\n35: cd /d \"%~dp0..\\..\\V2\\B866v2 Android 12\\B866v2 Android 12\\B866V2\"\n36: \n37: echo.\n38: echo [0/12] Verificando si la caja ya esta conectada en Android (ADB)...\n39: adb devices | findstr /r /c:\"device$\" >nul 2>&1\n40: if not errorlevel 1 (\n41:     echo        [+] Caja detectada en ADB! Enviando 'adb reboot bootloader' automaticamente...\n42:     adb reboot bootloader\n43: )\n44: \n45: echo [1/12] Esperando activamente en el puerto USB 2.0 a que la caja entre en Fastboot...\n46: :WAIT_FASTBOOT\n47: fastboot devices | findstr /r /c:\"fastboot\" >nul 2>&1\n48: if not errorlevel 1 goto FASTBOOT_CAUGHT\n49: adb devices | findstr /r /c:\"device$\" >nul 2>&1\n50: if not errorlevel 1 (\n51:     echo        [+] Caja detectada en ADB! Enviando 'adb reboot bootloader' automaticamente...\n52:     adb reboot bootloader\n53: )\n54: goto WAIT_FASTBOOT\n55: \n56: :FASTBOOT_CAUGHT\n57: echo [2/12] Dispositivo detectado! Apagando Watchdog, desbloqueando Bootloader y activando USB OTG...\n58: fastboot oem \"watchdog off\"\n59: fastboot flashing unlock_critical\n60: fastboot flashing unlock\n61: fastboot oem \"setenv lock 10100000;save\"\n62: fastboot oem \"setenv otg_device 1;save\"\n63: fastboot oem \"setenv lock 10100000\"\n64: fastboot oem \"setenv otg_device 1\"\n65: fastboot oem \"saveenv\"\n66: fastboot reboot bootloader\n67: \n68: echo        Esperando reconexion del bootloader...\n69: :WAIT_FASTBOOT_2\n70: fastboot devices | findstr /r /c:\"fastboot\" >nul 2>&1\n71: if errorlevel 1 goto WAIT_FASTBOOT_2\n72: fastboot oem \"watchdog off\"\n73: fastboot flashing unlock_critical\n74: fastboot flashing unlock\n75: fastboot oem \"setenv lock 10100000;save\"\n76: fastboot oem \"setenv otg_device 1;save\"\n77: fastboot getvar unlocked\n78: \n79: echo [3/12] Flasheando boot.img (100%% Oficial ZTE verificado)...\n80: fastboot flash boot boot.img\n81: \n82: echo [4/12] Flasheando _aml_dtb y dtbo.img (100%% Oficial ZTE verificado)...\n83: fastboot flash _aml_dtb dtb.img\n84: fastboot flash dtbo dtbo.img\n85: \n86: echo [5/12] OMITIENDO factory.img y cri_data.img para conservar tu Widevine L1 y MAC originales...\n87: \n88: echo [6/12] Flasheando logo.img y param.img...\n89: fastboot flash logo logo.img\n90: fastboot flash param param.img\n91: \n92: echo [7/12] Flasheando conf.img y limpiando oem.img...\n93: fastboot flash conf conf.img\n94: fastboot flash oem oem.img\n95: \n96: echo [8/12] Flasheando super.img (Android 12 liberado)...\n97: fastboot flash super super.img\n98: \n99: echo [9/12] Flasheando vbmeta.img (Flags=0x03 dm-verity desactivado)...\n100: fastboot flash vbmeta vbmeta.img\n101: \n102: echo [10/12] Flasheando recovery.img (Menu Fastboot/ADB desbloqueado en TV para MarketCode 4301)...\n103: fastboot flash recovery recovery.img\n104: \n105: echo [11/12] Reparando particion /cache con superbloque ext4 valido (cache_ext4.img)...\n106: fastboot erase cache\n107: fastboot flash cache \"%SCRIPT_DIR%cache_ext4.img\"\n108: \n109: echo [12/12] Limpiando userdata y reiniciando...\n110: fastboot erase userdata\n111: fastboot reboot\n112: \n113: echo.\n114: echo [COMPLETADO] Tu caja Xview B866V2 se reiniciara en Android 12 con USB OTG (otg_device=1),\n115: echo              menu completo de Recovery en TV y particion /cache reparada.\n116: pause"}
