     string targetUsb = drv + \":\\\\\";\n1250:                 if (Directory.Exists(targetUsb))\n1251:                 {\n1252:                     foreach (string f in Directory.GetFiles(KEYS_DIR))\n1253:                     {\n1254:                         File.Copy(f, Path.Combine(targetUsb, Path.GetFileName(f)), true);\n1255:                     }\n1256:                     string[] launcherApks = new[]\n1257:                     {\n1258:                         \"Home_Screen_Launcher_1.1.3.apk\",\n1259:                         \"TVLauncher_4_GoogleTV.apk\",\n1260:                         \"Button_Mapper_Pro_2.54.apk\",\n1261:                         \"Filemanager.apk\",\n1262:                         \"autostart.apk\"\n1263:                     };\n1264:                     foreach (string apk in launcherApks)\n1265:                     {\n1266:                         string src = Path.Combine(APKS_DIR, apk);\n1267:                         if (File.Exists(src)) File.Copy(src, Path.Combine(targetUsb, apk), true);\n1268:                     }\n1269:                     WriteColor(\"[OK] Llaves QADEBUG.ini, factory_update_param.aml y Launchers copiados a \" + targetUsb, ConsoleColor.Green);\n1270:                 }\n1271:                 else\n1272:                 {\n1273:                     WriteColor(\"[!] No existe la unidad \" + targetUsb, ConsoleColor.Red);\n1274:                 }\n1275:             }\n1276:             else if (op == \"2\")\n1277:             {\n1278:                 WriteColor(\"Escribe la letra de la memoria USB donde estan los logs (ej. D): \", ConsoleColor.Yellow, false);\n1279:                 string drv = (Console.ReadLine() ?? \"\").Replace(\":\", \"\").Replace(\"\\\\\", \"\").Trim();\n1280:                 string logFolder = drv + \":\\\\LOG_ZTESTB_OFF\";\n1281:                 if (Directory.Exists(logFolder))\n1282:                 {\n1283:                     string encStr = \"5;8|\\\"79+3(&16-409876543210/.-,+*)('&%$#\\\"! ~}|{zyxwvutsrqponmlkjihgfedcba`_^]\\\\[ZYXWVUTSRQPONMLKJIHGFEDCBA@?>=<;:9876543210/.-,+*)('&%$#\\\"! \";\n1284:                     string decStr = \" ~}|{zyxwvutsrqponmlkjihgfedcba`_^]\\\\[ZYXWVUTSRQPONMLKJIHGFEDCBA@?>=<;:9876543210/.-,+*)('&%$#\\\"! 5;8|\\\"79+3(&16-409876543210/.-,+*)('&%$#\\\"!\";\n1285:                     byte[] lut = new byte[256];\n1286:                     for (int i = 0; i < 256; i++) lut[i] = (byte)i;\n1287:                     for (int i = 0; i < encStr.Length; i++)\n1288:                     {\n1289:                         byte e = (byte)encStr[i];\n1290:                         byte d = (byte)decStr[i];\n1291:                         if (lut[e] == e) lut[e] = d;\n1292:                     }\n1293: \n1294:                     string outDir = Path.Combine(ROOT_DIR, \"LOGS_DESCIFRADOS_CAJA\");\n1295:                     Directory.CreateDirectory(outDir);\n1296:                     foreach (string f in Directory.GetFiles(logFolder, \"U_*\"))\n1297:                     {\n1298:                         string fName = Path.GetFileName(f);\n1299:                         WriteColor(\"[+] Descifrando \" + fName + \"...\", ConsoleColor.Cyan);\n1300:                         byte[] raw = File.ReadAllBytes(f);\n1301:                         byte[] outBytes = new byte[raw.Length];\n1302:                         for (int i = 0; i < raw.Length; i++) outBytes[i] = lut[raw[i]];\n1303:                         string destFile = Path.Combine(outDir, fName + \"_DEC.log\");\n1304:                         File.WriteAllBytes(destFile, outBytes);\n1305:                         WriteColor(\"  -> Guardado en: \" + destFile, ConsoleColor.Green);\n1306:                     }\n1307:                 }\n1308:                 else\n1309:                 {\n1310:                     WriteColor(\"[!] No se encontro la carpeta \" + logFolder, ConsoleColor.Red);\n1311:                 }\n1312:             }\n1313:             WriteColor(\"\\nPresiona ENTER para volver al men