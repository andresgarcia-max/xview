watch.StartNew();\n740:                     while (swWc.Elapsed.TotalSeconds < 6.0)\n741:                     {\n742:                         ToolResult fbAfterWc = InvokeFastbootSafe(\"devices\", 800, false);\n743:                         Match mWc = Regex.Match(fbAfterWc.Output ?? \"\", @\"(?m)^(\\S+)\\s+fastboot\");\n744:                         if (mWc.Success)\n745:                         {\n746:                             caughtSerial = mWc.Groups[1].Value;\n747:                             caughtMode = \"FASTBOOT\";\n748:                             break;\n749:                         }\n750:                         Thread.Sleep(150);\n751:                     }\n752:                     break;\n753:                 }\n754: \n755:                 if ((DateTime.Now - lastJumpToBl).TotalSeconds < 2.5)\n756:                 {\n757:                     Thread.Sleep(60);\n758:                     continue;\n759:                 }\n760: \n761:                 // B. Verificar Fastboot (Recovery PID_4EE7 o U-Boot PID_0D02) en cada ciclo\n762:                 ToolResult fbDevs = InvokeFastbootSafe(\"devices\", 800, false);\n763:                 if (!fbDevs.TimedOut && !string.IsNullOrWhiteSpace(fbDevs.Output))\n764:                 {\n765:                     Match mFb = Regex.Match(fbDevs.Output, @\"(?m)^(\\S+)\\s+fastboot\");\n766:                     if (mFb.Success)\n767:                     {\n768:                         string fbSn = mFb.Groups[1].Value;\n769:                         ToolResult ping = InvokeFastbootSafe(\"getvar version-bootloader\", 800, false);\n770:                         if (!ping.TimedOut && (\n771:                             ping.Output.IndexOf(\"version-bootloader\", StringComparison.OrdinalIgnoreCase) >= 0 ||\n772:                             ping.Output.IndexOf(\"OKAY\", StringComparison.OrdinalIgnoreCase) >= 0 ||\n773:                             ping.Output.IndexOf(\"Finished\", StringComparison.OrdinalIgnoreCase) >= 0))\n774:                         {\n775:                             ToolResult uCheck = InvokeFastbootSafe(\"getvar is-userspace\", 900, true);\n776:                             if (Regex.IsMatch(uCheck.Output ?? \"\", @\"is-userspace:\\s*yes\", RegexOptions.IgnoreCase))\n777:                             {\n778:                                 WriteColor(\"  [+] Detectado Recovery Fastbootd (PID_4EE7 / \" + fbSn + \") -> Saltando a Bootloader sin TTL...\", ConsoleColor.Green);\n779:                                 InvokeFastbootSafe(\"oem 'setenv lock 10100000;save\", 1000, true);\n780:                                 InvokeFastbootSafe(\"reboot bootloader\", 2500, true);\n781:                                 lastJumpToBl = DateTime.Now;\n782:                                 continue;\n783:                             }\n784: \n785:                             // Ya estamos en U-Boot Fastboot (PID_0D02)!\n786:                             caughtSerial = fbSn;\n787:                             caughtMode = \"FASTBOOT\";\n788:                             WriteColor(\"  [OK] Modo U-Boot Fastboot Activo y Retenido (PID_0D02 / Serie: \" + caughtSerial + \")!\", ConsoleColor.Green);\n789:                             break;\n790:                         }\n791:                     }\n792:                 }\n793: \n794:                 // C. Verificar si la caja abrio ADB USB directo (cada 1.8 segundos para no frenar el radar Fastboot/WorldCup)\n795:                 if ((DateTime.Now - lastAdbCheck).TotalSeconds >= 1.8)\n796:                 {\n797:                     lastAdbCheck = DateTime.Now;\n798:                     ToolResult adbRes = InvokeToolSafe(ADB_EXE, \"devices\", 1000, false);\n799:                     if (!adbRes.TimedOut && !string.IsNullOrWhiteSpace(adbRes.Output))\n800:                     {\n801:                         Match mAdb = Regex.Match(adbRes.Output, @\"(?m)^([^\\s:]+)\\s+device\\b\");\n802:                         if (mAdb.Success)\n803:                         {\n804:                             caughtSerial = mAdb.Groups[1].Value;\n805:                             caughtMode = \"ADB\";\n806:                             WriteColor(\"  [OK] Puente ADB USB Activo (\" + caughtSerial + \") -> Desbloqueando env e instalando Firmware Liberado...\", ConsoleColor.Green);\n807:                             break;\n808:                         }\n809:                     }\n810:                 }\n811: \n812:                 Thread.Sleep(35);\n813:             }\n814: \n815:             // --------------------------------------------------------------------------\n816:             // PASO 3/4: INYECTANDO FIRMWARE\n817:             // --------------------------------------------------------------------------\n818:             Console.WriteLine();\n819:             WriteColor(\"================================================================================\", ConsoleColor.Magenta);\n820:             WriteColor(\" [PASO 3/4] INYECTANDO FIRMWARE XVIEW LIBERADO...\", ConsoleColor.Magenta);\n821:             WriteColor(\"================================================================================\", ConsoleColor.Magenta);\n822: \n823:             if (caughtMode == \"ADB\")\n824:             {\n825:                 ExecuteLiberatedXviewFirmwareUiTransformation();\n826:             }\n827:             else if (caughtMode == \"WORLDCUP_FLASHED\" && string.IsNullOrEmpty(caughtSerial))\n828:             {\n829:                 WriteColor(\"  [OK] Particiones clave e imagen 'env_unlocked.img' inyectadas directamente por Amlogic WorldCup (VID_1B8E)!\", ConsoleColor.Green);\n830:             }\n831:             else\n832:             {\n833:                 WriteColor(\"  -> Ejecutando desbloqueo EVOCA sin TTL y reteniendo Watchdog...\", ConsoleColor.Cyan);\n834:                 InvokeFastbootSafe(\"getvar version-bootloader\", 800, false);\n835:                 InvokeFastbootSafe(\"oem \\\"watchdog off\\\"\", 1000, true);\n836:    