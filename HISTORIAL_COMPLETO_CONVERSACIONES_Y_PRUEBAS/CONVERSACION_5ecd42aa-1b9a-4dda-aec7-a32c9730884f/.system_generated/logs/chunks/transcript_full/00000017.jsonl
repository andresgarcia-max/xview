= ConsoleKey.Escape) return;\n                }\n\n                tick++;\n\n                // 1. Caza directa WorldCup cada 48ms\n                if (TryCatchWorldCup48ms())\n                {\n                    lastRebootToBl = DateTime.Now;\n                    continue;\n                }\n\n                if ((DateTime.Now - lastRebootToBl).TotalSeconds < 3.2)\n                {\n                    Thread.Sleep(50);\n                    continue;\n                }\n\n                // 2. Cada 6 ticks (~300ms), verificar Fastboot y ADB\n                if ((tick % 6) == 0)\n                {\n                    ToolResult fbDevs = InvokeFastbootSafe(\"devices\", 1200);\n                    if (!fbDevs.TimedOut)\n                    {\n                        Match mFb = Regex.Match(fbDevs.Output, @\"(?m)^(\\S+)\\s+fastboot\");\n                        if (mFb.Success)\n                        {\n                            string fbSn = mFb.Groups[1].Value;\n                            ToolResult ping = InvokeFastbootSafe(\"getvar version-bootloader\", 900);\n                            if (!ping.TimedOut && (\n                                ping.Output.IndexOf(\"version-bootloader\", StringComparison.OrdinalIgnoreCase) >= 0 ||\n                                ping.Output.IndexOf(\"OKAY\", StringComparison.OrdinalIgnoreCase) >= 0 ||\n                                ping.Output.IndexOf(\"Finished\", StringComparison.OrdinalIgnoreCase) >= 0))\n                            {\n                                ToolResult uCheck = InvokeFastbootSafe(\"getvar is-userspace\", 1200);\n                                if (Regex.IsMatch(uCheck.Output, @\"is-userspace:\\s*yes\", RegexOptions.IgnoreCase))\n                                {\n                                    Console.WriteLine();\n                                    WriteColor(\"[+] Detectado Recovery Fastbootd (PID_4EE7 / \" + fbSn + \")!\", ConsoleColor.Yellow);\n                                    if (File.Exists(ENV_UNL_IMG))\n                                    {\n                                        WriteColor(\"    Probando desbloqueo directo de 'env' en fastbootd...\", ConsoleColor.Cyan);\n                                        InvokeFastbootSafe(\"flashing unlock\", 1500);\n                                        InvokeFastbootSafe(\"flashing unlock_critical\", 1500);\n                                        InvokeFastbootSafe(\"flash env \\\"\" + ENV_UNL_IMG + \"\\\"\", 2500);\n                                    }\n                                    WriteColor(\"    Saltando a U-Boot Bootloader (PID_0D02) y activando caza WorldCup...\", ConsoleColor.Cyan);\n                                    InvokeFastbootSafe(\"reboot bootloader\", 2500);\n                                    lastRebootToBl = DateTime.Now;\n                                    continue;\n                                }\n\n                                Console.WriteLine();\n                                WriteColor(\"[+] Caja atrapada en U-Boot Fastboot en vivo (Serie: \" + fbSn + \")!\", ConsoleColor.Green);\n                                WriteColor(\"    Reteniendo Watchdog y ejecutando secuencia de desbloqueo limpia...\", ConsoleColor.Cyan);\n\n                                InvokeFastbootSafe(\"flashing get_unlock_ability\", 1500);\n                                InvokeFastbootSafe(\"flashing unlock_critical\", 1500);\n                                InvokeFastbootSafe(\"flashing unlock\", 1500);\n                                InvokeFastbootSafe(\"oem \\\"watchdog off\\\"\", 1200);\n                                InvokeFastbootSafe(\"oem \\\"setenv lock 10100000;save\\\"\", 1200);\n                                InvokeFastbootSafe(\"oem \\\"setenv otg_device 1;save\\\"\", 1200);\n                                InvokeFastbootSafe(\"oem \\\"saveenv\\\"\", 1200);\n\n                                ToolResult unlRes = InvokeFastbootSafe(\"getvar unlocked\", 1500);\n                                bool isUnlocked = Regex.IsMatch(unlRes.Output, @\"unlocked:\\s*yes\", RegexOptions.IgnoreCase);\n\n                                if (!isUnlocked)\n                                {\n                                    string dtbPath = Path.Combine(FW_DIR, \"dtb.img\");\n                                    if (File.Exists(dtbPath))\n                                    {\n                                        ToolResult testWrite = InvokeFastbootSafe(\"flash _aml_dtb \\\"\" + dtbPath + \"\\\"\", 2500);\n                                        if (!testWrite.TimedOut && testWrite.ExitCode == 0 &&\n                                            testWrite.Output.IndexOf(\"OKAY\", StringComparison.OrdinalIgnoreCase) >= 0 &&\n                                            testWrite.Output.IndexOf(\"FAILED\", StringComparison.OrdinalIgnoreCase) < 0 &&\n                                            testWrite.Output.IndexOf(\"locked device\", StringComparison.OrdinalIgnoreCase) < 0)\n                                        {\n                                            isUnlocked = true;\n                                        }\n                                    }\n                                }\n\n                                if (isUnlocked)\n                                {\n                                    Console.WriteLine();\n                                    WriteColor(\"================================================================================\", ConsoleColor.Green);\n                                    WriteColor(\" [OK] BOOTLOADER 100% DESBLOQUEADO (unlocked: yes) Y WATCHDOG RETENIDO          \", ConsoleColor.Green);\n                                    WriteColor(\"================================================================================\", ConsoleColor.Green);\n                                    WriteColor(\"  [1] Flashear ahora mismo Android 12 Liberado Completo (Conservando Widevine L1 y MAC)\", ConsoleColor.Magenta);\n                                    WriteColor(\"  [2] Inyectar vbmeta desbloqueado + recovery desbloqueado + cache_ext4 y reiniciar\", ConsoleColor.Cyan);\n                                    WriteColor(\"  [3] Dejar en Fastboot y volver al menu\", ConsoleColor.Gray);\n                                    Console.WriteLine();\n\n                                    string next = ReadChoiceWithKeepAlive(\"Elige 1, 2 o 3\", new[] { \"1\", \"2\", \"3\" });\n                                    if (next == \"1\")\n                                    {\n                                        InvokeSafeAndroid12Flash(true);\n                                    }\n                                    else if (next == \"2\")\n                                    {\n                                        InvokeQuickUnlockPartitionsFlash();\n                                    }\n                                    break;\n                                }\n                                else\n                                {\n                                    bool unlockedViaWc = StartDedicatedWorldCupHuntFromLockedFastboot();\n                                    if (unlockedViaWc)\n                                    {\n                                        lastRebootToBl = DateTime.Now;\n                                        continue;\n                                    }\n                                    else\n                                    {\n                                        break;\n                                    }\n                                }\n                            }\n                        }\n                    }\n\n                    // 3. Verificar sesion ADB activa\n                    ToolResult adbRes = InvokeToolSafe(ADB_EXE, \"devices\", 1500);\n                    if (!adbRes.TimedOut)\n                    {\n                        if (Regex.IsMatch(adbRes.Output, @\"(?m)^(\\S+)\\s+unauthorized\"))\n                        {\n                            WriteColor(\"[!] Acepta el cartel 'Permitir Depuracion por USB' en tu TV...\", ConsoleColor.Yellow);\n                        }\n                        else\n                        {\n                            Match mAdb = Regex.Match(adbRes.Output, @\"(?m)^(\\S+)\\s+device\\b\");\n                            if (mAdb.Success)\n                            {\n                                string adbId = mAdb.Groups[1].Value;\n                                Console.WriteLine();\n                                WriteColor(\"[+] Detectada sesion ADB activa (\" + adbId + \")! Ejecutando liberacion...\", ConsoleColor.Green);\n                                ExecuteAdbPayload();\n                                break;\n                            }\n                        }\n                    }\n                }\n\n                Thread.Sleep(20);\n            }\n\n            WriteColor(\"\\nPresiona ENTER para volver al menu: \", ConsoleColor.Gray, false);\n            Console.ReadLine();\n        }\n\n        static void InvokeSafeAndroid12Flash(bool alreadyInFastboot)\n        {\n            Console.WriteLine();\n            WriteColor(\"================================================================================\", ConsoleColor.Magenta);\n            WriteColor(\"   OPCION 2: FLASHEO SEGURO ANDROID 12 (B866V2) SIN PERDER WIDEVINE L1 / MAC   \", ConsoleColor.Magenta);\n            WriteColor(\"================================================================================\", ConsoleColor.Magenta);\n            WriteColor(\"  * Salta por completo el bloqueo de Megacable y el candado QR RSA-2048 de ZTE.\", ConsoleColor.Green);\n            WriteColor(\"  * Protege 100% tus particiones 'factory' (Widevine L1) y 'cri_data' (MAC/Serie).\", ConsoleColor.Green);\n            WriteColor(\"  * Repara la particion /cache con 'cache_ext4.img' e instala Recovery desbloqueado.\", ConsoleColor.Green);\n            Console.WriteLine();\n\n            string superPath = Path.Combine(FW_DIR, \"super.img\");\n            if (!File.Exists(superPath))\n            {\n                string[] candidates = new string[]\n                {\n                    @\"D:\\B866v2 Android 12\\B866v2 Android 12\\B866V2\\super.img\",\n                    @\"E:\\B866v2 Android 12\\B866v2 Android 12\\B866V2\\super.img\",\n                    @\"F:\\B866v2 Android 12\\B866v2 Android 12\\B866V2\\super.img\",\n                    @\"C:\\Users\\andre\\OneDrive\\Desktop\\xview\\V2\\B866v2 Android 12\\B866v2 Android 12\\B866V2\\super.img\",\n                    @\"C:\\Users\\andre\\OneDrive\\Desktop\\xview\\FIRMWARE_COMPLETO_B866V2_FASTBOOT\\super.img\"\n                };\n                foreach (string c in candidates)\n                {\n                    if (File.Exists(c)) { superPath = c; break; }\n                }\n            }\n\n            if (!alreadyInFastboot)\n            {\n                WriteColor(\"[1/12] Escuchando WorldCup (48ms) o Fastboot (Manten RESET al conectar corriente)... (ESC para cancelar)\", ConsoleColor.Cyan);\n                DateTime lastJump = DateTime.MinValue;\n                while (true)\n                {\n                    if (Console.KeyAvailable && Console.ReadKey(true).Key == ConsoleKey.Escape) return;\n\n                    if (TryCatchWorldCup48ms())\n                    {\n                        lastJump = DateTime.Now;\n                        continue;\n                    }\n                    if ((DateTime.Now - lastJump).TotalSeconds < 3.2)\n                    {\n                        Thread.Sleep(50);\n                        continue;\n                    }\n                    ToolResult fbRes = InvokeFastbootSafe(\"devices\", 1200);\n                    if (!fbRes.TimedOut && Regex.IsMatch(fbRes.Output, @\"(?m)^(\\S+)\\s+fastboot\"))\n                    {\n                        ToolResult ping = InvokeFastbootSafe(\"getvar version-bootloader\", 900);\n                        if (!ping.TimedOut && (\n                            ping.Output.IndexOf(\"version-bootloader\", StringComparison.OrdinalIgnoreCase) >= 0 ||\n                            ping.Output.IndexOf(\"OKAY\", StringComparison.OrdinalIgnoreCase) >= 0 ||\n                            ping.Output.IndexOf(\"Finished\", StringComparison.OrdinalIgnoreCase) >= 0))\n                        {\n                            ToolResult uCheck = InvokeFastbootSafe(\"getvar is-userspace\", 1200);\n                            if (Regex.IsMatch(uCheck.Output, @\"is-userspace:\\s*yes\", RegexOptions.IgnoreCase))\n                            {\n                                WriteColor(\"  -> Detectado fastbootd (Recovery), saltando a Bootloader U-Boot...\", ConsoleColor.Yellow);\n                                InvokeFastbootSafe(\"reboot bootloader\", 2500);\n                                lastJump = DateTime.Now;\n                                continue;\n                            }\n                            break;\n                        }\n                    }\n                    Thread.Sleep(35);\n                }\n            }\n\n            WriteColor(\"[2/12] Verificando desbloqueo del Bootloader y reteniendo Watchdog...\", ConsoleColor.Cyan);\n            InvokeFastbootSafe(\"flashing unlock_critical\", 1500);\n            InvokeFastbootSafe(\"flashing unlock\", 1500);\n            InvokeFastbootSafe(\"oem \\\"watchdog off\\\"\", 1200);\n            InvokeFastbootSafe(\"oem \\\"setenv lock 10100000;save\\\"\", 1200);\n            InvokeFastbootSafe(\"oem \\\"setenv otg_device 1;save\\\"\", 1200);\n            InvokeFastbootSafe(\"oem \\\"saveenv\\\"\", 1200);\n\n            ToolResult dtbTest = InvokeFastbootSafe(\"flash _aml_dtb \\\"\" + Path.Combine(FW_DIR, \"dtb.img\") + \"\\\"\", 2500);\n            if (dtbTest.TimedOut ||\n                dtbTest.Output.IndexOf(\"FAILED\", StringComparison.OrdinalIgnoreCase) >= 0 ||\n                dtbTest.Output.IndexOf(\"locked device\", StringComparison.OrdinalIgnoreCase) >= 0)\n            {\n                Console.WriteLine();\n                WriteColor(\"[!] El bootloader aun reporta lock=10001000. Iniciando desbloqueo por WorldCup (48ms)...\", ConsoleColor.Yellow);\n                bool okWc = StartDedicatedWorldCupHuntFromLockedFastboot();\n                if (!okWc) return;\n            }\n\n            if (!File.Exists(superPath))\n            {\n                Console.WriteLine();\n                WriteColor(\"[+] La caja esta retenida en Fastboot con Keep-Alive activo.\", ConsoleColor.Green);\n                WriteColor(\"    Si deseas incluir 'super.img' (1.88 GB), inserta tu memoria USB KINGSTON en la PC\", ConsoleColor.Yellow);\n                WriteColor(\"    y presiona [1], o presiona [2] para flashear las demas particiones ahora.\", ConsoleColor.Yellow);\n                string cSup = ReadChoiceWithKeepAlive(\"Elige 1 (Buscar super.img en USB) o 2 (Continuar)\", new[] { \"1\", \"2\" });\n                if (cSup == \"1\")\n                {\n                    foreach (string drv in new[] { \"D\", \"E\", \"F\", \"G\", \"H\" })\n                    {\n                        string tryPath = drv + @\":\\B866v2 Android 12\\B866v2 Android 12\\B866V2\\super.img\";\n                        if (File.Exists(tryPath)) { superPath = tryPath; break; }\n                    }\n                }\n            }\n\n            WriteColor(\"[5/12] PROTEGIENDO factory.img (Widevine L1) y cri_data.img (MAC/Serie) - OMITIDOS POR SEGURIDAD.\", ConsoleColor.Green);\n\n            var flashSteps = new[]\n            {\n                new { Step = \"[3/12]\",  Part = \"boot\",     File = Path.Combine(FW_DIR, \"boot.img\"),  Timeout = 30000 },\n                new { Step = \"[4/12]\",  Part = \"_aml_dtb\", File = Path.Combine(FW_DIR, \"dtb.img\"),   Timeout = 10000 },\n                new { Step = \"[4B/12]\", Part = \"dtbo\",     File = Path.Combine(FW_DIR, \"dtbo.img\"),  Timeout = 15000 },\n                new { Step = \"[6/12]\",  Part = \"logo\",     File = Path.Combine(FW_DIR, \"logo.img\"),  Timeout = 10000 },\n                new { Step = \"[6B/12]\", Part = \"param\",    File = Path.Combine(FW_DIR, \"param.img\"), Timeout = 20000 },\n                new { Step = \"[7/12]\",  Part = \"conf\",     File = Path.Combine(FW_DIR, \"conf.img\"),  Timeout = 15000 },\n                new { Step = \"[7B/12]\", Part = \"oem\",      File = Path.Combine(FW_DIR, \"oem.img\"),   Timeout = 25000 }\n            };\n\n            foreach (var fs in flashSteps)\n            {\n                if (File.Exists(fs.File))\n                {\n                    WriteColor(fs.Step + \" Flasheando '\" + fs.Part + \"'...\", ConsoleColor.Cyan);\n                    ToolResult r = InvokeFastbootSafe(\"flash \" + fs.Part + \" \\\"\" + fs.File + \"\\\"\", fs.Timeout);\n                    InvokeFastbootSafe(\"getvar version-bootloader\", 1200);\n                    if (!r.TimedOut && r.ExitCode == 0 &&\n                        r.Output.IndexOf(\"FAILED\", StringComparison.OrdinalIgnoreCase) < 0 &&\n                        r.Output.IndexOf(\"locked device\", StringComparison.OrdinalIgnoreCase) < 0)\n                    {\n                        WriteColor(\"       [OKAY] \" + fs.Part, ConsoleColor.Green);\n                    }\n                    else\n                    {\n                        WriteColor(\"       [AVISO] \" + fs.Part + \": \" + r.Output.Replace(\"\\r\", \" \").Replace(\"\\n\", \" \"), ConsoleColor.Yellow);\n                    }\n                }\n            }\n\n            if (File.Exists(superPath))\n            {\n                WriteColor(\"[8/12] Flasheando super.img (Android 12 Liberado B866V2 - puede tardar ~90s)...\", ConsoleColor.Cyan);\n                InvokeToolInteractive(FASTBOOT_EXE, \"flash super \\\"\" + superPath + \"\\\"\");\n                InvokeFastbootSafe(\"getvar version-bootloader\", 1200);\n            }\n            else\n            {\n                WriteColor(\"[!] No se encontro super.img en la PC, omitiendo paso 8...\", ConsoleColor.Yellow);\n            }\n\n            WriteColor(\"[9/12] Flasheando vbmeta.img (dm-verity desactivado flags=0x03)...\", ConsoleColor.Cyan);\n            InvokeFastbootSafe(\"flash vbmeta \\\"\" + Path.Combine(FW_DIR, \"vbmeta.img\") + \"\\\"\", 15000);\n\n            WriteColor(\"[10/12] Flasheando recovery.img (Menu Fastboot/ADB desbloqueado en TV)...\", ConsoleColor.Cyan);\n            InvokeFastbootSafe(\"flash recovery \\\"\" + Path.Combine(FW_DIR, \"recovery.img\") + \"\\\"\", 35000);\n\n            WriteColor(\"[11/12] Reparando particion /cache con cache_ext4.img...\", ConsoleColor.Cyan);\n            InvokeFastbootSafe(\"erase cache\", 10000);\n            InvokeFastbootSafe(\"flash cache \\\"\" + Path.Combine(FW_DIR, \"cache_ext4.img\") + \"\\\"\", 35000);\n\n            WriteColor(\"[12/12] Limpiando userdata y reiniciando...\", ConsoleColor.Cyan);\n            InvokeFastbootSafe(\"erase userdata\", 15000);\n            InvokeFastbootSafe(\"reboot\", 4000);\n\n            Console.WriteLine();\n            WriteColor(\"[COMPLETADO!] Proceso finalizado (con Widevine L1 y MAC intactos).\", ConsoleColor.Green);\n            WriteColor(\"\\nPresiona ENTER para volver al menu: \", ConsoleColor.Gray, false);\n            Console.ReadLine();\n        }\n\n        static void InvokeAppInstallerMenu()\n        {\n            Console.WriteLine();\n            WriteColor(\"=== OPCION 3: INSTALADOR DE APPS DE TV Y ENTRETENIMIENTO (OFFLINE DESDE PC) ===\", ConsoleColor.Yellow);\n            if (!Directory.Exists(APKS_DIR))\n            {\n                WriteColor(\"[!] No se encontro el directorio de APKs.\", ConsoleColor.Red);\n                return;\n            }\n            FileInfo[] apks = new DirectoryInfo(APKS_DIR).GetFiles(\"*.apk\");\n            for (int i = 0; i < apks.Length; i++)\n            {\n                double sizeMB = Math.Round(apks[i].Length / (1024.0 * 1024.0), 2);\n                WriteColor(string.Format(\"  [{0}] {1} ({2} MB)\", i + 1, apks[i].Name, sizeMB), ConsoleColor.White);\n            }\n            WriteColor(\"  [T] INSTALAR TODAS LAS APPS DE LA LISTA\", ConsoleColor.Green);\n            WriteColor(\"  [0] Volver al menu principal\", ConsoleColor.Gray);\n            Console.WriteLine();\n            WriteColor(\"Elige el numero de la app a instalar (o 'T' para todas): \", ConsoleColor.Yellow, false);\n            string sel = (Console.ReadLine() ?? \"\").Trim();\n            if (sel == \"0\" || string.IsNullOrEmpty(sel)) return;\n\n            if (sel.Equals(\"T\", StringComparison.OrdinalIgnoreCase))\n            {\n                foreach (FileInfo a in apks)\n                {\n                    WriteColor(\"[+] Instalando \" + a.Name + \"...\", ConsoleColor.Cyan);\n                    InvokeAdbInteractive(\"install -r -g \\\"\" + a.FullName + \"\\\"\");\n                }\n            }\n            else\n            {\n                int idx;\n                if (int.TryParse(sel, out idx))\n                {\n                    idx -= 1;\n                    if (idx >= 0 && idx < apks.Length)\n                    {\n                        WriteColor(\"[+] Instalando \" + apks[idx].Name + \"...\", ConsoleColor.Cyan);\n                        InvokeAdbInteractive(\"install -r -g \\\"\" + apks[idx].FullName + \"\\\"\");\n                    }\n                }\n            }\n            WriteColor(\"\\nPresiona ENTER para volver al menu: \", ConsoleColor.Gray, false);\n            Console.ReadLine();\n        }\n\n        static void InvokeAmlogicWorldCupEngine()\n        {\n            Console.WriteLine();\n            WriteColor(\"================================================================================\", ConsoleColor.Cyan);\n            WriteColor(\"   OPCION 4: MOTOR AMLOGIC DNL / WORLDCUP (adnl.exe + update.exe VID_1B8E)      \", ConsoleColor.Cyan);\n            WriteColor(\"================================================================================\", ConsoleColor.Cyan);\n            WriteColor(\"  [1] Activar Caza Continua WorldCup (48ms) -> Desbloquear env_unlocked.img y saltar a Fastboot\", ConsoleColor.Green);\n            WriteColor(\"  [2] Escanear dispositivo en modo WorldCup / ADNL ahora mismo\", ConsoleColor.White);\n            WriteColor(\"  [3] Reiniciar caja desde modo ADNL / WorldCup\", ConsoleColor.White);\n            WriteColor(\"  [0] Volver al menu principal\", ConsoleColor.Gray);\n            Console.WriteLine();\n            WriteColor(\"Elige una opcion: \", ConsoleColor.Yellow, false);\n            string sub = (Console.ReadLine() ?? \"\").Trim();\n\n            if (sub == \"1\")\n            {\n                WriteColor(\"\\n[*] Escuchando modo WorldCup / InUsbBurn cada 48ms (Manten RESET al conectar corriente)... (ESC para salir)\", ConsoleColor.Green);\n                while (true)\n                {\n                    if (Console.KeyAvailable && Console.ReadKey(true).Key == ConsoleKey.Escape) break;\n                    if (TryCatchWorldCup48ms())\n                    {\n                        WriteColor(\"[OK] Caja desbloqueada y enviada a Fastboot (PID_0D02)!\", ConsoleColor.Green);\n                        break;\n                    }\n                    Thread.Sleep(25);\n                }\n            }\n            else if (sub == \"2\")\n            {\n                WriteColor(\"\\n--- Escaneo con adnl.exe ---\", ConsoleColor.Cyan);\n                InvokeToolInteractive(ADNL_EXE, \"devices\");\n                WriteColor(\"\\n--- Escaneo con update.exe ---\", ConsoleColor.Cyan);\n                InvokeToolInteractive(UPDATE_EXE, \"identify 7\");\n            }\n            else if (sub == \"3\")\n            {\n                InvokeToolSafe(ADNL_EXE, \"reboot\", 3000);\n                InvokeUpdateSafe(\"bulkcmd \\\"reset\\\"\", 3000);\n            }\n            WriteColor(\"\\nPresiona ENTER para volver al menu: \", ConsoleColor.Gray, false);\n            Console.ReadLine();\n        }\n\n        static void InvokeUsbPrepAndLogDecrypt()\n        {\n            Console.WriteLine();\n            WriteColor(\"================================================================================\", ConsoleColor.Yellow);\n            WriteColor(\"   OPCION 5: PREPARAR MEMORIA USB (QADEBUG + APKS) Y DESCIFRAR LOGS ZTE         \", ConsoleColor.Yellow);\n            WriteColor(\"================================================================================\", ConsoleColor.Yellow);\n\n            try\n            {\n                var drives = DriveInfo.GetDrives().Where(d => d.DriveType == DriveType.Removable && d.IsReady).ToList();\n                if (drives.Count > 0)\n                {\n                    WriteColor(\"Memorias USB detectadas:\", ConsoleColor.Cyan);\n                    foreach (var d in drives)\n                    {\n                        WriteColor(string.Format(\"  * Unidad {0} ({1} - {2})\", d.Name, d.VolumeLabel, d.DriveFormat), ConsoleColor.Green);\n                    }\n                }\n            }\n            catch { }\n\n            Console.WriteLine();\n            WriteColor(\"  [1] Copiar llaves QADEBUG.ini + factory_update_param.aml + Launchers a una memoria USB\", ConsoleColor.White);\n            WriteColor(\"  [2] Descifrar logs ocultos de la caja (LOG_ZTESTB_OFF\\\\U_*) y mostrar Serie/MAC/Firmware\", ConsoleColor.Green);\n            WriteColor(\"  [0] Volver al menu principal\", ConsoleColor.Gray);\n            Console.WriteLine();\n            WriteColor(\"Elige una opcion: \", ConsoleColor.Yellow, false);\n            string op = (Console.ReadLine() ?? \"\").Trim();\n\n            if (op == \"1\")\n            {\n                WriteColor(\"Escribe la letra de tu memoria USB (ej. D): \", ConsoleColor.Yellow, false);\n                string drv = (Console.ReadLine() ?? \"\").Replace(\":\", \"\").Replace(\"\\\\\", \"\").Trim();\n                string targetUsb = drv + \":\\\\\";\n                if (Directory.Exists(targetUsb))\n                {\n                    foreach (string f in Directory.GetFiles(KEYS_DIR))\n                    {\n                        File.Copy(f, Path.Combine(targetUsb, Path.GetFileName(f)), true);\n                    }\n                    string[] launcherApks = new[]\n                    {\n                        \"Home_Screen_Launcher_1.1.3.apk\",\n                        \"TVLauncher_4_GoogleTV.apk\",\n                        \"Button_Mapper_Pro_2.54.apk\",\n                        \"Filemanager.apk\",\n                        \"autostart.apk\"\n                    };\n                    foreach (string apk in launcherApks)\n                    {\n                        string src = Path.Combine(APKS_DIR, apk);\n                        if (File.Exists(src)) File.Copy(src, Path.Combine(targetUsb, apk), true);\n                    }\n                    WriteColor(\"[OK] Llaves QADEBUG.ini, factory_update_param.aml y Launchers copiados a \" + targetUsb, ConsoleColor.Green);\n                }\n                else\n                {\n                    WriteColor(\"[!] No existe la unidad \" + targetUsb, ConsoleColor.Red);\n                }\n            }\n            else if (op == \"2\")\n            {\n                WriteColor(\"Escribe la letra de la memoria USB donde estan los logs (ej. D): \", ConsoleColor.Yellow, false);\n                string drv = (Console.ReadLine() ?? \"\").Replace(\":\", \"\").Replace(\"\\\\\", \"\").Trim();\n                string logFolder = drv + \":\\\\LOG_ZTESTB_OFF\";\n                if (Directory.Exists(logFolder))\n                {\n                    string encStr = \"5;8|\\\"79+3(&16-409876543210/.-,+*)('&%$#\\\"! ~}|{zyxwvutsrqponmlkjihgfedcba`_^]\\\\[ZYXWVUTSRQPONMLKJIHGFEDCBA@?>=<;:9876543210/.-,+*)('&%$#\\\"! \";\n                    string decStr = \" ~}|{zyxwvutsrqponmlkjihgfedcba`_^]\\\\[ZYXWVUTSRQPONMLKJIHGFEDCBA@?>=<;:9876543210/.-,+*)('&%$#\\\"! 5;8|\\\"79+3(&16-409876543210/.-,+*)('&%$#\\\"!\";\n                    byte[] lut = new byte[256];\n                    for (int i = 0; i < 256; i++) lut[i] = (byte)i;\n                    for (int i = 0; i < encStr.Length; i++)\n                    {\n                        byte e = (byte)encStr[i];\n                        byte d = (byte)decStr[i];\n                        if (lut[e] == e) lut[e] = d;\n                    }\n\n                    string outDir = Path.Combine(ROOT_DIR, \"LOGS_DESCIFRADOS_CAJA\");\n                    Directory.CreateDirectory(outDir);\n                    foreach (string f in Directory.GetFiles(logFolder, \"U_*\"))\n                    {\n                        string fName = Path.GetFileName(f);\n                        WriteColor(\"[+] Descifrando \" + fName + \"...\", ConsoleColor.Cyan);\n                        byte[] raw = File.ReadAllBytes(f);\n                        byte[] outBytes = new byte[raw.Length];\n                        for (int i = 0; i < raw.Length; i++) outBytes[i] = lut[raw[i]];\n                        string destFile = Path.Combine(outDir, fName + \"_DEC.log\");\n                        File.WriteAllBytes(destFile, outBytes);\n                        WriteColor(\"  -> Guardado en: \" + destFile, ConsoleColor.Green);\n                    }\n                }\n                else\n                {\n                    WriteColor(\"[!] No se encontro la carpeta \" + logFolder, ConsoleColor.Red);\n                }\n            }\n            WriteColor(\"\\nPresiona ENTER para volver al menu: \", ConsoleColor.Gray, false);\n            Console.ReadLine();\n        }\n\n        static void InvokeDriversAndGuiMenu()\n        {\n            Console.WriteLine();\n            WriteColor(\"=== OPCION 6: INSTALAR DRIVERS USB Y ABRIR ADB APPCONTROL GUI ===\", ConsoleColor.Yellow);\n            WriteColor(\"  [1] Abrir instalador de ADB AppControl 1.8.6 (Interfaz grafica para Windows)\", ConsoleColor.White);\n            WriteColor(\"  [2] Instalar Driver Oficial Amlogic WorldCup (VID_1B8E)\", ConsoleColor.White);\n            WriteColor(\"  [0] Volver al menu principal\", ConsoleColor.Gray);\n            Console.WriteLine();\n            WriteColor(\"Elige una opcion: \", ConsoleColor.Yellow, false);\n            string c = (Console.ReadLine() ?? \"\").Trim();\n            if (c == \"1\")\n            {\n                string exe = Path.Combine(DRV_DIR, \"ADBAppControl-1.8.6-setup.exe\");\n                if (File.Exists(exe)) Process.Start(exe);\n            }\n            else if (c == \"2\")\n            {\n                string exe = Path.Combine(DRV_DIR, @\"WorldCup_Driver_VID_1B8E\\InstallDriver.exe\");\n                if (File.Exists(exe))\n                {\n                    ProcessStartInfo psi = new ProcessStartInfo(exe) { Verb = \"runas\", UseShellExecute = true };\n                    try { Process.Start(psi); } catch { }\n                }\n            }\n        }\n\n        static void ConnectAdbTarget()\n        {\n            Console.WriteLine();\n            WriteColor(\"=== CONECTAR CAJA POR RED LOCAL (WI-FI / ETHERNET) O REFRESCAR USB ===\", ConsoleColor.Yellow);\n            WriteColor(\"Escribe la IP de la caja (ej. 192.168.0.47) o presiona ENTER para refrescar USB: \", ConsoleColor.White, false);\n            string ip = (Console.ReadLine() ?? \"\").Trim();\n            if (!string.IsNullOrEmpty(ip))\n            {\n                if (!ip.Contains(\":\")) ip = ip + \":5555\";\n                WriteColor(\"[+] Conectando por ADB a \" + ip + \" ...\", ConsoleColor.Cyan);\n                InvokeToolInteractive(ADB_EXE, \"connect \" + ip);\n                CONNECTED_IP = ip;\n            }\n            else\n            {\n                CONNECTED_IP = \"\";\n                InvokeToolInteractive(ADB_EXE, \"devices\");\n            }\n            WriteColor(\"\\nPresiona ENTER para volver al menu: \", ConsoleColor.Gray, false);\n            Console.ReadLine();\n        }\n    }\n}\n","Overwrite":true,"Path":"c:\\Users\\andre\\OneDrive\\Desktop\\xview\\programa perfecto\\1_HERRAMIENTAS_MOTOR\\ProgramaPerfecto.cs"}}]}
