.Cyan);\n            InvokeAdbSafe(\"shell \\\"cmd package set-home-activity dev.dworks.apps.alauncher/.Launcher\\\"\");\n            InvokeAdbSafe(\"shell \\\"settings put secure enabled_accessibility_services flar2.homebutton/flar2.homebutton.ButtonMapperService\\\"\");\n            InvokeAdbSafe(\"shell \\\"settings put secure accessibility_enabled 1\\\"\");\n            InvokeAdbSafe(\"shell \\\"am start -a android.intent.action.MAIN -c android.intent.category.HOME\\\"\");\n\n            WriteColor(\"[6/7] Eliminando banner 'No se pudo instalar la actualizacion del sistema'...\", ConsoleColor.Cyan);\n            InvokeAdbSafe(\"shell \\\"settings put global ota_disable_automatic_update 1\\\"\");\n            InvokeAdbSafe(\"shell \\\"cmd notification snooze --for 315360000000 '0|com.google.android.gms|1|com.google.android.gms.update.control.NotificationControl|10049'\\\"\");\n            InvokeAdbSafe(\"shell \\\"cmd appops set com.google.android.gms POST_NOTIFICATION ignore\\\"\");\n\n            WriteColor(\"[7/7] Activando Modo Stealth (Ocultar flags ADB manteniendo puerto 5555 activo)...\", ConsoleColor.Cyan);\n            InvokeAdbSafe(\"shell \\\"settings put global adb_enabled 0; settings put secure adb_enabled 0; settings put global development_settings_enabled 0; settings put secure development_settings_enabled 0\\\"\");\n            InvokeAdbSafe(\"shell \\\"setprop service.adb.tcp.port 5555; setprop ctl.start adbd\\\"\");\n\n            Console.WriteLine();\n            WriteColor(\"================================================================================\", ConsoleColor.Green);\n            WriteColor(\" [LISTO!] Caja liberada con exito (Candado QR y Pantalla Azul eliminados).      \", ConsoleColor.Green);\n            WriteColor(\"================================================================================\", ConsoleColor.Green);\n        }\n\n        static void InvokeQuickUnlockPartitionsFlash()\n        {\n            Console.WriteLine();\n            WriteColor(\"[+] Inyectando vbmeta desbloqueado (flags=0x03), recovery desbloqueado y cache_ext4...\", ConsoleColor.Cyan);\n            string[,] parts = new string[,]\n            {\n                { \"vbmeta\",   Path.Combine(FW_DIR, \"vbmeta.img\") },\n                { \"recovery\", Path.Combine(FW_DIR, \"recovery.img\") },\n                { \"cache\",    Path.Combine(FW_DIR, \"cache_ext4.img\") }\n            };\n\n            int okCount = 0;\n            int total = parts.GetLength(0);\n            for (int i = 0; i < total; i++)\n            {\n                string pName = parts[i, 0];\n                string pFile = parts[i, 1];\n                if (File.Exists(pFile))\n                {\n                    WriteColor(\"  -> Flasheando '\" + pName + \"' (\" + Path.GetFileName(pFile) + \")...\", ConsoleColor.White);\n                    ToolResult res = InvokeFastbootSafe(\"flash \" + pName + \" \\\"\" + pFile + \"\\\"\", 35000);\n                    InvokeFastbootSafe(\"getvar version-bootloader\", 1200);\n                    if (!res.TimedOut && res.ExitCode == 0 &&\n                        res.Output.IndexOf(\"FAILED\", StringComparison.OrdinalIgnoreCase) < 0 &&\n                        res.Output.IndexOf(\"locked device\", StringComparison.OrdinalIgnoreCase) < 0)\n                    {\n                        WriteColor(\"     [OKAY] Particion '\" + pName + \"' escrita correctamente.\", ConsoleColor.Green);\n                        okCount++;\n                    }\n                    else\n                    {\n                        WriteColor(\"     [AVISO] Respuesta en '\" + pName + \"': \" + res.Output.Replace(\"\\r\", \" \").Replace(\"\\n\", \" | \"), ConsoleColor.Yellow);\n                    }\n                }\n            }\n\n            if (okCount == total)\n            {\n                Console.WriteLine();\n                WriteColor(\"[EXITO] Las 3 particiones clave se inyectaron correctamente. Reiniciando caja