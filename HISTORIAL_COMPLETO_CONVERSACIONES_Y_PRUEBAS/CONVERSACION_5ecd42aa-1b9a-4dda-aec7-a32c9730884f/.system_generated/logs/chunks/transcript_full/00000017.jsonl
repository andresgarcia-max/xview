r(\"  3. Sin soltar RESET, presiona [1] aqui abajo (el programa reiniciara la caja\", ConsoleColor.Cyan);\n            WriteColor(\"     y cazara el modo WorldCup InUsbBurn en 48ms para inyectar env_unlocked.img)\", ConsoleColor.Cyan);\n            WriteColor(\"     O bien desconecta y reconecta el cable de corriente manteniendo RESET.\", ConsoleColor.Cyan);\n            WriteColor(\"--------------------------------------------------------------------------------\", ConsoleColor.DarkCyan);\n            WriteColor(\"  [1] Ya tengo presionado RESET -> Reiniciar caja y cazar WorldCup (48ms) AHORA\", ConsoleColor.Green);\n            WriteColor(\"  [2] Volver al menu principal (manteniendo la caja en Fastboot)\", ConsoleColor.Gray);\n            Console.WriteLine();\n\n            string sel = ReadChoiceWithKeepAlive(\"Elige 1 o 2\", new[] { \"1\", \"2\" });\n            if (sel == \"2\") return false;\n\n            Console.WriteLine();\n            WriteColor(\"[*] Enviando 'fastboot reboot' y activando Caza Ultrarrapida WorldCup (cada 48ms)...\", ConsoleColor.Green);\n            WriteColor(\"    (Manten presionado el boton RESET en la caja durante 6 segundos!)\", ConsoleColor.Yellow);\n            InvokeFastbootSafe(\"reboot\", 2500);\n\n            Stopwatch swHunt = Stopwatch.StartNew();\n            while (swHunt.Elapsed.TotalSeconds < 35)\n            {\n                if (TryCatchWorldCup48ms())\n                {\n                    return true;\n                }\n                Thread.Sleep(25);\n            }\n\n            Console.WriteLine();\n            WriteColor(\"[!] No se detecto la senal WorldCup (VID_1B8E) en estos 35 segundos.\", ConsoleColor.Yellow);\n            WriteColor(\"    Asegurate de haber retirado la memoria USB KINGSTON y mantener presionado\", ConsoleColor.Yellow);\n            WriteColor(\"    el boton RESET al conectar la corriente de la caja.\", ConsoleColor.Yellow);\n            return false;\n        }\n\n        static void 