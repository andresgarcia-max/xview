                   DateTime.Now, category, message, Environment.NewLine);\n                lock (LogLock)\n                {\n                    using (FileStream fs = new FileStream(LOG_FILE, FileMode.Append, FileAccess.Write, FileShare.ReadWrite))\n                    using (StreamWriter sw = new StreamWriter(fs, Encoding.UTF8))\n                    {\n                        sw.Write(line);\n                    }\n                }\n            }\n            catch { }\n        }\n\n        static int Main(string[] args)\n        {\n            try\n            {\n                Console.OutputEncoding = Encoding.UTF8;\n                Console.Title = \"PROGRAMA PERFECTO v3.0 - MISION PRINCIPAL: LIBERACION + INTERFAZ FIRMWARE XVIEW LIBERADO (DMC.v2.25)\";\n            }\n            catch { }\n\n            string exePath = Assembly.GetExecutingAssembly().Location;\n            string exeDir = Path.GetDirectoryName(exePath);\n\n            if (Directory.Exists(Path.Combine(exeDir, \"1_HERRAMIENTAS_MOTOR\")))\n            {\n                ROOT_DIR = exeDir;\n            }\n            else\n            {\n                ROOT_DIR = Path.GetDirectoryName(exeDir);\n            }\n\n            MOTOR_DIR = Path.Combine(ROOT_DIR, \"1_HERRAMIENTAS_MOTOR\");\n            APKS_DIR  = Path.Combine(ROOT_DIR, \"2_APKS_LIBERACION_Y_TV\");\n            KEYS_DIR  = Path.Combine(ROOT_DIR, \"3_LLAVES_USB_PARA_LA_CAJA\");\n            DRV_DIR   = Path.Combine(ROOT_DIR, \"4_DRIVERS_Y_GUI_WINDOWS\");\n            FW_DIR    = Path.Combine(ROOT_DIR, \"5_FIRMWARE_SEGURO_B866V2\");\n            LOG_FILE  = Path.Combine(ROOT_DIR, \"BITACORA_EN_VIVO_EXE.log\");\n\n            ADB_EXE      = Path.Combine(MOTOR_DIR, \"adb.exe\");\n            FASTBOOT_EXE = Path.Combine(MOTOR_DIR, \"fastboot_moderno.exe\");\n            if (!File.Exists(FASTBOOT_EXE))\n            {\n                FASTBOOT_EXE = Path.Combine(MOTOR_DIR, \"fastboot.exe\");\n            }\n            ADNL_EXE     = Path.Combine(MOTOR_DIR, \"adnl.exe\");\n            UPDATE_EXE   = Path.Combine(MOTOR_DIR, \"update.exe\");\n            ENV_UNL_IMG  = Path.Combine(FW_DIR, \"env_unlocked.img\");\n            CONF_IMG     = Path.Combine(FW_DIR, \"conf.img\");\n\n            if (args != null && args.Any(a => a.Equals(\"--check\", StringComparison.OrdinalIgnoreCase)))\n            {\n                ShowBanner();\n                PrintMenuOptions();\n                return 0;\n            }\n\n            LogEvent(\"SESION\", \"=== INICIO DE PROGRAMA_PERFECTO_XVIEW_B866V2.EXE v3.0 (PID=\" + Process.GetCurrentProcess().Id + \") ===\");\n\n            while (true)\n            {\n                ShowBanner();\n                PrintMenuOptions();\n                WriteColor(\"Selecciona el numero de la opcion [0-8]: \", ConsoleColor.Yellow, false);\n                string choice = Console.ReadLine();\n                if (choice == null)\n                {\n                    LogEvent(\"SESION\", \"Consola cerrada por el usuario (EOF).\");\n                    break;\n                }\n                choice = choice.Trim();\n                LogEvent(\"MENU\", \"Usuario selecciono opcion: '\" + choice + \"'\");\n\n                switch (choice)\n                {\n                    case \"0\":\n                        ConnectOrScanAdbNetwork();\n                        break;\n                    case \"1\":\n                        InvokeMainMissionLiberationAndUi();\n                        break;\n                    case \"2\":\n                        InvokeDirectLiberatedUiTransformation();\n                        break;\n                    case \"3\":\n                        InvokeSafeAndroid12Flash(false);\n                        break;\n                    case \"4\":\n                        InvokeUsbPrepAndLogDecrypt();\n                        break;\n                    case \"5\":\n                        InvokeAppInstallerMenu();\n                        break;\n                    case \"6\":\n                        InvokeAmlogicWorldCupEngine();\n                        break;\n                    case \"7\":\n                        InvokeDriversAndGuiMenu();\n                        break;\n                    case \"8\":\n                        LogEvent(\"SESION\", \"Usuario salio con opcion 8.\");\n                        return 0;\n                    default:\n                        Thread.Sleep(300);\n                        break;\n                }\n            }\n            return 0;\n        }\n\n        static void PrintMenuOptions()\n        {\n            WriteColor(\"  [1] MISION PRINCIPAL: LIBERACION TOTAL + INTERFAZ FIRMWARE XVIEW LIBERADO (DMC.v2.25)\", ConsoleColor.Green, true, false);\n            WriteColor(\"      (Caza WorldCup 48ms / Fastbootd / Fastboot / ADB -> Quita Pantalla Azul Megacable\", ConsoleColor.Green, true, false);\n            WriteColor(\"       -> Instala Launcher Android TV + AppDMC + DLStore + Xuper + MagisTV + HDPlay)\", ConsoleColor.Green, true, false);\n            WriteColor(\"  [2] TRANSFORMAR TV A INTERFAZ FIRMWARE XVIEW LIBERADO (Directo por ADB USB o Red Local)\", ConsoleColor.Cyan, true, false);\n            WriteColor(\"  [3] FLASHEAR PARTICIONES FIRMWARE LIBERADO ANDROID 12 (Protege Widevine L1 y MAC)\", ConsoleColor.Magenta, true, false);\n            WriteColor(\"  [4] PREPARAR MEMORIA USB (KINGSTON) CON PACK FIRMWARE XVIEW LIBERADO + LLAVES DE SALTO\", ConsoleColor.Yellow, true, false);\n            WriteColor(\"  [5] Catalogo Individual de APKs del Firmware Xview Liberado (15 Apps Listas)\", ConsoleColor.White, true, false);\n            WriteColor(\"  [6] Motor Amlogic DNL / WorldCup (adnl.exe + update.exe por boton externo RESET)\", ConsoleColor.Gray, true, false);\n            WriteColor(\"  [7] Instalar Drivers USB (WorldCup VID_1B8E) o Abrir ADB AppControl GUI\", ConsoleColor.Gray, true, false);\n            WriteColor(\"  [0] Escanear Red Local (:5555) / Conectar IP / Refrescar USB   |   [8] Salir\", ConsoleColor.DarkGray, true, false);\n            WriteColor(\"--------------------------------------------------------------------------------\", ConsoleColor.DarkCyan, true, false);\n        }\n\n        static void WriteColor(string text, ConsoleColor color, bool newLine = true, bool logToFile = true)\n        {\n            ConsoleColor prev = Console.ForegroundColor;\n            Console.ForegroundColor = color;\n            if (newLine) Console.WriteLine(text);\n            else Console.Write(text);\n            Console.ForegroundColor = prev;\n\n            if (logToFile && !string.IsNullOrWhiteSpace(text))\n            {\n                string clean = text.Replace(\"\\r\", \"\").Replace(\"\\n\", \" \").Trim();\n                if (!clean.StartsWith(\"===\"))\n                {\n                    LogEvent(\"UI\", clean);\n                }\n            }\n        }\n\n        static ToolResult InvokeToolSafe(string exePath, string argString, int timeoutMs = 3000, bool logCmd = true)\n        {\n            if (!File.Exists(exePath))\n            {\n                return new ToolResult { TimedOut = false, ExitCode = -1, Output = \"[NO_EXE]\" };\n            }\n            string exeName = Path.GetFileName(exePath);\n            try\n            {\n                ProcessStartInfo psi = new ProcessStartInfo\n                {\n                    FileName = exePath,\n                    Arguments = argString,\n                    WorkingDirectory = MOTOR_DIR,\n                    RedirectStandardOutput = true,\n                    RedirectStandardError = true,\n                    UseShellExecute = false,\n                    CreateNoWindow = true\n                };\n\n                using (Process proc = new Process())\n                {\n                    proc.StartInfo = psi;\n                    proc.Start();\n\n                    Task<string> outTask = proc.StandardOutput.ReadToEndAsync();\n                    Task<string> errTask = proc.StandardError.ReadToEndAsync();\n\n                    if (!proc.WaitForExit(timeoutMs))\n                    {\n                        try { proc.Kill(); } catch { }\n                        if (logCmd)\n                        {\n                            LogEvent(\"CMD_TIMEOUT\", exeName + \" \" + argString + \" -> [TIMEOUT \" + timeoutMs + \"ms]\");\n                        }\n                        return new ToolResult { TimedOut = true, ExitCode = -1, Output = \"[TIMEOUT]\" };\n                    }\n\n                    outTask.Wait(200);\n                    errTask.Wait(200);\n                    string oStr = outTask.IsCompleted ? outTask.Result : \"\";\n                    string eStr = errTask.IsCompleted ? errTask.Result : \"\";\n                    string combined = (oStr + \"\\n\" + eStr).Trim();\n\n                    if (logCmd)\n                    {\n                        string flat = combined.Replace(\"\\r\", \" \").Replace(\"\\n\", \" | \").Trim();\n                        LogEvent(\"CMD\", exeName + \" \" + argString + \" (Exit=\" + proc.ExitCode + \") -> \" + flat);\n                    }\n\n                    return new ToolResult { TimedOut = false, ExitCode = proc.ExitCode, Output = combined };\n                }\n            }\n            catch (Exception ex)\n            {\n                if (logCmd) LogEvent(\"CMD_EX\", exeName + \" \" + argString + \" -> \" + ex.Message);\n                return new ToolResult { TimedOut = false, ExitCode = -1, Output = ex.Message };\n            }\n        }\n\n        static int InvokeToolInteractive(string exePath, string argString)\n        {\n            if (!File.Exists(exePath)) return -1;\n            LogEvent(\"CMD_INTERACTIVE\", Path.GetFileName(exePath) + \" \" + argString);\n            try\n            {\n                ProcessStartInfo psi = new ProcessStartInfo\n                {\n                    FileName = exePath,\n                    Arguments = argString,\n                    WorkingDirectory = MOTOR_DIR,\n                    UseShellExecute = false\n                };\n                using (Process proc = Process.Start(psi))\n                {\n                    proc.WaitForExit();\n                    LogEvent(\"CMD_INTERACTIVE_END\", Path.GetFileName(exePath) + \" ExitCode=\" + proc.ExitCode);\n                    return proc.ExitCode;\n                }\n            }\n            catch (Exception ex)\n            {\n                LogEvent(\"CMD_INTERACTIVE_ERR\", ex.Message);\n                return -1;\n            }\n        }\n\n        static ToolResult InvokeFastbootSafe(string argString, int timeoutMs = 3000, bool logCmd = true)\n        {\n            return InvokeToolSafe(FASTBOOT_EXE, argString, timeoutMs, logCmd);\n        }\n\n        static ToolResult InvokeUpdateSafe(string argString, int timeoutMs = 5000, bool logCmd = true)\n        {\n            return InvokeToolSafe(UPDATE_EXE, argString, timeoutMs, logCmd);\n        }\n\n        static ToolResult InvokeAdbSafe(string argString, int timeoutMs = 10000, bool logCmd = true)\n        {\n            string prefix = string.IsNullOrEmpty(CONNECTED_IP) ? \"\" : (\"-s \" + CONNECTED_IP + \" \");\n            return InvokeToolSafe(ADB_EXE, prefix + argString, timeoutMs, logCmd);\n        }\n\n        static int InvokeAdbInteractive(string argString)\n        {\n            string prefix = string.IsNullOrEmpty(CONNECTED_IP) ? \"\" : (\"-s \" + CONNECTED_IP + \" \");\n            return InvokeToolInteractive(ADB_EXE, prefix + argString);\n        }\n\n        static string ReadChoiceWithKeepAlive(string promptText, string[] validChoices)\n        {\n            WriteColor(promptText + \" (\" + string.Join(\"/\", validChoices) + \"): \", ConsoleColor.Yellow, false);\n            DateTime lastPulse = DateTime.Now;\n            while (true)\n            {\n                if (Console.KeyAvailable)\n                {\n                    ConsoleKeyInfo keyInfo = Console.ReadKey(true);\n                    string ch = keyInfo.KeyChar.ToString().ToUpperInvariant();\n                    if (validChoices.Contains(ch))\n                    {\n                        WriteColor(ch, ConsoleColor.Green);\n                        LogEvent(\"INPUT\", \"Eleccion del usuario (KeepAlive): \" + ch);\n                        return ch;\n                    }\n                }\n                if ((DateTime.Now - lastPulse).TotalSeconds >= 2.0)\n                {\n                    lastPulse = DateTime.Now;\n                    InvokeFastbootSafe(\"getvar version-bootloader\", 1200, false);\n                }\n                Thread.Sleep(60);\n            }\n        }\n\n        // ==============================================================================\n        // CAZADOR ULTRARRAPIDO WORLDCUP / INUSBBURN (48ms DIRECTO POR LIBUSB)\n        // ==============================================================================\n        static bool TryCatchWorldCup48ms()\n        {\n            if (!File.Exists(UPDATE_EXE)) return false;\n\n            ToolResult res = InvokeUpdateSafe(\"bulkcmd \\\"setenv lock 10100000\\\"\", 1500, false);\n            if (!res.TimedOut &&\n                !string.IsNullOrWhiteSpace(res.Output) &&\n                res.Output.IndexOf(\"No [WorldCup Device]\", StringComparison.OrdinalIgnoreCase) < 0 &&\n                res.Output.IndexOf(\"can not find device\", StringComparison.OrdinalIgnoreCase) < 0)\n            {\n                LogEvent(\"WORLDCUP_CAUGHT\", \"Detectado WorldCup (VID_1B8E)! Respuesta inicial: \" + res.Output.Replace(\"\\r\", \" \").Replace(\"\\n\", \" | \"));\n                Console.WriteLine();\n                WriteColor(\"[+] Detectada caja en Modo Amlogic WorldCup / InUsbBurn (VID_1B8E) en <50ms!\", ConsoleColor.Green);\n                WriteColor(\"    [1/5] Primer paquete 'setenv lock 10100000' aceptado por U-Boot.\", ConsoleColor.Cyan);\n\n                string[] cmds = new string[]\n                {\n                    \"setenv -f lock 10100000\",\n                    \"setenv lock 10100000\",\n                    \"setenv unlock_ability 1\",\n                    \"setenv otg_device 1\",\n                    \"setenv upgrade_key_flag 0\",\n                    \"saveenv\"\n                };\n                WriteColor(\"    [2/5] Grabando variables U-Boot (lock=10100000, unlock_ability=1, otg_device=1)...\", ConsoleColor.Cyan);\n                foreach (string c in cmds)\n                {\n                    InvokeUpdateSafe(\"bulkcmd \\\"\" + c + \"\\\"\", 3000, true);\n                }\n\n                if (File.Exists(ENV_UNL_IMG))\n                {\n                    WriteColor(\"    [3/5] Inyectando particion 'env' desbloqueada (env_unlocked.img)...\", ConsoleColor.Cyan);\n                    ToolResult rEnv = InvokeUpdateSafe(\"partition env \\\"\" + ENV_UNL_IMG + \"\\\"\", 8000, true);\n                    WriteColor(\"          Resultado env: \" + rEnv.Output.Replace(\"\\r\", \" \").Replace(\"\\n\", \" \"), ConsoleColor.Gray);\n                }\n                if (File.Exists(CONF_IMG))\n                {\n                    InvokeUpdateSafe(\"partition conf \\\"\" + CONF_IMG + \"\\\"\", 6000, true);\n                }\n\n                string vbmetaImg = Path.Combine(FW_DIR, \"vbmeta.img\");\n                string recImg    = Path.Combine(FW_DIR, \"recovery.img\");\n                string dtbImg    = Path.Combine(FW_DIR, \"dtb.img\");\n                string logoImg   = Path.Combine(FW_DIR, \"logo.img\");\n                string oemImg    = Path.Combine(FW_DIR, \"oem.img\");\n                WriteColor(\"    [4/5] Inyectando logo, oem, _aml_dtb, vbmeta (flags=0x03) y recovery del Firmware Xview Liberado...\", ConsoleColor.Cyan);\n                if (File.Exists(logoImg))   InvokeUpdateSafe(\"partition logo \\\"\" + logoImg + \"\\\"\", 8000, true);\n                if (File.Exists(oemImg))    InvokeUpdateSafe(\"partition oem \\\"\" + oemImg + \"\\\"\", 15000, true);\n                if (File.Exists(dtbImg))    InvokeUpdateSafe(\"partition _aml_dtb \\\"\" + dtbImg + \"\\\"\", 8000, true);\n                if (File.Exists(vbmetaImg)) InvokeUpdateSafe(\"partition vbmeta \\\"\" + vbmetaImg + \"\\\"\", 10000, true);\n                if (File.Exists(recImg))    InvokeUpdateSafe(\"partition recovery \\\"\" + recImg + \"\\\"\", 25000, true);\n\n                WriteColor(\"    [5/5] Saltando la caja a U-Boot Fastboot DESBLOQUEADO (PID_0D02)...\", ConsoleColor.Green);\n                InvokeUpdateSafe(\"bulkcmd \\\"fastboot\\\"\", 3000, true);\n                Thread.Sleep(1200);\n                return true;\n            }\n            return false;\n        }\n\n        // ==============================================================================\n        // INYECCION DIRECTA EN RECOVERY FASTBOOTD (PID_4EE7) ANTES DE SALTAR A U-BOOT\n        // ==============================================================================\n        static void TryFlashInRecoveryFastbootd(string fbSn)\n        {\n            LogEvent(\"FASTBOOTD_FLASH\", \"Intentando desbloqueo e inyeccion en Recovery fastbootd (PID_4EE7 / \" + fbSn + \")...\");\n            Console.WriteLine();\n            WriteColor(\"================================================================================\", ConsoleColor.Yellow);\n            WriteColor(\" [+] CAJA DETECTADA EN RECOVERY FASTBOOTD (PID_4EE7 / Serie: \" + fbSn + \")\", ConsoleColor.Yellow);\n            WriteColor(\"================================================================================\", ConsoleColor.Yellow);\n            WriteColor(\"  Ejecutando secuencia de desbloqueo e inyeccion en espacio de usuario (fastbootd)...\", ConsoleColor.Cyan);\n\n            InvokeFastbootSafe(\"flashing unlock\", 2000, true);\n            InvokeFastbootSafe(\"flashing unlock_critical\", 2000, true);\n\n            var fastbootdParts = new[]\n            {\n                new { Name = \"env\",      Path = ENV_UNL_IMG,                        Timeout = 5000 },\n                new { Name = \"conf\",     Path = CONF_IMG,                           Timeout = 5000 },\n                new { Name = \"vbmeta\",   Path = Path.Combine(FW_DIR, \"vbmeta.img\"), Timeout = 8000 },\n                new { Name = \"logo\",     Path = Path.Combine(FW_DIR, \"logo.img\"),   Timeout = 8000 },\n                new { Name = \"oem\",      Path = Path.Combine(FW_DIR, \"oem.img\"),    Timeout = 15000 },\n                new { Name = \"cache\",    Path = Path.Combine(FW_DIR, \"cache_ext4.img\"), Timeout = 15000 },\n                new { Name = \"boot\",     Path = Path.Combine(FW_DIR, \"boot.img\"),   Timeout = 20000 },\n                new { Name = \"dtbo\",     Path = Path.Combine(FW_DIR, \"dtbo.img\"),   Timeout = 8000 },\n                new { Name = \"recovery\", Path = Path.Combine(FW_DIR, \"recovery.img\"), Timeout = 20000 }\n            };\n\n            int okCount = 0;\n            foreach (var p in fastbootdParts)\n            {\n                if (File.Exists(p.Path))\n                {\n                    WriteColor(\"  -> Probando inyeccion fastbootd en '\" + p.Name + \"' (\" + Path.GetFileName(p.Path) + \")...\", ConsoleColor.Gray);\n                    ToolResult r = InvokeFastbootSafe(\"flash \" + p.Name + \" \\\"\" + p.Path + \"\\\"\", p.Timeout, true);\n                    if (!r.TimedOut && r.ExitCode == 0 &&\n                        r.Output.IndexOf(\"OKAY\", StringComparison.OrdinalIgnoreCase) >= 0 &&\n                        r.Output.IndexOf(\"FAILED\", StringComparison.OrdinalIgnoreCase) < 0)\n                    {\n                        WriteColor(\"     [OKAY] Particion '\" + p.Name + \"' aceptada en fastbootd!\", ConsoleColor.Green);\n                        okCount++;\n                    }\n                }\n            }\n\n            WriteColor(\"  -> Saltando ahora de Recovery Fastbootd (PID_4EE7) a U-Boot Fastboot (PID_0D02)...\", ConsoleColor.Cyan);\n            InvokeFastbootSafe(\"reboot bootloader\", 3000, true);\n        }\n\n        static BoxConnectionState GetBoxConnectionState()\n        {\n            BoxConnectionState state = new BoxConnectionState();\n\n            // 1. Prueba directa WorldCup (48ms)\n            ToolResult wcCheck = InvokeUpdateSafe(\"bulkcmd \\\"setenv lock 10100000\\\"\", 1000, false);\n            if (!wcCheck.TimedOut &&\n                !string.IsNullOrWhiteSpace(wcCheck.Output) &&\n                wcCheck.Output.IndexOf(\"No [WorldCup Device]\", StringComparison.OrdinalIgnoreCase) < 0 &&\n                wcCheck.Output.IndexOf(\"can not find device\", StringComparison.OrdinalIgnoreCase) < 0)\n            {\n                state.UsbHardwareMode = \"Amlogic WorldCup / InUsbBurn Activo (VID_1B8E) - LISTO PARA DESBLOQUEO\";\n                state.RawPid = \"1B8E\";\n            }\n\n            // 2. Escaneo WMI PnP\n            try\n            {\n                using (ManagementObjectSearcher searcher = new ManagementObjectSearcher(\n                    \"SELECT DeviceID FROM Win32_PnPEntity WHERE DeviceID LIKE '%VID_18D1%' OR DeviceID LIKE '%VID_19D2%' OR DeviceID LIKE '%VID_1B8E%'\"))\n                {\n                    foreach (ManagementObject dev in searcher.Get())\n                    {\n                        string devId = Convert.ToString(dev[\"DeviceID\"]) ?? \"\";\n                        int lastSlash = devId.LastIndexOf('\\\\');\n                        if (lastSlash >= 0 && lastSlash + 1 < devId.Length)\n                        {\n                            string sn = devId.Substring(lastSlash + 1);\n                            if (!sn.Contains(\"&\")) state.SerialNumber = sn;\n                        }\n\n                        if (devId.IndexOf(\"PID_4EE2\", StringComparison.OrdinalIgnoreCase) >= 0)\n                        {\n                            state.UsbHardwareMode = \"ADB USB Activo (PID_4EE2) - LISTO PARA LIBERAR INTERFAZ XVIEW\";\n                            state.RawPid = \"4EE2\";\n                        }\n                        else if (devId.IndexOf(\"PID_4EE7\", StringComparison.OrdinalIgnoreCase) >= 0)\n                        {\n                            state.UsbHardwareMode = \"Recovery Fastbootd (PID_4EE7) - ACTIVO\";\n                            state.RawPid = \"4EE7\";\n                        }\n                        else if (devId.IndexOf(\"PID_0D02\", StringComparison.OrdinalIgnoreCase) >= 0)\n                        {\n                            state.RawPid = \"0D02\";\n                        }\n                        else if (devId.IndexOf(\"PID_4EE1\", StringComparison.OrdinalIgnoreCase) >= 0)\n                        {\n                            state.UsbHardwareMode = \"Caja Encendida en Android (PID_4EE1) - Usa Opcion [1] Mision Principal\";\n                            state.RawPid = \"4EE1\";\n                        }\n                        else if (devId.IndexOf(\"VID_1B8E\", StringComparison.OrdinalIgnoreCase) >= 0)\n                        {\n                            state.UsbHardwareMode = \"Amlogic WorldCup / DNL Mode (VID_1B8E) - LISTO PARA DESBLOQUEO U-BOOT\";\n                            state.RawPid = \"1B8E\";\n                        }\n                    }\n                }\n            }\n            catch { }\n\n            // 3. Verificar ADB\n            if (File.Exists(ADB_EXE))\n            {\n                ToolResult adbRes = InvokeToolSafe(ADB_EXE, \"devices\", 2000, false);\n                if (!adbRes.TimedOut)\n                {\n                    foreach (string rawLine in adbRes.Output.Split(new[] { '\\r', '\\n' }, StringSplitOptions.RemoveEmptyEntries))\n                    {\n                        Match m = Regex.Match(rawLine.Trim(), @\"^(\\S+)\\s+(device|unauthorized|offline)$\");\n                        if (m.Success)\n                        {\n                            state.AdbDevices.Add(m.Groups[1].Value + \" [\" + m.Groups[2].Value + \"]\");\n                        }\n                    }\n                }\n            }\n\n            // 4. Verificar Fastboot y filtrar descriptores fantasma\n            if (File.Exists(FASTBOOT_EXE))\n            {\n                ToolResult fbRes = InvokeFastbootSafe(\"devices\", 1500, false);\n                if (!fbRes.TimedOut)\n                {\n                    foreach (string rawLine in fbRes.Output.Split(new[] { '\\r', '\\n' }, StringSplitOptions.RemoveEmptyEntries))\n                    {\n                        Match m = Regex.Match(rawLine.Trim(), @\"^(\\S+)\\s+fastboot\");\n                        if (m.Success)\n                        {\n                            string candidateSn = m.Groups[1].Value;\n                            ToolResult ping = InvokeFastbootSafe(\"getvar version-bootloader\", 900, false);\n                            if (!ping.TimedOut && (\n                                ping.Output.IndexOf(\"version-bootloader\", StringComparison.OrdinalIgnoreCase) >= 0 ||\n                                ping.Output.IndexOf(\"OKAY\", StringComparison.OrdinalIgnoreCase) >= 0 ||\n                                ping.Output.IndexOf(\"Finished\", StringComparison.OrdinalIgnoreCase) >= 0))\n                            {\n                                state.FastbootDevices.Add(candidateSn);\n                                state.FastbootLive = true;\n                                if (state.RawPid == \"0D02\")\n                                {\n                                    state.UsbHardwareMode = \"U-Boot Fastboot Activo (PID_0D02) - RESPONDIENDO EN VIVO\";\n                                }\n                            }\n                            else\n                            {\n                                if (state.RawPid == \"0D02\")\n                                {\n                                    state.UsbHardwareMode = \"Caja encendida en Android (Descriptor Fastboot previo en reposo)\";\n                                    state.RawPid = \"0D02_GHOST\";\n                                }\n                            }\n                        }\n                    }\n                }\n            }\n\n            LogEvent(\"RADAR\", string.Format(\"SN={0} | RawPid={1} | FastbootLive={2} | ADB={3}\",\n                state.SerialNumber, state.RawPid, state.FastbootLive, string.Join(\",\", state.AdbDevices)));\n            return state;\n        }\n\n        static void ShowBanner()\n        {\n            try { Console.Clear(); } catch { }\n            WriteColor(\"================================================================================\", ConsoleColor.Cyan, true, false);\n            WriteColor(\"   PROGRAMA PERFECTO v3.0 - LIBERACION + INTERFAZ FIRMWARE XVIEW LIBERADO       \", ConsoleColor.Cyan, true, false);\n            WriteColor(\"   Objetivo Final: Interfaz Xview Liberada (DMC.v2.25 / Android TV / Google TV) \", ConsoleColor.Cyan, true, false);\n            WriteColor(\"   Regla: 100% Externo Sin Tornillos | Sin 7 Clics | Protege Widevine L1 y MAC  \", ConsoleColor.Cyan, true, false);\n            WriteColor(\"================================================================================\", ConsoleColor.Cyan, true, false);\n\n            BoxConnectionState st = GetBoxConnectionState();\n            Console.WriteLine();\n            WriteColor(\" [RADAR DE HARDWARE USB Y RED EN TIEMPO REAL]\", ConsoleColor.Yellow, true, false);\n            WriteColor(\"  * Caja Detectada   : Xview+ ZTE B866V2 (Serie: \" + st.SerialNumber + \")\", ConsoleColor.White, true, false);\n\n            if (st.RawPid == \"4EE2\" || st.RawPid == \"0D02\" || st.RawPid == \"4EE7\" || st.RawPid == \"1B8E\")\n            {\n                WriteColor(\"  * Estado Cable USB : \" + st.UsbHardwareMode, ConsoleColor.Green, true, false);\n            }\n            else if (st.RawPid == \"4EE1\" || st.RawPid == \"0D02_GHOST\")\n            {\n                WriteColor(\"  * Estado Cable USB : \" + st.UsbHardwareMode, ConsoleColor.Yellow, true, false);\n            }\n            else\n            {\n                WriteColor(\"  * Estado Cable USB : \" + st.UsbHardwareMode, ConsoleColor.Gray, true, false);\n            }\n\n            if (st.AdbDevices.Count > 0)\n            {\n                WriteColor(\"  * Sesion ADB       : ACTIVA (\" + string.Join(\", \", st.AdbDevices) + \") -> Lista para Interfaz Liberada\", ConsoleColor.Green, true, false);\n            }\n            else\n            {\n                WriteColor(\"  * Sesion ADB       : En espera (Opcion 1 o 2 escanea USB + Red Local :5555)\", ConsoleColor.DarkGray, true, false);\n            }\n\n            if (st.FastbootLive && st.FastbootDevices.Count > 0)\n            {\n                WriteColor(\"  * Sesion Fastboot  : ACTIVA EN VIVO (\" + string.Join(\", \", st.FastbootDevices) + \")\", ConsoleColor.Green, true, false);\n            }\n            else\n            {\n                WriteColor(\"  * Sesion Fastboot  : En espera de salto (Boton externo RESET)\", ConsoleColor.DarkGray, true, false);\n            }\n            WriteColor(\"--------------------------------------------------------------------------------\", ConsoleColor.DarkCyan, true, false);\n        }\n\n        // ==============================================================================\n        // ESCANER AUTOMATICO DE SUBRED LOCAL PARA ENCONTRAR LA CAJA EN PUERTO 5555\n        // ==============================================================================\n        static bool ScanLocalNetworkForBoxAdb()\n        {\n            LogEvent(\"NET_SCAN\", \"Iniciando escaneo rapido de subred local para puerto ADB 5555...\");\n            WriteColor(\"[*] Escaneando red local (Wi-Fi / Ethernet) en busca de la caja Xview+ (:5555)...\", ConsoleColor.Cyan);\n\n            List<string> prefixes = new List<string>();\n            try\n            {\n                foreach (NetworkInterface ni in NetworkInterface.GetAllNetworkInterfaces())\n                {\n                    if (ni.OperationalStatus != OperationalStatus.Up ||\n                        ni.NetworkInterfaceType == NetworkInterfaceType.Loopback)\n                        continue;\n\n                    foreach (UnicastIPAddressInformation ip in ni.GetIPProperties().UnicastAddresses)\n                    {\n                        if (ip.Address.AddressFamily == AddressFamily.InterNetwork)\n                        {\n                            byte[] b = ip.Address.GetAddressBytes();\n                            if (b[0] == 192 || b[0] == 10 || b[0] == 172)\n                            {\n                                string pref = string.Format(\"{0}.{1}.{2}.\", b[0], b[1], b[2]);\n                                if (!prefixes.Contains(pref)) prefixes.Add(pref);\n                            }\n                        }\n                    }\n                }\n            }\n            catch { }\n\n            if (prefixes.Count == 0)\n            {\n                prefixes.Add(\"192.168.0.\");\n                prefixes.Add(\"192.168.1.\");\n            }\n\n            ConcurrentBag<string> openIps = new ConcurrentBag<string>();\n            foreach (string prefix in prefixes)\n            {\n                WriteColor(\"    -> Sondeando subred \" + prefix + \"1-254 (puerto 5555)...\", ConsoleColor.Gray);\n                Parallel.For(1, 255, new ParallelOptions { MaxDegreeOfParallelism = 64 }, i =>\n                {\n                    string candidateIp = prefix + i;\n                    try\n                    {\n                        using (TcpClient tcp = new TcpClient())\n                        {\n                            IAsyncResult ar = tcp.BeginConnect(candidateIp, 5555, null, null);\n                            if (ar.AsyncWaitHandle.WaitOne(220))\n                            {\n                                tcp.EndConnect(ar);\n                                openIps.Add(candidateIp);\n                            }\n                        }\n                    }\n                    catch { }\n                });\n            }\n\n            foreach (string foundIp in openIps)\n            {\n                string target = foundIp + \":5555\";\n                WriteColor(\"    [+] Dispositivo con puerto 5555 abierto encontrado en: \" + target, ConsoleColor.Green);\n                LogEvent(\"NET_SCAN_HIT\", \"Puerto 5555 abierto en \" + target);\n                ToolResult conn = InvokeToolSafe(ADB_EXE, \"connect \" + target, 4000, true);\n                Thread.Sleep(500);\n                ToolResult devCheck = InvokeToolSafe(ADB_EXE, \"devices\", 2000, true);\n                if (Regex.IsMatch(devCheck.Output, Regex.Escape(foundIp) + @\"(?::5555)?\\s+device\\b\"))\n                {\n                    CONNECTED_IP = target;\n                    WriteColor(\"    [OK] Sesion ADB autorizada establecida con \" + target + \"!\", ConsoleColor.Green);\n                    return true;\n                }\n                else if (Regex.IsMatch(devCheck.Output, Regex.Escape(foundIp) + @\"(?::5555)?\\s+unauthorized\"))\n                {\n                    CONNECTED_IP = target;\n                    WriteColor(\"    [!] Caja encontrada en \" + target + \". Acepta el permiso de Depuracion en la TV!\", ConsoleColor.Yellow);\n                    for (int w = 0; w < 12; w++)\n                    {\n                        Thread.Sleep(1500);\n                        ToolResult reCheck = InvokeToolSafe(ADB_EXE, \"devices\", 2000, false);\n                        if (Regex.IsMatch(reCheck.Output, Regex.Escape(foundIp) + @\"(?::5555)?\\s+device\\b\"))\n                        {\n                            WriteColor(\"    [OK] Permiso aceptado en la TV!\", ConsoleColor.Green);\n                            return true;\n                        }\n                    }\n                }\n            }\n\n            return false;\n        }\n\n        // ==============================================================================\n        // MISION PRINCIPAL (FASE ANDROID/ADB): TRANSFORMACION TOTAL A INTERFAZ\n        // DEL FIRMWARE XVIEW LIBERADO (DMC.v2.25) + ELIMINACION DE PANTALLA AZUL\n        // ==============================================================================\n        static void ExecuteLiberatedXviewFirmwareUiTransformation()\n        {\n            LogEvent(\"LIBERATED_UI_TRANSFORM\", \"Iniciando transformacion completa a Interfaz Firmware Xview Liberado (DMC.v2.25)...\");\n            Console.WriteLine();\n            WriteColor(\"================================================================================\", ConsoleColor.Green);\n            WriteColor(\"  TRANSFORMANDO CAJA A INTERFAZ DEL FIRMWARE XVIEW LIBERADO (DMC.v2.25)         \", ConsoleColor.Green);\n            WriteColor(\"================================================================================\", ConsoleColor.Green);\n\n            WriteColor(\"[1/8] Inyectando llave 'EE@' en /cache/recovery/last_QR (Elimina Candado QR ZTE)...\", ConsoleColor.Cyan);\n            InvokeAdbSafe(\"shell \\\"echo -n 'EE@' > /cache/recovery/last_QR; rm -f /cache/recovery/last_QR_Time; chmod 666 /cache/recovery/last_QR\\\"\");\n\n            WriteColor(\"[2/8] Desbloqueando banderas OEM, U-Boot (lock=10100000) y perfil Viettel_OTT_12...\", ConsoleColor.Cyan);\n            InvokeAdbSafe(\"shell \\\"settings put global oem_unlock_enabled 1; settings put secure oem_unlock_enabled 1\\\"\");\n            InvokeAdbSafe(\"shell \\\"setprop ubootenv.var.lock 10100000; setprop ubootenv.var.unlock_ability 1; setprop ubootenv.var.otg_device 1; setprop ubootenv.var.upgrade_key_flag 0\\\"\");\n            InvokeAdbSafe(\"shell \\\"setprop persist.sys.usb.config mtp,adb; setprop service.adb.tcp.port 5555\\\"\");\n            InvokeAdbSafe(\"shell \\\"settings put global package_verifier_user_consent -1; settings put global package_verifier_enable 0; settings put secure install_non_market_apps 1; bmgr enable false\\\"\");\n\n            if (File.Exists(ENV_UNL_IMG))\n            {\n                InvokeAdbSafe(\"push \\\"\" + ENV_UNL_IMG + \"\\\" /data/local/tmp/env_unlocked.img\");\n                InvokeAdbSafe(\"shell \\\"dd if=/data/local/tmp/env_unlocked.img of=/dev/block/env bs=65536 count=1 2>/dev/null; su -c 'dd if=/data/local/tmp/env_unlocked.img of=/dev/block/env bs=65536 count=1' 2>/dev/null; sync\\\"\");\n            }\n            if (File.Exists(CONF_IMG))\n            {\n                InvokeAdbSafe(\"push \\\"\" + CONF_IMG + \"\\\" /data/local/tmp/conf.img\");\n                InvokeAdbSafe(\"shell \\\"dd if=/data/local/tmp/conf.img of=/dev/block/conf bs=65536 count=1 2>/dev/null; su -c 'dd if=/data/local/tmp/conf.img of=/dev/block/conf bs=65536 count=1' 2>/dev/null; sync\\\"\");\n            }\n\n            WriteColor(\"[3/8] Eliminando Pantalla Azul 'ESTE EQUIPO ES PROPIEDAD DE MEGACABLE' y candados ZTE...\", ConsoleColor.Cyan);\n            foreach (string pkg in MEGACABLE_LOCK_PACKAGES)\n            {\n                WriteColor(\"  -> Neutralizando y desinstalando bloqueo: \" + pkg, ConsoleColor.Gray);\n                InvokeAdbSafe(\"shell \\\"cmd appops set \" + pkg + \" RUN_IN_BACKGROUND ignore; cmd appops set \" + pkg + \" RUN_ANY_IN_BACKGROUND ignore; cmd appops set \" + pkg + \" SYSTEM_ALERT_WINDOW ignore; am force-stop \" + pkg + \"; pm clear \" + pkg + \"; pm disable-user --user 0 \" + pkg + \"; pm uninstall -k --user 0 \" + pkg + \"\\\"\");\n            }\n\n            WriteColor(\"[4/8] Instalando Interfaz Principal y Apps del Firmware Xview Liberado (DMC.v2.25)...\", ConsoleColor.Cyan);\n            int totalApks = LIBERATED_FIRMWARE_UI_APKS.GetLength(0);\n            int installedCount = 0;\n            for (int i = 0; i < totalApks; i++)\n            {\n                string fileName = LIBERATED_FIRMWARE_UI_APKS[i, 0];\n                string desc     = LIBERATED_FIRMWARE_UI_APKS[i, 1];\n                string apkPath  = Path.Combine(APKS_DIR, fileName);\n                if (File.Exists(apkPath))\n                {\n                    WriteColor(string.Format(\"  [{0}/{1}] Instalando {2}...\", i + 1, totalApks, desc), ConsoleColor.White);\n                    ToolResult instRes = InvokeAdbSafe(\"install -r -d -g \\\"\" + apkPath + \"\\\"\", 90000, true);\n                    if (!instRes.TimedOut && instRes.Output.IndexOf(\"Success\", StringComparison.OrdinalIgnoreCase) >= 0)\n                    {\n                        WriteColor(\"         [OK] Instalado correctamente.\", ConsoleColor.Green);\n                        installedCount++;\n                    }\n                    else\n                    {\n                        // Segundo intento sin -d por compatibilidad\n                        ToolResult retryRes = InvokeAdbSafe(\"install -r -g \\\"\" + apkPath + \"\\\"\", 90000, true);\n                        if (!retryRes.TimedOut && retryRes.Output.IndexOf(\"Success\", StringComparison.OrdinalIgnoreCase) >= 0)\n                        {\n                            WriteColor(\"         [OK] Instalado correctamente.\", ConsoleColor.Green);\n                            installedCount++;\n                        }\n                        else\n                        {\n                            WriteColor(\"         [AVISO] \" + retryRes.Output.Replace(\"\\r\", \" \").Replace(\"\\n\", \" \"), ConsoleColor.Yellow);\n                        }\n                    }\n                }\n            }\n\n            WriteColor(\"[5/8] Otorgando permisos de superposicion y almacenamiento a la Interfaz Xview Liberada...\", ConsoleColor.Cyan);\n            string[] liberatedPkgs = new string[]\n            {\n                \"com.google.android.tvlauncher\",\n                \"dev.dworks.apps.alauncher\",\n                \"com.example.appdmc\",\n                \"com.fof.DLStore\",\n                \"com.droidlogic.filebrowser\",\n                \"com.hdplay.online\",\n                \"com.xuper.netxxus\",\n                \"tv.mxlmovies.app\",\n                \"flar2.homebutton\",\n                \"com.autostart\"\n            };\n            foreach (string lp in liberatedPkgs)\n            {\n                InvokeAdbSafe(\"shell \\\"cmd appops set \" + lp + \" SYSTEM_ALERT_WINDOW allow; cmd appops set \" + lp + \" REQUEST_INSTALL_PACKAGES allow; cmd appops set \" + lp + \" WRITE_SETTINGS allow\\\"\");\n            }\n\n            WriteColor(\"[6/8] Fijando el Launcher del Firmware Xview Liberado como HOME Principal en la TV...\", ConsoleColor.Cyan);\n            // Fijar el Launcher Android TV oficial o Home Screen Launcher como actividad HOME predeterminada\n            InvokeAdbSafe(\"shell \\\"pm enable com.google.android.tvlauncher 2>/dev/null; pm enable dev.dworks.apps.alauncher 2>/dev/null\\\"\");\n            InvokeAdbSafe(\"shell \\\"cmd package set-home-activity com.google.android.tvlauncher/.MainActivity 2>/dev/null || cmd package set-home-activity dev.dworks.apps.alauncher/.Launcher\\\"\");\n            InvokeAdbSafe(\"shell \\\"settings put secure enabled_accessibility_services flar2.homebutton/flar2.homebutton.ButtonMapperService\\\"\");\n            InvokeAdbSafe(\"shell \\\"settings put secure accessibility_enabled 1\\\"\");\n\n            WriteColor(\"[7/8] Silenciando avisos de actualizacion OTA y preparando Modo Stealth...\", ConsoleColor.Cyan);\n            InvokeAdbSafe(\"shell \\\"settings put global ota_disable_automatic_update 1\\\"\");\n            InvokeAdbSafe(\"shell \\\"cmd notification snooze --for 315360000000 '0|com.google.android.gms|1|com.google.android.gms.update.control.NotificationControl|10049'\\\"\");\n            InvokeAdbSafe(\"shell \\\"cmd appops set com.google.android.gms POST_NOTIFICATION ignore\\\"\");\n            InvokeAdbSafe(\"shell \\\"settings put global adb_enabled 0; settings put secure adb_enabled 0; settings put global development_settings_enabled 0; settings put secure development_settings_enabled 0\\\"\");\n            InvokeAdbSafe(\"shell \\\"setprop service.adb.tcp.port 5555; setprop ctl.start adbd\\\"\");\n\n            WriteColor(\"[8/8] Lanzando ahora mismo la Interfaz del Firmware Xview Liberado en tu pantalla de TV...\", ConsoleColor.Green);\n            InvokeAdbSafe(\"shell \\\"input keyevent KEYCODE_WAKEUP; input keyevent KEYCODE_HOME\\\"\");\n            InvokeAdbSafe(\"shell \\\"am start -a android.intent.action.MAIN -c android.intent.category.HOME\\\"\");\n            InvokeAdbSafe(\"shell \\\"monkey -p com.google.android.tvlauncher -c android.intent.category.LAUNCHER 1 2>/dev/null || monkey -p dev.dworks.apps.alauncher -c android.intent.category.LAUNCHER 1\\\"\");\n\n            Console.WriteLine();\n            WriteColor(\"================================================================================\", ConsoleColor.Green);\n            WriteColor(\" [MISION CUMPLIDA!] CAJA LIBERADA CON LA INTERFAZ DEL FIRMWARE XVIEW LIBERADO   \", ConsoleColor.Green);\n            WriteColor(\" * Pantalla Azul de Megacable y Candado QR eliminados.                          \", ConsoleColor.Green);\n            WriteColor(\" * Interfaz Android TV / Google TV + AppDMC + DLStore + Xuper + MagisTV activos.\", ConsoleColor.Green);\n            WriteColor(\"================================================================================\", ConsoleColor.Green);\n            LogEvent(\"LIBERATED_UI_TRANSFORM\", \"Transformacion a Interfaz Firmware Xview Liberado completada (Apps instaladas=\" + installedCount + \").\");\n        }\n\n        static void InvokeDirectLiberatedUiTransformation()\n        {\n            LogEvent(\"OPCION_2_UI\", \"Usuario inicio Opcion 2: Transformar TV a Interfaz Firmware Xview Liberado.\");\n            Console.WriteLine();\n            WriteColor(\"================================================================================\", ConsoleColor.Cyan);\n            WriteColor(\"  OPCION 2: APLICAR INTERFAZ FIRMWARE XVIEW LIBERADO (DMC.v2.25) EN LA TV       \", ConsoleColor.Cyan);\n            WriteColor(\"================================================================================\", ConsoleColor.Cyan);\n\n            // 1. Verificar si ya hay ADB activo por USB o Red\n            ToolResult adbRes = InvokeToolSafe(ADB_EXE, \"devices\", 2000, true);\n            Match mAdb = Regex.Match(adbRes.Output, @\"(?m)^(\\S+)\\s+device\\b\");\n            if (mAdb.Success)\n            {\n                WriteColor(\"[+] Sesion ADB activa detectada (\" + mAdb.Groups[1].Value + \")! Aplicando interfaz liberada...\", ConsoleColor.Green);\n                ExecuteLiberatedXviewFirmwareUiTransformation();\n                WriteColor(\"\\nPresiona ENTER para volver al menu: \", ConsoleColor.Gray, false);\n                Console.ReadLine();\n                return;\n            }\n\n            // 2. Escanear automaticamente la red local por si la caja tiene puerto 5555 abierto\n            if (ScanLocalNetworkForBoxAdb())\n            {\n                ExecuteLiberatedXviewFirmwareUiTransformation();\n                WriteColor(\"\\nPresiona ENTER para volver al menu: \", ConsoleColor.Gray, false);\n                Console.ReadLine();\n                return;\n            }\n\n            Console.WriteLine();\n            WriteColor(\"[!] La caja aun no tiene el puente ADB abierto en USB ni en Red (:5555).\", ConsoleColor.Yellow);\n            WriteColor(\"    Para abrir la caja 100% por fuera sin codigo QR, usa la Opcion [1] (Mision Principal)\", ConsoleColor.White);\n            WriteColor(\"    presionando el boton externo RESET en la caja.\", ConsoleColor.White);\n            WriteColor(\"\\nPresiona ENTER para volver al menu: \", ConsoleColor.Gray, false);\n            Console.ReadLine();\n        }\n\n        static void InvokeQuickUnlockPartitionsFlash()\n        {\n            Console.WriteLine();\n            WriteColor(\"[+] Inyectando logo, oem, conf (Viettel_OTT_12), vbmeta (flags=0x03), recovery y cache_ext4...\", ConsoleColor.Cyan);\n            string[,] parts = new string[,]\n            {\n                { \"env\",      ENV_UNL_IMG },\n                { \"conf\",     CONF_IMG },\n                { \"logo\",     Path.Combine(FW_DIR, \"logo.img\") },\n                { \"oem\",      Path.Combine(FW_DIR, \"oem.img\") },\n                { \"vbmeta\",   Path.Combine(FW_DIR, \"vbmeta.img\") },\n                { \"recovery\", Path.Combine(FW_DIR, \"recovery.img\") },\n                { \"cache\",    Path.Combine(FW_DIR, \"cache_ext4.img\") }\n            };\n\n            int okCount = 0;\n            int total = parts.GetLength(0);\n            for (int i = 0; i < total; i++)\n            {\n                string pName = parts[i, 0];\n                string pFile = parts[i, 1];\n                if (File.Exists(pFile))\n                {\n                    WriteColor(\"  -> Flasheando '\" + pName + \"' (\" + Path.GetFileName(pFile) + \")...\", ConsoleColor.White);\n                    ToolResult res = InvokeFastbootSafe(\"flash \" + pName + \" \\\"\" + pFile + \"\\\"\", 35000);\n                    InvokeFastbootSafe(\"getvar version-bootloader\", 1200, false);\n                    if (!res.TimedOut && res.ExitCode == 0 &&\n                        res.Output.IndexOf(\"FAILED\", StringComparison.OrdinalIgnoreCase) < 0 &&\n                        res.Output.IndexOf(\"locked device\", StringComparison.OrdinalIgnoreCase) < 0)\n                    {\n                        WriteColor(\"     [OKAY] Particion '\" + pName + \"' escrita correctamente.\", ConsoleColor.Green);\n                        okCount++;\n                    }\n                    else\n                    {\n                        WriteColor(\"     [AVISO] Respuesta en '\" + pName + \"': \" + res.Output.Replace(\"\\r\", \" \").Replace(\"\\n\", \" | \"), ConsoleColor.Yellow);\n                    }\n                }\n            }\n\n            if (okCount > 0)\n            {\n                Console.WriteLine();\n                WriteColor(\"[EXITO] Particiones del Firmware Xview Liberado inyectadas. Reiniciando caja...\", ConsoleColor.Green);\n                InvokeFastbootSafe(\"reboot\", 3000);\n            }\n            else\n            {\n                Console.WriteLine();\n                WriteColor(\"[!] El bootloader sigue con lock=10001000 (bloqueado). La caja se mantiene en Fastboot.\", ConsoleColor.Yellow);\n            }\n        }\n\n        // ==============================================================================\n        // ASISTENTE EN VIVO CUANDO U-BOOT FASTBOOT (PID_0D02) REPORTA lock=10001000\n        // ==============================================================================\n        static bool HandleLockedFastbootInMainMission()\n        {\n            LogEvent(\"FASTBOOT_LOCKED_ASSIST\", \"Entrando en HandleLockedFastbootInMainMission (lock=10001000).\");\n            Console.WriteLine();\n            WriteColor(\"================================================================================\", ConsoleColor.Yellow);\n            WriteColor(\"  CAJA RETENIDA EN FASTBOOT (PID_0D02) CON CANDADO U-BOOT (lock=10001000)       \", ConsoleColor.Yellow);\n            WriteColor(\"================================================================================\", ConsoleColor.Yellow);\n            WriteColor(\"  Tu caja ZTE B866V2 (U-Boot Sep 05 2023) esta conectada y retenida en Fastboot.\", ConsoleColor.White);\n            WriteColor(\"  Elige como deseas continuar hacia la Interfaz del Firmware Xview Liberado:\", ConsoleColor.Cyan);\n            Console.WriteLine();\n            WriteColor(\"  [1] CAZAR MODO WORLDCUP (48ms) CON CUENTA REGRESIVA DE 5 SEGUNDOS:\", ConsoleColor.Green);\n            WriteColor(\"      (Retira la memoria USB KINGSTON de la caja, deja SOLO el cable USB Macho-a-Macho,\", ConsoleColor.Gray);\n            WriteColor(\"       el programa te dara 5 segundos para presionar RESET antes de reiniciar la caja\", ConsoleColor.Gray);\n            WriteColor(\"       y cazara WorldCup / Fastbootd / ADB simultaneamente)\", ConsoleColor.Gray);\n            WriteColor(\"  [2] PREPARAR MEMORIA USB KINGSTON CON PACK COMPLETO FIRMWARE XVIEW LIBERADO\", ConsoleColor.Yellow);\n            WriteColor(\"      + REINICIAR CAJA Y ESCANEAR PUENTE ADB (USB y Red Local :5555)\", ConsoleColor.Yellow);\n            WriteColor(\"  [3] Volver al menu principal (manteniendo la caja en Fastboot)\", ConsoleColor.Gray);\n            Console.WriteLine();\n\n            string sel = ReadChoiceWithKeepAlive(\"Elige 1, 2 o 3\", new[] { \"1\", \"2\", \"3\" });\n            if (sel == \"3\") return false;\n\n            if (sel == \"2\")\n            {\n                AutoPrepareConnectedUsbDrive();\n                WriteColor(\"\\n[*] Reiniciando la caja hacia Android y activando escaneo de ADB USB + Red (:5555)...\", ConsoleColor.Cyan);\n                InvokeFastbootSafe(\"reboot\", 2500);\n                WaitAndCatchAdbAfterReboot(45);\n                return false;\n            }\n\n            // Opcion 1: Cuenta regresiva de 5 segundos para que el usuario presione RESET antes de enviar fastboot reboot\n            Console.WriteLine();\n            WriteColor(\"================================================================================\", ConsoleColor.Green);\n            WriteColor(\"  PREPARATE: RETIRA LA MEMORIA USB DE LA CAJA Y PRESIONA EL BOTON RESET AHORA   \", ConsoleColor.Green);\n            WriteColor(\"================================================================================\", ConsoleColor.Green);\n            for (int sec = 5; sec >= 1; sec--)\n            {\n                WriteColor(\"  -> Reiniciando caja en \" + sec + \" segundos... (MANTEN PRESIONADO RESET CON EL CLIP!)\", ConsoleColor.Yellow);\n                InvokeFastbootSafe(\"getvar version-bootloader\", 800, false);\n                Thread.Sleep(900);\n            }\n\n            WriteColor(\"\\n[*] Enviando 'fastboot reboot' AHORA! (Sigue manteniendo RESET 5 segundos)...\", ConsoleColor.Green);\n            InvokeFastbootSafe(\"reboot\", 2500);\n\n            Stopwatch swHunt = Stopwatch.StartNew();\n            int loopTick = 0;\n            while (swHunt.Elapsed.TotalSeconds < 45)\n            {\n                loopTick++;\n                // 1. Caza WorldCup (VID_1B8E) cada 48ms\n                if (TryCatchWorldCup48ms())\n                {\n                    return true;\n                }\n\n                // 2. Cada ~400ms verificar si entro a Recovery Fastbootd (PID_4EE7) o ADB (PID_4EE2)\n                if ((loopTick % 8) == 0)\n                {\n                    ToolResult fbCheck = InvokeFastbootSafe(\"devices\", 1000, false);\n                    if (!fbCheck.TimedOut && Regex.IsMatch(fbCheck.Output, @\"(?m)^(\\S+)\\s+fastboot\"))\n                    {\n                        ToolResult uCheck = InvokeFastbootSafe(\"getvar is-userspace\", 1000, false);\n                        if (Regex.IsMatch(uCheck.Output, @\"is-userspace:\\s*yes\", RegexOptions.IgnoreCase))\n                        {\n                            Match mSn = Regex.Match(fbCheck.Output, @\"(?m)^(\\S+)\\s+fastboot\");\n                            TryFlashInRecoveryFastbootd(mSn.Success ? mSn.Groups[1].Value : \"B866V2\");\n                            return true;\n                        }\n                    }\n\n                    ToolResult adbCheck = InvokeToolSafe(ADB_EXE, \"devices\", 1000, false);\n                    if (!adbCheck.TimedOut && Regex.IsMatch(adbCheck.Output, @\"(?m)^(\\S+)\\s+device\\b\"))\n                    {\n                        WriteColor(\"\\n[+] Sesion ADB detectada tras el reinicio! Aplicando Interfaz Firmware Xview Liberado...\", ConsoleColor.Green);\n                        ExecuteLiberatedXviewFirmwareUiTransformation();\n                        return false;\n                    }\n                }\n\n                Thread.Sleep(25);\n            }\n\n            Console.WriteLine();\n            WriteColor(\"[!] La caja encendio en Android sin abrir WorldCup (VID_1B8E). Probando escaneo ADB en red local...\", ConsoleColor.Cyan);\n            if (ScanLocalNetworkForBoxAdb())\n            {\n                ExecuteLiberatedXviewFirmwareUiTransformation();\n            }\n            return false;\n        }\n\n        static void WaitAndCatchAdbAfterReboot(int secondsToWait)\n        {\n            WriteColor(\"[*] Esperando a que la caja termine de encender (\" + secondsToWait + \"s) mientras buscamos ADB por USB y Red...\", ConsoleColor.Cyan);\n            Stopwatch sw = Stopwatch.StartNew();\n            while (sw.Elapsed.TotalSeconds < secondsToWait)\n            {\n                ToolResult adbRes = InvokeToolSafe(ADB_EXE, \"devices\", 1500, false);\n                if (!adbRes.TimedOut && Regex.IsMatch(adbRes.Output, @\"(?m)^(\\S+)\\s+device\\b\"))\n                {\n                    WriteColor(\"[+] Sesion ADB USB detectada! Aplicando Interfaz del Firmware Xview Liberado...\", ConsoleColor.Green);\n                    ExecuteLiberatedXviewFirmwareUiTransformation();\n                    return;\n                }\n                Thread.Sleep(2000);\n            }\n\n            if (ScanLocalNetworkForBoxAdb())\n            {\n                ExecuteLiberatedXviewFirmwareUiTransformation();\n            }\n            else\n            {\n                WriteColor(\"[i] Si acabas de preparar la memoria USB KINGSTON, insertala en la caja para abrir el modo debug/instalador.\", ConsoleColor.Yellow);\n            }\n        }\n\n        // ==============================================================================\n        // OPCION 1: MISION PRINCIPAL - LIBERACION TOTAL + INTERFAZ FIRMWARE XVIEW LIBERADO\n        // ==============================================================================\n        static void InvokeMainMissionLiberationAndUi()\n        {\n            LogEvent(\"MISION_PRINCIPAL\", \"Iniciando Opcion 1: Mision Principal (Liberacion Total + Interfaz Firmware Xview Liberado DMC.v2.25)...\");\n            Console.WriteLine();\n            WriteColor(\"================================================================================\", ConsoleColor.Green);\n            WriteColor(\"  MISION PRINCIPAL: LIBERAR CAJA + INTERFAZ FIRMWARE XVIEW LIBERADO (DMC.v2.25) \", ConsoleColor.Green);\n            WriteColor(\"================================================================================\", ConsoleColor.Green);\n            WriteColor(\"  Resultado Final de esta Mision:\", ConsoleColor.White);\n            WriteColor(\"   1. Quitar Pantalla Azul 'ESTE EQUIPO ES PROPIEDAD DE MEGACABLE' y candado QR.\", ConsoleColor.Cyan);\n            WriteColor(\"   2. Instalar el Firmware / Interfaz Xview Liberado (Launcher Android TV Oficial,\", ConsoleColor.Cyan);\n            WriteColor(\"      Google TV, AppDMC, DLStore, HDPlay, Xuper Hydra, XSairec, MXL Movies, MagisTV).\", ConsoleColor.Cyan);\n            WriteColor(\"   3. Conservar 100% intactos tus certificados Widevine L1 (factory) y MAC (cri_data).\", ConsoleColor.Cyan);\n            Console.WriteLine();\n            WriteColor(\"  COMO ACTIVAR EL SALTO EXTERNO EN TU CAJA AHORA MISMO:\", ConsoleColor.Yellow);\n            WriteColor(\"   * Con la memoria USB KINGSTON insertada en la caja y el cable USB Macho-a-Macho\", ConsoleColor.White);\n            WriteColor(\"     conectado a la PC, desconecta la corriente, manten presionado el boton RESET\", ConsoleColor.White);\n            WriteColor(\"     y vuelve a conectar la corriente (o si ya esta en Fastboot/ADB la atrapara al instante).\", ConsoleColor.White);\n            Console.WriteLine();\n            WriteColor(\"[*] RADAR MULTICANAL ACTIVO (48ms WorldCup + Fastbootd + Fastboot + ADB)... (ESC para volver al menu)\", ConsoleColor.Green);\n\n            int tick = 0;\n            DateTime lastRebootToBl = DateTime.MinValue;\n\n            while (true)\n            {\n                if (Console.KeyAvailable)\n                {\n                    var k = Console.ReadKey(true);\n                    if (k.Key == ConsoleKey.Escape)\n                    {\n                        LogEvent(\"MISION_PRINCIPAL\", \"Usuario salio del radar con ESC.\");\n                        return;\n                    }\n                }\n\n                tick++;\n\n                // 1. Caza directa WorldCup cada 48ms\n                if (TryCatchWorldCup48ms())\n                {\n                    lastRebootToBl = DateTime.Now;\n                    continue;\n                }\n\n                if ((DateTime.Now - lastRebootToBl).TotalSeconds < 3.2)\n                {\n                    Thread.Sleep(50);\n                    continue;\n                }\n\n                // 2. Cada 6 ticks (~300ms), verificar Fastboot y ADB\n                if ((tick % 6) == 0)\n                {\n                    ToolResult fbDevs = InvokeFastbootSafe(\"devices\", 1200, false);\n                    if (!fbDevs.TimedOut)\n                    {\n                        Match mFb = Regex.Match(fbDevs.Output, @\"(?m)^(\\S+)\\s+fastboot\");\n                        if (mFb.Success)\n                        {\n                            string fbSn = mFb.Groups[1].Value;\n                            ToolResult ping = InvokeFastbootSafe(\"getvar version-bootloader\", 900, false);\n                            if (!ping.TimedOut && (\n                                ping.Output.IndexOf(\"version-bootloader\", StringComparison.OrdinalIgnoreCase) >= 0 ||\n                                ping.Output.IndexOf(\"OKAY\", StringComparison.OrdinalIgnoreCase) >= 0 ||\n                                ping.Output.IndexOf(\"Finished\", StringComparison.OrdinalIgnoreCase) >= 0))\n                            {\n                                ToolResult uCheck = InvokeFastbootSafe(\"getvar is-userspace\", 1200, true);\n                                if (Regex.IsMatch(uCheck.Output, @\"is-userspace:\\s*yes\", RegexOptions.IgnoreCase))\n                                {\n                                    LogEvent(\"FASTBOOTD_CAUGHT\", \"Detectado Recovery fastbootd (PID_4EE7 / \" + fbSn + \").\");\n                                    TryFlashInRecoveryFastbootd(fbSn);\n                                    lastRebootToBl = DateTime.Now;\n                                    continue;\n                                }\n\n                                LogEvent(\"UBOOT_FASTBOOT_CAUGHT\", \"Detectado U-Boot Fastboot en vivo (PID_0D02 / \" + fbSn + \").\");\n                                Console.WriteLine();\n                                WriteColor(\"[+] Caja atrapada en U-Boot Fastboot en vivo (Serie: \" + fbSn + \")!\", ConsoleColor.Green);\n                                WriteColor(\"    Reteniendo Watchdog y ejecutando secuencia de desbloqueo limpia...\", ConsoleColor.Cyan);\n\n                                InvokeFastbootSafe(\"flashing get_unlock_ability\", 1500, true);\n                                InvokeFastbootSafe(\"flashing unlock_critical\", 1500, true);\n                                InvokeFastbootSafe(\"flashing unlock\", 1500, true);\n                                InvokeFastbootSafe(\"oem \\\"watchdog off\\\"\", 1200, true);\n                                InvokeFastbootSafe(\"oem \\\"setenv lock 10100000;save\\\"\", 1200, true);\n                                InvokeFastbootSafe(\"oem \\\"setenv otg_device 1;save\\\"\", 1200, true);\n                                InvokeFastbootSafe(\"oem \\\"saveenv\\\"\", 1200, true);\n\n                                ToolResult unlRes = InvokeFastbootSafe(\"getvar unlocked\", 1500, true);\n                                bool isUnlocked = Regex.IsMatch(unlRes.Output, @\"unlocked:\\s*yes\", RegexOptions.IgnoreCase);\n\n                                if (!isUnlocked)\n                                {\n                                    string dtbPath = Path.Combine(FW_DIR, \"dtb.img\");\n                                    if (File.Exists(dtbPath))\n                                    {\n                                        ToolResult testWrite = InvokeFastbootSafe(\"flash _aml_dtb \\\"\" + dtbPath + \"\\\"\", 2500, true);\n                                        if (!testWrite.TimedOut && testWrite.ExitCode == 0 &&\n                                            testWrite.Output.IndexOf(\"OKAY\", StringComparison.OrdinalIgnoreCase) >= 0 &&\n                                            testWrite.Output.IndexOf(\"FAILED\", StringComparison.OrdinalIgnoreCase) < 0 &&\n                                            testWrite.Output.IndexOf(\"locked device\", StringComparison.OrdinalIgnoreCase) < 0)\n                                        {\n                                            isUnlocked = true;\n                                        }\n                                    }\n                                }\n\n                                if (isUnlocked)\n                                {\n                                    LogEvent(\"FASTBOOT_UNLOCKED\", \"Bootloader verificado como DESBLOQUEADO (isUnlocked=true).\");\n                                    Console.WriteLine();\n                                    WriteColor(\"================================================================================\", ConsoleColor.Green);\n                                    WriteColor(\" [OK] BOOTLOADER 100% DESBLOQUEADO (unlocked: yes) Y WATCHDOG RETENIDO          \", ConsoleColor.Green);\n                                    WriteColor(\"================================================================================\", ConsoleColor.Green);\n                                    WriteColor(\"  [1] Flashear Firmware Xview Liberado Completo (Particiones + Interfaz DMC.v2.25)\", ConsoleColor.Green);\n                                    WriteColor(\"  [2] Inyectar logo + oem + conf + vbmeta + recovery + cache_ext4 y reiniciar\", ConsoleColor.Cyan);\n                                    WriteColor(\"  [3] Dejar en Fastboot y volver al menu\", ConsoleColor.Gray);\n                                    Console.WriteLine();\n\n                                    string next = ReadChoiceWithKeepAlive(\"Elige 1, 2 o 3\", new[] { \"1\", \"2\", \"3\" });\n                                    if (next == \"1\")\n                                    {\n                                        InvokeSafeAndroid12Flash(true);\n                                    }\n                                    else if (next == \"2\")\n                                    {\n                                        InvokeQuickUnlockPartitionsFlash();\n                                        WaitAndCatchAdbAfterReboot(45);\n                                    }\n                                    break;\n                                }\n                                else\n                                {\n                                    bool continueRadar = HandleLockedFastbootInMainMission();\n                                    if (continueRadar)\n                                    {\n                                        lastRebootToBl = DateTime.Now;\n                                        continue;\n                                    }\n                                    else\n                                    {\n                                        break;\n                                    }\n                                }\n                            }\n                        }\n                    }\n\n                    // 3. Verificar sesion ADB activa\n                    ToolResult adbRes = InvokeToolSafe(ADB_EXE, \"devices\", 1500, false);\n                    if (!adbRes.TimedOut)\n                    {\n                        if (Regex.IsMatch(adbRes.Output, @\"(?m)^(\\S+)\\s+unauthorized\"))\n                        {\n                            WriteColor(\"[!] Acepta el cartel 'Permitir Depuracion por USB' en tu TV...\", ConsoleColor.Yellow);\n                        }\n                        else\n                        {\n                            Match mAdb = Regex.Match(adbRes.Output, @\"(?m)^(\\S+)\\s+device\\b\");\n                            if (mAdb.Success)\n                            {\n                                string adbId = mAdb.Groups[1].Value;\n                                LogEvent(\"ADB_CAUGHT\", \"Sesion ADB autorizada detectada: \" + adbId);\n                                Console.WriteLine();\n                                WriteColor(\"[+] Detectada sesion ADB activa (\" + adbId + \")! Ejecutando Transformacion a Interfaz Xview Liberado...\", ConsoleColor.Green);\n                                ExecuteLiberatedXviewFirmwareUiTransformation();\n                                break;\n                            }\n                        }\n                    }\n                }\n\n                Thread.Sleep(20);\n            }\n\n            WriteColor(\"\\nPresiona ENTER para volver al menu: \", ConsoleColor.Gray, false);\n            Console.ReadLine();\n        }\n\n        static void InvokeSafeAndroid12Flash(bool alreadyInFastboot)\n        {\n            LogEvent(\"OPCION_3_FLASH\", \"Iniciando InvokeSafeAndroid12Flash (alreadyInFastboot=\" + alreadyInFastboot + \")\");\n            Console.WriteLine();\n            WriteColor(\"================================================================================\", ConsoleColor.Magenta);\n            WriteColor(\"  FLASHEO FIRMWARE XVIEW LIBERADO ANDROID 12 (B866V2) PROTEGIENDO WIDEVINE L1   \", ConsoleColor.Magenta);\n            WriteColor(\"================================================================================\", ConsoleColor.Magenta);\n            WriteColor(\"  * Inyecta boot, _aml_dtb, dtbo, logo, param, conf (Viettel_OTT_12), oem,\", ConsoleColor.Green);\n            WriteColor(\"    vbmeta (flags=0x03), recovery desbloqueado y cache_ext4 del Xview Liberado.\", ConsoleColor.Green);\n            WriteColor(\"  * Protege 100% tus particiones 'factory' (Widevine L1) y 'cri_data' (MAC/Serie).\", ConsoleColor.Green);\n            WriteColor(\"  * Al reiniciar, instala automaticamente la Interfaz Xview Liberada (DMC.v2.25).\", ConsoleColor.Green);\n            Console.WriteLine();\n\n            string superPath = Path.Combine(FW_DIR, \"super.img\");\n            if (!File.Exists(superPath))\n            {\n                string[] candidates = new string[]\n                {\n                    @\"D:\\B866v2 Android 12\\B866v2 Android 12\\B866V2\\super.img\",\n                    @\"E:\\B866v2 Android 12\\B866v2 Android 12\\B866V2\\super.img\",\n                    @\"F:\\B866v2 Android 12\\B866v2 Android 12\\B866V2\\super.img\",\n                    @\"C:\\Users\\andre\\OneDrive\\Desktop\\xview\\V2\\B866v2 Android 12\\B866v2 Android 12\\B866V2\\super.img\",\n                    @\"C:\\Users\\andre\\OneDrive\\Desktop\\xview\\FIRMWARE_COMPLETO_B866V2_FASTBOOT\\super.img\"\n                };\n                foreach (string c in candidates)\n                {\n                    if (File.Exists(c)) { superPath = c; break; }\n                }\n            }\n\n            if (!alreadyInFastboot)\n            {\n                WriteColor(\"[1/12] Escuchando WorldCup (48ms) o Fastboot (Manten RESET al conectar corriente)... (ESC para cancelar)\", ConsoleColor.Cyan);\n                DateTime lastJump = DateTime.MinValue;\n                while (true)\n                {\n                    if (Console.KeyAvailable && Console.ReadKey(true).Key == ConsoleKey.Escape) return;\n\n                    if (TryCatchWorldCup48ms())\n                    {\n                        lastJump = DateTime.Now;\n                        continue;\n                    }\n                    if ((DateTime.Now - lastJump).TotalSeconds < 3.2)\n                    {\n                        Thread.Sleep(50);\n                        continue;\n                    }\n                    ToolResult fbRes = InvokeFastbootSafe(\"devices\", 1200, false);\n                    if (!fbRes.TimedOut && Regex.IsMatch(fbRes.Output, @\"(?m)^(\\S+)\\s+fastboot\"))\n                    {\n                        ToolResult ping = InvokeFastbootSafe(\"getvar version-bootloader\", 900, false);\n                        if (!ping.TimedOut && (\n                            ping.Output.IndexOf(\"version-bootloader\", StringComparison.OrdinalIgnoreCase) >= 0 ||\n                            ping.Output.IndexOf(\"OKAY\", StringComparison.OrdinalIgnoreCase) >= 0 ||\n                            ping.Output.IndexOf(\"Finished\", StringComparison.OrdinalIgnoreCase) >= 0))\n                        {\n                            ToolResult uCheck = InvokeFastbootSafe(\"getvar is-userspace\", 1200, true);\n                            if (Regex.IsMatch(uCheck.Output, @\"is-userspace:\\s*yes\", RegexOptions.IgnoreCase))\n                            {\n                                Match mSn = Regex.Match(fbRes.Output, @\"(?m)^(\\S+)\\s+fastboot\");\n                                TryFlashInRecoveryFastbootd(mSn.Success ? mSn.Groups[1].Value : \"B866V2\");\n                                lastJump = DateTime.Now;\n                                continue;\n                            }\n                            break;\n                        }\n                    }\n                    Thread.Sleep(35);\n                }\n            }\n\n            WriteColor(\"[2/12] Verificando desbloqueo del Bootloader y reteniendo Watchdog...\", ConsoleColor.Cyan);\n            InvokeFastbootSafe(\"flashing unlock_critical\", 1500, true);\n            InvokeFastbootSafe(\"flashing unlock\", 1500, true);\n            InvokeFastbootSafe(\"oem \\\"watchdog off\\\"\", 1200, true);\n            InvokeFastbootSafe(\"oem \\\"setenv lock 10100000;save\\\"\", 1200, true);\n            InvokeFastbootSafe(\"oem \\\"setenv otg_device 1;save\\\"\", 1200, true);\n            InvokeFastbootSafe(\"oem \\\"saveenv\\\"\", 1200, true);\n\n            ToolResult dtbTest = InvokeFastbootSafe(\"flash _aml_dtb \\\"\" + Path.Combine(FW_DIR, \"dtb.img\") + \"\\\"\", 2500, true);\n            if (dtbTest.TimedOut ||\n                dtbTest.Output.IndexOf(\"FAILED\", StringComparison.OrdinalIgnoreCase) >= 0 ||\n                dtbTest.Output.IndexOf(\"locked device\", StringComparison.OrdinalIgnoreCase) >= 0)\n            {\n                Console.WriteLine();\n                WriteColor(\"[!] El bootloader aun reporta lock=10001000. Abriendo asistente de desbloqueo...\", ConsoleColor.Yellow);\n                bool okWc = HandleLockedFastbootInMainMission();\n                if (!okWc) return;\n            }\n\n            WriteColor(\"[5/12] PROTEGIENDO factory.img (Widevine L1) y cri_data.img (MAC/Serie) - OMITIDOS POR SEGURIDAD.\", ConsoleColor.Green);\n\n            var flashSteps = new[]\n            {\n                new { Step = \"[3/12]\",  Part = \"env\",      File = ENV_UNL_IMG,                        Timeout = 10000 },\n                new { Step = \"[3B/12]\", Part = \"boot\",     File = Path.Combine(FW_DIR, \"boot.img\"),   Timeout = 30000 },\n                new { Step = \"[4/12]\",  Part = \"_aml_dtb\", File = Path.Combine(FW_DIR, \"dtb.img\"),    Timeout = 10000 },\n                new { Step = \"[4B/12]\", Part = \"dtbo\",     File = Path.Combine(FW_DIR, \"dtbo.img\"),   Timeout = 15000 },\n                new { Step = \"[6/12]\",  Part = \"logo\",     File = Path.Combine(FW_DIR, \"logo.img\"),   Timeout = 10000 },\n                new { Step = \"[6B/12]\", Part = \"param\",    File = Path.Combine(FW_DIR, \"param.img\"),  Timeout = 20000 },\n                new { Step = \"[7/12]\",  Part = \"conf\",     File = CONF_IMG,                           Timeout = 15000 },\n                new { Step = \"[7B/12]\", Part = \"oem\",      File = Path.Combine(FW_DIR, \"oem.img\"),    Timeout = 25000 }\n            };\n\n            foreach (var fs in flashSteps)\n            {\n                if (File.Exists(fs.File))\n                {\n                    WriteColor(fs.Step + \" Flasheando '\" + fs.Part + \"'...\", ConsoleColor.Cyan);\n                    ToolResult r = InvokeFastbootSafe(\"flash \" + fs.Part + \" \\\"\" + fs.File + \"\\\"\", fs.Timeout, true);\n                    InvokeFastbootSafe(\"getvar version-bootloader\", 1200, false);\n                    if (!r.TimedOut && r.ExitCode == 0 &&\n                        r.Output.IndexOf(\"FAILED\", StringComparison.OrdinalIgnoreCase) < 0 &&\n                        r.Output.IndexOf(\"locked device\", StringComparison.OrdinalIgnoreCase) < 0)\n                    {\n                        WriteColor(\"       [OKAY] \" + fs.Part, ConsoleColor.Green);\n                    }\n                    else\n                    {\n                        WriteColor(\"       [AVISO] \" + fs.Part + \": \" + r.Output.Replace(\"\\r\", \" \").Replace(\"\\n\", \" \"), ConsoleColor.Yellow);\n                    }\n                }\n            }\n\n            if (File.Exists(superPath))\n            {\n                WriteColor(\"[8/12] Flasheando super.img (Android 12 Liberado B866V2 - puede tardar ~90s)...\", ConsoleColor.Cyan);\n                InvokeToolInteractive(FASTBOOT_EXE, \"flash super \\\"\" + superPath + \"\\\"\");\n                InvokeFastbootSafe(\"getvar version-bootloader\", 1200, false);\n            }\n            else\n            {\n                WriteColor(\"[8/12] super.img no presente en disco; la interfaz completa DMC.v2.25 se instalara por APK al encender.\", ConsoleColor.Cyan);\n            }\n\n            WriteColor(\"[9/12] Flasheando vbmeta.img (dm-verity desactivado flags=0x03)...\", ConsoleColor.Cyan);\n            InvokeFastbootSafe(\"flash vbmeta \\\"\" + Path.Combine(FW_DIR, \"vbmeta.img\") + \"\\\"\", 15000, true);\n\n            WriteColor(\"[10/12] Flasheando recovery.img (Menu Fastboot/ADB desbloqueado en TV)...\", ConsoleColor.Cyan);\n            InvokeFastbootSafe(\"flash recovery \\\"\" + Path.Combine(FW_DIR, \"recovery.img\") + \"\\\"\", 35000, true);\n\n            WriteColor(\"[11/12] Reparando particion /cache con cache_ext4.img...\", ConsoleColor.Cyan);\n            InvokeFastbootSafe(\"erase cache\", 10000, true);\n            InvokeFastbootSafe(\"flash cache \\\"\" + Path.Combine(FW_DIR, \"cache_ext4.img\") + \"\\\"\", 35000, true);\n\n            WriteColor(\"[12/12] Limpiando userdata y reiniciando caja...\", ConsoleColor.Cyan);\n            InvokeFastbootSafe(\"erase userdata\", 15000, true);\n            InvokeFastbootSafe(\"reboot\", 4000, true);\n\n            Console.WriteLine();\n            WriteColor(\"[+] Particiones flasheadas (con Widevine L1 y MAC intactos)!\", ConsoleColor.Green);\n            WaitAndCatchAdbAfterReboot(50);\n\n            WriteColor(\"\\nPresiona ENTER para volver al menu: \", ConsoleColor.Gray, false);\n            Console.ReadLine();\n        }\n\n        // ==============================================================================\n        // PREPARACION AUTOMATICA DE MEMORIA USB KINGSTON CON TODA LA INTERFAZ LIBERADA\n        // ==============================================================================\n        static bool AutoPrepareConnectedUsbDrive(string explicitDriveLetter = null)\n        {\n            try\n            {\n                string targetUsb = null;\n                if (!string.IsNullOrEmpty(explicitDriveLetter))\n                {\n                    targetUsb = explicitDriveLetter.Replace(\":\", \"\").Replace(\"\\\\\", \"\").Trim() + \":\\\\\";\n                }\n                else\n                {\n                    var drives = DriveInfo.GetDrives().Where(d => d.DriveType == DriveType.Removable && d.IsReady).ToList();\n                    if (drives.Count == 1)\n                    {\n                        targetUsb = drives[0].Name;\n                        WriteColor(\"[+] Memoria USB detectada automaticamente: \" + drives[0].Name + \" (\" + drives[0].VolumeLabel + \")\", ConsoleColor.Green);\n                    }\n                    else if (drives.Count > 1)\n                    {\n                        WriteColor(\"Memorias USB detectadas:\", ConsoleColor.Cyan);\n                        foreach (var d in drives)\n                        {\n                            WriteColor(string.Format(\"  * Unidad {0} ({1} - {2})\", d.Name, d.VolumeLabel, d.DriveFormat), ConsoleColor.Green);\n                        }\n                        WriteColor(\"Escribe la letra de tu memoria USB (ej. D): \", ConsoleColor.Yellow, false);\n                        string drv = (Console.ReadLine() ?? \"\").Replace(\":\", \"\").Replace(\"\\\\\", \"\").Trim();\n                        if (!string.IsNullOrEmpty(drv)) targetUsb = drv + \":\\\\\";\n                    }\n                }\n\n                if (string.IsNullOrEmpty(targetUsb) || !Directory.Exists(targetUsb))\n                {\n                    WriteColor(\"[!] No se detecto una memoria USB conectada en la PC en este momento.\", ConsoleColor.Yellow);\n                    return false;\n                }\n\n                WriteColor(\"[*] Copiando llaves externas (factory_update_param.aml + QADEBUG.ini) a \" + targetUsb + \"...\", ConsoleColor.Cyan);\n                foreach (string f in Directory.GetFiles(KEYS_DIR))\n                {\n                    File.Copy(f, Path.Combine(targetUsb, Path.GetFileName(f)), true);\n                }\n\n                string usbApkDir = Path.Combine(targetUsb, \"INTERFAZ_FIRMWARE_XVIEW_LIBERADO\");\n                Directory.CreateDirectory(usbApkDir);\n\n                WriteColor(\"[*] Copiando Suite Completa de Interfaz Firmware Xview Liberado (DMC.v2.25) a la USB...\", ConsoleColor.Cyan);\n                for (int i = 0; i < LIBERATED_FIRMWARE_UI_APKS.GetLength(0); i++)\n                {\n                    string apkName = LIBERATED_FIRMWARE_UI_APKS[i, 0];\n                    string src = Path.Combine(APKS_DIR, apkName);\n                    if (File.Exists(src))\n                    {\n                        WriteColor(\"    -> Copiando \" + apkName + \"...\", ConsoleColor.Gray);\n                        File.Copy(src, Path.Combine(usbApkDir, apkName), true);\n                        // Copiar tambien los launchers principales a la raiz de la USB para acceso rapido\n                        if (i < 6)\n                        {\n                            File.Copy(src, Path.Combine(targetUsb, apkName), true);\n                        }\n                    }\n                }\n\n                WriteColor(\"[OK] Memoria USB \" + targetUsb + \" preparada con Llaves de Salto + Interfaz Firmware Xview Liberado!\", ConsoleColor.Green);\n                LogEvent(\"USB_PREP\", \"Memoria USB preparada exitosamente en \" + targetUsb);\n                return true;\n            }\n            catch (Exception ex)\n            {\n                WriteColor(\"[!] Error preparando USB: \" + ex.Message, ConsoleColor.Red);\n                return false;\n            }\n        }\n\n        static void InvokeAppInstallerMenu()\n        {\n            Console.WriteLine();\n            WriteColor(\"=== OPCION 5: CATALOGO DE APKS DEL FIRMWARE XVIEW LIBERADO (DMC.v2.25) ===\", ConsoleColor.Yellow);\n            if (!Directory.Exists(APKS_DIR))\n            {\n                WriteColor(\"[!] No se encontro el directorio de APKs.\", ConsoleColor.Red);\n                return;\n            }\n            FileInfo[] apks = new DirectoryInfo(APKS_DIR).GetFiles(\"*.apk\");\n            for (int i = 0; i < apks.Length; i++)\n            {\n                double sizeMB = Math.Round(apks[i].Length / (1024.0 * 1024.0), 2);\n                WriteColor(string.Format(\"  [{0}] {1} ({2} MB)\", i + 1, apks[i].Name, sizeMB), ConsoleColor.White, true, false);\n            }\n            WriteColor(\"  [T] TRANSFORMACION COMPLETA: INSTALAR TODA LA INTERFAZ LIBERADA + QUITAR PANTALLA AZUL\", ConsoleColor.Green, true, false);\n            WriteColor(\"  [0] Volver al menu principal\", ConsoleColor.Gray, true, false);\n            Console.WriteLine();\n            WriteColor(\"Elige el numero de la app a instalar (o 'T' para transformacion completa): \", ConsoleColor.Yellow, false);\n            string sel = (Console.ReadLine() ?? \"\").Trim();\n            if (sel == \"0\" || string.IsNullOrEmpty(sel)) return;\n\n            if (sel.Equals(\"T\", StringComparison.OrdinalIgnoreCase))\n            {\n                ExecuteLiberatedXviewFirmwareUiTransformation();\n            }\n            else\n            {\n                int idx;\n                if (int.TryParse(sel, out idx))\n                {\n                    idx -= 1;\n                    if (idx >= 0 && idx < apks.Length)\n                    {\n                        WriteColor(\"[+] Instalando \" + apks[idx].Name + \"...\", ConsoleColor.Cyan);\n                        InvokeAdbInteractive(\"install -r -d -g \\\"\" + apks[idx].FullName + \"\\\"\");\n                    }\n                }\n            }\n            WriteColor(\"\\nPresiona ENTER para volver al menu: \", ConsoleColor.Gray, false);\n            Console.ReadLine();\n        }\n\n        static void InvokeAmlogicWorldCupEngine()\n        {\n            Console.WriteLine();\n            WriteColor(\"================================================================================\", ConsoleColor.Cyan);\n            WriteColor(\"   OPCION 6: MOTOR AMLOGIC DNL / WORLDCUP (adnl.exe + update.exe VID_1B8E)      \", ConsoleColor.Cyan);\n            WriteColor(\"================================================================================\", ConsoleColor.Cyan);\n            WriteColor(\"  [1] Activar Caza Continua WorldCup (48ms) -> Desbloquear env_unlocked.img y saltar a Fastboot\", ConsoleColor.Green);\n            WriteColor(\"  [2] Escanear dispositivo en modo WorldCup / ADNL ahora mismo\", ConsoleColor.White);\n            WriteColor(\"  [3] Reiniciar caja desde modo ADNL / WorldCup\", ConsoleColor.White);\n            WriteColor(\"  [0] Volver al menu principal\", ConsoleColor.Gray);\n            Console.WriteLine();\n            WriteColor(\"Elige una opcion: \", ConsoleColor.Yellow, false);\n            string sub = (Console.ReadLine() ?? \"\").Trim();\n\n            if (sub == \"1\")\n            {\n                WriteColor(\"\\n[*] Escuchando modo WorldCup / InUsbBurn cada 48ms (Manten RESET al conectar corriente)... (ESC para salir)\", ConsoleColor.Green);\n                while (true)\n                {\n                    if (Console.KeyAvailable && Console.ReadKey(true).Key == ConsoleKey.Escape) break;\n                    if (TryCatchWorldCup48ms())\n                    {\n                        WriteColor(\"[OK] Caja desbloqueada y enviada a Fastboot (PID_0D02)!\", ConsoleColor.Green);\n                        break;\n                    }\n                    Thread.Sleep(25);\n                }\n            }\n            else if (sub == \"2\")\n            {\n                WriteColor(\"\\n--- Escaneo con adnl.exe ---\", ConsoleColor.Cyan);\n                InvokeToolInteractive(ADNL_EXE, \"devices\");\n                WriteColor(\"\\n--- Escaneo con update.exe ---\", ConsoleColor.Cyan);\n                InvokeToolInteractive(UPDATE_EXE, \"identify 7\");\n            }\n            else if (sub == \"3\")\n            {\n                InvokeToolSafe(ADNL_EXE, \"reboot\", 3000, true);\n                InvokeUpdateSafe(\"bulkcmd \\\"reset\\\"\", 3000, true);\n            }\n            WriteColor(\"\\nPresiona ENTER para volver al menu: \", ConsoleColor.Gray, false);\n            Console.ReadLine();\n        }\n\n        static void InvokeUsbPrepAndLogDecrypt()\n        {\n            Console.WriteLine();\n            WriteColor(\"================================================================================\", ConsoleColor.Yellow);\n            WriteColor(\"  OPCION 4: PREPARAR MEMORIA USB (KINGSTON) CON PACK FIRMWARE XVIEW LIBERADO    \", ConsoleColor.Yellow);\n            WriteColor(\"================================================================================\", ConsoleColor.Yellow);\n\n            try\n            {\n                var drives = DriveInfo.GetDrives().Where(d => d.DriveType == DriveType.Removable && d.IsReady).ToList();\n                if (drives.Count > 0)\n                {\n                    WriteColor(\"Memorias USB detectadas en la PC:\", ConsoleColor.Cyan);\n                    foreach (var d in drives)\n                    {\n                        WriteColor(string.Format(\"  * Unidad {0} ({1} - {2})\", d.Name, d.VolumeLabel, d.DriveFormat), ConsoleColor.Green);\n                    }\n                }\n                else\n                {\n                    WriteColor(\"  [i] Si la memoria USB KINGSTON esta en la caja, pasala un momento a la PC.\", ConsoleColor.Gray);\n                }\n            }\n            catch { }\n\n            Console.WriteLine();\n            WriteColor(\"  [1] Preparar Memoria USB Automaticamente (QADEBUG.ini + factory_update_param.aml + 14 APKs Firmware Liberado)\", ConsoleColor.Green);\n            WriteColor(\"  [2] Descifrar logs ocultos de la caja (LOG_ZTESTB_OFF\\\\U_*) y mostrar Serie/MAC/Firmware\", ConsoleColor.White);\n            WriteColor(\"  [0] Volver al menu principal\", ConsoleColor.Gray);\n            Console.WriteLine();\n            WriteColor(\"Elige una opcion: \", ConsoleColor.Yellow, false);\n            string op = (Console.ReadLine() ?? \"\").Trim();\n\n            if (op == \"1\")\n            {\n                AutoPrepareConnectedUsbDrive();\n            }\n            else if (op == \"2\")\n            {\n                WriteColor(\"Escribe la letra de la memoria USB donde estan los logs (ej. D): \", ConsoleColor.Yellow, false);\n                string drv = (Console.ReadLine() ?? \"\").Replace(\":\", \"\").Replace(\"\\\\\", \"\").Trim();\n                string logFolder = drv + \":\\\\LOG_ZTESTB_OFF\";\n                if (Directory.Exists(logFolder))\n                {\n                    string encStr = \"5;8|\\\"79+3(&16-409876543210/.-,+*)('&%$#\\\"! ~}|{zyxwvutsrqponmlkjihgfedcba`_^]\\\\[ZYXWVUTSRQPONMLKJIHGFEDCBA@?>=<;:9876543210/.-,+*)('&%$#\\\"! \";\n                    string decStr = \" ~}|{zyxwvutsrqponmlkjihgfedcba`_^]\\\\[ZYXWVUTSRQPONMLKJIHGFEDCBA@?>=<;:9876543210/.-,+*)('&%$#\\\"! 5;8|\\\"79+3(&16-409876543210/.-,+*)('&%$#\\\"!\";\n                    byte[] lut = new byte[256];\n                    for (int i = 0; i < 256; i++) lut[i] = (byte)i;\n                    for (int i = 0; i < encStr.Length; i++)\n                    {\n                        byte e = (byte)encStr[i];\n                        byte d = (byte)decStr[i];\n                        if (lut[e] == e) lut[e] = d;\n                    }\n\n                    string outDir = Path.Combine(ROOT_DIR, \"LOGS_DESCIFRADOS_CAJA\");\n                    Directory.CreateDirectory(outDir);\n                    foreach (string f in Directory.GetFiles(logFolder, \"U_*\"))\n                    {\n                        string fName = Path.GetFileName(f);\n                        WriteColor(\"[+] Descifrando \" + fName + \"...\", ConsoleColor.Cyan);\n                        byte[] raw = File.ReadAllBytes(f);\n                        byte[] outBytes = new byte[raw.Length];\n                        for (int i = 0; i < raw.Length; i++) outBytes[i] = lut[raw[i]];\n                        string destFile = Path.Combine(outDir, fName + \"_DEC.log\");\n                        File.WriteAllBytes(destFile, outBytes);\n                        WriteColor(\"  -> Guardado en: \" + destFile, ConsoleColor.Green);\n                    }\n                }\n                else\n                {\n                    WriteColor(\"[!] No se encontro la carpeta \" + logFolder, ConsoleColor.Red);\n                }\n            }\n            WriteColor(\"\\nPresiona ENTER para volver al menu: \", ConsoleColor.Gray, false);\n            Console.ReadLine();\n        }\n\n        static void InvokeDriversAndGuiMenu()\n        {\n            Console.WriteLine();\n            WriteColor(\"=== OPCION 7: INSTALAR DRIVERS USB Y ABRIR ADB APPCONTROL GUI ===\", ConsoleColor.Yellow);\n            WriteColor(\"  [1] Abrir instalador de ADB AppControl 1.8.6 (Interfaz grafica para Windows)\", ConsoleColor.White);\n            WriteColor(\"  [2] Instalar Driver Oficial Amlogic WorldCup (VID_1B8E)\", ConsoleColor.White);\n            WriteColor(\"  [0] Volver al menu principal\", ConsoleColor.Gray);\n            Console.WriteLine();\n            WriteColor(\"Elige una opcion: \", ConsoleColor.Yellow, false);\n            string c = (Console.ReadLine() ?? \"\").Trim();\n            if (c == \"1\")\n            {\n                string exe = Path.Combine(DRV_DIR, \"ADBAppControl-1.8.6-setup.exe\");\n                if (File.Exists(exe)) Process.Start(exe);\n            }\n            else if (c == \"2\")\n            {\n                string exe = Path.Combine(DRV_DIR, @\"WorldCup_Driver_VID_1B8E\\InstallDriver.exe\");\n                if (File.Exists(exe))\n                {\n                    ProcessStartInfo psi = new ProcessStartInfo(exe) { Verb = \"runas\", UseShellExecute = true };\n                    try { Process.Start(psi); } catch { }\n                }\n            }\n        }\n\n        static void ConnectOrScanAdbNetwork()\n        {\n            Console.WriteLine();\n            WriteColor(\"=== ESCANEAR RED LOCAL (:5555) / CONECTAR IP / REFRESCAR RADAR USB ===\", ConsoleColor.Yellow);\n            WriteColor(\"  [1] Escanear automaticamente toda tu red Wi-Fi/Ethernet buscando la caja (:5555)\", ConsoleColor.Green);\n            WriteColor(\"  [2] Escribir IP manualmente (ej. 192.168.0.47)\", ConsoleColor.White);\n            WriteColor(\"  [3] Refrescar estado USB directo\", ConsoleColor.Cyan);\n            WriteColor(\"Elige 1, 2 o 3: \", ConsoleColor.Yellow, false);\n            string sub = (Console.ReadLine() ?? \"\").Trim();\n\n            if (sub == \"1\")\n            {\n                if (ScanLocalNetworkForBoxAdb())\n                {\n                    WriteColor(\"\\nDeseas aplicar ahora mismo la Interfaz del Firmware Xview Liberado (DMC.v2.25)? (S/N): \", ConsoleColor.Green, false);\n                    string ans = (Console.ReadLine() ?? \"\").Trim();\n                    if (ans.Equals(\"S\", StringComparison.OrdinalIgnoreCase) || ans == \"1\")\n                    {\n                        ExecuteLiberatedXviewFirmwareUiTransformation();\n                    }\n                }\n                else\n                {\n                    WriteColor(\"[!] No se detecto ninguna caja con el puerto 5555 abierto en tu subred actual.\", ConsoleColor.Yellow);\n                }\n            }\n            else if (sub == \"2\")\n            {\n                WriteColor(\"Escribe la IP de la caja: \", ConsoleColor.White, false);\n                string ip = (Console.ReadLine() ?? \"\").Trim();\n                if (!string.IsNullOrEmpty(ip))\n                {\n                    if (!ip.Contains(\":\")) ip = ip + \":5555\";\n                    WriteColor(\"[+] Conectando por ADB a \" + ip + \" ...\", ConsoleColor.Cyan);\n                    InvokeToolInteractive(ADB_EXE, \"connect \" + ip);\n                    CONNECTED_IP = ip;\n                }\n            }\n            else\n            {\n                CONNECTED_IP = \"\";\n                InvokeToolInteractive(ADB_EXE, \"devices\");\n            }\n            WriteColor(\"\\nPresiona ENTER para volver al menu: \", ConsoleColor.Gray, false);\n            Console.ReadLine();\n        }\n    }\n}\n","Overwrite":true,"Path":"c:\\Users\\andre\\OneDrive\\Desktop\\xview\\programa perfecto\\1_HERRAMIENTAS_MOTOR\\ProgramaPerfecto.cs"}}]}
