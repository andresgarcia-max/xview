{"step_index":330,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-04T05:54:32Z","content":"Created At: 2026-11-03T23:54:32-06:00\nCompleted At: 2026-11-03T23:54:32-06:00\nShowing lines 1-400 of 618\n1: # ==============================================================================\n2: # MOTOR PRINCIPAL: PROGRAMA PERFECTO XVIEW+ (ZTE ZXV10 B866V2 - S905X2 G12A)\n3: # Fusion integral de todas las herramientas de la memoria USB + hallazgos REA\n4: # Reglas absolutas:\n5: #   1. 100% Externo (Cero tornillos, Cero TTL)\n6: #   2. Proteccion total de factory.img (Widevine L1) y cri_data.img (MAC/Serie)\n7: #   3. Salto directo del bloqueo QR RSA-2048 de ZTE mediante programas integrados\n8: #      (Recovery fastbootd PID_4EE7 / U-Boot Fastboot PID_0D02 / WorldCup VID_1B8E / QADEBUG)\n9: # ==============================================================================\n10: \n11: [Console]::OutputEncoding = [System.Text.Encoding]::UTF8\n12: $ErrorActionPreference = \"Continue\"\n13: \n14: $ROOT_DIR   = Split-Path -Parent $PSScriptRoot\n15: $MOTOR_DIR  = Join-Path $ROOT_DIR \"1_HERRAMIENTAS_MOTOR\"\n16: $APKS_DIR   = Join-Path $ROOT_DIR \"2_APKS_LIBERACION_Y_TV\"\n17: $KEYS_DIR   = Join-Path $ROOT_DIR \"3_LLAVES_USB_PARA_LA_CAJA\"\n18: $DRV_DIR    = Join-Path $ROOT_DIR \"4_DRIVERS_Y_GUI_WINDOWS\"\n19: $FW_DIR     = Join-Path $ROOT_DIR \"5_FIRMWARE_SEGURO_B866V2\"\n20: \n21: $ADB        = Join-Path $MOTOR_DIR \"adb.exe\"\n22: $FASTBOOT   = Join-Path $MOTOR_DIR \"fastboot_moderno.exe\"\n23: if (-not (Test-Path $FASTBOOT)) { $FASTBOOT = Join-Path $MOTOR_DIR \"fastboot.exe\" }\n24: $ADNL       = Join-Path $MOTOR_DIR \"adnl.exe\"\n25: $UPDATE     = Join-Path $MOTOR_DIR \"update.exe\"\n26: \n27: $Global:ADB_TARGET_ARGS = @()\n28: $Global:CONNECTED_IP    = \"\"\n29: \n30: function Invoke-Adb {\n31:     param([string[]]$Arguments)\n32:     $allArgs = @()\n33:     if ($Global:ADB_TARGET_ARGS.Count -gt 0) { $allArgs += $Global:ADB_TARGET_ARGS }\n34:     $allArgs += $Arguments\n35:     & $ADB @allArgs\n36: }\n37: \n38: function Get-BoxConnectionState {\n39:     $state = [ordered]@{\n40:         UsbHardwareMode = \"Ninguno detectado por cable USB directo\"\n41:         SerialNumber    = \"No detectado\"\n42:         RawPid          = \"\"\n43:         AdbDevices      = @()\n44:         FastbootDevices = @()\n45:     }\n46: \n47:     try {\n48:         $pnp = Get-CimInstance Win32_PnPEntity -ErrorAction SilentlyContinue | Where-Object {\n49:             $_.DeviceID -match \"VID_18D1|VID_19D2|VID_1B8E\"\n50:         }\n51:         foreach ($dev in $pnp) {\n52:             if ($dev.DeviceID -match \"\\\\([^\\\\]+)$\") {\n53:                 $sn = $Matches[1]\n54:                 if ($sn -notmatch \"&\") { $state.SerialNumber = $sn }\n55:             }\n56:             if ($dev.DeviceID -match \"PID_4EE2\") {\n57:                 $state.UsbHardwareMode = \"ADB USB Activo (PID_4EE2) - LISTO PARA LIBERACION DIRECTA\"\n58:                 $state.RawPid = \"4EE2\"\n59:             }\n60:             elseif ($dev.DeviceID -match \"PID_4EE7\") {\n61:                 $state.UsbHardwareMode = \"Recovery Fastbootd (PID_4EE7) - LISTO PARA SALTO A BOOTLOADER\"\n62:                 $state.RawPid = \"4EE7\"\n63:             }\n64:             elseif ($dev.DeviceID -match \"PID_0D02\") {\n65:                 $state.UsbHardwareMode = \"U-Boot Fastboot Bootloader (PID_0D02) - LISTO PARA FLASHEO\"\n66:                 $state.RawPid = \"0D02\"\n67:             }\n68:             elseif ($dev.DeviceID -match \"PID_4EE1\") {\n69:                 $state.UsbHardwareMode = \"Modo MTP Android (PID_4EE1) - Usa Opcion 1 para Salto por Recovery/WorldCup\"\n70:                 $state.RawPid = \"4EE1\"\n71:             }\n72:             elseif ($dev.DeviceID -match \"VID_1B8E\") {\n73:                 $state.UsbHardwareMode = \"Amlogic WorldCup / DNL Mode (VID_1B8E) - LISTO PARA DESBLOQUEO U-BOOT\"\n74:                 $state.RawPid = \"1B8E\"\n75:             }\n76:         }\n77:     } catch {}\n78: \n79:     if (Test-Path $ADB) {\n80:         $adbOut = & $ADB devices 2>$null\n81:         foreach ($line in $adbOut) {\n82:             if ($line -match \"^(\\S+)\\s+(device|unauthorized|offline)$\") {\n83:                 $state.AdbDevices += \"$($Matches[1]) [$($Matches[2])]\"\n84:             }\n85:         }\n86:     }\n87: \n88:     if (Test-Path $FASTBOOT) {\n89:         $fbOut = & $FASTBOOT devices 2>$null\n90:         foreach ($line in $fbOut) {\n91:             if ($line -match \"^(\\S+)\\s+fastboot\") {\n92:                 $state.FastbootDevices += $Matches[1]\n93:             }\n94:         }\n95:     }\n96: \n97:     return $state\n98: }\n99: \n100: function Show-Banner {\n101:     Clear-Host\n102:     Write-Host \"================================================================================\" -ForegroundColor Cyan\n103:     Write-Host \"          PROGRAMA PERFECTO - MEGACABLE XVIEW+ (ZTE ZXV10 B866V2)               \" -ForegroundColor Cyan\n104:     Write-Host \"     Motor de Salto Directo (Recovery Fastbootd / WorldCup / Fastboot / ADB)    \" -ForegroundColor Cyan\n105:     Write-Host \"      Regla: 100% Externo Sin Abrir Tornillos | Proteccion Widevine L1/MAC      \" -ForegroundColor Cyan\n106:     Write-Host \"================================================================================\" -ForegroundColor Cyan\n107: \n108:     $st = Get-BoxConnectionState\n109:     Write-Host \"\"\n110:     Write-Host \" [RADAR DE HARDWARE USB EN TIEMPO REAL]\" -ForegroundColor Yellow\n111:     Write-Host \"  * Caja Detectada   : Xview+ (Serie: $($st.SerialNumber))\" -ForegroundColor White\n112:     if ($st.RawPid -match \"4EE2|0D02|4EE7|1B8E\") {\n113:         Write-Host \"  * Estado Cable USB : $($st.UsbHardwareMode)\" -ForegroundColor Green\n114:     } elseif ($st.RawPid -eq \"4EE1\") {\n115:         Write-Host \"  * Estado Cable USB : $($st.UsbHardwareMode)\" -ForegroundColor Yellow\n116:     } else {\n117:         Write-Host \"  * Estado Cable USB : $($st.UsbHardwareMode)\" -ForegroundColor Gray\n118:     }\n119:     if ($st.AdbDevices.Count -gt 0) {\n120:         Write-Host \"  * Sesion ADB       : $($st.AdbDevices -join ', ')\" -ForegroundColor Green\n121:     } else {\n122:         Write-Host \"  * Sesion ADB       : Sin sesion activa\" -ForegroundColor DarkGray\n123:     }\n124:     if ($st.FastbootDevices.Count -gt 0) {\n125:         Write-Host \"  * Sesion Fastboot  : $($st.FastbootDevices -join ', ')\" -ForegroundColor Green\n126:     } else {\n127:         Write-Host \"  * Sesion Fastboot  : En espera de salto (Recovery 'Enter fastboot' o RESET)\" -ForegroundColor DarkGray\n128:     }\n129:     Write-Host \"--------------------------------------------------------------------------------\" -ForegroundColor DarkCyan\n130: }\n131: \n132: function Execute-AdbPayload {\n133:     Write-Host \"`n[1/7] Inyectando token 'EE@' en /cache/recovery/last_QR (Bypass candado QR ZTE)...\" -ForegroundColor Cyan\n134:     Invoke-Adb @(\"shell\", \"echo -n 'EE@' > /cache/recovery/last_QR; rm -f /cache/recovery/last_QR_Time\") 2>$null\n135: \n136:     Write-Host \"[2/7] Desactivando bloqueos de Google Play Protect (de 'adb comandos.txt')...\" -ForegroundColor Cyan\n137:     Invoke-Adb @(\"shell\", \"settings put global package_verifier_user_consent -1\")\n138:     Invoke-Adb @(\"shell\", \"settings put global package_verifier_enable 0\")\n139:     Invoke-Adb @(\"shell\", \"bmgr enable false\")\n140: \n141:     Write-Host \"[3/7] Instalando Launchers Offline y Utilidades desde '2_APKS_LIBERACION_Y_TV'...\" -ForegroundColor Cyan\n142:     $coreApks = @(\n143:         @{ File = \"Home_Screen_Launcher_1.1.3.apk\"; Name = \"Home Screen Launcher (Ligero)\" },\n144:         @{ File = \"TVLauncher_4_GoogleTV.apk\";      Name = \"TVLauncher 4 (Estilo Google TV)\" },\n145:         @{ File = \"Button_Mapper_Pro_2.54.apk\";     Name = \"Button Mapper Pro v2.54 (Reasignar Boton Home)\" },\n146:         @{ File = \"autostart.apk\";                  Name = \"AutoStart al encender\" },\n147:         @{ File = \"Filemanager.apk\";                Name = \"Gestor de Archivos USB\" },\n148:         @{ File = \"Downloader_2.0.4.apk\";           Name = \"Downloader Android TV\" }\n149:     )\n150:     foreach ($item in $coreApks) {\n151:         $apkPath = Join-Path $APKS_DIR $item.File\n152:         if (Test-Path $apkPath) {\n153:             Write-Host \"  -> Instalando $($item.Name)...\" -ForegroundColor Gray\n154:             Invoke-Adb @(\"install\", \"-r\", \"-g\", $apkPath)\n155:         }\n156:     }\n157: \n158:     Write-Host \"[4/7] Neutralizando Pantalla Azul Megacable, Core (oom_adj=-14), OTA y candado QR (com.zte.adb)...\" -ForegroundColor Cyan\n159:     $bloatPackages = @(\n160:         \"com.dotscreen.megacable.portal\",\n161:         \"com.dotscreen.megacable.core\",\n162:         \"com.dotscreen.megacable.atv\",\n163:         \"com.expway.ewm.service\",\n164:         \"com.zte.adb\",\n165:         \"com.ztestb.LauncherCustomize\",\n166:         \"com.zte.ums.oes\",\n167:         \"com.zte.ota\",\n168:         \"tv.upgrade.service\",\n169:         \"com.zte.tv.act\",\n170:         \"com.ztestb.uploaddiagno\",\n171:         \"com.zte.factorytesttool\",\n172:         \"com.hmdm.launcher\"\n173:     )\n174:     foreach ($pkg in $bloatPackages) {\n175:         Write-Host \"  -> Neutralizando $pkg ...\" -ForegroundColor Gray\n176:         Invoke-Adb @(\"shell\", \"cmd appops set $pkg RUN_IN_BACKGROUND ignore; cmd appops set $pkg RUN_ANY_IN_BACKGROUND ignore; am force-stop $pkg; pm disable-user --user 0 $pkg; pm uninstall -k --user 0 $pkg\") 2>$null | Out-Null\n177:     }\n178: \n179:     Write-Host \"[5/7] Configurando el nuevo Launcher como HOME predeterminado y activando Button Mapper...\" -ForegroundColor Cyan\n180:     Invoke-Adb @(\"shell\", \"cmd package set-home-activity dev.dworks.apps.alauncher/.Launcher\") 2>$null\n181:     Invoke-Adb @(\"shell\", \"settings put secure enabled_accessibility_services flar2.homebutton/flar2.homebutton.ButtonMapperService\") 2>$null\n182:     Invoke-Adb @(\"shell\", \"settings put secure accessibility_enabled 1\") 2>$null\n183:     Invoke-Adb @(\"shell\", \"am start -a android.intent.action.MAIN -c android.intent.category.HOME\") 2>$null\n184: \n185:     Write-Host \"[6/7] Eliminando banner 'No se pudo instalar la actualizacion del sistema'...\" -ForegroundColor Cyan\n186:     Invoke-Adb @(\"shell\", \"settings put global ota_disable_automatic_update 1\") 2>$null\n187:     Invoke-Adb @(\"shell\", \"cmd notification snooze --for 315360000000 '0|com.google.android.gms|1|com.google.android.gms.update.control.NotificationControl|10049'\") 2>$null\n188:     Invoke-Adb @(\"shell\", \"cmd appops set com.google.android.gms POST_NOTIFICATION ignore\") 2>$null\n189: \n190:     Write-Host \"[7/7] Activando Modo Stealth (Ocultar flags ADB manteniendo puerto 5555 activo)...\" -ForegroundColor Cyan\n191:     Invoke-Adb @(\"shell\", \"settings put global adb_enabled 0; settings put secure adb_enabled 0; settings put global development_settings_enabled 0; settings put secure development_settings_enabled 0\") 2>$null\n192:     Invoke-Adb @(\"shell\", \"setprop service.adb.tcp.port 5555; setprop ctl.start adbd\") 2>$null\n193: \n194:     Write-Host \"\"\n195:     Write-Host \"================================================================================\" -ForegroundColor Green\n196:     Write-Host \" [LISTO!] Caja liberada con exito (Candado QR y Pantalla Azul eliminados).      \" -ForegroundColor Green\n197:     Write-Host \"================================================================================\" -ForegroundColor Green\n198: }\n199: \n200: function Invoke-AutoMultiChannelJump {\n201:     Write-Host \"\"\n202:     Write-Host \"================================================================================\" -ForegroundColor Green\n203:     Write-Host \"  OPCION 1: CAPTURA Y S