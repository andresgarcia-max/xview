{"step_index":332,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-04T05:54:41Z","content":"Created At: 2026-11-03T23:54:41-06:00\nCompleted At: 2026-11-03T23:54:41-06:00\nShowing lines 401-618 of 618\n401:     & $FASTBOOT flash recovery (Join-Path $FW_DIR \"recovery.img\")\n402: \n403:     Write-Host \"[11/12] Reparando particion /cache con cache_ext4.img...\" -ForegroundColor Cyan\n404:     & $FASTBOOT erase cache\n405:     & $FASTBOOT flash cache (Join-Path $FW_DIR \"cache_ext4.img\")\n406: \n407:     Write-Host \"[12/12] Limpiando userdata y reiniciando...\" -ForegroundColor Cyan\n408:     & $FASTBOOT erase userdata\n409:     & $FASTBOOT reboot\n410: \n411:     Write-Host \"`n[COMPLETADO!] Tu caja B866V2 arrancara con Android 12 liberado (con ADB ya activo de fabrica y Widevine L1 intacto).\" -ForegroundColor Green\n412:     Read-Host \"`nPresiona ENTER para volver al menu\"\n413: }\n414: \n415: function Invoke-AppInstallerMenu {\n416:     Write-Host \"\"\n417:     Write-Host \"=== OPCION 3: INSTALADOR DE APPS DE TV Y ENTRETENIMIENTO (OFFLINE DESDE PC) ===\" -ForegroundColor Yellow\n418:     $apks = Get-ChildItem -Path $APKS_DIR -Filter \"*.apk\"\n419:     for ($i = 0; $i -lt $apks.Count; $i++) {\n420:         $sizeMB = [math]::Round($apks[$i].Length / 1MB, 2)\n421:         Write-Host (\"  [{0}] {1} ({2} MB)\" -f ($i + 1), $apks[$i].Name, $sizeMB) -ForegroundColor White\n422:     }\n423:     Write-Host \"  [T] INSTALAR TODAS LAS APPS DE LA LISTA\" -ForegroundColor Green\n424:     Write-Host \"  [0] Volver al menu principal\" -ForegroundColor Gray\n425:     Write-Host \"\"\n426:     $sel = Read-Host \"Elige el numero de la app a instalar (o 'T' para todas)\"\n427:     if ($sel -eq \"0\" -or [string]::IsNullOrWhiteSpace($sel)) { return }\n428:     if ($sel -match \"^[Tt]$\") {\n429:         foreach ($a in $apks) {\n430:             Write-Host \"[+] Instalando $($a.Name)...\" -ForegroundColor Cyan\n431:             Invoke-Adb @(\"install\", \"-r\", \"-g\", $a.FullName)\n432:         }\n433:     } elseif ($sel -match \"^\\d+$\") {\n434:         $idx = [int]$sel - 1\n435:         if ($idx -ge 0 -and $idx -lt $apks.Count) {\n436:             Write-Host \"[+] Instalando $($apks[$idx].Name)...\" -ForegroundColor Cyan\n437:             Invoke-Adb @(\"install\", \"-r\", \"-g\", $apks[$idx].FullName)\n438:         }\n439:     }\n440:     Read-Host \"`nPresiona ENTER para volver al menu\"\n441: }\n442: \n443: function Invoke-AmlogicWorldCupEngine {\n444:     Write-Host \"\"\n445:     Write-Host \"================================================================================\" -ForegroundColor Cyan\n446:     Write-Host \"   OPCION 4: MOTOR AMLOGIC DNL / WORLDCUP (adnl.exe + update.exe VID_1B8E)      \" -ForegroundColor Cyan\n447:     Write-Host \"================================================================================\" -ForegroundColor Cyan\n448:     Write-Host \"  [1] Escanear dispositivo en modo WorldCup / ADNL\" -ForegroundColor White\n449:     Write-Host \"  [2] Desbloquear Bootloader + Activar OTG + Saltar a Fastboot (via update.exe bulkcmd)\" -ForegroundColor Green\n450:     Write-Host \"  [3] Reiniciar caja desde modo ADNL / WorldCup\" -ForegroundColor White\n451:     Write-Host \"  [0] Volver al menu principal\" -ForegroundColor Gray\n452:     Write-Host \"\"\n453:     $sub = Read-Host \"Elige una opcion\"\n454:     if ($sub -eq \"1\") {\n455:         Write-Host \"`n--- Escaneo con adnl.exe ---\" -ForegroundColor Cyan\n456:         & $ADNL devices\n457:         Write-Host \"`n--- Escaneo con update.exe ---\" -ForegroundColor Cyan\n458:         & $UPDATE identify 7\n459:     } elseif ($sub -eq \"2\") {\n460:         Write-Host \"`n[+] Enviando comandos U-Boot por protocolo WorldCup (update.exe)...\" -ForegroundColor Cyan\n461:         & $UPDATE bulkcmd \"watchdog off\"\n462:         & $UPDATE bulkcmd \"setenv lock 10100000\"\n463:         & $UPDATE bulkcmd \"setenv otg_device 1\"\n464:         & $UPDATE bulkcmd \"saveenv\"\n465:         Write-Host \"[+] Saltando la caja a modo Fastboot...\" -ForegroundColor Green\n466:         & $UPDATE bulkcmd \"fastboot\"\n467:     } elseif ($sub -eq \"3\") {\n468:         & $ADNL reboot\n469:         & $UPDATE bulkcmd \"reset\"\n470:     }\n471:     Read-Host \"`nPresiona ENTER para volver al menu\"\n472: }\n473: \n474: function Invoke-UsbPrepAndLogDecrypt {\n475:     Write-Host \"\"\n476:     Write-Host \"================================================================================\" -ForegroundColor Yellow\n477:     Write-Host \"   OPCION 5: PREPARAR MEMORIA USB (QADEBUG + APKS) Y DESCIFRAR LOGS ZTE         \" -ForegroundColor Yellow\n478:     Write-Host \"================================================================================\" -ForegroundColor Yellow\n479: \n480:     $drives = Get-Volume | Where-Object { $_.DriveType -eq 'Removable' -and $_.DriveLetter }\n481:     if ($drives) {\n482:         Write-Host \"Memorias USB detectadas:\" -ForegroundColor Cyan\n483:         foreach ($d in $drives) {\n484:             Write-Host \"  * Unidad $($d.DriveLetter):\\ ($($d.FileSystemLabel) - $($d.FileSystem))\" -ForegroundColor Green\n485:         }\n486:     }\n487:     Write-Host \"\"\n488:     Write-Host \"  [1] Copiar llaves QADEBUG.ini + factory_update_param.aml + Launchers a una memoria USB\" -ForegroundColor White\n489:     Write-Host \"  [2] Descifrar logs ocultos de la caja (LOG_ZTESTB_OFF\\U_*) y mostrar Serie/MAC/Firmware\" -ForegroundColor Green\n490:     Write-Host \"  [0] Volver al menu principal\" -ForegroundColor Gray\n491:     Write-Host \"\"\n492:     $op = Read-Host \"Elige una opcion\"\n493:     if ($op -eq \"1\") {\n494:         $drv = Read-Host \"Escribe la letra de tu memoria USB (ej. D)\"\n495:         $drv = ($drv -replace \"[:\\\\]\", \"\").Trim()\n496:         $targetUsb = \"${drv}:\\\"\n497:         if (Test-Path $targetUsb) {\n498:             Copy-Item \"$KEYS_DIR\\*\" $targetUsb -Force\n499:             Copy-Item \"$APKS_DIR\\Home_Screen_Launcher_1.1.3.apk\" $targetUsb -Force\n500:             Copy-Item \"$APKS_DIR\\TVLauncher_4_GoogleTV.apk\" $targetUsb -Force\n501:             Copy-Item \"$APKS_DIR\\Button_Mapper_Pro_2.54.apk\" $targetUsb -Force\n502:             Copy-Item \"$APKS_DIR\\Filemanager.apk\" $targetUsb -Force\n503:             Copy-Item \"$APKS_DIR\\autostart.apk\" $targetUsb -Force\n504:             Write-Host \"[OK] Llaves QADEBUG.ini, factory_update_param.aml y Launchers copiados a $targetUsb\" -ForegroundColor Green\n505:         } else {\n506:             Write-Host \"[!] No existe la unidad $targetUsb\" -ForegroundColor Red\n507:         }\n508:     } elseif ($op -eq \"2\") {\n509:         $drv = Read-Host \"Escribe la letra de la memoria USB donde estan los logs (ej. D)\"\n510:         $drv = ($drv -replace \"[:\\\\]\", \"\").Trim()\n511:         $logFolder = \"${drv}:\\LOG_ZTESTB_OFF\"\n512:         if (Test-Path $logFolder) {\n513:             $encStr = '5;8|\"79+3(&16-409876543210/.-,+*)(''&%$#\"! ~}|{zyxwvutsrqponmlkjihgfedcba`_^]\\[ZYXWVUTSRQPONMLKJIHGFEDCBA@?>=<;:9876543210/.-,+*)(''&%$#\"! '\n514:             $decStr = ' ~}|{zyxwvutsrqponmlkjihgfedcba`_^]\\[ZYXWVUTSRQPONMLKJIHGFEDCBA@?>=<;:9876543210/.-,+*)(''&%$#\"! 5;8|\"79+3(&16-409876543210/.-,+*)(''&%$#\"!'\n515:             $lut = New-Object byte[] 256\n516:             for ($i=0; $i -lt 256; $i++) { $lut[$i] = [byte]$i }\n517:             for ($i=0; $i -lt $encStr.Length; $i++) {\n518:                 $e = [byte][char]$encStr[$i]\n519:                 $d = [byte][char]$decStr[$i]\n520:                 if ($lut[$e] -eq $e) { $lut[$e] = $d }\n521:             }\n522:             $outDir = Join-Path $ROOT_DIR \"LOGS_DESCIFRADOS_CAJA\"\n523:             New-Item -ItemType Directory -Path $outDir -Force | Out-Null\n524:             $files = Get-ChildItem $logFolder -Filter \"U_*\"\n525:             foreach ($f in $files) {\n526:                 Write-Host \"[+] Descifrando $($f.Name)...\" -ForegroundColor Cyan\n527:                 $raw = [System.IO.File]::ReadAllBytes($f.FullName)\n528:                 $out = New-Object byte[] $raw.Length\n529:                 for ($i=0; $i -lt $raw.Length; $i++) { $out[$i] = $lut[$raw[$i]] }\n530:                 $destFile = Join-Path $outDir \"$($f.Name)_DEC.log\"\n531:                 [System.IO.File]::WriteAllBytes($destFile, $out)\n532:                 Write-Host \"  -> Guardado en: $destFile\" -ForegroundColor Green\n533:                 Select-String -Path $destFile -Pattern \"SerialNumber|ro.build.fingerprint|Linux version|U-Boot 2015|checkUdisk\" | Select-Object -First 8 | ForEach-Object {\n534:                     Write-Host \"     $($_.Line)\" -ForegroundColor Gray\n535:                 }\n536:             }\n537:         } else {\n538:             Write-Host \"[!] No se encontro la carpeta $logFolder\" -ForegroundColor Red\n539:         }\n540:     }