Color Green\n226:             Write-Host \"    Apagando Watchdog, desbloqueando U-Boot (lock=10100000), activando OTG y saltando a Fastboot...\" -ForegroundColor Cyan\n227:             & $UPDATE bulkcmd \"watchdog off\"\n228:             & $UPDATE bulkcmd \"setenv lock 10100000\"\n229:             & $UPDATE bulkcmd \"setenv otg_device 1\"\n230:             & $UPDATE bulkcmd \"saveenv\"\n231:             & $UPDATE bulkcmd \"fastboot\"\n232:             Start-Sleep -Seconds 1\n233:             continue\n234:         }\n235: \n236:         # Canal 2: Recovery Fastbootd (PID_4EE7 desde 'Enter fastboot' en TV) o U-Boot Fastboot (PID_0D02)\n237:         if ($st.FastbootDevices.Count -gt 0 -or $st.RawPid -eq \"4EE7\" -or $st.RawPid -eq \"0D02\") {\n238:             $isUserspace = & $FASTBOOT getvar is-userspace 2>&1\n239:             if ($isUserspace -match \"yes\" -or $st.RawPid -eq \"4EE7\") {\n240:                 Write-Host \"`n[+] ¡Detectado Recovery Fastbootd (PID_4EE7)! Saltando a U-Boot Bootloader real...\" -ForegroundColor Yellow\n241:                 & $FASTBOOT reboot bootloader\n242:                 Start-Sleep -Milliseconds 400\n243:                 continue\n244:             }\n245:             Write-Host \"`n[+] ¡Caja atrapada en U-Boot Fastboot (PID_0D02)! Apagando Watchdog 14s y desbloqueando...\" -ForegroundColor Green\n246:             & $FASTBOOT oem \"watchdog off\"\n247:             & $FASTBOOT flashing unlock_critical\n248:             & $FASTBOOT flashing unlock\n249:             & $FASTBOOT oem \"setenv lock 10100000;save\"\n250:             & $FASTBOOT oem \"setenv otg_device 1;save\"\n251:             & $FASTBOOT oem \"saveenv\"\n252:             & $FASTBOOT getvar unlocked\n253:             Write-Host \"\"\n254:             Write-Host \"[OK] ¡Bootloader desbloqueado y Watchdog detenido! Que deseas hacer ahora?\" -ForegroundColor Green\n255:             Write-Host \"  [1] Flashear ahora mismo Android 12 Liberado Completo (Conservando Widevine L1 y MAC)\" -ForegroundColor Magenta\n256:             Write-Host \"  [2] Solo inyectar vbmeta desbloqueado + recovery desbloqueado + cache_ext4 y reiniciar\" -ForegroundColor Cyan\n257:             Write-Host \"  [3] Dejar en Fastboot y volver al menu\" -ForegroundColor Gray\n258:             $next = Read-Host \"Elige 1, 2 o 3\"\n259:             if ($next -eq \"1\") {\n260:                 Invoke-SafeAndroid12Flash -AlreadyInFastboot $true\n261:             } elseif ($next -eq \"2\") {\n262:                 & $FASTBOOT flash vbmeta (Join-Path $FW_DIR \"vbmeta.img\")\n263:                 & $FASTBOOT flash recovery (Join-Path $FW_DIR \"recovery.img\")\n264:                 & $FASTBOOT erase cache\n265:                 & $FASTBOOT flash cache (Join-Path $FW_DIR \"cache_ext4.img\")\n266:                 & $FASTBOOT reboot\n267:             }\n268:             break\n269:         }\n270: \n271:         # Canal 3: ADB Activo (PID_4EE2 o Red Local)\n272:         if ($st.AdbDevices.Count -gt 0) {\n273:             if ($st.AdbDevices[0] -match \"unauthorized\") {\n274:                 Write-Host \"[!] Acepta el cartel en la pantalla de tu TV...\" -ForegroundColor Yellow\n275:                 Start-Sleep -Seconds 2\n276:                 continue\n277:             }\n278:             Write-Host \"`n[+] ¡Detectada sesion ADB activa ($($st.AdbDevices -join ', '))! Ejecutando liberacion...\" -ForegroundColor Green\n279:             Execute-AdbPayload\n280:             break\n281:         }\n282: \n283:         Start-Sleep -Milliseconds 250\n284:     }\n285:     Read-Host \"`nPresiona ENTER para volver al menu\"\n286: }\n287: \n288: function Invoke-SafeAndroid12Flash {\n289:     param([bool]$AlreadyInFastboot = $false)\n290:     Write-Host \"\"\n291:     Write-Host \"================================================================================\" -ForegroundColor Magenta\n292:     Write-Host \"   OPCION 2: FLASHEO SEGURO ANDROID 12 (B866V2) SIN PERDER WIDEVINE L1 / MAC   \" -ForegroundColor Magenta\n293:     Write-Host \"================================================================================\" -ForegroundColor Magenta\n294:     Write-Host \"  * Salta por completo el bloqueo de Megacable y el candado QR RSA-2048 de ZTE.\" -ForegroundColor Green\n295:     Write-Host \"  * Protege 100% tus particiones 'factory' (Widevine L1) y 'cri_data' (MAC/Serie).\" -ForegroundColor Green\n296:     Write-Host \"  * Repara la particion /cache con 'cache_ext4.img' e instala Recovery desbloqueado.\" -ForegroundColor Green\n297:     Write-Host \"\"\n298: \n299:     $superPath = Join-Path $FW_DIR \"super.img\"\n300:     if (-not (Test-Path $superPath)) {\n301:         $candidates = @(\n302:             \"D:\\B866v2 Android 12\\B866v2 Android 12\\B866V2\\super.img\",\n303:             \"E:\\B866v2 Android 12\\B866v2 Android 12\\B866V2\\super.img\",\n304:             \"F:\\B866v2 Android 12\\B866v2 Android 12\\B866V2\\super.img\",\n305:             \"C:\\Users\\andre\\OneDrive\\Desktop\\xview\\V2\\B866v2 Android 12\\B866v2 Android 12\\B866V2\\super.img\",\n306:             \"C:\\Users\\andre\\OneDrive\\Desktop\\xview\\FIRMWARE_COMPLETO_B866V2_FASTBOOT\\super.img\"\n307:         )\n308:         foreach ($c in $candidates) {\n309:             if (Test-Path $c) { $superPath = $c; break }\n310:         }\n311:     }\n312: \n313:     if (-not (Test-Path $superPath)) {\n314:         Write-Host \"[!] Para flashear 'super.img' (1.88 GB), inserta la memoria USB KINGSTON en la PC\" -ForegroundColor Yellow\n315:         Write-Host \"    despues de que la caja haya entrado en Fastboot (el programa ya tiene el resto\" -ForegroundColor Yellow\n316:         Write-Host \"    de las imagenes en '5_FIRMWARE_SEGURO_B866V2').\" -ForegroundColor Yellow\n317:     } else {\n318:         Write-Host \"[+] Imagen super.img localizada en: $superPath\" -ForegroundColor Cyan\n319:     }\n320: \n321:     if (-not $AlreadyInFastboot) {\n322:         $st = Get-BoxConnectionState\n323:         if ($st.AdbDevices.Count -gt 0) {\n324:             Write-Host \"[+] Enviando 'adb reboot bootloader'...\" -ForegroundColor Cyan\n325:             Invoke-Adb @(\"reboot\", \"bootloader\")\n326:         }\n327:         Write-Host \"[1/12] Esperando a que la caja entre en Fastboot (desde Recovery 'Enter fastboot' o RESET)...\" -ForegroundColor Cyan\n328:         while ($true) {\n329:             $cur = Get-BoxConnectionState\n330:             if ($cur.RawPid -eq \"1B8E\") {\n331:                 Write-Host \"  -> Detectado WorldCup (VID_1B8E), saltando a Fastboot...\" -ForegroundColor Yellow\n332:                 & $UPDATE bulkcmd \"watchdog off\"\n333:                 & $UPDATE bulkcmd \"setenv lock 10100000\"\n334:                 & $UPDATE bulkcmd \"setenv otg_device 1\"\n335:                 & $UPDATE bulkcmd \"saveenv\"\n336:                 & $UPDATE bulkcmd \"fastboot\"\n337:                 Start-Sleep -Seconds 1\n338:                 continue\n339:             }\n340:             $fbOut = & $FASTBOOT devices 2>$null\n341:             if ($fbOut -match \"fastboot\") {\n342:                 $isUserspace = & $FASTBOOT getvar is-userspace 2>&1\n343:                 if ($isUserspace -match \"yes\") {\n344:                     Write-Host \"  -> Detectado fastbootd (Recovery), saltando a Bootloader U-Boot...\" -ForegroundColor Yellow\n345:                     & $FASTBOOT reboot bootloader\n346:                     Start-Sleep -Milliseconds 400\n347:                     continue\n348:                 }\n349:                 break\n350:             }\n351:             Start-Sleep -Milliseconds 250\n352:         }\n353:     }\n354: \n355:     Write-Host \"[2/12] Apagando Watchdog, desbloqueando Bootloader y activando USB OTG...\" -ForegroundColor Cyan\n356:     & $FASTBOOT oem \"watchdog off\"\n357:     & $FASTBOOT flashing unlock_critical\n358:     & $FASTBOOT flashing unlock\n359:     & $FASTBOOT oem \"setenv lock 10100000;save\"\n360:     & $FASTBOOT oem \"setenv otg_device 1;save\"\n361:     & $FASTBOOT oem \"saveenv\"\n362: \n363:     if (-not (Test-Path $superPath)) {\n364:         Write-Host \"`n[!] La caja YA esta retenida en Fastboot con el Watchdog APAGADO.\" -ForegroundColor Green\n365:         Write-Host \"    Ahora puedes pasar la memoria USB KINGSTON de la caja a tu PC para leer 'super.img'.\" -ForegroundColor Yellow\n366:         Read-Host \"    Conecta la memoria USB a tu PC y presiona ENTER\"\n367:         foreach ($drv in @(\"D\",\"E\",\"F\",\"G\",\"H\")) {\n368:             $tryPath = \"${drv}:\\B866v2 Android 12\\B866v2 Android 12\\B866V2\\super.img\"\n369:             if (Test-Path $tryPath) { $superPath = $tryPath; break }\n370:         }\n371:     }\n372: \n373:     Write-Host \"[3/12] Flasheando boot.img...\" -ForegroundColor Cyan\n374:     & $FASTBOOT flash boot (Join-Path $FW_DIR \"boot.img\")\n375: \n376:     Write-Host \"[4/12] Flasheando _aml_dtb y dtbo.img...\" -ForegroundColor Cyan\n377:     & $FASTBOOT flash _aml_dtb (Join-Path $FW_DIR \"dtb.img\")\n378:     & $FASTBOOT flash dtbo (Join-Path $FW_DIR \"dtbo.img\")\n379: \n380:     Write-Host \"[5/12] PROTEGIENDO factory.img (Widevine L1) y cri_data.img (MAC/Serie) - OMITIDOS POR SEGURIDAD.\" -ForegroundColor Green\n381: \n382:     Write-Host \"[6/12] Flasheando logo.img y param.img...\" -ForegroundColor Cyan\n383:     & $FASTBOOT flash logo (Join-Path $FW_DIR \"logo.img\")\n384:     & $FASTBOOT flash param (Join-Path $FW_DIR \"param.img\")\n385: \n386:     Write-Host \"[7/12] Flasheando conf.img y oem.img...\" -ForegroundColor Cyan\n387:     & $FASTBOOT flash conf (Join-Path $FW_DIR \"conf.img\")\n388:     & $FASTBOOT flash oem (Join-Path $FW_DIR \"oem.img\")\n389: \n390:     if (Test-Path $superPath) {\n391:         Write-Host \"[8/12] Flasheando super.img (Android 12 Liberado B866V2)...\" -ForegroundColor Cyan\n392:         & $FASTBOOT flash super $superPath\n393:     } else {\n394:         Write-Host \"[!] No se encontro super.img, omitiendo paso 8...\" -ForegroundColor Yellow\n395:     }\n396: \n397:     Write-Host \"[9/12] Flasheando vbmeta.img (dm-verity desactivado flags=0x03)...\" -ForegroundColor Cyan\n398:     & $FASTBOOT flash vbmeta (Join-Path $FW_DIR \"vbmeta.img\")\n399: \n400:     Write-Host \"[10/12] Flasheando recovery.img (Menu Fastboot/ADB desbloqueado en TV)...\" -ForegroundColor Cyan"}
