rite-Host \"\"\n    $ip = Read-Host \"Escribe la IP de la caja (ej. 192.168.0.47) o presiona ENTER para usar Cable USB\"\n    if (-not [string]::IsNullOrWhiteSpace($ip)) {\n        if ($ip -notmatch \":\") { $ip = \"${ip}:5555\" }\n        Write-Host \"[+] Conectando por ADB a $ip ...\" -ForegroundColor Cyan\n        & $ADB connect $ip\n        $Global:ADB_TARGET_ARGS = @(\"-s\", $ip)\n        $Global:CONNECTED_IP = $ip\n        Write-Host \"[!] Revisa tu TV y acepta el cartel 'Permitir depuracion por USB' marcando 'Permitir siempre'.\" -ForegroundColor Green\n    } else {\n        $Global:ADB_TARGET_ARGS = @()\n        $Global:CONNECTED_IP = \"\"\n        & $ADB devices\n    }\n    Read-Host \"`nPresiona ENTER para volver al menu\"\n}\n\nfunction Invoke-FullAdbLiberation {\n    Write-Host \"\"\n    Write-Host \"================================================================================\" -ForegroundColor Green\n    Write-Host \"    OPCION 1: LIBERACION COMPLETA EN 1 CLIC POR ADB (SIN ABRIR LA CAJA)         \" -ForegroundColor Green\n    Write-Host \"================================================================================\" -ForegroundColor Green\n\n    $st = Get-BoxConnectionState\n    if ($st.AdbDevices.Count -eq 0) {\n        if ($st.RawPid -eq \"4EE1\") {\n            Write-Host \"[!] Tu caja (Serie: $($st.SerialNumber)) YA esta conectada por USB en modo MTP (PID_4EE1).\" -ForegroundColor Yellow\n            Write-Host \"    Para que cambie a modo ADB (PID_4EE2), haz esto en tu TV (SIN conectar Wi-Fi):\" -ForegroundColor White\n            Write-Host \"    1. Ve a Configuracion -> Preferencias del dispositivo -> Informacion.\" -ForegroundColor Gray\n            Write-Host \"    2. Baja a 'Compilacion' y presiona OK 7 veces en el control remoto.\" -ForegroundColor Gray\n            Write-Host \"    3. Entra a 'Opciones de programador' y activa 'Depuracion por USB'.\" -ForegroundColor Gray\n            Write-Host \"\"\n            Write-Host \"[*] Esperando automaticamente a que actives 'Depuracion por USB' en la TV (o escribe una IP)...\" -ForegroundColor Cyan\n            $ip = Read-Host \"Presiona ENTER para activar el Radar de Espera USB (o escribe IP local si prefieres red)\"\n            if (-not [string]::IsNullOrWhiteSpace($ip)) {\n                if ($ip -notmatch \":\") { $ip = \"${ip}:5555\" }\n                & $ADB connect $ip\n                $Global:ADB_TARGET_ARGS = @(\"-s\", $ip)\n            } else {\n                Write-Host \"[*] Radar activo: En cuanto actives 'Depuracion por USB' en tu TV, el programa continuara solo...\" -ForegroundColor Green\n                while ($true) {\n                    $cur = Get-BoxConnectionState\n                    if ($cur.AdbDevices.Count -gt 0) {\n                        Write-Host \"[+] Detectada sesion ADB: $($cur.AdbDevices -join ', ')\" -ForegroundColor Green\n                        if ($cur.AdbDevices[0] -match \"unauthorized\") {\n                            Write-Host \"[!] Acepta el cartel 'Permitir depuracion por USB' en la pantalla de tu TV...\" -ForegroundColor Yellow\n                            Start-Sleep -Seconds 2\n                            continue\n                        }\n                        break\n                    }\n                    Start-Sleep -Milliseconds 500\n                }\n            }\n        } else {\n            Write-Host \"[!] No se detecta la caja en ADB todavia.\" -ForegroundColor Yellow\n            $ip = Read-Host \"Si esta en red local escribe su IP (o ENTER para reintentar por USB)\"\n            if (-not [string]::IsNullOrWhiteSpace($ip)) {\n                if ($ip -notmatch \":\") { $ip = \"${ip}:5555\" }\n                & $ADB connect $ip\n                $Global:ADB_TARGET_ARGS = @(\"-s\", $ip)\n            }\n        }\n    }\n\n    Write-Host \"`n[1/6] Desactivando bloqueos de Google Play Protect (de 'adb comandos.txt')...\" -ForegroundColor Cyan\n    Invoke-Adb @(\"shell\", \"settings put global package_verifier_user_consent -1\")\n    Invoke-Adb @(\"shell\", \"settings put global package_verifier_enable 0\")\n    Invoke-Adb @(\"shell\", \"bmgr enable false\")\n\n    Write-Host \"`n[2/6] Instalando Launchers Offline y Utilidades desde '2_APKS_LIBERACION_Y_TV'...\" -ForegroundColor Cyan\n    $coreApks = @(\n        @{ File = \"Home_Screen_Launcher_1.1.3.apk\"; Name = \"Home Screen Launcher (Ligero)\" },\n        @{ File = \"TVLauncher_4_GoogleTV.apk\";      Name = \"TVLauncher 4 (Estilo Google TV)\" },\n        @{ File = \"Button_Mapper_Pro_2.54.apk\";     Name = \"Button Mapper Pro v2.54 (Reasignar Boton Home)\" },\n        @{ File = \"autostart.apk\";                  Name = \"AutoStart al encender\" },\n        @{ File = \"Filemanager.apk\";                Name = \"Gestor de Archivos USB\" },\n        @{ File = \"Downloader_2.0.4.apk\";           Name = \"Downloader Android TV\" }\n    )\n    foreach ($item in $coreApks) {\n        $apkPath = Join-Path $APKS_DIR $item.File\n        if (Test-Path $apkPath) {\n            Write-Host \"  -> Instalando $($item.Name)...\" -ForegroundColor Gray\n            Invoke-Adb @(\"install\", \"-r\", \"-g\", $apkPath)\n        }\n    }\n\n    Write-Host \"`n[3/6] Congelando y desinstalando Pantalla Azul Megacable, Core (oom_adj=-14), OTA y Telemetria ZTE...\" -ForegroundColor Cyan\n    $bloatPackages = @(\n        \"com.dotscreen.megacable.portal\",\n        \"com.dotscreen.megacable.core\",\n        \"com.dotscreen.megacable.atv\",\n        \"com.expway.ewm.service\",\n        \"com.ztestb.LauncherCustomize\",\n        \"com.zte.ums.oes\",\n        \"com.zte.ota\",\n        \"tv.upgrade.service\",\n        \"com.zte.tv.act\",\n        \"com.ztestb.uploaddiagno\",\n        \"com.zte.factorytesttool\",\n        \"com.hmdm.launcher\"\n    )\n    foreach ($pkg in $bloatPackages) {\n        Write-Host \"  -> Neutralizando $pkg ...\" -ForegroundColor Gray\n        Invoke-Adb @(\"shell\", \"cmd appops set $pkg RUN_IN_BACKGROUND ignore; cmd appops set $pkg RUN_ANY_IN_BACKGROUND ignore; am force-stop $pkg; pm disable-user --user 0 $pkg; pm uninstall -k --user 0 $pkg\") 2>$null | Out-Null\n    }\n\n    Write-Host \"`n[4/6] Configurando el nuevo Launcher como Pantalla de Inicio (HOME) y activando Button Mapper...\" -ForegroundColor Cyan\n    Invoke-Adb @(\"shell\", \"cmd package set-home-activity dev.dworks.apps.alauncher/.Launcher\") 2>$null\n    Invoke-Adb @(\"shell\", \"settings put secure enabled_accessibility_services flar2.homebutton/flar2.homebutton.ButtonMapperService\") 2>$null\n    Invoke-Adb @(\"shell\", \"settings put secure accessibility_enabled 1\") 2>$null\n    Invoke-Adb @(\"shell\", \"am start -a android.intent.action.MAIN -c android.intent.category.HOME\") 2>$null\n\n    Write-Host \"`n[5/6] Eliminando banner 'No se pudo instalar la actualizacion del sistema'...\" -ForegroundColor Cyan\n    Invoke-Adb @(\"shell\", \"settings put global ota_disable_automatic_update 1\") 2>$null\n    Invoke-Adb @(\"shell\", \"cmd notification snooze --for 315360000000 '0|com.google.android.gms|1|com.google.android.gms.update.control.NotificationControl|10049'\") 2>$null\n    Invoke-Adb @(\"shell\", \"cmd appops set com.google.android.gms POST_NOTIFICATION ignore\") 2>$null\n\n    Write-Host \"`n[6/6] Activando Modo Stealth (Ocultar Depuracion USB a las apps manteniendo puerto 5555 activo)...\" -ForegroundColor Cyan\n    Invoke-Adb @(\"shell\", \"settings put global adb_enabled 0; settings put secure adb_enabled 0; settings put global development_settings_enabled 0; settings put secure development_settings_enabled 0\") 2>$null\n    Invoke-Adb @(\"shell\", \"setprop service.adb.tcp.port 5555; setprop ctl.start adbd\") 2>$null\n\n    Write-Host \"\"\n    Write-Host \"================================================================================\" -ForegroundColor Green\n    Write-Host \" [LISTO!] Tu caja Xview+ ha quedado liberada, sin pantalla azul de Megacable,  \" -ForegroundColor Green\n    Write-Host \"          con sus nuevos Launchers instalados y lista para conectarse a Wi-Fi.  \" -ForegroundColor Green\n    Write-Host \"================================================================================\" -ForegroundColor Green\n    Read-Host \"`nPresiona ENTER para volver al menu\"\n}\n\nfunction Invoke-AppInstallerMenu {\n    Write-Host \"\"\n    Write-Host \"=== OPCION 2: INSTALADOR DE APPS DE TV Y ENTRETENIMIENTO (OFFLINE DESDE PC) ===\" -ForegroundColor Yellow\n    $apks = Get-ChildItem -Path $APKS_DIR -Filter \"*.apk\"\n    for ($i = 0; $i -lt $apks.Count; $i++) {\n        $sizeMB = [math]::Round($apks[$i].Length / 1MB, 2)\n        Write-Host (\"  [{0}] {1} ({2} MB)\" -f ($i + 1), $apks[$i].Name, $sizeMB) -ForegroundColor White\n    }\n    Write-Host \"  [T] INSTALAR TODAS LAS APPS DE LA LISTA\" -ForegroundColor Green\n    Write-Host \"  [0] Volver al menu principal\" -ForegroundColor Gray\n    Write-Host \"\"\n    $sel = Read-Host \"Elige el numero de la app a instalar (o 'T' para todas)\"\n    if ($sel -eq \"0\" -or [string]::IsNullOrWhiteSpace($sel)) { return }\n    if ($sel -match \"^[Tt]$\") {\n        foreach ($a in $apks) {\n            Write-Host \"[+] Instalando $($a.Name)...\" -ForegroundColor Cyan\n            Invoke-Adb @(\"install\", \"-r\", \"-g\", $a.FullName)\n        }\n    } elseif ($sel -match \"^\\d+$\") {\n        $idx = [int]$sel - 1\n        if ($idx -ge 0 -and $idx -lt $apks.Count) {\n            Write-Host \"[+] Instalando $($apks[$idx].Name)...\" -ForegroundColor Cyan\n            Invoke-Adb @(\"install\", \"-r\", \"-g\", $apks[$idx].FullName)\n        }\n    }\n    Read-Host \"`nPresiona ENTER para volver al menu\"\n}\n\nfunction Invoke-FastbootBridgeAndUnlock {\n    Write-Host \"\"\n    Write-Host \"================================================================================\" -ForegroundColor Yellow\n    Write-Host \"   OPCION 3: PUENTE A BOOTLOADER FASTBOOT + ANTI-WATCHDOG + DESBLOQUEO OTG     \" -ForegroundColor Yellow\n    Write-Host \"================================================================================\" -ForegroundColor Yellow\n    Write-Host \"Esta funcion fusiona 'Comandos.txt', 'Tools cek slot' y nuestro enganche Anti-Watchdog:\" -ForegroundColor Gray\n    Write-Host \"  * Si la caja esta en ADB -> la envia automaticamente a U-Boot Fastboot.\" -ForegroundColor Gray\n    Write-Host \"  * Si la caja esta en Recovery 'Enter fastboot' (fastbootd PID_4EE7) -> la salta a\" -ForegroundColor Gray\n    Write-Host \"    U-Boot Fastboot real (PID_0D02) y apaga el Watchdog de 14 segundos al instante.\" -ForegroundColor Gray\n    Write-Host \"\"\n\n    $st = Get-BoxConnectionState\n    if ($st.AdbDevices.Count -gt 0) {\n        Write-Host \"[+] Caja detectada en ADB. Enviando 'adb reboot bootloader'...\" -ForegroundColor Cyan\n        Invoke-Adb @(\"reboot\", \"bootloader\")\n    }\n\n    Write-Host \"[*] Esperando activamente a la caja en USB Fastboot / Fastbootd (Presiona Ctrl+C para cancelar)...\" -ForegroundColor Cyan\n    while ($true) {\n        $fbOut = & $FASTBOOT devices 2>$null\n        if ($fbOut -match \"fastboot\") {\n            $isUserspace = & $FASTBOOT getvar is-userspace 2>&1\n            if ($isUserspace -match \"yes\") {\n                Write-Host \"[!] Detectado Recovery Fastbootd (PID_4EE7). Saltando a U-Boot Bootloader real...\" -ForegroundColor Yellow\n                & $FASTBOOT reboot bootloader\n                Start-Sleep -Milliseconds 500\n                continue\n            }\n            Write-Host \"[+] Caja atrapada en U-Boot Fastboot! Apagando Watchdog y desbloqueando...\" -ForegroundColor Green\n            & $FASTBOOT oem \"watchdog off\"\n            & $FASTBOOT flashing unlock_critical\n            & $FASTBOOT flashing unlock\n            & $FASTBOOT oem \"setenv lock 10100000;save\"\n            & $FASTBOOT oem \"setenv otg_device 1;save\"\n            & $FASTBOOT oem \"saveenv\"\n            & $FASTBOOT getvar unlocked\n            Write-Host \"[OK] Bootloader desbloqueado, Watchdog apagado y USB OTG activado.\" -ForegroundColor Green\n            break\n        }\n        Start-Sleep -Milliseconds 250\n    }\n    Read-Host \"`nPresiona ENTER para volver al menu\"\n}\n\nfunction Invoke-SafeAndroid12Flash {\n    Write-Host \"\"\n    Write-Host \"================================================================================\" -ForegroundColor Magenta\n    Write-Host \"   OPCION 4: FLASHEO SEGURO ANDROID 12 (B866V2) SIN PERDER WIDEVINE L1 / MAC   \" -ForegroundColor Magenta\n    Write-Host \"================================================================================\" -ForegroundColor Magenta\n    Write-Host \"  * Protege 100% tus particiones 'factory' (Widevine L1) y 'cri_data' (MAC/Serie).\" -ForegroundColor Green\n    Write-Host \"  * Rechaza automaticamente imagenes incompatibles de B866F (S905Y4).\" -ForegroundColor Green\n    Write-Host \"  * Repara la particion /cache con 'cache_ext4.img' e instala Recovery desbloqueado.\" -ForegroundColor Green\n    Write-Host \"\"\n\n    $superPath = Join-Path $FW_DIR \"super.img\"\n    if (-not (Test-Path $superPath)) {\n        $candidates = @(\n            \"D:\\B866v2 Android 12\\B866v2 Android 12\\B866V2\\super.img\",\n            \"C:\\Users\\andre\\OneDrive\\Desktop\\xview\\V2\\B866v2 Android 12\\B866v2 Android 12\\B866V2\\super.img\",\n            \"C:\\Users\\andre\\OneDrive\\Desktop\\xview\\FIRMWARE_COMPLETO_B866V2_FASTBOOT\\super.img\"\n        )\n        foreach ($c in $candidates) {\n            if (Test-Path $c) { $superPath = $c; break }\n        }\n    }\n\n    if (-not (Test-Path $superPath)) {\n        Write-Host \"[!] No se encontro 'super.img' de B866V2. Conecta la memoria USB KINGSTON (D:\\) donde esta 'D:\\B866v2 Android 12'.\" -ForegroundColor Red\n        Read-Host \"`nPresiona ENTER para volver al menu\"\n        return\n    }\n\n    Write-Host \"[+] Imagen super.img localizada en: $superPath\" -ForegroundColor Cyan\n    $confirm = Read-Host \"Deseas iniciar el flasheo completo y seguro de Android 12 B866V2? (S/N)\"\n    if ($confirm -notmatch \"^[Ss]$\") { return }\n\n    $st = Get-BoxConnectionState\n    if ($st.AdbDevices.Count -gt 0) {\n        Write-Host \"[+] Enviando 'adb reboot bootloader'...\" -ForegroundColor Cyan\n        Invoke-Adb @(\"reboot\", \"bootloader\")\n    }\n\n    Write-Host \"[1/12] Esperando a que la caja entre en Fastboot...\" -ForegroundColor Cyan\n    while ($true) {\n        $fbOut = & $FASTBOOT devices 2>$null\n        if ($fbOut -match \"fastboot\") {\n            $isUserspace = & $FASTBOOT getvar is-userspace 2>&1\n            if ($isUserspace -match \"yes\") {\n                Write-Host \"  -> Detectado fastbootd (Recovery), reiniciando a Bootloader U-Boot...\" -ForegroundColor Yellow\n                & $FASTBOOT reboot bootloader\n                Start-Sleep -Milliseconds 500\n                continue\n            }\n            break\n        }\n        Start-Sleep -Milliseconds 250\n    }\n\n    Write-Host \"[2/12] Apagando Watchdog, desbloqueando Bootloader y activando USB OTG...\" -ForegroundColor Cyan\n    & $FASTBOOT oem \"watchdog off\"\n    & $FASTBOOT flashing unlock_critical\n    & $FASTBOOT flashing unlock\n    & $FASTBOOT oem \"setenv lock 10100000;save\"\n    & $FASTBOOT oem \"setenv otg_device 1;save\"\n    & $FASTBOOT oem \"saveenv\"\n\n    Write-Host \"[3/12] Flasheando boot.img...\" -ForegroundColor Cyan\n    & $FASTBOOT flash boot (Join-Path $FW_DIR \"boot.img\")\n\n    Write-Host \"[4/12] Flasheando _aml_dtb y dtbo.img...\" -ForegroundColor Cyan\n    & $FASTBOOT flash _aml_dtb (Join-Path $FW_DIR \"dtb.img\")\n    & $FASTBOOT flash dtbo (Join-Path $FW_DIR \"dtbo.img\")\n\n    Write-Host \"[5/12] PROTEGIENDO factory.img (Widevine L1) y cri_data.img (MAC/Serie) - OMITIDOS POR SEGURIDAD.\" -ForegroundColor Green\n\n    Write-Host \"[6/12] Flasheando logo.img y param.img...\" -ForegroundColor Cyan\n    & $FASTBOOT flash logo (Join-Path $FW_DIR \"logo.img\")\n    & $FASTBOOT flash param (Join-Path $FW_DIR \"param.img\")\n\n    Write-Host \"[7/12] Flasheando conf.img y oem.img...\" -ForegroundColor Cyan\n    & $FASTBOOT flash conf (Join-Path $FW_DIR \"conf.img\")\n    & $FASTBOOT flash oem (Join-Path $FW_DIR \"oem.img\")\n\n    Write-Host \"[8/12] Flasheando super.img (Android 12 Liberado B866V2)...\" -ForegroundColor Cyan\n    & $FASTBOOT flash super $superPath\n\n    Write-Host \"[9/12] Flasheando vbmeta.img (dm-verity desactivado flags=0x03)...\" -ForegroundColor Cyan\n    & $FASTBOOT flash vbmeta (Join-Path $FW_DIR \"vbmeta.img\")\n\n    Write-Host \"[10/12] Flasheando recovery.img (Menu Fastboot/ADB desbloqueado en TV)...\" -ForegroundColor Cyan\n    & $FASTBOOT flash recovery (Join-Path $FW_DIR \"recovery.img\")\n\n    Write-Host \"[11/12] Reparando particion /cache con cache_ext4.img...\" -ForegroundColor Cyan\n    & $FASTBOOT erase cache\n    & $FASTBOOT flash cache (Join-Path $FW_DIR \"cache_ext4.img\")\n\n    Write-Host \"[12/12] Limpiando userdata y reiniciando...\" -ForegroundColor Cyan\n    & $FASTBOOT erase userdata\n    & $FASTBOOT reboot\n\n    Write-Host \"`n[COMPLETADO!] Tu caja B866V2 arrancara con el firmware Android 12 libre conservando Widevine L1.\" -ForegroundColor Green\n    Read-Host \"`nPresiona ENTER para volver al menu\"\n}\n\nfunction Invoke-AmlogicWorldCupEngine {\n    Write-Host \"\"\n    Write-Host \"================================================================================\" -ForegroundColor Cyan\n    Write-Host \"   OPCION 5: MOTOR AMLOGIC DNL / WORLDCUP (adnl.exe + update.exe VID_1B8E)      \" -ForegroundColor Cyan\n    Write-Host \"================================================================================\" -ForegroundColor Cyan\n    Write-Host \"Para entrar a este modo con la caja 100% cerrada:\" -ForegroundColor Gray\n    Write-Host \"  1. Desconecta la corriente de la caja.\" -ForegroundColor Gray\n    Write-Host \"  2. Conecta el cable USB Macho-a-Macho en el puerto USB lateral.\" -ForegroundColor Gray\n    Write-Host \"  3. Manten presionado el boton fisico externo RESET (orificio lateral) y conecta la corriente.\" -ForegroundColor Gray\n    Write-Host \"\"\n    Write-Host \"  [1] Escanear dispositivo en modo WorldCup / ADNL\" -ForegroundColor White\n    Write-Host \"  [2] Desbloquear Bootloader + Activar OTG + Saltar a Fastboot (via update.exe bulkcmd)\" -ForegroundColor Green\n    Write-Host \"  [3] Reiniciar caja desde modo ADNL / WorldCup\" -ForegroundColor White\n    Write-Host \"  [0] Volver al menu principal\" -ForegroundColor Gray\n    Write-Host \"\"\n    $sub = Read-Host \"Elige una opcion\"\n    if ($sub -eq \"1\") {\n        Write-Host \"`n--- Escaneo con adnl.exe ---\" -ForegroundColor Cyan\n        & $ADNL devices\n        Write-Host \"`n--- Escaneo con update.exe ---\" -ForegroundColor Cyan\n        & $UPDATE identify 7\n    } elseif ($sub -eq \"2\") {\n        Write-Host \"`n[+] Enviando comandos U-Boot por protocolo WorldCup (update.exe)...\" -ForegroundColor Cyan\n        & $UPDATE bulkcmd \"watchdog off\"\n        & $UPDATE bulkcmd \"setenv lock 10100000\"\n        & $UPDATE bulkcmd \"setenv otg_device 1\"\n        & $UPDATE bulkcmd \"saveenv\"\n        Write-Host \"[+] Saltando la caja a modo Fastboot...\" -ForegroundColor Green\n        & $UPDATE bulkcmd \"fastboot\"\n    } elseif ($sub -eq \"3\") {\n        & $ADNL reboot\n        & $UPDATE bulkcmd \"reset\"\n    }\n    Read-Host \"`nPresiona ENTER para volver al menu\"\n}\n\nfunction Invoke-UsbPrepAndLogDecrypt {\n    Write-Host \"\"\n    Write-Host \"================================================================================\" -ForegroundColor Yellow\n    Write-Host \"   OPCION 6: PREPARAR MEMORIA USB (QADEBUG + APKS) Y DESCIFRAR LOGS ZTE         \" -ForegroundColor Yellow\n    Write-Host \"================================================================================\" -ForegroundColor Yellow\n\n    $drives = Get-Volume | Where-Object { $_.DriveType -eq 'Removable' -and $_.DriveLetter }\n    if ($drives) {\n        Write-Host \"Memorias USB detectadas:\" -ForegroundColor Cyan\n        foreach ($d in $drives) {\n            Write-Host \"  * Unidad $($d.DriveLetter):\\ ($($d.FileSystemLabel) - $($d.FileSystem))\" -ForegroundColor Green\n        }\n    }\n    Write-Host \"\"\n    Write-Host \"  [1] Copiar llaves QADEBUG.ini + factory_update_param.aml + Launchers a una memoria USB\" -ForegroundColor White\n    Write-Host \"  [2] Descifrar logs ocultos de la caja (LOG_ZTESTB_OFF\\U_*) y mostrar Serie/MAC/Firmware\" -ForegroundColor Green\n    Write-Host \"  [0] Volver al menu principal\" -ForegroundColor Gray\n    Write-Host \"\"\n    $op = Read-Host \"Elige una opcion\"\n    if ($op -eq \"1\") {\n        $drv = Read-Host \"Escribe la letra de tu memoria USB (ej. D)\"\n        $drv = ($drv -replace \"[:\\\\]\", \"\").Trim()\n        $targetUsb = \"${drv}:\\\"\n        if (Test-Path $targetUsb) {\n            Copy-Item \"$KEYS_DIR\\*\" $targetUsb -Force\n            Copy-Item \"$APKS_DIR\\Home_Screen_Launcher_1.1.3.apk\" $targetUsb -Force\n            Copy-Item \"$APKS_DIR\\TVLauncher_4_GoogleTV.apk\" $targetUsb -Force\n            Copy-Item \"$APKS_DIR\\Button_Mapper_Pro_2.54.apk\" $targetUsb -Force\n            Copy-Item \"$APKS_DIR\\Filemanager.apk\" $targetUsb -Force\n            Copy-Item \"$APKS_DIR\\autostart.apk\" $targetUsb -Force\n            Write-Host \"[OK] Llaves QADEBUG.ini y Launchers copiados a la raiz de $targetUsb\" -ForegroundColor Green\n        } else {\n            Write-Host \"[!] No existe la unidad $targetUsb\" -ForegroundColor Red\n        }\n    } elseif ($op -eq \"2\") {\n        $drv = Read-Host \"Escribe la letra de la memoria USB donde estan los logs (ej. D)\"\n        $drv = ($drv -replace \"[:\\\\]\", \"\").Trim()\n        $logFolder = \"${drv}:\\LOG_ZTESTB_OFF\"\n        if (Test-Path $logFolder) {\n            $encStr = '5;8|\"79+3(&16-409876543210/.-,+*)(''&%$#\"! ~}|{zyxwvutsrqponmlkjihgfedcba`_^]\\[ZYXWVUTSRQPONMLKJIHGFEDCBA@?>=<;:9876543210/.-,+*)(''&%$#\"! '\n            $decStr = ' ~}|{zyxwvutsrqponmlkjihgfedcba`_^]\\[ZYXWVUTSRQPONMLKJIHGFEDCBA@?>=<;:9876543210/.-,+*)(''&%$#\"! 5;8|\"79+3(&16-409876543210/.-,+*)(''&%$#\"!'\n            $lut = New-Object byte[] 256\n            for ($i=0; $i -lt 256; $i++) { $lut[$i] = [byte]$i }\n            for ($i=0; $i -lt $encStr.Length; $i++) {\n                $e = [byte][char]$encStr[$i]\n                $d = [byte][char]$decStr[$i]\n                if ($lut[$e] -eq $e) { $lut[$e] = $d }\n            }\n            $outDir = Join-Path $ROOT_DIR \"LOGS_DESCIFRADOS_CAJA\"\n            New-Item -ItemType Directory -Path $outDir -Force | Out-Null\n            $files = Get-ChildItem $logFolder -Filter \"U_*\"\n            foreach ($f in $files) {\n                Write-Host \"[+] Descifrando $($f.Name)...\" -ForegroundColor Cyan\n                $raw = [System.IO.File]::ReadAllBytes($f.FullName)\n                $out = New-Object byte[] $raw.Length\n                for ($i=0; $i -lt $raw.Length; $i++) { $out[$i] = $lut[$raw[$i]] }\n                $destFile = Join-Path $outDir \"$($f.Name)_DEC.log\"\n                [System.IO.File]::WriteAllBytes($destFile, $out)\n                Write-Host \"  -> Guardado en: $destFile\" -ForegroundColor Green\n                Select-String -Path $destFile -Pattern \"SerialNumber|ro.build.fingerprint|Linux version|U-Boot 2015|checkUdisk\" | Select-Object -First 8 | ForEach-Object {\n                    Write-Host \"     $($_.Line)\" -ForegroundColor Gray\n                }\n            }\n        } else {\n            Write-Host \"[!] No se encontro la carpeta $logFolder\" -ForegroundColor Red\n        }\n    }\n    Read-Host \"`nPresiona ENTER para volver al menu\"\n}\n\nfunction Invoke-DriversAndGuiMenu {\n    Write-Host \"\"\n    Write-Host \"=== OPCION 7: INSTALAR DRIVERS USB Y ABRIR ADB APPCONTROL GUI ===\" -ForegroundColor Yellow\n    Write-Host \"  [1] Abrir instalador de ADB AppControl 1.8.6 (Interfaz grafica para Windows)\" -ForegroundColor White\n    Write-Host \"  [2] Instalar Driver Oficial Amlogic WorldCup (VID_1B8E)\" -ForegroundColor White\n    Write-Host \"  [0] Volver al menu principal\" -ForegroundColor Gray\n    Write-Host \"\"\n    $c = Read-Host \"Elige una opcion\"\n    if ($c -eq \"1\") {\n        $exe = Join-Path $DRV_DIR \"ADBAppControl-1.8.6-setup.exe\"\n        if (Test-Path $exe) { Start-Process $exe }\n    } elseif ($c -eq \"2\") {\n        $exe = Join-Path $DRV_DIR \"WorldCup_Driver_VID_1B8E\\InstallDriver.exe\"\n        if (Test-Path $exe) { Start-Process $exe -Verb RunAs }\n    }\n}\n\n# Permitir prueba no interactiva del Radar con --check\nif ($args -contains \"--check\") {\n    Show-Banner\n    exit 0\n}\n\n# Bucle Principal del Programa Perfecto\nwhile ($true) {\n    Show-Banner\n    Write-Host \"  [0] Conectar Caja por Direccion IP (Red Local Wi-Fi/Ethernet) o Refrescar USB\" -ForegroundColor Cyan\n    Write-Host \"  [1] LIBERACION COMPLETA EN 1 CLIC POR ADB (Quita Pantalla Azul Megacable,\" -ForegroundColor Green\n    Write-Host \"      desactiva Core/OTA, instala Launchers + Button Mapper y activa Modo Stealth)\" -ForegroundColor Green\n    Write-Host \"  [2] Instalador de Apps de TV y Entretenimiento (MagisTV, Xuper, Hdplay, etc.)\" -ForegroundColor White\n    Write-Host \"  [3] Puente Fastboot / Fastbootd + Apagar Watchdog 14s + Desbloquear Bootloader/OTG\" -ForegroundColor Yellow\n    Write-Host \"  [4] Flashear Firmware Completo Android 12 (B866V2) Conservando Widevine L1 y MAC\" -ForegroundColor Magenta\n    Write-Host \"  [5] Motor Amlogic DNL / WorldCup (adnl.exe + update.exe por boton externo RESET)\" -ForegroundColor Cyan\n    Write-Host \"  [6] Preparar Memoria USB (QADEBUG.ini + APKs) y Descifrar Logs de Caja (LOG_ZTESTB)\" -ForegroundColor White\n    Write-Host \"  [7] Instalar Drivers USB (WorldCup VID_1B8E) o Abrir ADB AppControl GUI\" -ForegroundColor White\n    Write-Host \"  [8] Salir\" -ForegroundColor DarkGray\n    Write-Host \"--------------------------------------------------------------------------------\" -ForegroundColor DarkCyan\n    $choice = Read-Host \"Selecciona el numero de la opcion [0-8]\"\n\n    switch ($choice) {\n        \"0\" { Connect-AdbTarget }\n        \"1\" { Invoke-FullAdbLiberation }\n        \"2\" { Invoke-AppInstallerMenu }\n        \"3\" { Invoke-FastbootBridgeAndUnlock }\n        \"4\" { Invoke-SafeAndroid12Flash }\n        \"5\" { Invoke-AmlogicWorldCupEngine }\n        \"6\" { Invoke-UsbPrepAndLogDecrypt }\n        \"7\" { Invoke-DriversAndGuiMenu }\n        \"8\" { exit 0 }\n        default { Start-Sleep -Milliseconds 500 }\n    }\n}\n","Overwrite":true,"Path":"c:\\Users\\andre\\OneDrive\\Desktop\\xview\\programa perfecto\\1_HERRAMIENTAS_MOTOR\\MOTOR_PROGRAMA_PERFECTO.ps1"}}]}
