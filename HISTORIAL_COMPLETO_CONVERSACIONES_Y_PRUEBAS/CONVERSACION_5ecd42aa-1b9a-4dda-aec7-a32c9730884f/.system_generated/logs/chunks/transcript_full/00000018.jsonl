TERACTIVE\", Path.GetFileName(exePath) + \" \" + argString);\n            try\n            {\n                ProcessStartInfo psi = new ProcessStartInfo\n                {\n                    FileName = exePath,\n                    Arguments = argString,\n                    WorkingDirectory = MOTOR_DIR,\n                    UseShellExecute = false\n                };\n                using (Process proc = Process.Start(psi))\n                {\n                    proc.WaitForExit();\n                    LogEvent(\"CMD_INTERACTIVE_END\", Path.GetFileName(exePath) + \" ExitCode=\" + proc.ExitCode);\n                    return proc.ExitCode;\n                }\n            }\n            catch (Exception ex)\n            {\n                LogEvent(\"CMD_INTERACTIVE_ERR\", ex.Message);\n                return -1;\n            }\n        }\n\n        static ToolResult InvokeFastbootSafe(string argString, int timeoutMs = 3000, bool logCmd = true)\n        {\n            return InvokeToolSafe(FASTBOOT_EXE, argString, timeoutMs, logCmd);\n        }\n\n        static ToolResult InvokeUpdateSafe(string argString, int timeoutMs = 5000, bool logCmd = true)\n        {\n            return InvokeToolSafe(UPDATE_EXE, argString, timeoutMs, logCmd);\n        }\n\n        static ToolResult InvokeAdbSafe(string argString, int timeoutMs = 10000, bool logCmd = true)\n        {\n            string prefix = string.IsNullOrEmpty(CONNECTED_IP) ? \"\" : (\"-s \" + CONNECTED_IP + \" \");\n            return InvokeToolSafe(ADB_EXE, prefix + argString, timeoutMs, logCmd);\n        }\n\n        static int InvokeAdbInteractive(string argString)\n        {\n            string prefix = string.IsNullOrEmpty(CONNECTED_IP) ? \"\" : (\"-s \" + CONNECTED_IP + \" \");\n            return InvokeToolInteractive(ADB_EXE, prefix + argString);\n        }\n\n        static string ReadChoiceWithKeepAlive(string promptText, string[] validChoices)\n        {\n            WriteColor(promptText + \" (\" + string.Join(\"/\", validChoices) + \"): \", ConsoleColor.Yellow, false);\n            DateTime lastPulse = DateTime.Now;\n            while (true)\n            {\n                if (Console.KeyAvailable)\n                {\n                    ConsoleKeyInfo keyInfo = Console.ReadKey(true);\n                    string ch = keyInfo.KeyChar.ToString().ToUpperInvariant();\n                    if (validChoices.Contains(ch))\n                    {\n                        WriteColor(ch, ConsoleColor.Green);\n                        LogEvent(\"INPUT\", \"Eleccion del usuario (KeepAlive): \" + ch);\n                        return ch;\n                    }\n                }\n                if ((DateTime.Now - lastPulse).TotalSeconds >= 2.0)\n                {\n                    lastPulse = DateTime.Now;\n                    InvokeFastbootSafe(\"getvar version-bootloader\", 1200, false);\n                }\n                Thread.Sleep(60);\n            }\n        }\n\n        // ==============================================================================\n        // CAZADOR ULTRARRAPIDO WORLDCUP / INUSBBURN (48ms DIRECTO POR LIBUSB)\n        // Usa 'setenv lock 10100000' como primer paquete para desbloquear al instante!\n        // ==============================================================================\n        static bool TryCatchWorldCup48ms()\n        {\n            if (!File.Exists(UPDATE_EXE)) return false;\n\n            // Sondeo silencioso de 48ms: si no hay dispositivo WorldCup no ensucia el log\n            ToolResult res = InvokeUpdateSafe(\"bulkcmd \\\"setenv lock 10100000\\\"\", 1500, false);\n            if (!res.TimedOut &&\n                !string.IsNullOrWhiteSpace(res.Output) &&\n                res.Output.IndexOf(\"No [WorldCup Device]\", StringComparison.OrdinalIgnoreCase) < 0 &&\n                res.Output.IndexOf(\"can not find device\", StringComparison.OrdinalIgnoreCase) < 0)\n            {\n                LogEvent(\"WORLDCUP_CAUGHT\", \"Detectado WorldCup (VID_1B8E)! Respuesta inicial: \" + res.Output.Replace(\"\\r\", \" \").Replace(\"\\n\", \" | \"));\n                Console.WriteLine();\n                WriteColor(\"[+] Detectada caja en Modo Amlogic WorldCup / InUsbBurn (VID_1B8E) en <50ms!\", ConsoleColor.Green);\n                WriteColor(\"    [1/5] Primer paquete 'setenv lock 10100000' aceptado por U-Boot.\", ConsoleColor.Cyan);\n\n                string[] cmds = new string[]\n                {\n                    \"setenv -f lock 10100000\",\n                    \"setenv lock 10100000\",\n                    \"setenv unlock_ability 1\",\n                    \"setenv otg_device 1\",\n                    \"saveenv\"\n                };\n                WriteColor(\"    [2/5] Grabando variables U-Boot (lock=10100000, unlock_ability=1, otg_device=1)...\", ConsoleColor.Cyan);\n                foreach (string c in cmds)\n                {\n                    InvokeUpdateSafe(\"bulkcmd \\\"\" + c + \"\\\"\", 3000, true);\n                }\n\n                if (File.Exists(ENV_UNL_IMG))\n                {\n                    WriteColor(\"    [3/5] Inyectando particion 'env' desbloqueada (env_unlocked.img)...\", ConsoleColor.Cyan);\n                    ToolResult rEnv = InvokeUpdateSafe(\"partition env \\\"\" + ENV_UNL_IMG + \"\\\"\", 8000, true);\n                    WriteColor(\"          Resultado env: \" + rEnv.Output.Replace(\"\\r\", \" \").Replace(\"\\n\", \" \"), ConsoleColor.Gray);\n                }\n                if (File.Exists(CONF_IMG))\n                {\n                    InvokeUpdateSafe(\"partition conf \\\"\" + CONF_IMG + \"\\\"\", 6000, true);\n                }\n\n                // Inyectar tambien vbmeta y recovery directamente por WorldCup mientras tenemos acceso directo!\n                string vbmetaImg = Path.Combine(FW_DIR, \"vbmeta.img\");\n                string recImg    = Path.Combine(FW_DIR, \"recovery.img\");\n                string dtbImg    = Path.Combine(FW_DIR, \"dtb.img\");\n                WriteColor(\"    [4/5] Inyectando _aml_dtb, vbmeta (flags=0x03) y recovery desbloqueado directo por WorldCup...\", ConsoleColor.Cyan);\n                if (File.Exists(dtbImg))    InvokeUpdateSafe(\"partition _aml_dtb \\\"\" + dtbImg + \"\\\"\", 8000, true);\n                if (File.Exists(vbmetaImg)) InvokeUpdateSafe(\"partition vbmeta \\\"\" + vbmetaImg + \"\\\"\", 10000, true);\n                if (File.Exists(recImg))    InvokeUpdateSafe(\"partition recovery \\\"\" + recImg + \"\\\"\", 25000, true);\n\n                WriteColor(\"    [5/5] Saltando la caja a U-Boot Fastboot DESBLOQUEADO (PID_0D02)...\", ConsoleColor.Green);\n                InvokeUpdateSafe(\"bulkcmd \\\"fastboot\\\"\", 3000, true);\n                Thread.Sleep(1200);\n                return true;\n            }\n            return false;\n        }\n\n        static BoxConnectionState GetBoxConnectionState()\n        {\n            BoxConnectionState state = new BoxConnectionState();\n\n            // 1. Prueba directa WorldCup (48ms)\n            ToolResult wcCheck = InvokeUpdateSafe(\"bulkcmd \\\"setenv lock 10100000\\\"\", 1000, false);\n            if (!wcCheck.TimedOut &&\n                !string.IsNullOrWhiteSpace(wcCheck.Output) &&\n                wcCheck.Output.IndexOf(\"No [WorldCup Device]\", StringComparison.OrdinalIgnoreCase) < 0 &&\n                wcCheck.Output.IndexOf(\"can not find device\", StringComparison.OrdinalIgnoreCase) < 0)\n            {\n                state.UsbHardwareMode = \"Amlogic WorldCup / InUsbBurn Activo (VID_1B8E) - LISTO PARA DESBLOQUEO\";\n                state.RawPid = \"1B8E\";\n            }\n\n            // 2. Escaneo WMI PnP\n            try\n            {\n                using (ManagementObjectSearcher searcher = new ManagementObjectSearcher(\n                    \"SELECT DeviceID FROM Win32_PnPEntity WHERE DeviceID LIKE '%VID_18D1%' OR DeviceID LIKE '%VID_19D2%' OR DeviceID LIKE '%VID_1B8E%'\"))\n                {\n                    foreach (ManagementObject dev in searcher.Get())\n                    {\n                        string devId = Convert.ToString(dev[\"DeviceID\"]) ?? \"\";\n                        int lastSlash = devId.LastIndexOf('\\\\');\n                        if (lastSlash >= 0 && lastSlash + 1 < devId.Length)\n                        {\n                            string sn = devId.Substring(lastSlash + 1);\n                            if (!sn.Contains(\"&\")) state.SerialNumber = sn;\n                        }\n\n                        if (devId.IndexOf(\"PID_4EE2\", StringComparison.OrdinalIgnoreCase) >= 0)\n                        {\n                            state.UsbHardwareMode = \"ADB USB Activo (PID_4EE2) - LISTO PARA LIBERACION DIRECTA\";\n                            state.RawPid = \"4EE2\";\n                        }\n                        else if (devId.IndexOf(\"PID_4EE7\", StringComparison.OrdinalIgnoreCase) >= 0)\n                        {\n                            state.UsbHardwareMode = \"Recovery Fastbootd (PID_4EE7) - ACTIVO\";\n                            state.RawPid = \"4EE7\";\n                        }\n                        else if (devId.IndexOf(\"PID_0D02\", StringComparison.OrdinalIgnoreCase) >= 0)\n                        {\n                            state.RawPid = \"0D02\";\n                        }\n                        else if (devId.IndexOf(\"PID_4EE1\", StringComparison.OrdinalIgnoreCase) >= 0)\n                        {\n                            state.UsbHardwareMode = \"Modo MTP Android (PID_4EE1) - Usa Opcion 1 para Salto Automatico\";\n                            state.RawPid = \"4EE1\";\n                        }\n                        else if (devId.IndexOf(\"VID_1B8E\", StringComparison.OrdinalIgnoreCase) >= 0)\n                        {\n                            state.UsbHardwareMode = \"Amlogic WorldCup / DNL Mode (VID_1B8E) - LISTO PARA DESBLOQUEO U-BOOT\";\n                            state.RawPid = \"1B8E\";\n                        }\n                    }\n                }\n            }\n            catch { }\n\n            // 3. Verificar ADB\n            if (File.Exists(ADB_EXE))\n            {\n                ToolResult adbRes = InvokeToolSafe(ADB_EXE, \"devices\", 2000, false);\n                if (!adbRes.TimedOut)\n                {\n                    foreach (string rawLine in adbRes.Output.Split(new[] { '\\r', '\\n' }, StringSplitOptions.RemoveEmptyEntries))\n                    {\n                        Match m = Regex.Match(rawLine.Trim(), @\"^(\\S+)\\s+(device|unauthorized|offline)$\");\n                        if (m.Success)\n                        {\n                            state.AdbDevices.Add(m.Groups[1].Value + \" [\" + m.Groups[2].Value + \"]\");\n                        }\n                    }\n                }\n            }\n\n            // 4. Verificar Fastboot y filtrar descriptores fantasma\n            if (File.Exists(FASTBOOT_EXE))\n            {\n                ToolResult fbRes = InvokeFastbootSafe(\"devices\", 1500, false);\n                if (!fbRes.TimedOut)\n                {\n                    foreach (string rawLine in fbRes.Output.Split(new[] { '\\r', '\\n' }, StringSplitOptions.RemoveEmptyEntries))\n                    {\n                        Match m = Regex.Match(rawLine.Trim(), @\"^(\\S+)\\s+fastboot\");\n                        if (m.Success)\n                        {\n                            string candidateSn = m.Groups[1].Value;\n                            ToolResult ping = InvokeFastbootSafe(\"getvar version-bootloader\", 900, false);\n                            if (!ping.TimedOut && (\n                                ping.Output.IndexOf(\"version-bootloader\", StringComparison.OrdinalIgnoreCase) >= 0 ||\n                                ping.Output.IndexOf(\"OKAY\", StringComparison.OrdinalIgnoreCase) >= 0 ||\n                                ping.Output.IndexOf(\"Finished\", StringComparison.OrdinalIgnoreCase) >= 0))\n                            {\n                                state.FastbootDevices.Add(candidateSn);\n                                state.FastbootLive = true;\n                                if (state.RawPid == \"0D02\")\n                                {\n                                    state.UsbHardwareMode = \"U-Boot Fastboot Activo (PID_0D02) - RESPONDIENDO EN VIVO\";\n                                }\n                            }\n                            else\n                            {\n                                if (state.RawPid == \"0D02\")\n                                {\n                                    state.UsbHardwareMode = \"Caja encendida en Android (Descriptor Fastboot previo en reposo)\";\n                                    state.RawPid = \"0D02_GHOST\";\n                                }\n                            }\n                        }\n                    }\n                }\n            }\n\n            LogEvent(\"RADAR\", string.Format(\"SN={0} | RawPid={1} | FastbootLive={2} | ADB={3}\",\n                state.SerialNumber, state.RawPid, state.FastbootLive, string.Join(\",\", state.AdbDevices)));\n            return state;\n        }\n\n        static void ShowBanner()\n        {\n            try { Console.Clear(); } catch { }\n            WriteColor(\"================================================================================\", ConsoleColor.Cyan, true, false);\n            WriteColor(\"          PROGRAMA PERFECTO - MEGACABLE XVIEW+ (ZTE ZXV10 B866V2) [.EXE]        \", ConsoleColor.Cyan, true, false);\n            WriteColor(\"     Motor de Salto Directo (WorldCup 48ms / Fastbootd / Fastboot / ADB)        \", ConsoleColor.Cyan, true, false);\n            WriteColor(\"      Regla: 100% Externo Sin Abrir Tornillos | Proteccion Widevine L1/MAC      \", ConsoleColor.Cyan, true, false);\n            WriteColor(\"================================================================================\", ConsoleColor.Cyan, true, false);\n\n            BoxConnectionState st = GetBoxConnectionState();\n            Console.WriteLine();\n            WriteColor(\" [RADAR DE HARDWARE USB EN TIEMPO REAL]\", ConsoleColor.Yellow, true, false);\n            WriteColor(\"  * Caja Detectada   : Xview+ (Serie: \" + st.SerialNumber + \")\", ConsoleColor.White, true, false);\n\n            if (st.RawPid == \"4EE2\" || st.RawPid == \"0D02\" || st.RawPid == \"4EE7\" || st.RawPid == \"1B8E\")\n            {\n                WriteColor(\"  * Estado Cable USB : \" + st.UsbHardwareMode, ConsoleColor.Green, true, false);\n            }\n            else if (st.RawPid == \"4EE1\" || st.RawPid == \"0D02_GHOST\")\n            {\n                WriteColor(\"  * Estado Cable USB : \" + st.UsbHardwareMode, ConsoleColor.Yellow, true, false);\n            }\n            else\n            {\n                WriteColor(\"  * Estado Cable USB : \" + st.UsbHardwareMode, ConsoleColor.Gray, true, false);\n            }\n\n            if (st.AdbDevices.Count > 0)\n            {\n                WriteColor(\"  * Sesion ADB       : \" + string.Join(\", \", st.AdbDevices), ConsoleColor.Green, true, false);\n            }\n            else\n            {\n                WriteColor(\"  * Sesion ADB       : Sin sesion activa\", ConsoleColor.DarkGray, true, false);\n            }\n\n            if (st.FastbootLive && st.FastbootDevices.Count > 0)\n            {\n                WriteColor(\"  * Sesion Fastboot  : ACTIVA EN VIVO (\" + string.Join(\", \", st.FastbootDevices) + \")\", ConsoleColor.Green, true, false);\n            }\n            else\n            {\n                WriteColor(\"  * Sesion Fastboot  : En espera de salto (Opcion 1 caza WorldCup/Fastboot)\", ConsoleColor.DarkGray, true, false);\n            }\n            WriteColor(\"--------------------------------------------------------------------------------\", ConsoleColor.DarkCyan, true, false);\n        }\n\n        static void ExecuteAdbPayload()\n        {\n            LogEvent(\"ADB_PAYLOAD\", \"Iniciando ExecuteAdbPayload()...\");\n            Console.WriteLine();\n            WriteColor(\"[1/7] Inyectando token 'EE@' en /cache/recovery/last_QR (Bypass candado QR ZTE)...\", ConsoleColor.Cyan);\n            InvokeAdbSafe(\"shell \\\"echo -n 'EE@' > /cache/recovery/last_QR; rm -f /cache/recovery/last_QR_Time\\\"\");\n\n            WriteColor(\"[2/7] Desbloqueando banderas OEM y U-Boot (lock=10100000, otg_device=1) desde ADB...\", ConsoleColor.Cyan);\n            InvokeAdbSafe(\"shell \\\"settings put global oem_unlock_enabled 1; settings put secure oem_unlock_enabled 1\\\"\");\n            InvokeAdbSafe(\"shell \\\"setprop ubootenv.var.lock 10100000; setprop ubootenv.var.otg_device 1; setprop persist.sys.usb.config mtp,adb\\\"\");\n            InvokeAdbSafe(\"shell \\\"settings put global package_verifier_user_consent -1; settings put global package_verifier_enable 0; bmgr enable false\\\"\");\n\n            if (File.Exists(ENV_UNL_IMG))\n            {\n                InvokeAdbSafe(\"push \\\"\" + ENV_UNL_IMG + \"\\\" /data/local/tmp/env_unlocked.img\");\n                InvokeAdbSafe(\"shell \\\"dd if=/data/local/tmp/env_unlocked.img of=/dev/block/env bs=65536 count=1 2>/dev/null; su -c 'dd if=/data/local/tmp/env_unlocked.img of=/dev/block/env bs=65536 count=1' 2>/dev/null; sync\\\"\");\n            }\n\n            WriteColor(\"[3/7] Instalando Launchers Offline y Utilidades desde '2_APKS_LIBERACION_Y_TV'...\", ConsoleColor.Cyan);\n            string[,] coreApks = new string[,]\n            {\n                { \"Home_Screen_Launcher_1.1.3.apk\", \"Home Screen Launcher (Ligero)\" },\n                { \"TVLauncher_4_GoogleTV.apk\",      \"TVLauncher 4 (Estilo Google TV)\" },\n                { \"Button_Mapper_Pro_2.54.apk\",     \"Button Mapper Pro v2.54 (Reasignar Boton Home)\" },\n                { \"autostart.apk\",                  \"AutoStart al encender\" },\n                { \"Filemanager.apk\",                \"Gestor de Archivos USB\" },\n                { \"Downloader_2.0.4.apk\",           \"Downloader Android TV\" }\n            };\n\n            for (int i = 0; i < coreApks.GetLength(0); i++)\n            {\n                string apkPath = Path.Combine(APKS_DIR, coreApks[i, 0]);\n                if (File.Exists(apkPath))\n                {\n                    WriteColor(\"  -> Instalando \" + coreApks[i, 1] + \"...\", ConsoleColor.Gray);\n                    InvokeAdbInteractive(\"install -r -g \\\"\" + apkPath + \"\\\"\");\n                }\n            }\n\n            WriteColor(\"[4/7] Neutralizando Pantalla Azul Megacable, Core (oom_adj=-14), OTA y candado QR (com.zte.adb)...\", ConsoleColor.Cyan);\n            string[] bloatPackages = new string[]\n            {\n                \"com.dotscreen.megacable.portal\",\n                \"com.dotscreen.megacable.core\",\n                \"com.dotscreen.megacable.atv\",\n                \"com.expway.ewm.service\",\n                \"com.zte.adb\",\n                \"com.ztestb.LauncherCustomize\",\n                \"com.zte.ums.oes\",\n                \"com.zte.ota\",\n                \"tv.upgrade.service\",\n                \"com.zte.tv.act\",\n                \"com.ztestb.uploaddiagno\",\n                \"com.zte.factorytesttool\",\n                \"com.hmdm.launcher\"\n            };\n\n            foreach (string pkg in bloatPackages)\n            {\n                WriteColor(\"  -> Neutralizando \" + pkg + \" ...\", ConsoleColor.Gray);\n                InvokeAdbSafe(\"shell \\\"cmd appops set \" + pkg + \" RUN_IN_BACKGROUND ignore; cmd appops set \" + pkg + \" RUN_ANY_IN_BACKGROUND ignore; am force-stop \" + pkg + \"; pm disable-user --user 0 \" + pkg + \"; pm uninstall -k --user 0 \" + pkg + \"\\\"\");\n            }\n\n            WriteColor(\"[5/7] Configurando el nuevo Launcher como HOME predeterminado y activando Button Mapper...\", ConsoleColor.Cyan);\n            InvokeAdbSafe(\"shell \\\"cmd package set-home-activity dev.dworks.apps.alauncher/.Launcher\\\"\");\n            InvokeAdbSafe(\"shell \\\"settings put secure enabled_accessibility_services flar2.homebutton/flar2.homebutton.ButtonMapperService\\\"\");\n            InvokeAdbSafe(\"shell \\\"settings put secure accessibility_enabled 1\\\"\");\n            InvokeAdbSafe(\"shell \\\"am start -a android.intent.action.MAIN -c android.intent.category.HOME\\\"\");\n\n            WriteColor(\"[6/7] Eliminando banner 'No se pudo instalar la actualizacion del sistema'...\", ConsoleColor.Cyan);\n            InvokeAdbSafe(\"shell \\\"settings put global ota_disable_automatic_update 1\\\"\");\n            InvokeAdbSafe(\"shell \\\"cmd notification snooze --for 315360000000 '0|com.google.android.gms|1|com.google.android.gms.update.control.NotificationControl|10049'\\\"\");\n            InvokeAdbSafe(\"shell \\\"cmd appops set com.google.android.gms POST_NOTIFICATION ignore\\\"\");\n\n            WriteColor(\"[7/7] Activando Modo Stealth (Ocultar flags ADB manteniendo puerto 5555 activo)...\", ConsoleColor.Cyan);\n            InvokeAdbSafe(\"shell \\\"settings put global adb_enabled 0; settings put secure adb_enabled 0; settings put global development_settings_enabled 0; settings put secure development_settings_enabled 0\\\"\");\n            InvokeAdbSafe(\"shell \\\"setprop service.adb.tcp.port 5555; setprop ctl.start adbd\\\"\");\n\n            Console.WriteLine();\n            WriteColor(\"================================================================================\", ConsoleColor.Green);\n            WriteColor(\" [LISTO!] Caja liberada con exito (Candado QR y Pantalla Azul eliminados).      \", ConsoleColor.Green);\n            WriteColor(\"================================================================================\", ConsoleColor.Green);\n            LogEvent(\"ADB_PAYLOAD\", \"ExecuteAdbPayload() finalizado con exito.\");\n        }\n\n        static void InvokeQuickUnlockPartitionsFlash()\n        {\n            Console.WriteLine();\n            WriteColor(\"[+] Inyectando vbmeta desbloqueado (flags=0x03), recovery desbloqueado y cache_ext4...\", ConsoleColor.Cyan);\n            string[,] parts = new string[,]\n            {\n                { \"vbmeta\",   Path.Combine(FW_DIR, \"vbmeta.img\") },\n                { \"recovery\", Path.Combine(FW_DIR, \"recovery.img\") },\n                { \"cache\",    Path.Combine(FW_DIR, \"cache_ext4.img\") }\n            };\n\n            int okCount = 0;\n            int total = parts.GetLength(0);\n            for (int i = 0; i < total; i++)\n            {\n                string pName = parts[i, 0];\n                string pFile = parts[i, 1];\n                if (File.Exists(pFile))\n                {\n                    WriteColor(\"  -> Flasheando '\" + pName + \"' (\" + Path.GetFileName(pFile) + \")...\", ConsoleColor.White);\n                    ToolResult res = InvokeFastbootSafe(\"flash \" + pName + \" \\\"\" + pFile + \"\\\"\", 35000);\n                    InvokeFastbootSafe(\"getvar version-bootloader\", 1200, false);\n                    if (!res.TimedOut && res.ExitCode == 0 &&\n                        res.Output.IndexOf(\"FAILED\", StringComparison.OrdinalIgnoreCase) < 0 &&\n                        res.Output.IndexOf(\"locked device\", StringComparison.OrdinalIgnoreCase) < 0)\n                    {\n                        WriteColor(\"     [OKAY] Particion '\" + pName + \"' escrita correctamente.\", ConsoleColor.Green);\n                        okCount++;\n                    }\n                    else\n                    {\n                        WriteColor(\"     [AVISO] Respuesta en '\" + pName + \"': \" + res.Output.Replace(\"\\r\", \" \").Replace(\"\\n\", \" | \"), ConsoleColor.Yellow);\n                    }\n                }\n            }\n\n            if (okCount == total)\n            {\n                Console.WriteLine();\n                WriteColor(\"[EXITO] Las 3 particiones clave se inyectaron correctamente. Reiniciando caja...\", ConsoleColor.Green);\n                InvokeFastbootSafe(\"reboot\", 3000);\n            }\n            else\n            {\n                Console.WriteLine();\n                WriteColor(\"[!] El bootloader sigue con lock=10001000 (bloqueado). La caja se mantiene en Fastboot\", ConsoleColor.Yellow);\n                WriteColor(\"    para que NO pierdas la conexion y puedas desbloquear 'env' por Modo WorldCup.\", ConsoleColor.Yellow);\n            }\n        }\n\n        static bool StartDedicatedWorldCupHuntFromLockedFastboot()\n        {\n            LogEvent(\"FASTBOOT_LOCKED_ASSIST\", \"Entrando en StartDedicatedWorldCupHuntFromLockedFastboot (lock=10001000).\");\n            Console.WriteLine();\n            WriteColor(\"================================================================================\", ConsoleColor.Yellow);\n            WriteColor(\"  DESBLOQUEO AUTOMATICO DE 'locked device' (lock=10001000 -> lock=10100000)     \", ConsoleColor.Yellow);\n            WriteColor(\"================================================================================\", ConsoleColor.Yellow);\n            WriteColor(\"  Por que salio 'FAILED (remote: locked device)':\", ConsoleColor.White);\n            WriteColor(\"  * Tu caja (U-Boot Sep 05 2023) tiene lock=10001000 en la particion 'env'.\", ConsoleColor.Gray);\n            WriteColor(\"  * Con la memoria USB KINGSTON puesta, al presionar RESET la caja salta la\", ConsoleColor.Gray);\n            WriteColor(\"    ventana de 1.5s de Amlogic WorldCup (InUsbBurn) y entra directo a Recovery.\", ConsoleColor.Gray);\n            Console.WriteLine();\n            WriteColor(\"  COMO DESBLOQUEARLA EN 5 SEGUNDOS AHORA MISMO (SIN ABRIR TORNILLOS):\", ConsoleColor.Green);\n            WriteColor(\"  1. Desconecta temporalmente la memoria USB KINGSTON de la caja (deja SOLO el\", ConsoleColor.Cyan);\n            WriteColor(\"     cable USB Macho-a-Macho conectado entre la caja y la PC).\", ConsoleColor.Cyan);\n            WriteColor(\"  2. Manten presionado el boton fisico RESET (con el clip) en la caja.\", ConsoleColor.Cyan);\n            WriteColor(\"  3. Sin soltar RESET, presiona [1] aqui abajo (el programa reiniciara la caja\", ConsoleColor.Cyan);\n            WriteColor(\"     y cazara el modo WorldCup InUsbBurn en 48ms para inyectar env_unlocked.img)\", ConsoleColor.Cyan);\n            WriteColor(\"     O bien desconecta y reconecta el cable de corriente manteniendo RESET.\", ConsoleColor.Cyan);\n            WriteColor(\"--------------------------------------------------------------------------------\", ConsoleColor.DarkCyan);\n            WriteColor(\"  [1] Ya tengo presionado RESET -> Reiniciar caja y cazar WorldCup (48ms) AHORA\", ConsoleColor.Green);\n            WriteColor(\"  [2] Volver al menu principal (manteniendo la caja en Fastboot)\", ConsoleColor.Gray);\n            Console.WriteLine();\n\n            string sel = ReadChoiceWithKeepAlive(\"Elige 1 o 2\", new[] { \"1\", \"2\" });\n            if (sel == \"2\") return false;\n\n            Console.WriteLine();\n            WriteColor(\"[*] Enviando 'fastboot reboot' y activando Caza Ultrarrapida WorldCup (cada 48ms)...\", ConsoleColor.Green);\n            WriteColor(\"    (Manten presionado el boton RESET en la caja durante 6 segundos!)\", ConsoleColor.Yellow);\n            InvokeFastbootSafe(\"reboot\", 2500);\n\n            Stopwatch swHunt = Stopwatch.StartNew();\n            while (swHunt.Elapsed.TotalSeconds < 40)\n            {\n                if (TryCatchWorldCup48ms())\n                {\n                    return true;\n                }\n                Thread.Sleep(20);\n            }\n\n            Console.WriteLine();\n            WriteColor(\"[!] No se detecto la senal WorldCup (VID_1B8E) en estos 40 segundos.\", ConsoleColor.Yellow);\n            WriteColor(\"    Asegurate de haber retirado 