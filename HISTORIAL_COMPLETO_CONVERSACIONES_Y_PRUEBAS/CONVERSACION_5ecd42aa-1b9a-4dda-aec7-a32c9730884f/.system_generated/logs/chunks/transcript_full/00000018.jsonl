niendo Watchdog y ejecutando secuencia de desbloqueo limpia...\", ConsoleColor.Cyan);\n\n                                InvokeFastbootSafe(\"flashing get_unlock_ability\", 1500, true);\n                                InvokeFastbootSafe(\"flashing unlock_critical\", 1500, true);\n                                InvokeFastbootSafe(\"flashing unlock\", 1500, true);\n                                InvokeFastbootSafe(\"oem \\\"watchdog off\\\"\", 1200, true);\n                                InvokeFastbootSafe(\"oem \\\"setenv lock 10100000;save\\\"\", 1200, true);\n                                InvokeFastbootSafe(\"oem \\\"setenv otg_device 1;save\\\"\", 1200, true);\n                                InvokeFastbootSafe(\"oem \\\"saveenv\\\"\", 1200, true);\n\n                                ToolResult unlRes = InvokeFastbootSafe(\"getvar unlocked\", 1500, true);\n                                bool isUnlocked = Regex.IsMatch(unlRes.Output, @\"unlocked:\\s*yes\", RegexOptions.IgnoreCase);\n\n                                if (!isUnlocked)\n                                {\n                                    string dtbPath = Path.Combine(FW_DIR, \"dtb.img\");\n                                    if (File.Exists(dtbPath))\n                                    {\n                                        ToolResult testWrite = InvokeFastbootSafe(\"flash _aml_dtb \\\"\" + dtbPath + \"\\\"\", 2500, true);\n                                        if (!testWrite.TimedOut && testWrite.ExitCode == 0 &&\n                                            testWrite.Output.IndexOf(\"OKAY\", StringComparison.OrdinalIgnoreCase) >= 0 &&\n                                            testWrite.Output.IndexOf(\"FAILED\", StringComparison.OrdinalIgnoreCase) < 0 &&\n                                            testWrite.Output.IndexOf(\"locked device\", StringComparison.OrdinalIgnoreCase) < 0)\n                                        {\n                                            isUnlocked = true;\n                                        }\n                                    }\n                                }\n\n                                if (isUnlocked)\n                                {\n                                    LogEvent(\"FASTBOOT_UNLOCKED\", \"Bootloader verificado como DESBLOQUEADO (isUnlocked=true).\");\n                                    Console.WriteLine();\n                                    WriteColor(\"================================================================================\", ConsoleColor.Green);\n                                    WriteColor(\" [OK] BOOTLOADER 100% DESBLOQUEADO (unlocked: yes) Y WATCHDOG RETENIDO          \", ConsoleColor.Green);\n                                    WriteColor(\"================================================================================\", ConsoleColor.Green);\n                                    WriteColor(\"  [1] Flashear ahora mismo Android 12 Liberado Completo (Conservando Widevine L1 y MAC)\", ConsoleColor.Magenta);\n                                    WriteColor(\"  [2] Inyectar vbmeta desbloqueado + recovery desbloqueado + cache_ext4 y reiniciar\", ConsoleColor.Cyan);\n                                    WriteColor(\"  [3] Dejar en Fastboot y volver al menu\", ConsoleColor.Gray);\n                                    Console.WriteLine();\n\n                                    string next = ReadChoiceWithKeepAlive(\"Elige 1, 2 o 3\", new[] { \"1\", \"2\", \"3\" });\n                                    if (next == \"1\")\n                                    {\n                                        InvokeSafeAndroid12Flash(true);\n                                    }\n                                    else if (next == \"2\")\n                                    {\n                                        InvokeQuickUnlockPartitionsFlash();\n                                    }\n                                    break;\n                                }\n          