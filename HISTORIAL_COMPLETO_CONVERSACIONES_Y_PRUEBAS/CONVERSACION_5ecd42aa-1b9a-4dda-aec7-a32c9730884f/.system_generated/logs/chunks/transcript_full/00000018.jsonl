ESCUCHANDO EN VIVO... (Presiona ESC para volver al menu)\", ConsoleColor.Green);\n\n            int tick = 0;\n            DateTime lastRebootToBl = DateTime.MinValue;\n\n            while (true)\n            {\n                if (Console.KeyAvailable)\n                {\n                    var k = Console.ReadKey(true);\n                    if (k.Key == ConsoleKey.Escape)\n                    {\n                        LogEvent(\"OPCION_1\", \"Usuario salio del radar con ESC.\");\n                        return;\n                    }\n                }\n\n                tick++;\n\n                // 1. Caza directa WorldCup cada 48ms\n                if (TryCatchWorldCup48ms())\n                {\n                    lastRebootToBl = DateTime.Now;\n                    continue;\n                }\n\n                if ((DateTime.Now - lastRebootToBl).TotalSeconds < 3.2)\n                {\n                    Thread.Sleep(50);\n                    continue;\n                }\n\n                // 2. Cada 6 ticks (~300ms), verificar Fastboot y ADB\n                if ((tick % 6) == 0)\n                {\n                    ToolResult fbDevs = InvokeFastbootSafe(\"devices\", 1200, false);\n                    if (!fbDevs.TimedOut)\n                    {\n                        Match mFb = Regex.Match(fbDevs.Output, @\"(?m)^(\\S+)\\s+fastboot\");\n                        if (mFb.Success)\n                        {\n                            string fbSn = mFb.Groups[1].Value;\n                            ToolResult ping = InvokeFastbootSafe(\"getvar version-bootloader\", 900, false);\n                            if (!ping.TimedOut && (\n                                ping.Output.IndexOf(\"version-bootloader\", StringComparison.OrdinalIgnoreCase) >= 0 ||\n                                ping.Output.IndexOf(\"OKAY\", StringComparison.OrdinalIgnoreCase) >= 0 ||\n                                ping.Output.IndexOf(\"Finished\", StringComparison.OrdinalIgnoreCase)