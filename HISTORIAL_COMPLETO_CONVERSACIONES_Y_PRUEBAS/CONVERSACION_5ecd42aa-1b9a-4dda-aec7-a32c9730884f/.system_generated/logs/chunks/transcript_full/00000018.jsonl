     }\n\n                Thread.Sleep(20);\n            }\n\n            WriteColor(\"\\nPresiona ENTER para volver al menu: \", ConsoleColor.Gray, false);\n            Console.ReadLine();\n        }\n\n        static void InvokeSafeAndroid12Flash(bool alreadyInFastboot)\n        {\n            LogEvent(\"OPCION_2\", \"Iniciando InvokeSafeAndroid12Flash (alreadyInFastboot=\" + alreadyInFastboot + \")\");\n            Console.WriteLine();\n            WriteColor(\"================================================================================\", ConsoleColor.Magenta);\n            WriteColor(\"   OPCION 2: FLASHEO SEGURO ANDROID 12 (B866V2) SIN PERDER WIDEVINE L1 / MAC   \", ConsoleColor.Magenta);\n            WriteColor(\"================================================================================\", ConsoleColor.Magenta);\n            WriteColor(\"  * Salta por completo el bloqueo de Megacable y el candado QR RSA-2048 de ZTE.\", ConsoleColor.Green);\n            WriteColor(\"  * Protege 100% tus particiones 'factory' (Widevine L1) y 'cri_data' (MAC/Serie).\", ConsoleColor.Green);\n            WriteColor(\"  * Repara la particion /cache con 'cache_ext4.img' e instala Recovery desbloqueado.\", ConsoleColor.Green);\n            Console.WriteLine();\n\n            string superPath = Path.Combine(FW_DIR, \"super.img\");\n            if (!File.Exists(superPath))\n            {\n                string[] candidates = new string[]\n                {\n                    @\"D:\\B866v2 Android 12\\B866v2 Android 12\\B866V2\\super.img\",\n                    @\"E:\\B866v2 Android 12\\B866v2 Android 12\\B866V2\\super.img\",\n                    @\"F:\\B866v2 Android 12\\B866v2 Android 12\\B866V2\\super.img\",\n                    @\"C:\\Users\\andre\\OneDrive\\Desktop\\xview\\V2\\B866v2 Android 12\\B866v2 Android 12\\B866V2\\super.img\",\n                    @\"C:\\Users\\andre\\OneDrive\\Desktop\\xview\\FIRMWARE_COMPLETO_B866V2_FASTBOOT\\super.img\"\n                };\n