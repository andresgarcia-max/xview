35000, true);\n\n            WriteColor(\"[11/12] Reparando particion /cache con cache_ext4.img...\", ConsoleColor.Cyan);\n            InvokeFastbootSafe(\"erase cache\", 10000, true);\n            InvokeFastbootSafe(\"flash cache \\\"\" + Path.Combine(FW_DIR, \"cache_ext4.img\") + \"\\\"\", 35000, true);\n\n            WriteColor(\"[12/12] Limpiando userdata y reiniciando...\", ConsoleColor.Cyan);\n            InvokeFastbootSafe(\"erase userdata\", 15000, true);\n            InvokeFastbootSafe(\"reboot\", 4000, true);\n\n            Console.WriteLine();\n            WriteColor(\"[COMPLETADO!] Proceso finalizado (con Widevine L1 y MAC intactos).\", ConsoleColor.Green);\n            WriteColor(\"\\nPresiona ENTER para volver al menu: \", ConsoleColor.Gray, false);\n            Console.ReadLine();\n        }\n\n        static void InvokeAppInstallerMenu()\n        {\n            Console.WriteLine();\n            WriteColor(\"=== OPCION 3: INSTALADOR DE APPS DE TV Y ENTRETENIMIENTO (OFFLINE DESDE PC) ===\", ConsoleColor.Yellow);\n            if (!Directory.Exists(APKS_DIR))\n            {\n                WriteColor(\"[!] No se encontro el directorio de APKs.\", ConsoleColor.Red);\n                return;\n            }\n            FileInfo[] apks = new DirectoryInfo(APKS_DIR).GetFiles(\"*.apk\");\n            for (int i = 0; i < apks.Length; i++)\n            {\n                double sizeMB = Math.Round(apks[i].Length / (1024.0 * 1024.0), 2);\n                WriteColor(string.Format(\"  [{0}] {1} ({2} MB)\", i + 1, apks[i].Name, sizeMB), ConsoleColor.White, true, false);\n            }\n            WriteColor(\"  [T] INSTALAR TODAS LAS APPS DE LA LISTA\", ConsoleColor.Green, true, false);\n            WriteColor(\"  [0] Volver al menu principal\", ConsoleColor.Gray, true, false);\n            Console.WriteLine();\n            WriteColor(\"Elige el numero de la app a instalar (o 'T' para todas): \", ConsoleColor.Yellow, false);\n            string sel = (Console.ReadLine() ?? \"\").Trim();\n            if (sel == \"0\" || string.IsNullOrEmpty(sel)) return;\n\n            if (sel.Equals(\"T\", StringComparison.OrdinalIgnoreCase))\n            {\n                foreach (FileInfo a in apks)\n                {\n                    WriteColor(\"[+] Instalando \" + a.Name + \"...\", ConsoleColor.Cyan);\n                    InvokeAdbInteractive(\"install -r -g \\\"\" + a.FullName + \"\\\"\");\n                }\n            }\n            else\n            {\n                int idx;\n                if (int.TryParse(sel, out idx))\n                {\n                    idx -= 1;\n                    if (idx >= 0 && idx < apks.Length)\n                    {\n                        WriteColor(\"[+] Instalando \" + apks[idx].Name + \"...\", ConsoleColor.Cyan);\n                        InvokeAdbInteractive(\"install -r -g \\\"\" + apks[idx].FullName + \"\\\"\");\n                    }\n                }\n            }\n            WriteColor(\"\\nPresiona ENTER para volver al menu: \", ConsoleColor.Gray, false);\n            Console.ReadLine();\n        }\n\n        static void InvokeAmlogicWorldCupEngine()\n        {\n            Console.WriteLine();\n            WriteColor(\"================================================================================\", ConsoleColor.Cyan);\n            WriteColor(\"   OPCION 4: MOTOR AMLOGIC DNL / WORLDCUP (adnl.exe + update.exe VID_1B8E)      \", ConsoleColor.Cyan);\n            WriteColor(\"================================================================================\", ConsoleColor.Cyan);\n            WriteColor(\"  [1] Activar Caza Continua WorldCup (48ms) -> Desbloquear env_unlocked.img y saltar a Fastboot\", ConsoleColor.Green);\n            WriteColor(\"  [2] Escanear dispositivo en modo WorldCup / ADNL ahora mismo\", ConsoleColor.White);\n            WriteColor(\"  [3] Reiniciar caja desde modo ADNL / WorldCup\", ConsoleColor.White);\n            WriteColor(\"  [0] Volver al menu principal\", ConsoleColor.Gray);\n            Console.WriteLine();\n            WriteColor(\"Elige una opcion: \", ConsoleColor.Yellow, false);\n            string sub = (Console.ReadLine() ?? \"\").Trim();\n\n            if (sub == \"1\")\n            {\n                WriteColor(\"\\n[*] Escuchando modo WorldCup / InUsbBurn cada 48ms (Manten RESET al conectar corriente)... (ESC para salir)\", ConsoleColor.Green);\n                while (true)\n                {\n                    if (Console.KeyAvailable && Console.ReadKey(true).Key == ConsoleKey.Escape) break;\n                    if (TryCatchWorldCup48ms())\n                    {\n                        WriteColor(\"[OK] Caja desbloqueada y enviada a Fastboot (PID_0D02)!\", ConsoleColor.Green);\n                        break;\n                    }\n                    Thread.Sleep(25);\n                }\n            }\n            else if (sub == \"2\")\n            {\n                WriteColor(\"\\n--- Escaneo con adnl.exe ---\", ConsoleColor.Cyan);\n                InvokeToolInteractive(ADNL_EXE, \"devices\");\n                WriteColor(\"\\n--- Escaneo con update.exe ---\", ConsoleColor.Cyan);\n                InvokeToolInteractive(UPDATE_EXE, \"identify 7\");\n            }\n            else if (sub == \"3\")\n            {\n                InvokeToolSafe(ADNL_EXE, \"reboot\", 3000, true);\n                InvokeUpdateSafe(\"bulkcmd \\\"reset\\\"\", 3000, true);\n            }\n            WriteColor(\"\\nPresiona ENTER para volver al menu: \", ConsoleColor.Gray, false);\n            Console.ReadLine();\n        }\n\n        static void InvokeUsbPrepAndLogDecrypt()\n        {\n            Console.WriteLine();\n            WriteColor(\"================================================================================\", ConsoleColor.Yellow);\n            WriteColor(\"   OPCION 5: PREPARAR MEMORIA USB (QADEBUG + APKS) Y DESCIFRAR LOGS ZTE         \", ConsoleColor.Yellow);\n            WriteColor(\"================================================================================\", ConsoleColor.Yellow);\n\n            try\n            {\n                var drives = DriveInfo.GetDrives().Where(d => d.DriveType == DriveType.Removable && d.IsReady).ToList();\n                if (drives.Count > 0)\n                {\n                    WriteColor(\"Memorias USB detectadas:\", ConsoleColor.Cyan);\n                    foreach (var d in drives)\n                    {\n                        WriteColor(string.Format(\"  * Unidad {0} ({1} - {2})\", d.Name, d.VolumeLabel, d.DriveFormat), ConsoleColor.Green);\n                    }\n                }\n            }\n            catch { }\n\n            Console.WriteLine();\n            WriteColor(\"  [1] Copiar llaves QADEBUG.ini + factory_update_param.aml + Launchers a una memoria USB\", ConsoleColor.White);\n            WriteColor(\"  [2] Descifrar logs ocultos de la caja (LOG_ZTESTB_OFF\\\\U_*) y mostrar Serie/MAC/Firmware\", ConsoleColor.Green);\n            WriteColor(\"  [0] Volver al menu principal\", ConsoleColor.Gray);\n            Console.WriteLine();\n            WriteColor(\"Elige una opcion: \", ConsoleColor.Yellow, false);\n            string op = (Console.ReadLine() ?? \"\").Trim();\n\n            if (op == \"1\")\n            {\n                WriteColor(\"Escribe la letra de tu memoria USB (ej. D): \", ConsoleColor.Yellow, false);\n                string drv = (Console.ReadLine() ?? \"\").Replace(\":\", \"\").Replace(\"\\\\\", \"\").Trim();\n                string targetUsb = drv + \":\\\\\";\n                if (Directory.Exists(targetUsb))\n                {\n                    foreach (string f in Directory.GetFiles(KEYS_DIR))\n                    {\n                        File.Copy(f, Path.Combine(targetUsb, Path.GetFileName(f)), true);\n                    }\n                    string[] launcherApks = new[]\n                    {\n                        \"Home_Screen_Launcher_1.1.3.apk\",\n                        \"TVLauncher_4_GoogleTV.apk\",\n                        \"Button_Mapper_Pro_2.54.apk\",\n                        \"Filemanager.apk\",\n                        \"autostart.apk\"\n                    };\n                    foreach (string apk in launcherApks)\n                    {\n                        string src = Path.Combine(APKS_DIR, apk);\n                        if (File.Exists(src)) File.Copy(src, Path.Combine(targetUsb, apk), true);\n                    }\n                    WriteColor(\"[OK] Llaves QADEBUG.ini, factory_update_param.aml y Launchers copiados a \" + targetUsb, ConsoleColor.Green);\n                }\n                else\n                {\n                    WriteColor(\"[!] No existe la unidad \" + targetUsb, ConsoleColor.Red);\n                }\n            }\n            else if (op == \"2\")\n            {\n                WriteColor(\"Escribe la letra de la memoria USB donde estan los logs (ej. D): \", ConsoleColor.Yellow, false);\n                string drv = (Console.ReadLine() ?? \"\").Replace(\":\", \"\").Replace(\"\\\\\", \"\").Trim();\n                string logFolder = drv + \":\\\\LOG_ZTESTB_OFF\";\n                if (Directory.Exists(logFolder))\n                {\n                    string encStr = \"5;8|\\\"79+3(&16-409876543210/.-,+*)('&%$#\\\"! ~}|{zyxwvutsrqponmlkjihgfedcba`_^]\\\\[ZYXWVUTSRQPONMLKJIHGFEDCBA@?>=<;:9876543210/.-,+*)('&%$#\\\"! \";\n                    string decStr = \" ~}|{zyxwvutsrqponmlkjihgfedcba`_^]\\\\[ZYXWVUTSRQPONMLKJIHGFEDCBA@?>=<;:9876543210/.-,+*)('&%$#\\\"! 5;8|\\\"79+3(&16-409876543210/.-,+*)('&%$#\\\"!\";\n                    byte[] lut = new byte[256];\n                    for (int i = 0; i < 256; i++) lut[i] = (byte)i;\n                    for (int i = 0; i < encStr.Length; i++)\n                    {\n                        byte e = (byte)encStr[i];\n                        byte d = (byte)decStr[i];\n                        if (lut[e] == e) lut[e] = d;\n                    }\n\n                    string outDir = Path.Combine(ROOT_DIR, \"LOGS_DESCIFRADOS_CAJA\");\n                    Directory.CreateDirectory(outDir);\n                    foreach (string f in Directory.GetFiles(logFolder, \"U_*\"))\n                    {\n                        string fName = Path.GetFileName(f);\n                        WriteColor(\"[+] Descifrando \" + fName + \"...\", ConsoleColor.Cyan);\n                        byte[] raw = File.ReadAllBytes(f);\n                        byte[] outBytes = new byte[raw.Length];\n                        for (int i = 0; i < raw.Length; i++) outBytes[i] = lut[raw[i]];\n                        string destFile = Path.Combine(outDir, fName + \"_DEC.log\");\n                        File.WriteAllBytes(destFile, outBytes);\n                        WriteColor(\"  -> Guardado en: \" + destFile, ConsoleColor.Green);\n                    }\n                }\n                else\n                {\n                    WriteColor(\"[!] No se encontro la carpeta \" + logFolder, ConsoleColor.Red);\n                }\n            }\n            WriteColor(\"\\nPresiona ENTER para volver al menu: \", ConsoleColor.Gray, false);\n            Console.ReadLine();\n        }\n\n        static void InvokeDriversAndGuiMenu()\n        {\n            Console.WriteLine();\n            WriteColor(\"=== OPCION 6: INSTALAR DRIVERS USB Y ABRIR ADB APPCONTROL GUI ===\", ConsoleColor.Yellow);\n            WriteColor(\"  [1] Abrir instalador de ADB AppControl 1.8.6 (Interfaz grafica para Windows)\", ConsoleColor.White);\n            WriteColor(\"  [2] Instalar Driver Oficial Amlogic WorldCup (VID_1B8E)\", ConsoleColor.White);\n            WriteColor(\"  [0] Volver al menu principal\", ConsoleColor.Gray);\n            Console.WriteLine();\n            WriteColor(\"Elige una opcion: \", ConsoleColor.Yellow, false);\n            string c = (Console.ReadLine() ?? \"\").Trim();\n            if (c == \"1\")\n            {\n                string exe = Path.Combine(DRV_DIR, \"ADBAppControl-1.8.6-setup.exe\");\n                if (File.Exists(exe)) Process.Start(exe);\n            }\n            else if (c == \"2\")\n            {\n                string exe = Path.Combine(DRV_DIR, @\"WorldCup_Driver_VID_1B8E\\InstallDriver.exe\");\n                if (File.Exists(exe))\n                {\n                    ProcessStartInfo psi = new ProcessStartInfo(exe) { Verb = \"runas\", UseShellExecute = true };\n                    try { Process.Start(psi); } catch { }\n                }\n            }\n        }\n\n        static void ConnectAdbTarget()\n        {\n            Console.WriteLine();\n            WriteColor(\"=== CONECTAR CAJA POR RED LOCAL (WI-FI / ETHERNET) O REFRESCAR USB ===\", ConsoleColor.Yellow);\n            WriteColor(\"Escribe la IP de la caja (ej. 192.168.0.47) o presiona ENTER para refrescar USB: \", ConsoleColor.White, false);\n            string ip = (Console.ReadLine() ?? \"\").Trim();\n            if (!string.IsNullOrEmpty(ip))\n            {\n                if (!ip.Contains(\":\")) ip = ip + \":5555\";\n                WriteColor(\"[+] Conectando por ADB a \" + ip + \" ...\", ConsoleColor.Cyan);\n                InvokeToolInteractive(ADB_EXE, \"connect \" + ip);\n                CONNECTED_IP = ip;\n            }\n            else\n            {\n                CONNECTED_IP = \"\";\n                InvokeToolInteractive(ADB_EXE, \"devices\");\n            }\n            WriteColor(\"\\nPresiona ENTER para volver al menu: \", ConsoleColor.Gray, false);\n            Console.ReadLine();\n        }\n    }\n}\n","Overwrite":true,"Path":"c:\\Users\\andre\\OneDrive\\Desktop\\xview\\programa perfecto\\1_HERRAMIENTAS_MOTOR\\ProgramaPerfecto.cs"}}]}
