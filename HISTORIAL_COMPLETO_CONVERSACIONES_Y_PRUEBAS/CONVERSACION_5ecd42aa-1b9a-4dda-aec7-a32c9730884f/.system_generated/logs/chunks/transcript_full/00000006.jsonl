echo   1  - Scan Device\r\necho   2  - Disk Initial\r\necho   3  - Flash ROM Slot A  \r\necho   4  - Flash ROM Slot B\r\necho   5  - Reboot\r\necho   6  - Exit\r\necho.\r\nset /p main=Please Enter Your Choice: \r\nif %main% == 1 goto Scan Device\r\nif %main% == 2 goto Disk\r\nif %main% == 3 goto B866FA\r\nif %main% == 4 goto B866FB\r\nif %main% == 5 goto System\r\nif %main% == 6 goto exit\r\necho Please select [1..6]\r\ntimeout 2 >nul\r\ncls\r\ngoto main\r\n:Scan Device\r\nadnl devices\r\necho.\r\npause\r\ncls\r\ngoto main\r\n:Disk Initial\r\nadnl oem disk_initial\r\necho.\r\npause\r\ncls\r\ngoto main\r\n:B866FA\r\nadnl partition -p super -f .\\B866FA\\super_a.img\r\nadnl partition -p vendor_boot_a -f .\\B866FA\\vendor_boot.img\r\nadnl partition -p odm_ext_a -f .\\B866FA\\odm_ext.img\r\nadnl partition -p boot_a -f .\\B866FA\\boot.img\r\nadnl partition -p vbmeta_a -f .\\B866FA\\vbmeta.img\r\nadnl partition -p vbmeta_system_a -f .\\B866FA\\vbmeta_system.img\r\necho.\r\npause\r\ncls\r\ngoto main\r\n:B866FB\r\nadnl partition -p super -f .\\B866FB\\super_b.img\r\nadnl partition -p vendor_boot_b -f .\\B866FA\\vendor_boot.img\r\nadnl partition -p odm_ext_b -f .\\B866FB\\odm_ext.img\r\nadnl partition -p boot_b -f .\\B866FB\\boot.img\r\nadnl partition -p vbmeta_b -f .\\B866FB\\vbmeta.img\r\nadnl partition -p vbmeta_system_b -f .\\B866FB\\vbmeta_system.img\r\necho.\r\npause\r\ncls\r\ngoto main\r\n:system\r\nadnl reboot\r\necho.\r\npause\r\ncls\r\ngoto main\r\n:exit\r\nadnl exit\r\n"}
