{"step_index":790,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-05T04:14:27Z","content":"Created At: 2026-11-04T22:14:27-06:00\nCompleted At: 2026-11-04T22:14:27-06:00\nShowing lines 1-66 of 66\n1: # ==============================================================================\n2: # AUTO_ACCESO_TOTAL_XVIEW.ps1\n3: # Monitoreo pasivo (sin tocar endpoints WinUSB para no bloquear WUDFHost/MTP).\n4: # 1. Si detecta COM8 (UART), envia comandos para habilitar MTP + ADB de inmediato.\n5: # 2. Si detecta reconexion de USB\\VID_18D1&PID_4EE*, abre Este equipo > Xview+\n6: #    y si ADB esta activo (PID_4EE2 / PID_4EE7), conecta por ADB y lista todo.\n7: # ==============================================================================\n8: \n9: $ErrorActionPreference = \"SilentlyContinue\"\n10: $adbExe = \"c:\\Users\\andre\\OneDrive\\Desktop\\xview\\experimento\\06_internet_y_repositorios\\adb_tools\\platform-tools\\adb.exe\"\n11: $seenUsb = $false\n12: $seenCom8 = $false\n13: \n14: Write-Output \"[$(Get-Date -Format 'HH:mm:ss')] Esperando reconexion de cable USB Macho-Macho o UART COM8...\"\n15: \n16: for ($i = 0; $i -lt 1200; $i++) {\n17:     # 1. Revisar si conectaron COM8 (UART)\n18:     $ports = [System.IO.Ports.SerialPort]::GetPortNames()\n19:     if ($ports -contains \"COM8\" -and -not $seenCom8) {\n20:         $seenCom8 = $true\n21:         Write-Output \"[$(Get-Date -Format 'HH:mm:ss')] [!] COM8 detectado! Activando MTP + ADB desde consola UART...\"\n22:         try {\n23:             $sp = New-Object System.IO.Ports.SerialPort(\"COM8\", 115200, \"None\", 8, \"One\")\n24:             $sp.ReadTimeout = 1000\n25:             $sp.WriteTimeout = 1000\n26:             $sp.Open()\n27:             $sp.Write(\"`r`n\")\n28:             Start-Sleep -Milliseconds 300\n29:             # Enviar comandos para habilitar transferencia de archivos MTP y ADB en Android / Recovery\n30:             $sp.Write(\"setprop persist.sys.usb.config mtp,adb`r`n\")\n31:             Start-Sleep -Milliseconds 200\n32:             $sp.Write(\"setprop sys.usb.config mtp,adb`r`n\")\n33:             Start-Sleep -Milliseconds 200\n34:             $sp.Write(\"svc usb setFunctions mtp`r`n\")\n35:             Start-Sleep -Milliseconds 500\n36:             $out = $sp.ReadExisting()\n37:             Write-Output \"[COM8 Respuesta]: $out\"\n38:             $sp.Close()\n39:         } catch {\n40:             Write-Output \"[COM8 Error]: $_\"\n41:         }\n42:     }\n43: \n44:     # 2. Revisar pasivamente PnP para Xview+ (VID_18D1)\n45:     $usb = Get-PnpDevice -PresentOnly | Where-Object { $_.InstanceId -match \"VID_18D1\" }\n46:     if ($usb -and -not $seenUsb) {\n47:         $seenUsb = $true\n48:         foreach ($d in $usb) {\n49:             Write-Output \"[$(Get-Date -Format 'HH:mm:ss')] [+] USB Conectado: $($d.FriendlyName) | $($d.InstanceId) | Class: $($d.Class)\"\n50:         }\n51:         Start-Sleep -Seconds 2\n52:         $shell = New-Object -ComObject Shell.Application\n53:         $thisPC = $shell.NameSpace(17)\n54:         $xviewItem = $thisPC.Items() | Where-Object { $_.Name -match \"Xview\" }\n55:         if ($xviewItem) {\n56:             $xviewItem.InvokeVerb(\"open\")\n57:             Write-Output \"[$(Get-Date -Format 'HH:mm:ss')] [+] Abierta ventana limpia 'Este equipo > Xview+'.\"\n58:         }\n59:         if (Test-Path $adbExe) {\n60:             $adbOut = & $adbExe devices -l 2>&1\n61:             Write-Output \"[ADB]: $adbOut\"\n62:         }\n63:         break\n64:     }\n65:     Start-Sleep -Milliseconds 500\n66: }"}
{"step_index":791,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-05T04:14:27Z","content":"Created At: 2026-11-04T22:14:27-06:00\nCompleted At: 2026-11-04T22:14:27-06:00\nShowing lines 1-36 of 36\n1: @echo off\n2: chcp 65001 >nul\n3: title Retenedor Anti-Watchdog Fastboot - ZTE B866V2 (U-Boot 2015.01-g220e992)\n4: color 0A\n5: \n6: set \"ROM_DIR=%~dp0..\\..\\V2\\B866v2 Android 12\\B866v2 Android 12\\B866V2\"\n7: cd /d \"%ROM_DIR%\"\n8: \n9: echo ================================================================================\n10: echo   RETENEDOR ANTI-WATCHDOG PARA FASTBOOT (ZTE B866V2 - U-Boot 2015.01-g220e992)\n11: echo ================================================================================\n12: echo   Evita que el temporizador Watchdog (reboot_mode:::: watchdog_reboot) reinicie\n13: echo   la placa por inactividad USB y cargue el sistema normal (ztebsp: bootcmd=bootsys).\n14: echo.\n15: echo   [PASO EN SMARTTY (Consola # de Recovery antes de reiniciar a Fastboot)]:\n16: echo     echo -n \"boot-recovery\" ^> /dev/block/misc ; sync ; reboot bootloader\n17: echo ================================================================================\n18: echo.\n19: echo [*] Esperando a que la placa entre en modo Fastboot...\n20: \n21: :WAIT_LOOP\n22: for /f \"tokens=1,2\" %%A in ('fastboot devices 2^>nul') do (\n23:     if \"%%B\"==\"fastboot\" (\n24:         echo [+] Placa detectada en Fastboot (%%A). Enviando desactivacion de Watchdog...\n25:         fastboot oem \"watchdog off\" 2>nul\n26:         goto :KEEP_ALIVE\n27:     )\n28: )\n29: goto :WAIT_LOOP\n30: \n31: :KEEP_ALIVE\n32: echo [*] Mantenimiento Anti-Watchdog activo (pulso USB cada 2s). Presiona Ctrl+C para salir.\n33: :PULSE_LOOP\n34: fastboot getvar version >nul 2>&1\n35: timeout /t 2 /nobreak >nul\n36: goto :PULSE_LOOP"}
