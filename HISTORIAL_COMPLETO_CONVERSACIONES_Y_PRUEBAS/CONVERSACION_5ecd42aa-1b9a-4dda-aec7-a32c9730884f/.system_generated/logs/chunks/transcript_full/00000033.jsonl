{"step_index":793,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-05T04:14:41Z","content":"Created At: 2026-11-04T22:14:41-06:00\nCompleted At: 2026-11-04T22:14:41-06:00\nShowing lines 1-246 of 246\n1: param(\n2:     [string]$ComPort = \"COM8\",\n3:     [int]$BaudRate = 115200,\n4:     [switch]$FlashAndroid12 = $true\n5: )\n6: \n7: $ErrorActionPreference = \"Continue\"\n8: $outDir = \"c:\\Users\\andre\\OneDrive\\Desktop\\xview\\experimento\\14_MONITOREO_EN_VIVO_SMARTTY\"\n9: $logFile = Join-Path $outDir \"CAPTURA_DIRECTA_CONTROLADOR.log\"\n10: $statusFile = Join-Path $outDir \"ESTADO_CONTROLADOR_DIRECTO.txt\"\n11: $fbDir = \"c:\\Users\\andre\\OneDrive\\Desktop\\xview\\V2\\B866v2 Android 12\\B866v2 Android 12\\B866V2\"\n12: $fbExe = Join-Path $fbDir \"fastboot.exe\"\n13: $cacheImg = \"c:\\Users\\andre\\OneDrive\\Desktop\\xview\\experimento\\11_VALIDACION_OTA_Y_FIRMWARE_ZTE\\cache_ext4.img\"\n14: \n15: function Write-Log([string]$msg) {\n16:     $ts = (Get-Date).ToString(\"yyyy-MM-dd HH:mm:ss.fff\")\n17:     $line = \"[$ts] $msg\"\n18:     Write-Host $line\n19:     Add-Content -Path $logFile -Value $line -Encoding UTF8\n20:     Set-Content -Path $statusFile -Value $line -Encoding UTF8\n21: }\n22: \n23: function Send-UartCommand([System.IO.Ports.SerialPort]$port, [string]$cmd) {\n24:     if ($null -ne $port -and $port.IsOpen) {\n25:         Write-Log \"[UART-TX -> $($port.PortName)] $cmd\"\n26:         $port.Write(\"$cmd`r`n\")\n27:     }\n28: }\n29: \n30: Write-Log \"=== INICIANDO CONTROLADOR DIRECTO ANTIGRAVITY (UART $ComPort + USB FASTBOOT) ===\"\n31: \n32: $serialPort = $null\n33: $recoveryPatched = $false\n34: $ubootUnlocked = $false\n35: $fastbootFlashed = $false\n36: $rxBuffer = \"\"\n37: \n38: while ($true) {\n39:     # 1. Abrir COM8 directamente\n40:     if ($null -eq $serialPort -or -not $serialPort.IsOpen) {\n41:         $availablePorts = [System.IO.Ports.SerialPort]::GetPortNames()\n42:         if ($availablePorts -contains $ComPort) {\n43:             try {\n44:                 $serialPort = New-Object System.IO.Ports.SerialPort($ComPort, $BaudRate, [System.IO.Ports.Parity]::None, 8, [System.IO.Ports.StopBits]::One)\n45:                 $serialPort.ReadTimeout = 100\n46:                 $serialPort.WriteTimeout = 500\n47:                 $serialPort.Open()\n48:                 Write-Log \"[+] CONECTADO DIRECTAMENTE A $ComPort ($BaudRate 8N1) - Esperando datos de la caja...\"\n49:                 $serialPort.Write(\"`r`n\")\n50:             } catch {\n51:                 Write-Log \"[!] No se pudo abrir $ComPort directamete: $($_.Exception.Message)\"\n52:             }\n53:         }\n54:     }\n55: \n56:     # 2. Leer todos los bytes entrantes por UART\n57:     if ($null -ne $serialPort -and $serialPort.IsOpen) {\n58:         try {\n59:             $incoming = $serialPort.ReadExisting()\n60:             if (-not [string]::IsNullOrEmpty($incoming)) {\n61:                 $rxBuffer += $incoming\n62:                 if ($rxBuffer.Length -gt 16384) {\n63:                     $rxBuffer = $rxBuffer.Substring($rxBuffer.Length - 8192)\n64:                 }\n65: \n66:                 $lines = $incoming -split \"`r?`n\"\n67:                 foreach ($ln in $lines) {\n68:                     if ($ln.Trim().Length -gt 0) {\n69:                         Write-Log \"[UART-RX] $ln\"\n70:                     }\n71:                 }\n72: \n73:                 # A1) Si vemos el inicio de arranque (BL1/BL2/BL31/U-Boot) y aún no hemos desbloqueado U-Boot,\n74:                 # enviamos pulsos de Enter para detener el autoboot en cuanto U-Boot abra la consola.\n75:                 if (($incoming -match \"G12A:BL:|BL2 Built|BL31:|U-Boot 2015|reboot_mode=|Hit any key to stop autoboot\") -and (-not $ubootUnlocked)) {\n76:                     Write-Log \"[!] DETECTADO ARRANQUE DE BOOTLOADER: Enviando rafaga de interrupcion hacia U-Boot...\"\n77:                     for ($k = 0; $k -lt 35; $k++) {\n78:                         $serialPort.Write(\"`r\")\n79:                         Start-Sleep -Milliseconds 25\n80:                         $subRx = $serialPort.ReadExisting()\n81:                         if (-not [string]::IsNullOrEmpty($subRx)) {\n82:                             $rxBuffer += $subRx\n83:                             foreach ($sln in ($subRx -split \"`r?`n\")) {\n84:                                 if ($sln.Trim().Length -gt 0) { Write-Log \"[UART-RX] $sln\" }\n85:                             }\n86:                             if ($subRx -match \"g12a_u212_v1#|gxl_p212_v1#|=>\") {\n87:                                 break\n88:                             }\n89:                         }\n90:                     }\n91:                 }\n92: \n93:                 # A2) Si entramos al prompt de U-Boot (g12a_u212_v1#)\n94:                 if (($rxBuffer -match \"g12a_u212_v1#|gxl_p212_v1#\") -and (-not $ubootUnlocked)) {\n95:                     Write-Log \"[+] ¡CONSOLA U-BOOT CAPTURADA! Ejecutando desbloqueo directo en eMMC...\"\n96:                     Send-UartCommand $serialPort \"printenv\"\n97:                     Start-Sleep -Milliseconds 800\n98:                     $envDump = $serialPort.ReadExisting()\n99:                     if ($envDump) {\n100:                         foreach ($eln in ($envDump -split \"`r?`n\")) {\n101:                             if ($eln.Trim().Length -gt 0) { Write-Log \"[UBOOT-ENV] $eln\" }\n102:                         }\n103:                     }\n104:                     Send-UartCommand $serialPort \"setenv lock 10100000\"\n105:                     Start-Sleep -Milliseconds 150\n106:                     Send-UartCommand $serialPort \"setenv unlock_ability 1\"\n107:                     Start-Sleep -Milliseconds 150\n108:                     Send-UartCommand $serialPort \"setenv EnableSelinux permissive\"\n109:                     Start-Sleep -Milliseconds 150\n110:                     Send-UartCommand $serialPort \"saveenv\"\n111:                     Start-Sleep -Milliseconds 800\n112:                     $saveOut = $serialPort.ReadExisting()\n113:                     if ($saveOut) { Write-Log \"[UBOOT-SAVE] $($saveOut.Trim())\" }\n114:                     Send-UartCommand $serialPort \"fastboot\"\n115:                     $ubootUnlocked = $true\n116:                 }\n117: \n118:                 # B) Si entramos a la consola Root (#) de Recovery\n119:                 if (($incoming -match \"gpio_keypad_down_cnt: 60\" -or $incoming -match \"/system/bin/sh\" -or $incoming -match \"(^|\\n)# \") -and (-not $recoveryPatched)) {\n120:                     Write-Log \"[+] ¡CONSOLA ROOT (#) DE RECOVERY DETECTADA! Ejecutando diagnostico y parche CRC32 de /dev/block/env...\"\n121:                     Start-Sleep -Milliseconds 500\n122:                     Send-UartCommand $serialPort \"echo === CONEXION_ROOT_ANTIGRAVITY_OK ===\"\n123:                     Send-UartCommand $serialPort \"id; uname -a; getprop ro.serialno; getprop ro.build.display.id\"\n124:                     Start-Sleep -Milliseconds 600\n125:                     Send-UartCommand $serialPort \"cat /proc/partitions\"\n126:                     Start-Sleep -Milliseconds 600\n127:                     Send-UartCommand $serialPort \"strings /dev/block/env | grep -E 'lock|ethaddr|serial|bootcmd|version|selinux'\"\n128:                     Start-Sleep -Milliseconds 600\n129:                     Send-UartCommand $serialPort \"setprop ubootenv.var.lock 10100000\"\n130:                     $patchCmd = \"dd if=/dev/block/env of=/dev/env_orig.bin bs=65536 count=1 2>/dev/null; dd if=/dev/env_orig.bin bs=1 skip=4 count=65532 2>/dev/null | sed 's/lock=10001000/lock=10100000/g' > /dev/env_body.bin; gzip -c /dev/env_body.bin > /dev/env_body.gz; S=`$(wc -c < /dev/env_body.gz); O=`$((S - 8)); dd if=/dev/env_body.gz bs=1 skip=`$O count=4 2>/dev/null > /dev/env_new.bin; cat /dev/env_body.bin >> /dev/env_new.bin; dd if=/dev/env_new.bin of=/dev/block/env bs=65536 count=1 2>/dev/null; sync; strings /dev/block/env | grep '^lock='; echo === PARCHE_ENV_COMPLETADO ===\"\n131:                     Send-UartCommand $serialPort $patchCmd\n132:                     Start-Sleep -Seconds 3\n133:                     $recOut = $serialPort.ReadExisting()\n134:                     if ($recOut) {\n135:                         foreach ($rln in ($recOut -split \"`r?`n\")) {\n136:                             if ($rln.Trim().Length -gt 0) { Write-Log \"[ROOT-RX] $rln\" }\n137:                         }\n138:                     }\n139:                     Send-UartCommand $serialPort \"reboot bootloader\"\n140:                     $recoveryPatched = $true\n141:                 }\n142:             }\n143:         } catch {\n144:             # Ignorar timeouts normales de lectura serie\n145:         }\n146:     }\n147: \n148:     # 3. Verificar si la caja está conectada en USB Fastboot\n149:     $fbDevices = & $fbExe devices 2>&1 | Out-String\n150:     if ($fbDevices -match \"fastboot\") {\n151:         Write-Log \"[+] CAJA DETECTADA EN USB FASTBOOT: $($fbDevices.Trim())\"\n152: \n153:         # Intentar comandos de desbloqueo por USB\n154:         $u1 = & $fbExe flashing unlock_critical 2>&1 | Out-String\n155:         Write-Log \"[FASTBOOT] flashing unlock_critical: $($u1.Trim())\"\n156: \n157:         $u2 = & $fbExe flashing unlock 2>&1 | Out-String\n158:         Write-Log \"[FASTBOOT] flashing unlock: $($u2.Trim())\"\n159: \n160:         $u3 = & $fbExe oem \"setenv lock 10100000\" 2>&1 | Out-String\n161:         Write-Log \"[FASTBOOT] oem setenv lock 10100000: $($u3.Trim())\"\n162: \n163:         $u4 = & $fbExe oem \"saveenv\" 2>&1 | Out-String\n164:         Write-Log \"[FASTBOOT] oem saveenv: $($u4.Trim())\"\n165: \n166:         # Probar flasheo de dtbo para confirmar si está desbloqueado\n167:         $testDtbo = & $fbExe flash dtbo (Join-Path $fbDir \"dtbo.img\") 2>&1 | Out-String\n168:         Write-Log \"[FASTBOOT] Prueba flash dtbo: $($testDtbo.Trim())\"\n169: \n170:         if ($testDtbo -match \"locked device\") {\n171:             Write-Log \"[!] USB Fastboot sigue reportando 'locked device' (lock=10001000 en eMMC). Reiniciando hacia UART para interceptar U-Boot...\"\n172:             if ($null -ne $serialPort -and $serialPort.IsOpen) {\n173:                 $ubootUnlocked = $false\n174:                 & $fbExe reboot | Out-Null\n175:                 # Ráfaga de Enter para atrapar U-Boot en cuanto reinicie\n176:                 for ($i = 0; $i -lt 160; $i++) {\n177:                     $serialPort.Write(\"`r\")\n178:                     Start-Sleep -Milliseconds 25\n179:                     $subRx = $serialPort.ReadExisting()\n180:                     if (-not [string]::IsNullOrEmpty($subRx)) {\n181:                         $rxBuffer += $subRx\n182:                         foreach ($sln in ($subRx -split \"`r?`n\")) {\n183:                             if ($sln.Trim().Length -gt 0) { Write-Log \"[UART-RX] $sln\" }\n184:                         }\n185:                         if ($subRx -match \"g12a_u212_v1#|gxl_p212_v1#\") {\n186:                             Write-Log \"[+] ¡U-BOOT ATRAPADO TRAS REINICIO FASTBOOT!\"\n187:                             Send-UartCommand $serialPort \"setenv lock 10100000\"\n188:                             Start-Sleep -Milliseconds 150\n189:                             Send-UartCommand $serialPort \"setenv EnableSelinux permissive\"\n190:                             Start-Sleep -Milliseconds 150\n191:                             Send-UartCommand $serialPort \"saveenv\"\n192:                             Start-Sleep -Milliseconds 800\n193:                             Send-UartCommand $serialPort \"fastboot\"\n194:                             $ubootUnlocked = $true\n195:                             break\n196:                         }\n197:                     }\n198:                 }\n199:             }\n200:         } elseif (-not $fastbootFlashed -and $FlashAndroid12) {\n201:             Write-Log \"[+] ¡BOOTLOADER DESBLOQUEADO VERIFICADO! Flasheando Android 12 seguro...\"\n202:             Push-Location $fbDir\n203:             try {\n204:                 foreach ($pair in @(\n205:                     @(\"boot\", \"boot.img\"),\n206:                     @(\"bootloader\", \"bootloader.img\"),\n207:                     @(\"_aml_dtb\", \"dtb.img\"),\n208:                     @(\"dtbo\", \"dtbo.img\"),\n209:                     @(\"logo\", \"logo.img\"),\n210:                     @(\"param\", \"param.img\"),\n211:                     @(\"conf\", \"conf.img\"),\n212:                     @(\"oem\", \"oem.img\"),\n213:                     @(\"super\", \"super.img\"),\n214:                     @(\"vbmeta\", \"vbmeta.img\"),\n215:                     @(\"recovery\", \"recovery.img\")\n216:                 )) {\n217:                     $part = $pair[0]\n218:                     $img = $pair[1]\n219:                     Write-Log \"[FLASH] fastboot flash $part $img ...\"\n220:                     $res = & $fbExe flash $part $img 2>&1 | Out-String\n221:                     Write-Log \"[FLASH-RES] $($res.Trim())\"\n222:                 }\n223:                 if (Test-Path $cacheImg) {\n224:                     Write-Log \"[FLASH] fastboot flash cache $cacheImg ...\"\n225:                     $res = & $fbExe flash cache $cacheImg 2>&1 | Out-String\n226:                     Write-Log \"[FLASH-RES] $($res.Trim())\"\n227:                 } else {\n228:                     & $fbExe erase cache 2>&1 | Out-Null\n229:                 }\n230:                 Write-Log \"[FLASH] fastboot erase userdata ...\"\n231:                 $res = & $fbExe erase userdata 2>&1 | Out-String\n232:                 Write-Log \"[FLASH-RES] $($res.Trim())\"\n233:                 $fastbootFlashed = $true\n234:                 Write-Log \"[+] ¡FLASHEO DE ANDROID 12 COMPLETADO CON EXITO!\"\n235:             } finally {\n236:                 Pop-Location\n237:             }\n238:         } else {\n239:             # Keep-Alive Anti-Watchdog\n240:             & $fbExe getvar version 2>&1 | Out-Null\n241:         }\n242:     }\n243: \n244:     [GC]::Collect()\n245:     Start-Sleep -Milliseconds 200\n246: }"}
