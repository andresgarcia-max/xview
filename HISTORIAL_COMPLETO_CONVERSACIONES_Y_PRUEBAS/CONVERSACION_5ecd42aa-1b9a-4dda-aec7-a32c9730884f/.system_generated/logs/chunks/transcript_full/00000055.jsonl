t &&\n528:                 !string.IsNullOrWhiteSpace(wcCheck.Output) &&\n529:                 wcCheck.Output.IndexOf(\"No [WorldCup Device]\", StringComparison.OrdinalIgnoreCase) < 0 &&\n530:                 wcCheck.Output.IndexOf(\"can not find device\", StringComparison.OrdinalIgnoreCase) < 0)\n531:             {\n532:                 state.UsbHardwareMode = \"Amlogic WorldCup Activo (VID_1B8E)\";\n533:                 state.RawPid = \"1B8E\";\n534:             }\n535: \n536:             try\n537:             {\n538:                 using (ManagementObjectSearcher searcher = new ManagementObjectSearcher(\n539:                     \"SELECT DeviceID FROM Win32_PnPEntity WHERE DeviceID LIKE '%VID_18D1%' OR DeviceID LIKE '%VID_19D2%' OR DeviceID LIKE '%VID_1B8E%'\"))\n540:                 {\n541:                     foreach (ManagementObject dev in searcher.Get())\n542:                     {\n543:                         string devId = Convert.ToString(dev[\"DeviceID\"]) ?? \"\";\n544:                         int lastSlash = devId.LastIndexOf('\\\\');\n545:                         if (lastSlash >= 0 && lastSlash + 1 < devId.Length)\n546:                         {\n547:                             string sn = devId.Substring(lastSlash + 1);\n548:                             if (!sn.Contains(\"&\")) state.SerialNumber = sn;\n549:                         }\n550: \n551:                         if (devId.IndexOf(\"PID_4EE2\", StringComparison.OrdinalIgnoreCase) >= 0)\n552:                         {\n553:                             state.UsbHardwareMode = \"ADB USB Activo (PID_4EE2)\";\n554:                             state.RawPid = \"4EE2\";\n555:                         }\n556:                         else if (devId.IndexOf(\"PID_4EE7\", StringComparison.OrdinalIgnoreCase) >= 0)\n557:                         {\n558:                             state.UsbHardwareMode = \"Recovery Fastbootd Activo (PID_4EE7)\";\n559:                             state.RawPid = \"4EE7\";\n560:                         }\n561:                         else if (devId.IndexOf(\"PID_0D02\", StringComparison.OrdinalIgnoreCase) >= 0)\n562:                         {\n563:                             state.RawPid = \"0D02\";\n564:                         }\n565:                         else if (devId.IndexOf(\"PID_4EE1\", StringComparison.OrdinalIgnoreCase) >= 0)\n566:                         {\n567:                             state.UsbHardwareMode = \"Conectada por USB (PID_4EE1) - Presiona [1] para Iniciar\";\n568:                             state.RawPid = \"4EE1\";\n569:                         }\n570:                         else if (devId.IndexOf(\"VID_1B8E\", StringComparison.OrdinalIgnoreCase) >= 0)\n571:                         {\n572:                             state.UsbHardwareMode = \"Amlogic WorldCup Activo (VID_1B8E)\";\n573:                             state.RawPid = \"1B8E\";\n574:                         }\n575:                     }\n576:                 }\n577:             }\n578:             catch { }\n579: \n580:             if (File.Exists(ADB_EXE))\n581:             {\n582:                 ToolResult adbRes = InvokeToolSafe(ADB_EXE, \"devices\", 1200, false);\n583:                 if (!adbRes.TimedOut)\n584:                 {\n585:                     foreach (string rawLine in adbRes.Output.Split(new[] { '\\r', '\\n' }, StringSplitOptions.RemoveEmptyEntries))\n586:                     {\n587:                         Match m = Regex.Match(rawLine.Trim(), @\"^(\\S+)\\s+(device|unauthorized|offline)$\");\n588:                         if (m.Success) state.AdbDevices.Add(m.Groups[1].Value + \" [\" + m.Groups[2].Value + \"]\");\n589:                     }\n590:                 }\n591:             }\n592: \n593:             if (File.Exists(FASTBOOT_EXE))\n594:             {\n595:                 ToolResult fbRes = InvokeFastbootSafe(\"devices\", 1000, false);\n596:                 if (!fbRes.TimedOut)\n597:                 {\n598:                     foreach (string rawLine in fbRes.Output.Split(new[] { '\\r', '\\n' }, StringSplitOptions.RemoveEmptyEntries))\n599:                     {\n600:                         Match m = Regex.Match(rawLine.Trim(), @\"^(\\S+)\\s+fastboot\");\n601:                         if (m.Success)\n602:                         {\n603:                             string candidateSn = m.Groups[1].Value;\n604:                             ToolResult ping = InvokeFastbootSafe(\"getvar version-bootloader\", 800, false);\n605:                             if (!ping.TimedOut && (\n606:                                 ping.Output.IndexOf(\"version-bootloader\", StringComparison.OrdinalIgnoreCase) >= 0 ||\n607:                                 ping.Output.IndexOf(\"OKAY\", StringComparison.OrdinalIgnoreCase) >= 0 ||\n608:                                 ping.Output.IndexOf(\"Finished\", StringComparison.OrdinalIgnoreCase) >= 0))\n609:                             {\n610:                                 state.FastbootDevices.Add(candidateSn);\n611:                                 state.FastbootLive = true;\n612:                                 if (state.RawPid == \"0D02\")\n613:                                 {\n614:                                     state.UsbHardwareMode = \"Modo Fastboot Activo en Vivo (PID_0D02)\";\n615:                                 }\n616:                                 else if (state.RawPid == \"4EE7\")\n617:                                 {\n618:                                     state.UsbHardwareMode = \"Recovery Fastbootd Activo en Vivo (PID_4EE7)\";\n619:                                 }\n620:                             }"}
