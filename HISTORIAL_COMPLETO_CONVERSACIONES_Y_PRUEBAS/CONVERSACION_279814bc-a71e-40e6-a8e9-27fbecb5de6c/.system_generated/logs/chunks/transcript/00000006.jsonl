rkingDirectory = $targetDir\\n$lnk3.IconLocation = \\\"$iconPath, 0\\\"\\n$lnk3.Description = \\\"Fitness Legends - Cartera de Clientes y Membresias Pro\\\"\\n$lnk3.Save()\\n\\n# 4. Vincular Equipos\\n$lnk4 = $wsh.CreateShortcut(\\\"$targetDir\\\\4. Vincular Equipos en Red LAN.lnk\\\")\\n$lnk4.TargetPath = \\\"$targetDir\\\\4. VINCULAR_EQUIPOS_RED_LAN.bat\\\"\\n$lnk4.WorkingDirectory = $targetDir\\n$lnk4.IconLocation = \\\"$iconPath, 0\\\"\\n$lnk4.Description = \\\"Fitness Legends - Asistente de Conexion en Red LAN\\\"\\n$lnk4.Save()\\n\\nWrite-Host \\\"Shortcuts created successfully.\\\"\"","WaitMsBeforeAsync":"5000","toolSummary":"\"Create Windows shortcuts in accesos directos\""}}]}
