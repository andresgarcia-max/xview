on = \\\"Fitness Legends - Caja y Finanzas\\\"\\n$lnk4.Save()\\n\\nWrite-Host \\\"Shortcuts created in SISTEMA_ERP_ADMINISTRADOR.\\\"\"","WaitMsBeforeAsync":"5000","toolSummary":"\"Create shortcuts in SISTEMA_ERP_ADMINISTRADOR\""}}]}
