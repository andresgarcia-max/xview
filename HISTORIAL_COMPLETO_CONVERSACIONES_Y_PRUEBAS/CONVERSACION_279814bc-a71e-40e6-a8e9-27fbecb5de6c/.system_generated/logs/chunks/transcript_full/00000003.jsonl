er' && (\r\n62:       activeTab === 'pos' || \r\n63:       activeTab === 'cash' || \r\n64:       activeTab === 'inventory' || \r\n65:       activeTab === 'catalog' || \r\n66:       activeTab === 'expenses' ||\r\n67:       activeTab === 'incomes' ||\r\n68:       activeTab.startsWith('config_')\r\n69:     )) {\r\n70:       setActiveTab('access');\r\n71:     }\r\n72:   }, [currentRole, activeTab]);\r\n73: \r\n74:   return (\r\n75:     <div className=\"min-h-screen bg-gym-bg text-gym-text flex flex-col font-sans select-none sm:select-auto\">\r\n76:       \r\n77:       {/* Top Navbar matching Panadería Brito */}\r\n78:       <Navbar \r\n79:         activeTab={activeTab} \r\n80:         setActiveTab={setActiveTab} \r\n81:         onOpenCart={() => setIsCartOpen(true)}\r\n82:         onOpenNotifications={() => setIsNotificationsOpen(true)}\r\n83:         onOpenSync={() => setIsSyncModalOpen(true)}\r\n84:       />\r\n85: \r\n86:       <div className=\"flex-1 flex overflow-hidden\">\r\n87:         {/* Navigation Sidebar */}\r\n88:         <Sidebar activeTab={activeTab} setActiveTab={setActiveTab} />\r\n89: \r\n90:         {/* Dynamic Main Workspace View */}\r\n91:         <main className={`flex-1 ${\r\n92:           activeTab === 'pos' \r\n93:             ? 'p-2 sm:p-2.5 overflow-hidden flex flex-col h-[calc(100vh-61px)]' \r\n94:             : 'overflow-y-auto p-4 sm:p-6 lg:p-8'\r\n95:         } bg-gradient-to-b from-gym-bg to-[#07080c]`}>\r\n96:           <div className={activeTab === 'pos' ? 'w-full h-full flex flex-col max-w-[1800px] mx-auto' : 'max-w-7xl mx-auto'}>\r\n97:             {activeTab === 'dashboard' && <Dashboard setActiveTab={setActiveTab} />}\r\n98:             {activeTab === 'access' && <TurnstileTerminal />}\r\n99:             {activeTab === 'pos' && (\r\n100:               <PosTerminal \r\n101:                 isCartOpen={isCartOpen} \r\n102:                 setIsCartOpen={setIsCartOpen} \r\n103:                 onNavigateToCash={() => setActiveTab('cash'