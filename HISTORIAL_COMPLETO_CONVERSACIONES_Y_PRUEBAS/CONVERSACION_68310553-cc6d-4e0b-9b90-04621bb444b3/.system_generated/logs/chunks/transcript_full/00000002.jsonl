 return true;\n981:             }\n982:             catch (Exception ex)\n983:             {\n984:                 WriteColor(\"[!] Error en USB: \" + ex.Message, ConsoleColor.Red);\n985:                 return false;\n986:             }\n987:         }\n988:     }\n989: }"}
