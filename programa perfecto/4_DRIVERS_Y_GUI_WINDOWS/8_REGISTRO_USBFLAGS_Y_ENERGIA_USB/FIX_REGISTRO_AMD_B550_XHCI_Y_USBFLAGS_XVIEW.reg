; ------------------------------------------------------------------------------------
; 3. IGNORAR CAMBIOS DE NUMERO DE SERIE EN RE-ENUMERACION RAPIDA (EVITA BLOQUEOS EN B550)
; ------------------------------------------------------------------------------------
[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Control\usbflags]
"IgnoreHWSerNum18D10D02"=hex:01
"IgnoreHWSerNum18D14EE7"=hex:01
"IgnoreHWSerNum18D14EE0"=hex:01
"IgnoreHWSerNum1B8EC003"=hex:01
"IgnoreHWSerNum1B8EC004"=hex:01
